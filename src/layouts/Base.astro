---
/* 全局壳 — axiom 方向(2026-08-20 主人指令):自托管双字体 + 固定洛伦兹粒子背景
   + 全站交互引擎(fx.ts)。SEO/hreflang/JSON-LD 契约不变。 */
import '@fontsource/funnel-display/400.css';
import '@fontsource/funnel-display/500.css';
import '@fontsource/space-mono/400.css';
import '@fontsource/space-mono/700.css';
import '@fontsource/be-vietnam-pro/500.css';
import '../styles/tokens.css';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { locales, type Locale } from '../i18n';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  /** path without locale prefix, e.g. "/" or "/learn" — for hreflang alternates */
  path?: string;
}
const { locale, title, description, path = '/' } = Astro.props;
const site = Astro.site ?? new URL('https://nexgrid.ai');
const urlFor = (l: Locale) => new URL(l === 'en' ? path : `/${l}${path}`, site).href;
---

<!doctype html>
<html lang={locale} data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- 本站自带暗色设计:head 内 meta 声明让 UA 强制暗色(Auto Dark)全局收手。
         注意:CSS 里的 color-scheme 声明实测不被本机 Chromium 的 auto-dark 认,
         必须用 meta(最小复现页 A/B 实证,2026-08-20)。 -->
    <meta name="color-scheme" content="dark" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={urlFor(locale)} />
    {locales.map((l) => <link rel="alternate" hreflang={l} href={urlFor(l)} />)}
    <link rel="alternate" hreflang="x-default" href={urlFor('en')} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={urlFor(locale)} />
    <meta property="og:image" content={new URL('/og.png', site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'Organization',
        name: 'NexGrid',
        url: site.href,
        logo: new URL('/favicon.svg', site).href,
      })}
    />
  </head>
  <body>
    <canvas id="x-bg" aria-hidden="true"></canvas>
    <SiteNav locale={locale} path={path} />
    <div class="x-frame">
      <div class="x-canvas">
        <slot />
        <SiteFooter locale={locale} />
      </div>
    </div>
    <script src="../scripts/fx.ts"></script>
  </body>
</html>

<style is:global>
  body {
    margin: 0;
    font-family: var(--x-font-display);
    background: var(--x-bg);
    color: var(--x-ink);
    line-height: 1.6;
  }
  /* 固定粒子底层:z-0;所有内容 z≥1(暗区块透出粒子,亮区块以实底盖住) */
  #x-bg {
    position: fixed;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    display: block;
    background: var(--x-bg);
  }
  /* 层叠哲学(参考站同款):canvas z0 < 导航 z1 < 内容 z2。
     导航透过暗区块的透明底可见;反白区块(不透明)滑上来时直接盖过导航。 */
  /* 全宽裁切框:停放的叠卡裁在**屏缘**(参考站同口径:裁切盒 = [0, 视口宽])。
     不能放 body —— body 的溢出属性会被上交给视口、body 自己反而不裁,文档宽度照样被撑开(实测溢出 5153px);
     也不能放画布 —— 那会把裁切边拉回画布边,卡片从屏内一条硬边凭空冒出(R39 实录)。
     用 clip 不用 hidden:clip 不制造滚动容器,吸顶不受影响。 */
  .x-frame {
    overflow-x: clip;
  }

  /* ── R42 画布壳 ──
     参考站是「1440 画布整体缩放、1920 封顶、再宽居中」。本站此前用三百多条声明逐个模拟,
     两轮评审证明那条路的缺陷族补不完(门被换个写法即绕过)。改为**整体缩放**后,
     字号/盒子/间距/边框/渐变止点/栅格全部按构造等比,该族结构性绝种。
     用 zoom 不用 transform:zoom 影响布局(无需 JS 补高)且**不破坏 sticky**(叠卡编舞得以原样保留);
     transform 两条都不满足(已逐项实测)。
     ⚠️ 画布内禁用视口单位 —— 会被 zoom 二次放大。 */
  .x-canvas {
    width: 1440px;
    margin-inline: auto;
    zoom: var(--x-zoom);
  }
  /* 断点定在 1440:该处画布宽 = 视口宽、zoom 恰为 1,两条曲线天然接合 —— **裂缝在构造上不存在**。
     定在 1200 会有 16.7% 的硬跳变(R41 实测),且 1200-1439 段小字掉到 10px、触达破 44px。 */
  @media (max-width: 1439px) {
    .x-canvas {
      width: auto;
      zoom: 1;
    }
  }

  main {
    position: relative;
    z-index: 2;
  }
  ::selection {
    background: var(--x-accent);
    color: var(--x-on-accent);
  }
</style>
