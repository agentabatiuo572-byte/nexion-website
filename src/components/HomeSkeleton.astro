---
/* Home 剩余板块占位骨架 — hero 已由 HeroSection(T3)顶替,本组件只占 T4-T12 未落地板块。
   id 一律字面量(anchor-check 门按字面量扫,OBS-3 裁决);逐板块落地后删除对应 stub,
   全部落地后删除本组件。 */
import { useT, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useT(locale);
---

<section class="stub" id="stats" aria-label="Live platform stats">
  <h2>Live platform stats</h2>
  <p class="note">{t('scaffold.placeholder')}</p>
</section>
<section class="stub" id="path" aria-label="Earning path">
  <h2>Earning path</h2>
  <p class="note">{t('scaffold.placeholder')}</p>
</section>
<section class="stub" id="how" aria-label="How it works">
  <h2>How it works</h2>
  <p class="note">{t('scaffold.placeholder')}</p>
</section>
<section class="stub" id="devices" aria-label="Devices">
  <h2>Devices</h2>
  <p class="note">{t('scaffold.placeholder')}</p>
</section>
<section class="stub" id="trust" aria-label="Trust">
  <h2>Trust</h2>
  <p class="note">{t('scaffold.placeholder')}</p>
</section>
<section class="stub" id="nex" aria-label="NEX">
  <h2>NEX</h2>
  <p class="note">{t('scaffold.placeholder')}</p>
</section>
<section class="stub" id="faq" aria-label="FAQ">
  <h2>FAQ</h2>
  <p class="note">{t('scaffold.placeholder')}</p>
</section>

<style>
  .stub {
    max-width: var(--w-content-max);
    margin: 0 auto;
    padding: 48px 20px;
    border-top: 1px solid var(--v5-border);
  }
  .stub h2 {
    font-size: 18px;
    font-weight: 600;
    color: var(--v5-ink-2);
    margin: 0 0 6px;
  }
  .note {
    color: var(--v5-ink-4);
    font-size: 13px;
    margin: 6px 0 0;
  }
</style>
