---
/* [FEAT-WEB13] Why now 行业叙事板块 — R3 卡片排版重构(主人 2026-09-01 拍板 ABC 混合定稿)。
   叙事之桥不变(紧缺在最高端 → 集中式撞物理墙 → 分布式绕墙 → F@h 先例 → 8.8B 连接普惠收束),
   变的是版式:整段连排 → **三幕**,每幕 = 线绘插画 + 幕号 + 标题 + 带批注的短文 + 数字锚。
   三处取材:A 三幕骨架与数字锚 · B 批注墨水([[硬数据]] 柠檬底块 / __关键短语__ 柠檬下划线 /
   ^N^ 引注上标,六条来源全部被逐条引用)· C 线绘插画(与粒子地球同族的 stroke 语言)。
   引用卡上真人头像(NVIDIA Newsroom / Microsoft-Brian Smale CC BY-SA 4.0,署名在 photoCredit)。

   合规姿势不变(PRD §1.4-2):公司名只以文字出现,零 logo;每数字带 as-of 日期戳;
   Sources 折叠块列「机构+报告名+日期+外链」;非关联免责声明常驻于板块尾、所有具名内容之后。
   ⚠️ 与 social/mission 的定高体例仍是有意偏差:本板块含可展开 <details>,
   定高 + overflow:hidden 会把展开内容静默截掉(竖向裁切无机器门可见)→ min-height、不写 hidden。
   ⚠️ 'why' 不加入 fx.ts ANCHOR_IDS(需新姿态定义并重排四段混合链,属编舞重设计);
   本区段地球停 poseHome(中央大球),故正文与小字全部进玻璃 tile 护字,大标题裸排压球(hero 先例)。 */
import { useT, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useT(locale);

/* 批注标记解析:[[硬数据]] / __关键短语__ / ^N^ 引注上标 → 片段流。
   ponytail:标记只此一处消费,就地解析不建工具模块;文案里存标记而非 HTML —— 译者
   移动整块即可(三语语序差异大),且 JSON 永不含标签,杜绝 set:html 注入面。 */
type Frag = { k: 'plain' | 'data' | 'em' | 'ref'; s: string };
const marks = (src: string): Frag[] => {
  const out: Frag[] = [];
  const re = /\[\[(.+?)\]\]|__(.+?)__|\^(\d)\^/g;
  let last = 0;
  let m: RegExpExecArray | null;
  while ((m = re.exec(src)) !== null) {
    if (m.index > last) out.push({ k: 'plain', s: src.slice(last, m.index) });
    if (m[1] !== undefined) out.push({ k: 'data', s: m[1] });
    else if (m[2] !== undefined) out.push({ k: 'em', s: m[2] });
    else out.push({ k: 'ref', s: m[3] });
    last = re.lastIndex;
  }
  if (last < src.length) out.push({ k: 'plain', s: src.slice(last) });
  return out;
};

/* 三幕插画:与背景粒子网络同族的 stroke 线绘(无填充、无文字标签 —— 标签会绕过 i18n)。
   幕一 = 指数曲线;幕二 = 满载机房撞上断电的墙;幕三 = 中心节点辐射的设备网络。 */
const ART: Record<number, string> = {
  1: `<svg class="art" viewBox="0 0 320 112" fill="none" role="img" aria-hidden="true" focusable="false">
        <path d="M16 10v88h288" stroke="var(--x-line)" stroke-width="1"/>
        <path d="M16 74h288M16 44h288" stroke="var(--x-line-soft)" stroke-width="1"/>
        <path d="M16 94 C 116 90, 186 78, 226 52 C 252 34, 272 22, 294 8" stroke="var(--x-accent)" stroke-width="2" stroke-linecap="round"/>
        <circle cx="226" cy="52" r="3.5" fill="var(--x-bg)" stroke="var(--x-accent-hot)" stroke-width="2"/>
        <circle cx="294" cy="8" r="3.5" fill="var(--x-bg)" stroke="var(--x-accent-hot)" stroke-width="2"/>
      </svg>`,
  2: `<svg class="art" viewBox="0 0 320 112" fill="none" role="img" aria-hidden="true" focusable="false">
        <rect x="18" y="38" width="38" height="60" rx="2" stroke="var(--x-ink-dim)" stroke-width="1.5"/>
        <rect x="66" y="22" width="38" height="76" rx="2" stroke="var(--x-ink-dim)" stroke-width="1.5"/>
        <rect x="114" y="50" width="38" height="48" rx="2" stroke="var(--x-ink-dim)" stroke-width="1.5"/>
        <path d="M25 50h24M25 62h24M73 34h24M73 46h24M121 62h24M121 74h24" stroke="var(--x-line)" stroke-width="1.5"/>
        <path d="M186 6v92" stroke="var(--x-accent)" stroke-width="2" stroke-dasharray="6 5"/>
        <path d="M228 28l-13 24h15l-13 24" stroke="var(--x-accent-hot)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>`,
  3: `<svg class="art" viewBox="0 0 320 112" fill="none" role="img" aria-hidden="true" focusable="false">
        <circle cx="160" cy="56" r="24" stroke="var(--x-accent)" stroke-width="1" stroke-dasharray="2 4" opacity="0.45"/>
        <path d="M152 53 L79 29M154 61 L63 80M156 49 L131 17M168 52 L229 25M169 59 L257 72M164 64 L190 95M154 62 L105 98" stroke="var(--x-accent)" stroke-width="1" opacity="0.5"/>
        <circle cx="160" cy="56" r="8" stroke="var(--x-accent-hot)" stroke-width="2"/>
        <circle cx="74" cy="26" r="4.5" stroke="var(--x-ink-dim)" stroke-width="1.5"/>
        <circle cx="58" cy="82" r="4.5" stroke="var(--x-ink-dim)" stroke-width="1.5"/>
        <circle cx="128" cy="14" r="4.5" stroke="var(--x-ink-dim)" stroke-width="1.5"/>
        <circle cx="234" cy="22" r="4.5" stroke="var(--x-ink-dim)" stroke-width="1.5"/>
        <circle cx="262" cy="74" r="4.5" stroke="var(--x-ink-dim)" stroke-width="1.5"/>
        <circle cx="192" cy="98" r="4.5" stroke="var(--x-ink-dim)" stroke-width="1.5"/>
        <circle cx="100" cy="100" r="4.5" stroke="var(--x-ink-dim)" stroke-width="1.5"/>
      </svg>`,
};
const ACTS = [1, 2, 3] as const;

/* 来源外链:URL 不进 i18n(TrustSection order 数组同体例)。序号与 why.src{n} 及正文 ^N^ 引注一一对应。 */
const SOURCES = [
  { n: 1, url: 'https://investor.nvidia.com/news/press-release-details/2026/NVIDIA-Announces-Financial-Results-for-Second-Quarter-Fiscal-2027/default.aspx' },
  { n: 2, url: 'https://www.cbre.com/insights/books/north-america-data-center-trends-h1-2026' },
  { n: 3, url: 'https://www.tomshardware.com/tech-industry/artificial-intelligence/microsoft-ceo-says-the-company-doesnt-have-enough-electricity-to-install-all-the-ai-gpus-in-its-inventory-you-may-actually-have-a-bunch-of-chips-sitting-in-inventory-that-i-cant-plug-in' },
  { n: 4, url: 'https://epoch.ai/data-insights/compute-trend-post-2010' },
  { n: 5, url: 'https://www.gsmaintelligence.com/research/the-mobile-economy-2026' },
  { n: 6, url: 'https://www.techspot.com/news/84832-foldinghome-project-passes-24-exaflops-more-than-top.html' },
] as const;

/* 引用人:头像文件与姓名同源(public/people/<file>.webp,160 见方,官方新闻室件)。 */
const VOICES = [
  { n: 1, file: 'kress' },
  { n: 2, file: 'nadella' },
] as const;
---

<section class="why" id="why">
  <div class="head">
    <p class="kicker">
      <span class="ktick" aria-hidden="true"></span>
      <span class="ktxt x-mono-lg" data-tw>{t('why.kicker')}</span>
    </p>
    <h2 class="state x-display" data-lr>{t('why.title')}</h2>
  </div>

  <ol class="acts x-tile x-tile-calm" role="list" data-rv>
    {
      ACTS.map((n) => (
        <li class="act">
          <Fragment set:html={ART[n]} />
          <span class="anum x-mono">{`0${n}`}</span>
          <h3 class="atitle x-h24">{t(`why.act${n}Title`)}</h3>
          <p class="abody">
            {marks(t(`why.act${n}Body`)).map((f) =>
              f.k === 'data' ? (
                <span class="ink-data">{f.s}</span>
              ) : f.k === 'em' ? (
                <span class="ink-em">{f.s}</span>
              ) : f.k === 'ref' ? (
                <sup class="ink-ref x-mono">[{f.s}]</sup>
              ) : (
                f.s
              ),
            )}
          </p>
          <div class="anchor">
            <span class="anum-big">{t(`why.act${n}Num`)}</span>
            <span class="acap x-label">{t(`why.act${n}Cap`)}</span>
          </div>
        </li>
      ))
    }
  </ol>

  <div class="quotes">
    {
      VOICES.map(({ n, file }, i) => (
        <figure class="qcard x-tile" data-rv style={`--d:${i * 0.08}s`}>
          <div class="person">
            <img
              class="face"
              src={`/people/${file}.webp`}
              alt={t('why.portraitAlt', { name: t(`why.name${n}`) })}
              width="160"
              height="160"
              loading="lazy"
              decoding="async"
            />
            <span class="pnames">
              <span class="pname x-mono">{t(`why.name${n}`)}</span>
              <span class="prole x-label">{t(`why.role${n}`)}</span>
            </span>
          </div>
          <blockquote class="quote">{t(`why.quote${n}`)}</blockquote>
          <figcaption class="qmeta">
            <span class="qsrc x-label">
              <span class="qdot" aria-hidden="true" />
              {t(`why.meta${n}`)}
            </span>
            <span class="qdate x-label">{t(`why.date${n}`)}</span>
          </figcaption>
        </figure>
      ))
    }
  </div>

  {/* 板块尾:完整来源(可折叠)+ 常驻小字。免责与照片署名在所有具名内容之后,
      不可回避(FTC clear-and-conspicuous 口径;折叠态不可见即失职 —— R2 判例)。 */}
  <div class="foot x-tile x-tile-calm">
    <details class="sources">
      <summary>
        <span class="q x-q">{t('why.sourcesTitle')}</span>
        <span class="mark x-mono" aria-hidden="true">+</span>
      </summary>
      <ol class="srclist" role="list">
        {
          SOURCES.map(({ n, url }) => (
            <li>
              <a class="srcline x-mono" href={url} target="_blank" rel="noopener noreferrer">
                <span class="srcnum">[{n}]</span>
                <span class="srctxt">
                  {t(`why.src${n}`)} <span aria-hidden="true">↗</span>
                </span>
              </a>
            </li>
          ))
        }
      </ol>
    </details>
    <p class="disclaim x-mono">
      <span class="dtext">{t('why.disclaim')}</span>
      <span class="dtext dcredit">{t('why.photoCredit')}</span>
    </p>
  </div>
</section>

<style>
  .why {
    position: relative;
    z-index: 1;
    /* 有意偏差:min-height 不定高、无 overflow:hidden —— 见头注(details 展开不许被截) */
    min-height: var(--x-sec-h);
    padding: max(60px, calc(100 * var(--u))) var(--x-pad);
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: max(24px, calc(36 * var(--u)));
  }
  .head {
    display: flex;
    flex-direction: column;
    gap: max(24px, calc(40 * var(--u)));
  }
  /* 章节眉(全站体例:柠檬刻度 + 16 档保形眉标) */
  .kicker {
    color: var(--x-white);
    margin: 0;
    min-height: 1.2em;
    display: flex;
    align-items: center;
    gap: calc(10 * var(--uc));
  }
  .ktick {
    width: max(2px, calc(2 * var(--u)));
    height: max(20px, calc(20.16 * var(--u)));
    background: linear-gradient(to bottom, var(--x-accent-hot), color-mix(in srgb, var(--x-accent-hot) 10%, transparent));
    flex: 0 0 auto;
  }
  /* 大陈述 48 档(social/mission 同规格);大字裸排压球 = hero 先例 */
  .state {
    font-size: max(32px, calc(48 * var(--u)));
    color: var(--x-white);
    margin: 0;
    width: max-content;
    max-width: calc(835.2 * var(--u));
  }

  /* ── 三幕:等宽三列,列间细线(mission 六宫格同族的线即区界) ── */
  .acts {
    list-style: none;
    margin: 0;
    padding: calc(34 * var(--uc)) calc(38 * var(--uc));
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: calc(34 * var(--uc));
  }
  .act {
    display: flex;
    flex-direction: column;
    gap: calc(12 * var(--uc));
    min-width: 0;
  }
  .act + .act {
    border-left: 1px solid var(--x-line-soft);
    padding-left: calc(34 * var(--uc));
  }
  .act :global(.art) {
    width: 100%;
    height: calc(104 * var(--uc));
    display: block;
    margin-bottom: calc(4 * var(--uc));
  }
  .anum {
    color: var(--x-accent-hot);
  }
  .atitle {
    font-size: max(18px, calc(22 * var(--u)));
    color: var(--x-white);
    margin: 0;
  }
  /* 幕正文:13 档 sentence-case —— 长文可读性优先于全站 uppercase 体例
     (R2 工艺评审 P2 观察项「叙事段建议弃 uppercase」的采纳)。手写不挂 .x-mono:
     型类的 :lang 分支特异度会把字号盖回 12.5(SocialSection .roles 同型注释)。 */
  .abody {
    font-family: var(--x-font-mono);
    font-size: calc(13 * var(--uc));
    letter-spacing: 0;
    line-height: 1.65;
    color: var(--x-ink-cap);
    margin: 0;
    text-wrap: pretty;
  }
  .abody:lang(zh) {
    font-size: calc(13.5 * var(--uc));
    line-height: 1.75; /* CJK 密排不变量之上再放一档:本段是全站最小的正文 */
    word-spacing: -0.36em; /* mission.body zh 同款:收中西混排空洞 */
  }
  .abody:lang(vi) {
    line-height: 1.7; /* 叠音符 + 下点:比拉丁再放一档 */
  }
  /* 批注墨水:硬数据 = 柠檬底黑字(全站唯一的实心柠檬文字块,只给可核验数字);
     关键短语 = 白字 + 柠檬下划线;引注 = 柠檬上标,指向下方 Sources 同号条目。 */
  .ink-data {
    color: var(--x-on-accent);
    background: var(--x-accent);
    border-radius: calc(4 * var(--uc));
    padding: 0 calc(6 * var(--uc));
    white-space: nowrap;
  }
  .ink-em {
    color: var(--x-white);
    border-bottom: 1px solid var(--x-accent);
  }
  /* 引注上标:字号不得低于 12 档 —— 9 档在 1440 带经典滚动条时实测 8.91px,
     跌破 canvas-geometry 判据 E 的 11px 可读线(门当轮抓到)。上标形态由 <sup>
     自带的 vertical-align:super 承担,不靠更小的字号。 */
  .ink-ref {
    font-size: calc(12 * var(--uc));
    color: var(--x-accent-hot);
    line-height: 0; /* 上标不撑行盒:否则每有引注的一行都比邻行高(render-fit A 判据面) */
    margin-left: calc(2 * var(--uc));
  }
  /* 数字锚:幕的收束,54 档太重(三列并置会与首屏大字争),取 34 档 */
  .anchor {
    margin-top: auto;
    padding-top: calc(16 * var(--uc));
    border-top: 1px solid var(--x-line-soft);
    display: flex;
    flex-direction: column;
    gap: calc(6 * var(--uc));
  }
  .anum-big {
    font-family: var(--x-font-display);
    font-size: max(26px, calc(34 * var(--u)));
    font-weight: 500;
    color: var(--x-white);
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.02em;
    line-height: 1;
  }
  .acap {
    color: var(--x-ink-dim);
    text-wrap: pretty;
  }
  .acap:lang(zh) {
    line-height: 1.6; /* 全站 CJK 行高不变量(x-label 型类缺 zh 分支,组件侧补) */
  }

  /* ── 署名引用卡:头像 + 引语 + 机构徽记 ── */
  .quotes {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: calc(18 * var(--uc));
  }
  .qcard {
    margin: 0;
    padding: calc(28 * var(--uc)) calc(32 * var(--uc));
    display: flex;
    flex-direction: column;
    gap: calc(20 * var(--uc));
  }
  .person {
    display: flex;
    align-items: center;
    gap: calc(14 * var(--uc));
  }
  /* 真人头像(官方新闻室件):圆形裁切 + 细亮环,浅底照片在深玻璃上自成视觉锚 */
  .face {
    width: calc(52 * var(--uc));
    height: calc(52 * var(--uc));
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid var(--x-glass-border);
    flex: 0 0 auto;
    background: var(--x-glass);
  }
  .pnames {
    display: flex;
    flex-direction: column;
    gap: calc(3 * var(--uc));
    min-width: 0;
  }
  .pname {
    color: var(--x-white);
    text-transform: none; /* 专名照原样:全大写会把 Kress / Nadella 读成缩写 */
  }
  .prole {
    color: var(--x-ink-dim);
  }
  .prole:lang(zh) {
    line-height: 1.6;
  }
  .quote {
    margin: 0;
    font-family: var(--x-font-display);
    font-size: max(20px, calc(26 * var(--u)));
    font-weight: 400;
    letter-spacing: -0.02em;
    line-height: 1.3;
    color: var(--x-white);
    text-wrap: balance;
  }
  .quote:lang(zh),
  .quote:lang(vi) {
    line-height: 1.45; /* CJK 方块字与 vi 叠音符容不下 1.3 */
  }
  .qmeta {
    margin-top: auto;
    padding-top: calc(14 * var(--uc));
    border-top: 1px solid var(--x-line-soft);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: calc(8 * var(--uc)) calc(14 * var(--uc));
  }
  .qsrc {
    color: var(--x-ink-dim);
    display: inline-flex;
    align-items: center;
    gap: calc(8 * var(--uc));
  }
  .qsrc:lang(zh) {
    line-height: 1.6;
  }
  .qdot {
    width: calc(6 * var(--uc));
    height: calc(6 * var(--uc));
    border-radius: 50%;
    background: var(--x-accent);
    flex: 0 0 auto;
  }
  .qdate {
    color: var(--x-accent);
  }

  /* ── 板块尾:来源折叠 + 常驻小字 ── */
  .foot {
    padding: calc(6 * var(--uc)) calc(30 * var(--uc)) calc(24 * var(--uc));
  }
  /* 细线行式(.poc / FAQ 同规格) */
  .sources summary {
    cursor: pointer;
    min-height: calc(60 * var(--uc));
    display: flex;
    align-items: center;
    gap: clamp(14px, 2vw, calc(28 * var(--uc)));
    padding: calc(12 * var(--uc)) 0;
    list-style: none;
  }
  .sources summary::-webkit-details-marker {
    display: none;
  }
  .sources .q {
    color: var(--x-ink);
    flex: 1;
    transition: opacity 0.2s;
  }
  .sources summary:hover .q,
  .sources summary:focus-visible .q {
    opacity: 0.6;
  }
  .sources .mark {
    color: var(--x-accent-hot);
    font-weight: 400;
    position: relative;
  }
  .sources[open] .mark {
    visibility: hidden;
  }
  .sources[open] .mark::after {
    content: '−';
    visibility: visible;
    position: absolute;
    left: 0;
    color: var(--x-accent-hot);
  }
  .srclist {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .srclist li {
    border-top: 1px solid var(--x-line-soft);
  }
  /* 来源行:序号列与正文列分开 —— 折行时正文不钻到序号下方(悬挂缩进) */
  .srcline {
    color: var(--x-ink);
    text-decoration: none;
    min-height: var(--x-touch);
    display: flex;
    align-items: baseline;
    gap: calc(10 * var(--uc));
    padding: calc(10 * var(--uc)) 0;
    transition: opacity 0.2s;
  }
  .srcnum {
    color: var(--x-accent-hot);
    flex: 0 0 auto;
  }
  .srctxt {
    text-decoration: underline;
    text-underline-offset: calc(3 * var(--uc));
  }
  .srcline:hover {
    opacity: 0.7;
  }
  .srcline:active {
    opacity: 0.6;
  }
  /* 非关联免责 + 照片署名:常驻,分线通栏、文本限宽分开挂
     (max-width 若压在盒上会把 border-top 截停在半空 —— R2-D2 判例) */
  .disclaim {
