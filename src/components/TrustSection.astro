---
/* [FEAT-WEB07] 关于 NexGrid — R48 玻璃重构(章 03,B+C 杂交):
   实体信息来自 O2 资料包(D:\WORKS\公司资料,2026-08-20 主人交付):
   NexGrid LTD · Colorado Corporation · Entity ID 20221592644 · MSB 31000329265856。
   合规软化 2 处(汇报已交底):MSB 用「注册/登记」表述。
   章头 = 幽灵编号 03(右)+ kicker(nav.trust)+ 44 档标题(trust.title);
   证书双图进 5/12 高瓷砖(灯箱/放大机制 R44-R46 原样),五信息卡全文入瓷砖阵
   (卡文一句不删,展示序号按版面顺序重排:01=card1 / 02=card3 / 03=card2 / 04=card5 / 05=card4);
   PoC 手风琴保留细线行式(与 FAQ 同规格,B7 归一)。 */
import { useT, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useT(locale);
/* 版面顺序:事实(公司/MSB)→ 核验步骤(Colorado/FinCEN)→ 制度解释;卡 key 不变,只重排 */
const order = [
  { card: 1, span: 's7' },
  { card: 3, span: 's7' },
  { card: 2, span: 's6' },
  { card: 5, span: 's6' },
  { card: 4, span: 's12' },
] as const;
---

<section class="trust" id="trust">
  <div class="head">
    <span class="x-ghost ghost" aria-hidden="true">03</span>
    <p class="lab x-mono-lg" data-tw>{t('nav.trust')}</p>
    <h2 class="x-display" data-lr>{t('trust.title')}</h2>
  </div>

  <div class="grid">
    <div class="certs x-tile" data-rv>
      <figure>
        <a
          class="cert-open"
          href="/cert-msb@2x.png"
          data-src="/cert-msb@2x.png"
          data-srcset="/cert-msb.png 660w, /cert-msb@2x.png 1160w"
          data-alt={t('trust.certMsbAlt')}
          aria-label={t('trust.certZoom')}
        >
          <img src="/cert-msb.png" alt={t('trust.certMsbAlt')} width="660" height="881" loading="lazy" />
          <span class="cert-hint x-mono">{t('trust.certZoom')}</span>
        </a>
      </figure>
      <figure>
        <a
          class="cert-open"
          href="/cert-colorado@2x.png"
          data-src="/cert-colorado@2x.png"
          data-srcset="/cert-colorado.png 660w, /cert-colorado@2x.png 1160w"
          data-alt={t('trust.certCoAlt')}
          aria-label={t('trust.certZoom')}
        >
          <img src="/cert-colorado.png" alt={t('trust.certCoAlt')} width="660" height="881" loading="lazy" />
          <span class="cert-hint x-mono">{t('trust.certZoom')}</span>
        </a>
      </figure>
    </div>

    {
      order.map(({ card, span }, i) => (
        <article class:list={['card', 'x-tile', span]} data-rv style={`--d:${i * 0.08}s`}>
          <span class="idx x-mono">0{i + 1}</span>
          <p class="x-mono">{t(`trust.card${card}`)}</p>
        </article>
      ))
    }
  </div>

  <dialog class="cert-zoom" aria-label={t('trust.certZoom')} data-lenis-prevent>
    <form method="dialog" class="cert-zoom-close">
      <button class="xbtn" aria-label={t('trust.certClose')}>{t('trust.certClose')}</button>
    </form>
    {/* 1x 屏复用页面里已下好的 660 缩略件(桌面灯箱只渲染约 528px);HiDPI 与手机取 @2x。
        手机档故意写死 1160(远大于适宽后的渲染宽):双指放大不会回源重取,取小图放大就是糊的。
        实测慢网首开 2521ms → 179ms */}
    <img alt="" width="1160" height="1548" sizes="(max-width: 860px) 1160px, (min-width: 1441px) 747px, 560px" />
  </dialog>

  <details class="poc">
    <summary>
      <span class="q x-q">{t('trust.pocTitle')}</span>
      <span class="mark x-mono" aria-hidden="true">+</span>
    </summary>
    <p class="x-mono">{t('trust.pocBody1')}</p>
    <p class="x-mono">{t('trust.pocBody2')}</p>
  </details>
</section>

<style>
  .trust {
    padding: 0 var(--x-pad);
  }
  .head {
    position: relative;
    margin-bottom: max(32px, calc(48 * var(--u)));
  }
  .ghost {
    right: calc(-10 * var(--uc));
    top: calc(-30 * var(--uc));
  }
  .lab {
    color: var(--x-ink);
    margin: 0 0 calc(16 * var(--uc));
    min-height: 1.2em;
  }
  .head h2 {
    position: relative;
    z-index: 1;
    font-size: max(30px, calc(44 * var(--u)));
    color: var(--x-ink);
    margin: 0;
  }

  /* 瓷砖阵:证书 5/12 占两行,信息卡按版面顺序补位 */
  .grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: calc(18 * var(--uc));
  }
  .certs {
    grid-column: span 5;
    grid-row: span 2;
    display: flex;
    gap: calc(14 * var(--uc));
    padding: calc(20 * var(--uc));
    align-items: flex-start;
  }
  .card {
    display: grid;
    gap: calc(18 * var(--uc));
    align-content: start;
    padding: calc(26 * var(--uc)) calc(30 * var(--uc));
  }
  .s7 {
    grid-column: span 7;
  }
  .s6 {
    grid-column: span 6;
  }
  .s12 {
    grid-column: span 12;
  }
  .idx {
    color: var(--x-accent-hot);
    font-weight: 400;
  }
  .card p {
    margin: 0;
    color: var(--x-ink-cap);
    text-wrap: pretty;
    line-height: 1.45;
  }
  .card p:lang(zh) {
    line-height: 1.6; /* 全站 CJK 行高不变量 */
  }
  @media (max-width: 900px) {
    .certs,
    .s7,
    .s6,
    .s12 {
      grid-column: 1 / -1;
      grid-row: auto;
    }
  }

  /* —— 证书开启件与灯箱:R44-R46 机制原样(键盘可达 / 无 JS 直开图 / dialog 锁滚)—— */
  .cert-open {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
    position: relative;
    text-decoration: none;
    color: inherit;
  }
  .cert-hint {
    position: absolute;
    inset: auto 0 0 0;
    padding: calc(6 * var(--uc));
    background: var(--x-bg);
    color: var(--x-light);
    opacity: 0;
    transition: opacity 0.18s ease;
  }
  .cert-open:hover .cert-hint,
  .cert-open:focus-visible .cert-hint {
    opacity: 1;
  }
  .cert-zoom {
    border: 0;
    padding: 0 calc(16 * var(--uc)) calc(16 * var(--uc));
    background: var(--x-light);
    width: min(
      calc(96vw / var(--x-zoom)),
      calc(760 * var(--uc)),
      calc((94vh / var(--x-zoom) - 100 * var(--uc)) * 0.7494)
    );
    max-width: min(calc(96vw / var(--x-zoom)), calc(760 * var(--uc))); /* 画布内须换算,否则被二次放大 */
    max-height: calc(94vh / var(--x-zoom));
    overscroll-behavior: contain; /* 灯箱滚到端点不串联滚后面的页面 */
  }
  .cert-zoom::backdrop {
    background: rgb(var(--x-bg-rgb) / 0.82);
  }
  .cert-zoom img {
    display: block;
    width: 100%;
    height: auto;
    background: var(--x-line-soft); /* 大图在慢网要几秒:盒子先显浅底,不是一片空白 */
  }
  .cert-zoom.is-loading img {
    animation: x-pulse 1.4s ease-in-out infinite;
  }
  @keyframes x-pulse {
    50% {
      opacity: 0.55;
    }
  }
  .cert-zoom-close {
    position: sticky;
    top: 0;
    left: 0;
    z-index: 1;
    display: flex;
    justify-content: flex-end;
    padding: calc(16 * var(--uc)) 0 calc(12 * var(--uc));
    margin-bottom: 0;
    background: var(--x-light);
  }
  /* 灯箱住在浅底上,关闭键按纸面墨色走(玻璃暗版按钮在浅底上会隐形) */
  .cert-zoom-close .xbtn {
    border-color: var(--x-line-dark);
    color: var(--x-dark);
  }
  .certs figure {
    margin: 0;
    flex: 1;
    min-width: 0;
    padding: calc(8 * var(--uc));
    background: var(--x-white);
    border-radius: var(--x-r-sm);
  }
  .certs img {
    display: block;
    width: 100%;
    height: auto;
  }

  /* PoC 手风琴 = 与首页 FAQ 同一细线行式(B7 归一;墨色随深带翻回暗系) */
  .poc {
    margin-top: max(20px, calc(28 * var(--u)));
    border-top: 1px solid var(--x-line);
    border-bottom: 1px solid var(--x-line);
  }
  .poc summary {
    cursor: pointer;
    min-height: calc(60 * var(--uc));
    display: flex;
    align-items: center;
    gap: clamp(14px, 2vw, calc(28 * var(--uc)));
    padding: calc(12 * var(--uc)) 0;
    list-style: none;
  }
  .poc summary::-webkit-details-marker {
    display: none;
  }
  .poc .q {
    color: var(--x-ink);
    flex: 1;
  }
  .poc .mark {
    color: var(--x-accent-hot);
    font-weight: 400;
    position: relative;
  }
  .poc[open] .mark {
    visibility: hidden;
  }
  .poc[open] .mark::after {
    content: '−';
    visibility: visible;
    position: absolute;
    left: 0;
    color: var(--x-accent-hot);
  }
  .poc p {
    color: var(--x-ink-cap);
    margin: 0 0 calc(20 * var(--uc));
    max-width: calc(760 * var(--uc));
    text-wrap: pretty;
    line-height: 1.45;
  }
  .poc p:lang(zh) {
    line-height: 1.6;
  }
  .poc .q {
    transition: opacity 0.2s;
  }
  .poc summary:hover .q,
  .poc summary:focus-visible .q {
    opacity: 0.6;
  }

  /* 手机端灯箱:R46 竖向 flex 收缩方案原样 */
  @media (max-width: 860px) {
    .cert-zoom {
      display: flex;
      flex-direction: column;
      width: 100vw;
      max-width: 100vw;
      max-height: 100dvh;
      padding: 0 calc(8 * var(--uc)) calc(8 * var(--uc));
    }
    .cert-zoom img {
      width: 100%;
      max-width: 100%;
      min-height: 0; /* flex 项默认不肯缩到内容高以下,不解开这条 max-height 不起作用 */
      object-fit: contain;
    }
    .cert-zoom-close {
      padding: calc(8 * var(--uc)) 0;
    }
  }
  @media (hover: none) {
    .cert-hint {
      opacity: 1;
    }
  }
</style>
