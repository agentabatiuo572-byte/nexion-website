---
/* [FEAT-WEB07] 关于 NexGrid — 形式照主人指定参考截图:标题 + 双证书图 + 5 信息卡。
   全部实体信息来自 O2 资料包(D:\WORKS\公司资料,2026-08-20 主人交付):
   NexGrid LTD · Colorado Corporation · Entity ID 20221592644 · MSB 31000329265856。
   合规软化 2 处(汇报已交底):MSB 用「注册/登记」表述,不用「许可证/认证/通过审查」
   ——FinCEN transcript 原文明确 registration ≠ 背书。PoC 手风琴按官网 PRD 保留于卡组后。 */
import { useT, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useT(locale);
const cards = [
  { n: 1, tint: 'var(--v5-brand-soft)', color: 'var(--v5-brand)', icon: 'M4 20V8l8-5 8 5v12h-6v-6h-4v6z' },
  { n: 2, tint: 'var(--v5-success-soft)', color: 'var(--v5-success)', icon: 'M10 3a7 7 0 1 0 4.9 12l4.5 4.5 1.4-1.4-4.5-4.5A7 7 0 0 0 10 3zm0 2a5 5 0 1 1 0 10 5 5 0 0 1 0-10z' },
  { n: 3, tint: 'var(--v5-tech-cyan-soft)', color: 'var(--v5-tech-cyan)', icon: 'M12 2l8 4v6c0 5-3.5 8.5-8 10-4.5-1.5-8-5-8-10V6zm-1.2 12.6l6-6-1.4-1.4-4.6 4.6-2.2-2.2-1.4 1.4z' },
  { n: 4, tint: 'var(--v5-warning-soft)', color: 'var(--v5-warning)', icon: 'M12 3c4.4 0 8 1.3 8 3s-3.6 3-8 3-8-1.3-8-3 3.6-3 8-3zm-8 6c0 1.7 3.6 3 8 3s8-1.3 8-3v3c0 1.7-3.6 3-8 3s-8-1.3-8-3zm0 6c0 1.7 3.6 3 8 3s8-1.3 8-3v3c0 1.7-3.6 3-8 3s-8-1.3-8-3z' },
  { n: 5, tint: 'var(--v5-nex-soft)', color: 'var(--v5-nex)', icon: 'M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm7.9 9h-3.4a15 15 0 0 0-1.2-6A8 8 0 0 1 19.9 11zM12 4c.9 1.2 1.9 3.6 2.1 7h-4.2C10.1 7.6 11.1 5.2 12 4zM4.1 13h3.4a15 15 0 0 0 1.2 6A8 8 0 0 1 4.1 13zm3.4-2H4.1a8 8 0 0 1 4.6-6 15 15 0 0 0-1.2 6zm2.4 2h4.2c-.2 3.4-1.2 5.8-2.1 7-.9-1.2-1.9-3.6-2.1-7zm5.4 6a15 15 0 0 0 1.2-6h3.4a8 8 0 0 1-4.6 6z' },
] as const;
---

<section class="trust" id="trust">
  <h2 class="title">{t('trust.title')}</h2>

  <div class="certs">
    <figure>
      <img src="/cert-msb.png" alt={t('trust.certMsbAlt')} loading="lazy" width="1000" height="1400" />
    </figure>
    <figure>
      <img src="/cert-colorado.png" alt={t('trust.certCoAlt')} loading="lazy" width="1000" height="1400" />
    </figure>
  </div>

  <div class="cards">
    {
      cards.map((c) => (
        <article class="card">
          <span class="icon" style={`background:${c.tint};color:${c.color}`} aria-hidden="true">
            <svg viewBox="0 0 24 24" width="22" height="22"><path fill="currentColor" d={c.icon} /></svg>
          </span>
          <p>{t(`trust.card${c.n}`)}</p>
        </article>
      ))
    }
  </div>

  <details class="poc">
    <summary>{t('trust.pocTitle')}</summary>
    <p>{t('trust.pocBody1')}</p>
    <p>{t('trust.pocBody2')}</p>
  </details>
</section>

<style>
  .trust {
    max-width: var(--w-content-max);
    margin: 0 auto;
    padding: var(--w-space-section) 20px 0;
  }
  .title {
    font-size: clamp(26px, 3.4vw, 34px);
    font-weight: 600;
    color: var(--v5-ink);
    margin: 0 0 30px;
    text-align: center;
    text-wrap: balance;
  }
  .certs {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 330px));
    justify-content: center;
    gap: 28px;
    margin-bottom: 38px;
  }
  .certs figure {
    margin: 0;
    border-radius: 10px;
    overflow: hidden;
  }
  .certs img {
    display: block;
    width: 100%;
    height: auto;
  }
  .cards {
    display: grid;
    gap: 14px;
  }
  .card {
    background: var(--v5-surface);
    border-radius: var(--w-radius-card);
    padding: 22px 24px;
    display: flex;
    gap: 18px;
    align-items: center;
  }
  .icon {
    flex: 0 0 44px;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    display: grid;
    place-items: center;
  }
  .card p {
    color: var(--v5-ink-2);
    font-size: 14px;
    line-height: 1.75;
    margin: 0;
    text-wrap: pretty;
  }
  .poc {
    margin-top: 26px;
    background: var(--v5-surface);
    border-radius: var(--w-radius-card);
    padding: 4px 24px;
  }
  .poc summary {
    cursor: pointer;
    min-height: 48px;
    display: flex;
    align-items: center;
    font-size: 15px;
    font-weight: 600;
    color: var(--v5-ink);
    list-style: none;
  }
  .poc summary::before {
    content: '+';
    color: var(--v5-brand);
    margin-right: 10px;
    font-weight: 600;
  }
  .poc[open] summary::before {
    content: '−';
  }
  .poc summary:focus-visible {
    outline: 2px solid var(--v5-brand);
    outline-offset: 2px;
  }
  .poc p {
    color: var(--v5-ink-2);
    font-size: 14px;
    margin: 0 0 14px;
    text-wrap: pretty;
  }
  @media (max-width: 640px) {
    .card {
      align-items: flex-start;
    }
  }
</style>
