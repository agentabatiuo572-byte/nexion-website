---
/* [FEAT-WEB07] 关于 NexGrid — R48 玻璃重构(章 03,B+C 杂交):
   实体信息来自 O2 资料包(D:\WORKS\公司资料,2026-08-20 主人交付):
   NexGrid LTD · Colorado Corporation · Entity ID 20221592644 · MSB 31000329265856。
   合规软化 2 处(汇报已交底):MSB 用「注册/登记」表述。
   章头 = 幽灵编号 03(右)+ kicker(nav.trust)+ 44 档标题(trust.title);
   证书双图进 5/12 高瓷砖(灯箱/放大机制 R44-R46 原样),五信息卡全文入瓷砖阵
   (卡文一句不删,展示序号按版面顺序重排:01=card1 / 02=card3 / 03=card2 / 04=card5 / 05=card4);
   PoC 手风琴保留细线行式(与 FAQ 同规格,B7 归一)。 */
import { useT, type Locale } from '../i18n';
import Icon from './Icon.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useT(locale);
/* R3 卡片排版重构(主人 2026-09-01 拍板 ABC 混合定稿):五张整段卡 → 三张分层卡。
   每卡三层:**结论**(19 档标题,一句话说清是什么)→ **细节**(12 档小字)→ **锚**
   (可核验值 chip + 实心查册按钮)。信息零删减 —— 旧 card1..card5 逐句拆进
   t1/t2/t3(实体/州/公司类型/Entity ID/股本/平台/MSB 编号/BSA 框架/两处查册说明),
   守恒由改写脚本的断言逐条核过。⚠️ 其中「登记≠背书」那一条**已于 2026-09-02 按主人指令删除**
   (站上不放免责/风险提示类文案)—— 所以这里不再是「零删减」,是「零删减 + 一条按令删除」。
   查册链接从下划线小字升级为按钮:它是本板块希望
   访客真正去做的动作(「Verify it yourself」),满饱和柠檬只给可点转化件的分层纪律成立。
   R48.7 令②的语义图标保留,升为 44 档卡首图标:注册实体 / 盾勾 / 天平。 */
/* 🔴 栅格结构(R3c 结构性反思):证书列不再 `grid-row: span 2`。
   竖版证书按宽度缩放 → 高度随之定死,物理上填不满两卡的高度;三轮里「拉伸 / 居中 /
   收到内容高」三种修法只是把同一块空洞在容器内外挪位置(内部 30% → 外部 61%)。
   根因是网格假设与内容特性不符,不是「怎么摆」。改为两行各自配对:
   行一 证书(5)+ 实体卡(7),两者自然高天然接近;行二 MSB(5)+ 制度卡(7),后者内容多吃宽栏。
   不变量:容器高度由自己的内容决定,不由兄弟元素决定。 */
const CARDS = [
  { k: 't1', span: 's7', icon: 'registry', verify: 'https://www.coloradosos.gov/biz/BusinessEntityCriteriaExt.do' },
  /* FinCEN 规范路径带 /resources —— 不带的那条在官方站索引里不存在(R3 评审观察项;
     本机对 .gov 出站被阻断,无法直连确认,取规范侧 = 风险更低的一侧)。 */
  { k: 't2', span: 's5', icon: 'shield', verify: 'https://www.fincen.gov/resources/msb-state-selector' },
  { k: 't3', span: 's7', icon: 'scale' },
] as const;
/* 卡 03 的「意味着」三条(拆自旧 card4 第二句,逐条守恒) */
const MEANS = [1, 2, 3] as const;
---

<section class="trust" id="trust">
  <div class="head">
    <span class="x-ghost ghost" aria-hidden="true">03</span>
    <p class="lab x-mono-lg" data-tw>{t('nav.trust')}</p>
    <h2 class="x-display" data-lr>{t('trust.title')}</h2>
  </div>

  <div class="grid">
    <div class="certs x-tile" data-rv>
      <figure>
        <a
          class="cert-open"
          href="/cert-msb@2x.png"
          data-src="/cert-msb@2x.png"
          data-srcset="/cert-msb.png 660w, /cert-msb@2x.png 1160w"
          data-alt={t('trust.certMsbAlt')}
          aria-label={t('trust.certZoom')}
        >
          <img src="/cert-msb.png" alt={t('trust.certMsbAlt')} width="660" height="881" loading="lazy" />
          <span class="cert-hint x-mono">{t('trust.certZoom')}</span>
        </a>
      </figure>
      <figure>
        <a
          class="cert-open"
          href="/cert-colorado@2x.png"
          data-src="/cert-colorado@2x.png"
          data-srcset="/cert-colorado.png 660w, /cert-colorado@2x.png 1160w"
          data-alt={t('trust.certCoAlt')}
          aria-label={t('trust.certZoom')}
        >
          <img src="/cert-colorado.png" alt={t('trust.certCoAlt')} width="660" height="881" loading="lazy" />
          <span class="cert-hint x-mono">{t('trust.certZoom')}</span>
        </a>
      </figure>
    </div>

    {
      CARDS.map(({ k, span, icon, ...rest }, i) => (
        <article class:list={['card', 'x-tile', span]} data-rv style={`--d:${i * 0.08}s`}>
          <Icon name={icon} class="cic" />
          <div class="cbody">
            <span class="idx x-mono">0{i + 1}</span>
            <h3 class="ctitle">{t(`trust.${k}Title`)}</h3>
            {k === 't3' ? (
              /* 卡 03 拆层(R3 评审 D1/P1-4):旧 card4 是本板块最长的一段整段大写文字,
                 上一轮只在它头上焊了标题、底下 408 字原样 —— 主人点名的那种墙留在了原地。
                 现在拆成「定义 → 意味着三条」,中间一句拆成三条要点(守恒断言逐条核过)。
                 ⚠️ 原设计是双栏(左「意味着」/ 右「不意味着」),右栏已按主人 2026-09-02 指令删除,
                 所以现在是单栏 —— `.t3grid` 保留栅格形态,以后要加第二栏时结构还在。 */
              <Fragment>
                <p class="cdesc x-mono">{t('trust.t3Lead')}</p>
                {/* 「不意味着什么」那一栏已删(主人 2026-09-02 指令:站上不放免责/风险提示类文案)。
                    两条 key(t3NotTitle / t3Not)一并从三语文案里移除,标题也从
                    「…means — and what it does not」收成「…means」。 */}
                <div class="t3grid">
                  <div class="t3col">
                    <span class="t3h x-label">{t('trust.t3MeansTitle')}</span>
                    <ul class="t3list" role="list">
                      {MEANS.map((m) => (
                        <li class="x-mono">{t(`trust.t3Means${m}`)}</li>
                      ))}
                    </ul>
                  </div>
                </div>
              </Fragment>
            ) : (
              <p class="cdesc x-mono">{t(`trust.${k}Body`)}</p>
            )}
            {'verify' in rest && rest.verify && (
              <p class="vrow">
                <span class="vchip x-label">{t(`trust.${k}Chip`)}</span>
                <a class="vcta x-label" href={rest.verify} target="_blank" rel="noopener noreferrer">
                  {t(`trust.${k}Cta`)}&nbsp;<span aria-hidden="true">↗</span>
                </a>
              </p>
            )}
          </div>
        </article>
      ))
    }
  </div>

  <dialog class="cert-zoom" aria-label={t('trust.certZoom')} data-lenis-prevent>
    <form method="dialog" class="cert-zoom-close">
      <button class="xbtn" aria-label={t('trust.certClose')}>{t('trust.certClose')}</button>
    </form>
    {/* 1x 屏复用页面里已下好的 660 缩略件(桌面灯箱只渲染约 528px);HiDPI 与手机取 @2x。
        手机档故意写死 1160(远大于适宽后的渲染宽):双指放大不会回源重取,取小图放大就是糊的。
        实测慢网首开 2521ms → 179ms */}
    <a class="cert-orig x-mono" target="_blank" rel="noopener noreferrer" href="#">{t('trust.openOriginal')} <span aria-hidden="true">↗</span></a>
    <img alt="" width="1160" height="1548" sizes="(max-width: 860px) 1160px, (min-width: 1441px) 747px, 560px" />
  </dialog>

  <details class="poc" id="poc">
    <summary>
      <span class="q x-q">{t('trust.pocTitle')}</span>
      <span class="mark x-mono" aria-hidden="true">+</span>
    </summary>
    <p class="x-mono">{t('trust.pocBody1')}</p>
    <p class="x-mono">{t('trust.pocBody2')}</p>
  </details>
</section>

<style>
  .trust {
    padding: 0 var(--x-pad);
  }
  .head {
    position: relative;
    margin-bottom: max(32px, calc(48 * var(--u)));
  }
  .ghost {
    right: calc(-10 * var(--uc));
    top: calc(-30 * var(--uc));
  }
  .lab {
    color: var(--x-ink);
    margin: 0 0 calc(16 * var(--uc));
    min-height: 1.2em;
  }
  .head h2 {
    position: relative;
    z-index: 1;
    font-size: max(30px, calc(44 * var(--u)));
    color: var(--x-ink);
    margin: 0;
  }

  /* 瓷砖阵:证书 5/12 占两行,信息卡按版面顺序补位 */
  /* 🔴 align-items:start —— 不变量真正落地的那一行(此前只写在注释里,CSS 缺失,
     四个子项实测全是 stretch)。证书是**定宽比图片**(高 ∝ 列宽),文字卡高 ∝ 1/列宽,
     两条曲线反向、只交叉一次(约 1150-1250)——「并排配对天然等高」这个前提不成立:
     强制自然高实测 en@1440 失配 33%、zh@1440 58%、en@901 反向 58%。stretch 把矮的那张
     拉平,盒高相等而内部空 91-181px(zh 1304-1920 整段),这是「把洞挪个位置」的第四次。
     让每张卡收到自己的内容高:卡底参差,但每张都是饱满的 —— bento 本就允许参差。 */
  .grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: calc(18 * var(--uc));
    align-items: start;
  }
  /* 证书瓷砖:align-self:start —— 不被两行的行高拉伸,盒子收到内容自然高。
     两张竖版证书按宽度缩放,拉高后物理上填不满(1024 档实测 64% 是空的,R3b 评审 P0-1);
     居中只是把空区挪到上下,真正的修法是让盒子别长那么高。 */
  .certs {
    grid-column: span 5;
    display: flex;
    gap: calc(14 * var(--uc));
    padding: calc(20 * var(--uc));
    align-items: center;
  }
  /* R3 分层卡:大图标 ←→ 三层正文(编号+结论+细节+锚) */
  .card {
    display: flex;
    gap: calc(22 * var(--uc));
    align-items: flex-start;
    padding: calc(28 * var(--uc)) calc(32 * var(--uc));
  }
  .s5 {
    grid-column: span 5;
  }
  .s7 {
    grid-column: span 7;
  }
  /* 图标升 44 档并转柠檬:它现在是卡的视觉入口,不再是编号旁的小配件 */
  .card :global(.cic) {
    width: max(34px, calc(44 * var(--u)));
    height: max(34px, calc(44 * var(--u)));
    color: var(--x-accent);
    flex: 0 0 auto;
    margin-top: calc(2 * var(--uc));
  }
  /* 三层间距有层级:结论贴编号(6)、细节稍离(10)、锚层拉开(22)——
     等距一摞会让「结论 → 细节 → 锚」的分层只存在于设计意图里(R3 评审 P2-11)。 */
  .cbody {
    display: flex;
    flex-direction: column;
    gap: calc(6 * var(--uc));
    min-width: 0;
    flex: 1;
  }
  .idx {
    color: var(--x-accent-hot);
    font-weight: 400;
  }
  /* 结论层 19 档:一句话说清这张卡是什么,读者不必读完细节。
     量宽 46ch 给 balance 更合理的解空间 —— 647 宽容器里两行标题曾出现「下行比上行长」
     的倒参差(R3 评审 P2-12)。 */
  .ctitle {
    font-family: var(--x-font-display);
    font-size: max(17px, calc(19 * var(--u)));
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.25;
    color: var(--x-ink);
    margin: 0;
    /* pretty 不用 balance:balance 只压最长行、不管顺序,en 两行标题出现「下行比上行
       长 22%」的倒参差,放宽量宽也没解(R3b 工艺 P2-9);pretty 优化收尾更稳。 */
    text-wrap: pretty;
    max-width: calc(46 * var(--x-ch-display));
  }
  /* 宽栏卡的标题放宽一档,免得右上角留死区。
     ⚠️ 用 :where() 压掉特异度 —— 写成 `.s7 .ctitle`(0,4,0)会盖过下面的
     `.ctitle:lang(zh)`(0,3,0),让 zh 的 26em 量宽在三分之二的卡上成为死声明
     (R3d 工艺 P2-8:computed 实测 611.7px 而非 494px);:where() 记 0 特异度。
     这类「写进去了但被更特异的规则盖住」现有 css-shadowed 门抓不到(它只查同规则内
     重复与 media 源序),评审建议补判据,已记入台账。 */
  :where(.s7) .ctitle {
    max-width: calc(56 * var(--x-ch-display));
  }
  .ctitle:lang(zh),
  .ctitle:lang(vi) {
    line-height: 1.45;
  }
  /* 46ch 是按拉丁字身算的量宽;CJK 无空格断行,盒缘落哪断哪 —— zh 卡 01 末行只占首行
     15.4%,且把专名「科罗拉多州」劈成两行(R3c 工艺 P2-2)。按 CJK 字身单独给。 */
  .ctitle:lang(zh) {
    max-width: 26em;
    line-break: strict;
  }
  /* 细节层 12 档:量宽 62ch —— 640px 在 12 档等宽下实测 88 字符/行,
     全大写超舒适带一倍(R3 评审 P1-5 的行长面) */
  .cdesc {
    margin: calc(4 * var(--uc)) 0 0;
    color: var(--x-ink-dim);
    text-wrap: pretty;
    line-height: 1.45;
    max-width: calc(62 * var(--x-ch-display));
  }
  .cdesc:lang(zh) {
    /* .x-mono 型类的 zh 档就是 1.6,本地 1.45 会盖掉它,补回同值 */
    line-height: 1.6;
    text-wrap: balance; /* CJK 短段孤行控制(R49 收线 D1) */
  }

  /* 卡 03 双栏:意味着(要点列表)| 不意味着(柠檬左界强调) */
  /* 双栏按内容定宽,不按固定比例:1.35fr/1fr 是照 en 最长条目调的,
     zh 条目短得多 → 左栏 69% 是空的、柠檬界线离文字 637px(R3b 评审 P1-2)。
     fit-content 让三种语言各自收到自己的宽度。 */
  .t3grid {
    display: grid;
    grid-template-columns: fit-content(46%) fit-content(46%);
    justify-content: start;
    gap: calc(48 * var(--uc));
    margin-top: calc(18 * var(--uc));
    padding-top: calc(18 * var(--uc));
    border-top: 1px solid var(--x-line-soft);
  }
  .t3col {
    display: flex;
    flex-direction: column;
    gap: calc(10 * var(--uc));
    min-width: 0;
  }
  .t3h {
    color: var(--x-accent);
  }
  .t3h:lang(zh) {
    line-height: 1.6; /* x-label 与 x-mono 同基座,取同一 zh 档;型类只有 vi 分支 */
  }
  .t3list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: calc(8 * var(--uc));
  }
  .t3list li {
    color: var(--x-ink-cap);
    line-height: 1.45;
    display: flex;
    gap: calc(10 * var(--uc));
    text-wrap: pretty;
  }
  .t3list li:lang(zh) {
    line-height: 1.6;
    text-wrap: balance; /* 同上:zh@901 实测「…FINCEN / 登记」两字孤行 */
  }
  /* 方点垂直居中于首行行盒:写死的 0.42em 在三套行高(17.4/17.4/20)下落点各异,
     en 偏高约两成大写高(R3b 工艺 P2-8)。三语自适应靠「与本列表 line-height 同值」达成,
     zh 档另有一条覆写(见下)—— 两处必须成对改,改一个漏一个方点就偏。 */
  .t3list li::before {
    content: '';
    width: calc(6 * var(--uc));
    height: calc(6 * var(--uc));
    /* 🔴 曾写 `1lh`(三语自适应),但 R50 立的字身单位判据禁掉了它 —— lh 的长度同样取自
       字体度量,字体就绪前按兜底值算、到位后重算不可靠,会非确定性锁死在错值。
       改直写 1.45em:与本列表 `.t3list li` 的 line-height 同源,zh 档由 :lang(zh) 覆写,
       自适应保住而不吃字形量。 */
    margin-top: calc((1.45em - 6 * var(--uc)) / 2);
    border-radius: 1px;
    background: var(--x-accent);
    flex: 0 0 auto;
  }
  /* zh 行高是 1.6(见上面 .t3list li:lang(zh)),方点要跟着走,否则中文那颗偏高 */
  .t3list li:lang(zh)::before {
    margin-top: calc((1.6em - 6 * var(--uc)) / 2);
  }

  /* 锚层:可核验值 chip(方角标签)+ 查册按钮(实心柠檬胶囊 = 可点转化件)。
     chip 曾与按钮同为 999 胶囊 + 同色族 + 同字档 = 标准 ghost button 长相,
     而它并不可点(R3 评审 P2-7):改方角、抬高度,与实心键在形上拉开。 */
  /* 🔴 无条件竖排,不设断点:两卡的 chip+按钮总宽本就不同(内容宽度差),
     断点挪到哪失配带就在新位置复现 —— 设 1200 后它从 <1200 跑到 1201-1395,
     正好吃掉 1280 与 1366 两个最常见笔电宽(R3d 工艺 P1-3 逐 15px 扫描实测)。
     构造统一比找「好断点」可靠:两卡永远同形。 */
  .vrow {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: calc(10 * var(--uc));
    margin: calc(22 * var(--uc)) 0 0;
  }
  .vchip {
    color: var(--x-accent);
    border: 1px solid color-mix(in srgb, var(--x-accent) 35%, transparent);
    border-radius: calc(4 * var(--uc));
    padding: calc(9 * var(--uc)) calc(12 * var(--uc));
  }
  .vchip:lang(zh) {
    line-height: 1.6;
  }
  /* 查册按钮:唯一的实心柠檬件(可点转化件分层纪律)。
     行内块而非 flex —— vi@390 文案折两行时,flex 会把 ↗ 甩到按钮最右侧垂直居中、与文字
     脱开一大段,读作坏掉的按钮(R3 评审 D4);行内块下箭头随文本流,由 NBSP 绑住末词。 */
  /* 触达高由**对称内衬**产出,不靠 min-height 兜底:min-height 的余量只加在盒底,
     文字实测偏上 2.13px(en),与同排 chip 的基线差 3.00px,且三语偏上量各不同
     (zh 行盒够高时 min-height 根本不生效)—— R3b 工艺 P1-1。
     内衬按各语言行盒推:44 = 行盒 + 2×padding。 */
  .vcta {
    color: var(--x-on-accent);
    background: var(--x-accent);
    border-radius: 999px;
    /* 1.45em 而非 1lh:字身单位会在字体就绪前锁死在兜底值(R50 判据);
       1.45 是本元素 line-height 的同值直写。 */
    padding: calc((var(--x-touch) - 1.45em) / 2) calc(16 * var(--uc));
    font-weight: 700; /* 全站体例:按钮 700(tokens 排版尺子) */
    display: inline-block;
    text-align: center;
    text-decoration: none;
    transition: opacity 0.2s;
  }
  .vcta:lang(zh) {
    line-height: 1.6; /* x-label 与 x-mono 同基座,取同一 zh 档(型类只有 vi 分支) */
  }
  .vcta:hover {
    opacity: 0.85;
  }
  .vcta:active {
    opacity: 0.75;
  }
  /* 灯箱内「查看原件」出口(R49-D6):dialog 是亮底,走纸面墨色 */
  .cert-orig {
    display: inline-flex;
    align-items: center;
    gap: calc(4 * var(--uc));
    color: var(--x-accent-ink-paper);
    text-decoration: underline;
    text-underline-offset: calc(3 * var(--uc));
    margin: calc(8 * var(--uc)) 0;
    min-height: var(--x-touch);
  }
  @media (max-width: 900px) {
    /* 🔴 按容器复位,不按 span 类枚举:上一版清单是 `.certs,.s7,.s12`,本轮 t2 改成
       `.s5` 后清单没跟着改 → 该卡在 ≤900 全段只有 100-337px 宽的窄柱(R3d 工艺 P0-1,
       三语全中)。枚举式清单每加一个 span 类就要记着改一次,已在同一处栽第二次;
       改成子代选择器后,加多少 span 类都不用回来改这里。 */
    .grid > * {
      grid-column: 1 / -1;
      grid-row: auto;
    }
    /* 窄档图标转上方:横排时图标列把正文挤到 237px,标题折到 4-5 行
       且 balance 在多行下给出「最长行落在最后」的倒参差(R3 评审 P1-6) */
    .card {
      flex-direction: column;
      gap: calc(14 * var(--uc));
      padding: calc(24 * var(--uc)) calc(22 * var(--uc));
    }
    .card :global(.cic) {
      margin-top: 0;
    }
    .ctitle {
      text-wrap: pretty; /* 窄档多行:balance 的解空间不够,pretty 收尾更稳 */
    }
    .t3grid {
      grid-template-columns: 1fr;
      gap: calc(20 * var(--uc));
    }
  }

  /* —— 证书开启件与灯箱:R44-R46 机制原样(键盘可达 / 无 JS 直开图 / dialog 锁滚)—— */
  .cert-open {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
    position: relative;
    text-decoration: none;
    color: inherit;
  }
  .cert-hint {
    position: absolute;
    inset: auto 0 0 0;
    padding: calc(6 * var(--uc));
    background: var(--x-bg);
    color: var(--x-light);
    opacity: 0;
    transition: opacity 0.18s ease;
  }
  .cert-open:hover .cert-hint,
  .cert-open:focus-visible .cert-hint {
    opacity: 1;
  }
  .cert-zoom {
    border: 0;
    padding: 0 calc(16 * var(--uc)) calc(16 * var(--uc));
    background: var(--x-light);
    /* 第三项(按高度反推宽)在极矮视口会塌穿弹层自身构件宽(1920×360 实测横溢 19px)——
       给 240 下限:装得下关闭行与原件行;纵向富余交给图的 min-height:0 收缩(letterbox 不溢出)。 */
    width: min(
      calc(96vw / var(--x-zoom)),
      calc(760 * var(--uc)),
      max(calc((94vh / var(--x-zoom) - 160 * var(--uc)) * 0.7494), calc(240 * var(--uc)))
    );
    max-width: min(calc(96vw / var(--x-zoom)), calc(760 * var(--uc))); /* 画布内须换算,否则被二次放大 */
    max-height: calc(94vh / var(--x-zoom));
    overscroll-behavior: contain; /* 灯箱滚到端点不串联滚后面的页面 */
  }
  /* 竖向弹性只挂打开态(R49 修门的高度预算 160 机制不变)。
     ⚠️ 禁写回基类:dialog 关闭态靠 UA 的 display:none 藏身,基类 display 会把它顶掉——
     弹层从首帧起常驻可见、吞信任区点击(R49 收线 P0,两路独立审计同时抓到)。 */
  .cert-zoom[open] {
    display: flex;
    flex-direction: column;
  }
  .cert-zoom::backdrop {
    background: rgb(var(--x-bg-rgb) / 0.82);
  }
  .cert-zoom img {
    display: block;
    width: 100%;
    height: auto;
    min-height: 0; /* flex 项默认不缩到内容高以下;与 contain 配合,超预算时收缩不溢出 */
    object-fit: contain;
    background: var(--x-line-soft); /* 大图在慢网要几秒:盒子先显浅底,不是一片空白 */
  }
  .cert-orig {
    flex: 0 0 auto;
  }
  .cert-zoom.is-loading img {
    animation: x-pulse 1.4s ease-in-out infinite;
  }
  @keyframes x-pulse {
    50% {
      opacity: 0.55;
    }
  }
  .cert-zoom-close {
    position: sticky;
    top: 0;
    left: 0;
    z-index: 1;
    display: flex;
    justify-content: flex-end;
    padding: calc(16 * var(--uc)) 0 calc(12 * var(--uc));
    margin-bottom: 0;
    background: var(--x-light);
  }
  /* 灯箱住在浅底上,关闭键按纸面墨色走(玻璃暗版按钮在浅底上会隐形) */
  .cert-zoom-close .xbtn {
    border-color: var(--x-line-dark);
    color: var(--x-dark);
  }
  .certs figure {
    margin: 0;
    flex: 1;
    min-width: 0;
    padding: calc(8 * var(--uc));
    background: var(--x-white);
    border-radius: var(--x-r-sm);
  }
  .certs img {
    display: block;
    width: 100%;
    height: auto;
  }

  /* PoC 手风琴 = 与首页 FAQ 同一细线行式(B7 归一;墨色随深带翻回暗系) */
  .poc {
    margin-top: max(20px, calc(28 * var(--u)));
    border-top: 1px solid var(--x-line);
    border-bottom: 1px solid var(--x-line);
  }
  .poc summary {
    cursor: pointer;
    min-height: calc(60 * var(--uc));
    display: flex;
    align-items: center;
    gap: clamp(14px, 2vw, calc(28 * var(--uc)));
    padding: calc(12 * var(--uc)) 0;
    list-style: none;
  }
  .poc summary::-webkit-details-marker {
    display: none;
  }
  .poc .q {
    color: var(--x-ink);
    flex: 1;
  }
  .poc .mark {
    color: var(--x-accent-hot);
    font-weight: 400;
    position: relative;
  }
  .poc[open] .mark {
    visibility: hidden;
  }
  .poc[open] .mark::after {
    content: '−';
    visibility: visible;
    position: absolute;
    left: 0;
    color: var(--x-accent-hot);
  }
  /* 62 字身宽:与 .cdesc / #why .disclaim 同族同值(760uc 实测 93 字符/行,R3c 工艺 P2-4)。
     写成 calc(62 * var(--x-ch-display)) 而非 `62ch` —— 后者会在字体就绪前锁死在兜底值(R50 判据)。 */
  .poc p {
    color: var(--x-ink-cap);
    margin: 0 0 calc(20 * var(--uc));
    max-width: calc(62 * var(--x-ch-display));
    text-wrap: pretty;
    line-height: 1.45;
  }
  .poc p:lang(zh) {
    line-height: 1.6;
  }
  .poc .q {
    transition: opacity 0.2s;
  }
  .poc summary:hover .q,
  .poc summary:focus-visible .q {
    opacity: 0.6;
  }

  /* 手机端灯箱:R46 竖向 flex 收缩方案原样 */
  @media (max-width: 860px) {
    .cert-zoom {
      width: 100vw;
      max-width: 100vw;
      max-height: 100dvh;
      padding: 0 calc(8 * var(--uc)) calc(8 * var(--uc));
    }
    .cert-zoom img {
      width: 100%;
      max-width: 100%;
      min-height: 0; /* flex 项默认不肯缩到内容高以下,不解开这条 max-height 不起作用 */
      object-fit: contain;
    }
    .cert-zoom-close {
      padding: calc(8 * var(--uc)) 0;
    }
  }
  @media (hover: none) {
    .cert-hint {
      opacity: 1;
    }
  }
</style>

<script>
  /* PoC 意图到达自动展开(WEB07):点站内 #poc 链 / 带 #poc 直达 → details 自动打开。
     (此脚本曾被批量替换写成空壳,黑盒审计以「只滚不开」抓回——R49 收线 P1。) */
  const poc = document.getElementById('poc') as HTMLDetailsElement | null;
  if (poc) {
    const openPoc = () => {
      poc.open = true;
    };
    if (location.hash === '#poc') openPoc();
    window.addEventListener('hashchange', () => {
      if (location.hash === '#poc') openPoc();
    });
    document.addEventListener('click', (e) => {
      const hit = e.target instanceof Element && e.target.closest('a[href$="#poc"]');
      if (hit) openPoc();
    });
  }
</script>
