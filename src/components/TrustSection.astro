---
/* [FEAT-WEB07] 关于 NexGrid — 实体信息来自 O2 资料包(D:\WORKS\公司资料,2026-08-20 主人交付):
   NexGrid LTD · Colorado Corporation · Entity ID 20221592644 · MSB 31000329265856。
   合规软化 2 处(汇报已交底):MSB 用「注册/登记」表述。
   axiom 方向:反白区块,双证书并排(比例沿用主人已批的 330px 档),
   五信息卡改为序号等宽文块栅格,PoC 手风琴保留。 */
import { useT, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useT(locale);
const cards = [1, 2, 3, 4, 5] as const;
---

<section class="trust x-invert" id="trust">
  <div class="head">
    <span class="x-label lab" data-rv>{t('trust.title')}</span>
  </div>

  <div class="certs" data-rv>
    <figure>
      <img src="/cert-msb.png" alt={t('trust.certMsbAlt')} width="660" height="880" />
    </figure>
    <figure>
      <img src="/cert-colorado.png" alt={t('trust.certCoAlt')} width="660" height="880" />
    </figure>
  </div>

  <div class="cards">
    {
      cards.map((n, i) => (
        <article class="card" data-rv style={`--d:${i * 0.08}s`}>
          <span class="idx x-mono">0{n}</span>
          <p class="x-mono">{t(`trust.card${n}`)}</p>
        </article>
      ))
    }
  </div>

  <details class="poc">
    <summary>
      <span class="mark x-mono" aria-hidden="true">+</span>
      {t('trust.pocTitle')}
    </summary>
    <p class="x-mono">{t('trust.pocBody1')}</p>
    <p class="x-mono">{t('trust.pocBody2')}</p>
  </details>
</section>

<style>
  .trust {
    padding: var(--x-section-gap) var(--x-pad);
  }
  .head {
    border-top: 1px solid var(--x-line-dark);
    padding-top: 18px;
    margin-bottom: clamp(28px, 4vw, 52px);
  }
  .lab {
    color: var(--x-dark);
  }
  .certs {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 330px));
    justify-content: center;
    gap: 28px;
    margin-bottom: clamp(36px, 5vw, 64px);
  }
  .certs figure {
    margin: 0;
    border: 1px solid var(--x-line-dark);
    padding: 8px;
    background: var(--x-white);
  }
  .certs img {
    display: block;
    width: 100%;
    height: auto;
  }
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 0;
    border-top: 1px solid var(--x-line-dark);
  }
  .card {
    display: grid;
    grid-template-columns: 40px 1fr;
    gap: 12px;
    padding: 22px 18px 22px 0;
    border-bottom: 1px solid var(--x-line-dark);
    align-content: start;
  }
  .idx {
    color: var(--x-accent);
    font-weight: 700;
  }
  .card p {
    margin: 0;
    color: var(--x-dark-dim);
    text-wrap: pretty;
  }
  .poc {
    margin-top: clamp(28px, 4vw, 44px);
    border: 1px solid var(--x-line-dark);
    padding: 4px 20px;
  }
  .poc summary {
    cursor: pointer;
    min-height: 52px;
    display: flex;
    align-items: center;
    gap: 12px;
    font-family: var(--x-font-display);
    font-size: clamp(17px, 1.6vw, 21px);
    font-weight: 500;
    color: var(--x-dark);
    list-style: none;
  }
  .poc summary::-webkit-details-marker {
    display: none;
  }
  .poc .mark {
    color: var(--x-accent);
    font-weight: 700;
    font-size: 16px;
  }
  .poc[open] .mark {
    /* + → − */
    visibility: hidden;
    position: relative;
  }
  .poc[open] .mark::after {
    content: '−';
    visibility: visible;
    position: absolute;
    left: 0;
  }
  .poc p {
    color: var(--x-dark-dim);
    margin: 0 0 16px;
    max-width: 760px;
    text-wrap: pretty;
  }
</style>
