---
/* [FEAT-WEB07] 关于 NexGrid — R48 玻璃重构(章 03,B+C 杂交):
   实体信息来自 O2 资料包(D:\WORKS\公司资料,2026-08-20 主人交付):
   NexGrid LTD · Colorado Corporation · Entity ID 20221592644 · MSB 31000329265856。
   合规软化 2 处(汇报已交底):MSB 用「注册/登记」表述。
   章头 = 幽灵编号 03(右)+ kicker(nav.trust)+ 44 档标题(trust.title);
   证书双图进 5/12 高瓷砖(灯箱/放大机制 R44-R46 原样),五信息卡全文入瓷砖阵
   (卡文一句不删,展示序号按版面顺序重排:01=card1 / 02=card3 / 03=card2 / 04=card5 / 05=card4);
   PoC 手风琴保留细线行式(与 FAQ 同规格,B7 归一)。 */
import { useT, type Locale } from '../i18n';
import Icon from './Icon.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useT(locale);
/* 版面顺序:事实(公司/MSB)→ 核验步骤(Colorado/FinCEN)→ 制度解释;卡 key 不变,只重排。
   R48.7 令②:每卡配语义线性图标(按卡内容不按版面序):注册实体/盾勾/查册/清单查询/天平。
   R49b(主人 2026-08-31 改令):查册两卡**只留官网真外链**——复制编号按钮撤除,
   卡文由 step-by-step 详述改一句话模糊化(查询细节交给官网自己)。链接仍指检索入口页。 */
const order = [
  { card: 1, span: 's7', icon: 'registry' },
  { card: 3, span: 's7', icon: 'shield' },
  { card: 2, span: 's6', icon: 'verify-search', verify: { url: 'https://www.coloradosos.gov/biz/BusinessEntityCriteriaExt.do', label: 'coloradosos.gov' } },
  { card: 5, span: 's6', icon: 'lookup', verify: { url: 'https://www.fincen.gov/msb-state-selector', label: 'fincen.gov/msb-state-selector' } },
  { card: 4, span: 's12', icon: 'scale' },
] as const;
---

<section class="trust" id="trust">
  <div class="head">
    <span class="x-ghost ghost" aria-hidden="true">03</span>
    <p class="lab x-mono-lg" data-tw>{t('nav.trust')}</p>
    <h2 class="x-display" data-lr>{t('trust.title')}</h2>
  </div>

  <div class="grid">
    <div class="certs x-tile" data-rv>
      <figure>
        <a
          class="cert-open"
          href="/cert-msb@2x.png"
          data-src="/cert-msb@2x.png"
          data-srcset="/cert-msb.png 660w, /cert-msb@2x.png 1160w"
          data-alt={t('trust.certMsbAlt')}
          aria-label={t('trust.certZoom')}
        >
          <img src="/cert-msb.png" alt={t('trust.certMsbAlt')} width="660" height="881" loading="lazy" />
          <span class="cert-hint x-mono">{t('trust.certZoom')}</span>
        </a>
      </figure>
      <figure>
        <a
          class="cert-open"
          href="/cert-colorado@2x.png"
          data-src="/cert-colorado@2x.png"
          data-srcset="/cert-colorado.png 660w, /cert-colorado@2x.png 1160w"
          data-alt={t('trust.certCoAlt')}
          aria-label={t('trust.certZoom')}
        >
          <img src="/cert-colorado.png" alt={t('trust.certCoAlt')} width="660" height="881" loading="lazy" />
          <span class="cert-hint x-mono">{t('trust.certZoom')}</span>
        </a>
      </figure>
    </div>

    {
      order.map(({ card, span, icon, ...rest }, i) => (
        <article class:list={['card', 'x-tile', span]} data-rv style={`--d:${i * 0.08}s`}>
          <span class="crow">
            <span class="idx x-mono">0{i + 1}</span>
            <Icon name={icon} class="cic" />
          </span>
          <p class="x-mono">{t(`trust.card${card}`)}</p>
          {'verify' in rest && rest.verify && (
            <p class="vrow">
              <a class="vout x-mono" href={rest.verify.url} target="_blank" rel="noopener noreferrer">
                {rest.verify.label} <span aria-hidden="true">↗</span>
              </a>
            </p>
          )}
        </article>
      ))
    }
  </div>

  <dialog class="cert-zoom" aria-label={t('trust.certZoom')} data-lenis-prevent>
    <form method="dialog" class="cert-zoom-close">
      <button class="xbtn" aria-label={t('trust.certClose')}>{t('trust.certClose')}</button>
    </form>
    {/* 1x 屏复用页面里已下好的 660 缩略件(桌面灯箱只渲染约 528px);HiDPI 与手机取 @2x。
        手机档故意写死 1160(远大于适宽后的渲染宽):双指放大不会回源重取,取小图放大就是糊的。
        实测慢网首开 2521ms → 179ms */}
    <a class="cert-orig x-mono" target="_blank" rel="noopener noreferrer" href="#">{t('trust.openOriginal')} <span aria-hidden="true">↗</span></a>
    <img alt="" width="1160" height="1548" sizes="(max-width: 860px) 1160px, (min-width: 1441px) 747px, 560px" />
  </dialog>

  <details class="poc" id="poc">
    <summary>
      <span class="q x-q">{t('trust.pocTitle')}</span>
      <span class="mark x-mono" aria-hidden="true">+</span>
    </summary>
    <p class="x-mono">{t('trust.pocBody1')}</p>
    <p class="x-mono">{t('trust.pocBody2')}</p>
  </details>
</section>

<style>
  .trust {
    padding: 0 var(--x-pad);
  }
  .head {
    position: relative;
    margin-bottom: max(32px, calc(48 * var(--u)));
  }
  .ghost {
    right: calc(-10 * var(--uc));
    top: calc(-30 * var(--uc));
  }
  .lab {
    color: var(--x-ink);
    margin: 0 0 calc(16 * var(--uc));
    min-height: 1.2em;
  }
  .head h2 {
    position: relative;
    z-index: 1;
    font-size: max(30px, calc(44 * var(--u)));
    color: var(--x-ink);
    margin: 0;
  }

  /* 瓷砖阵:证书 5/12 占两行,信息卡按版面顺序补位 */
  .grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: calc(18 * var(--uc));
  }
  .certs {
    grid-column: span 5;
    grid-row: span 2;
    display: flex;
    gap: calc(14 * var(--uc));
    padding: calc(20 * var(--uc));
    align-items: flex-start;
  }
  .card {
    display: grid;
    gap: calc(18 * var(--uc));
    align-content: start;
    padding: calc(26 * var(--uc)) calc(30 * var(--uc));
  }
  .s7 {
    grid-column: span 7;
  }
  .s6 {
    grid-column: span 6;
  }
  .s12 {
    grid-column: span 12;
  }
  /* 两端行:编号 ←→ 语义图标(与瓷砖章 metarow 同构;图标退 dim 档,不与编号争柠檬) */
  .crow {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .idx {
    color: var(--x-accent-hot);
    font-weight: 400;
  }
  .crow :global(.cic) {
    width: max(18px, calc(24 * var(--u)));
    height: max(18px, calc(24 * var(--u)));
    color: var(--x-ink-dim);
    flex: 0 0 auto;
  }
  .card p {
    margin: 0;
    color: var(--x-ink-cap);
    text-wrap: pretty;
    line-height: 1.45;
    /* 量宽上限(R49 收线 D2):s12 卡曾 1290px≈179 字符/行,s7 卡 ≈100 字符/行——
       全大写 12px mono 超舒适带一倍以上;封 640(≈89ch),zh 3 字孤行随之消失。 */
    max-width: calc(640 * var(--uc));
  }
  .card p:lang(zh) {
    line-height: 1.6; /* 全站 CJK 行高不变量 */
    text-wrap: balance; /* CJK 短段孤行控制:pretty 对 CJK 几乎不管孤行(R49 收线 D1) */
  }
  /* R49b 核验行:官方外链(复制按钮已按主人令撤除) */
  .vrow {
    display: flex;
    flex-wrap: wrap;
    gap: calc(10 * var(--uc)) calc(14 * var(--uc));
    align-items: center;
  }
  .vout {
    color: var(--x-ink);
    text-decoration: underline;
    text-underline-offset: calc(3 * var(--uc));
    min-height: var(--x-touch);
    display: inline-flex;
    align-items: center;
    transition: opacity 0.2s;
  }
  .vout:hover {
    opacity: 0.7;
  }
  .vout:active {
    opacity: 0.6;
  }
  /* 灯箱内「查看原件」出口(R49-D6):dialog 是亮底,走纸面墨色 */
  .cert-orig {
    display: inline-flex;
    align-items: center;
    gap: calc(4 * var(--uc));
    color: var(--x-accent-ink-paper);
    text-decoration: underline;
    text-underline-offset: calc(3 * var(--uc));
    margin: calc(8 * var(--uc)) 0;
    min-height: var(--x-touch);
  }
  @media (max-width: 900px) {
    .certs,
    .s7,
    .s6,
    .s12 {
      grid-column: 1 / -1;
      grid-row: auto;
    }
  }

  /* —— 证书开启件与灯箱:R44-R46 机制原样(键盘可达 / 无 JS 直开图 / dialog 锁滚)—— */
  .cert-open {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
    position: relative;
    text-decoration: none;
    color: inherit;
  }
  .cert-hint {
    position: absolute;
    inset: auto 0 0 0;
    padding: calc(6 * var(--uc));
    background: var(--x-bg);
    color: var(--x-light);
    opacity: 0;
    transition: opacity 0.18s ease;
  }
  .cert-open:hover .cert-hint,
  .cert-open:focus-visible .cert-hint {
    opacity: 1;
  }
  .cert-zoom {
    border: 0;
    padding: 0 calc(16 * var(--uc)) calc(16 * var(--uc));
    background: var(--x-light);
    /* 第三项(按高度反推宽)在极矮视口会塌穿弹层自身构件宽(1920×360 实测横溢 19px)——
       给 240 下限:装得下关闭行与原件行;纵向富余交给图的 min-height:0 收缩(letterbox 不溢出)。 */
    width: min(
      calc(96vw / var(--x-zoom)),
      calc(760 * var(--uc)),
      max(calc((94vh / var(--x-zoom) - 160 * var(--uc)) * 0.7494), calc(240 * var(--uc)))
    );
    max-width: min(calc(96vw / var(--x-zoom)), calc(760 * var(--uc))); /* 画布内须换算,否则被二次放大 */
    max-height: calc(94vh / var(--x-zoom));
    overscroll-behavior: contain; /* 灯箱滚到端点不串联滚后面的页面 */
  }
  /* 竖向弹性只挂打开态(R49 修门的高度预算 160 机制不变)。
     ⚠️ 禁写回基类:dialog 关闭态靠 UA 的 display:none 藏身,基类 display 会把它顶掉——
     弹层从首帧起常驻可见、吞信任区点击(R49 收线 P0,两路独立审计同时抓到)。 */
  .cert-zoom[open] {
    display: flex;
    flex-direction: column;
  }
  .cert-zoom::backdrop {
    background: rgb(var(--x-bg-rgb) / 0.82);
  }
  .cert-zoom img {
    display: block;
    width: 100%;
    height: auto;
    min-height: 0; /* flex 项默认不缩到内容高以下;与 contain 配合,超预算时收缩不溢出 */
    object-fit: contain;
    background: var(--x-line-soft); /* 大图在慢网要几秒:盒子先显浅底,不是一片空白 */
  }
  .cert-orig {
    flex: 0 0 auto;
  }
  .cert-zoom.is-loading img {
    animation: x-pulse 1.4s ease-in-out infinite;
  }
  @keyframes x-pulse {
    50% {
      opacity: 0.55;
    }
  }
  .cert-zoom-close {
    position: sticky;
    top: 0;
    left: 0;
    z-index: 1;
    display: flex;
    justify-content: flex-end;
    padding: calc(16 * var(--uc)) 0 calc(12 * var(--uc));
    margin-bottom: 0;
    background: var(--x-light);
  }
  /* 灯箱住在浅底上,关闭键按纸面墨色走(玻璃暗版按钮在浅底上会隐形) */
  .cert-zoom-close .xbtn {
    border-color: var(--x-line-dark);
    color: var(--x-dark);
  }
  .certs figure {
    margin: 0;
    flex: 1;
    min-width: 0;
    padding: calc(8 * var(--uc));
    background: var(--x-white);
    border-radius: var(--x-r-sm);
  }
  .certs img {
    display: block;
    width: 100%;
    height: auto;
  }

  /* PoC 手风琴 = 与首页 FAQ 同一细线行式(B7 归一;墨色随深带翻回暗系) */
  .poc {
    margin-top: max(20px, calc(28 * var(--u)));
    border-top: 1px solid var(--x-line);
    border-bottom: 1px solid var(--x-line);
  }
  .poc summary {
    cursor: pointer;
    min-height: calc(60 * var(--uc));
    display: flex;
    align-items: center;
    gap: clamp(14px, 2vw, calc(28 * var(--uc)));
    padding: calc(12 * var(--uc)) 0;
    list-style: none;
  }
  .poc summary::-webkit-details-marker {
    display: none;
  }
  .poc .q {
    color: var(--x-ink);
    flex: 1;
  }
  .poc .mark {
    color: var(--x-accent-hot);
    font-weight: 400;
    position: relative;
  }
  .poc[open] .mark {
    visibility: hidden;
  }
  .poc[open] .mark::after {
    content: '−';
    visibility: visible;
    position: absolute;
    left: 0;
    color: var(--x-accent-hot);
  }
  .poc p {
    color: var(--x-ink-cap);
    margin: 0 0 calc(20 * var(--uc));
    max-width: calc(760 * var(--uc));
    text-wrap: pretty;
    line-height: 1.45;
  }
  .poc p:lang(zh) {
    line-height: 1.6;
  }
  .poc .q {
    transition: opacity 0.2s;
  }
  .poc summary:hover .q,
  .poc summary:focus-visible .q {
    opacity: 0.6;
  }

  /* 手机端灯箱:R46 竖向 flex 收缩方案原样 */
  @media (max-width: 860px) {
    .cert-zoom {
      width: 100vw;
      max-width: 100vw;
      max-height: 100dvh;
      padding: 0 calc(8 * var(--uc)) calc(8 * var(--uc));
    }
    .cert-zoom img {
      width: 100%;
      max-width: 100%;
      min-height: 0; /* flex 项默认不肯缩到内容高以下,不解开这条 max-height 不起作用 */
      object-fit: contain;
    }
    .cert-zoom-close {
      padding: calc(8 * var(--uc)) 0;
    }
  }
  @media (hover: none) {
    .cert-hint {
      opacity: 1;
    }
  }
</style>

<script>
  /* PoC 意图到达自动展开(WEB07):点站内 #poc 链 / 带 #poc 直达 → details 自动打开。
     (此脚本曾被批量替换写成空壳,黑盒审计以「只滚不开」抓回——R49 收线 P1。) */
  const poc = document.getElementById('poc') as HTMLDetailsElement | null;
  if (poc) {
    const openPoc = () => {
      poc.open = true;
    };
    if (location.hash === '#poc') openPoc();
    window.addEventListener('hashchange', () => {
      if (location.hash === '#poc') openPoc();
    });
    document.addEventListener('click', (e) => {
      const hit = e.target instanceof Element && e.target.closest('a[href$="#poc"]');
      if (hit) openPoc();
    });
  }
</script>
