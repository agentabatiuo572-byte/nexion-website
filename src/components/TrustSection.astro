---
/* [FEAT-WEB07] 两张验证卡各自绑定证书、注册说明、编号和查册入口。
   实体信息来自主人提供的公司资料；解释区与 PoC 沿用现有事实文案。
   证书开启件的 class / data 属性由 fx.ts 的原生 dialog 消费。 */
import { useT, type Locale } from '../i18n';
import Icon from './Icon.astro';
import { WHITEPAPER } from '../lib/downloads';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useT(locale);
const CARDS = [
  { k: 't1', icon: 'registry', cert: 'colorado', alt: 'certCoAlt', verify: 'https://www.coloradosos.gov/biz/BusinessEntityCriteriaExt.do' },
  { k: 't2', icon: 'shield', cert: 'msb', alt: 'certMsbAlt', verify: 'https://www.fincen.gov/resources/msb-state-selector' },
] as const;
const MEANS = [1, 2, 3] as const;
---

<section class="trust" id="trust">
  <div class="head">
    <span class="x-ghost ghost" aria-hidden="true">03</span>
    <p class="lab x-mono-lg" data-tw>{t('nav.trust')}</p>
    <h2 class="x-display" data-lr>{t('trust.title')}</h2>
  </div>

  <div class="grid">
    {
      CARDS.map(({ k, icon, cert, alt, verify }, i) => (
        <article class="card verification x-tile" data-rv style={`--d:${i * 0.08}s`}>
          <div class="card-head">
            <Icon name={icon} class="cic" />
            <div class="cbody">
              <span class="idx x-label">0{i + 1}</span>
              <h3 class="ctitle">{t(`trust.${k}Title`)}</h3>
            </div>
          </div>
          <div class="card-detail">
            <figure class="certificate">
              <a
                class="cert-open"
                href={`/cert-${cert}@2x.png`}
                data-src={`/cert-${cert}@2x.png`}
                data-srcset={`/cert-${cert}.png 660w, /cert-${cert}@2x.png 1160w`}
                data-alt={t(`trust.${alt}`)}
                aria-label={t('trust.certZoom')}
              >
                <img src={`/cert-${cert}.png`} alt={t(`trust.${alt}`)} width="660" height="881" loading="lazy" />
                <span class="cert-hint x-label">{t('trust.certZoom')}</span>
              </a>
            </figure>
            <div class="detail-copy">
              <p class="cdesc x-copy">{t(`trust.${k}Body`)}</p>
              <p class="vrow">
                <span class="vchip x-label">{t(`trust.${k}Chip`)}</span>
                <a class="vcta x-label" href={verify} target="_blank" rel="noopener noreferrer">
                  {t(`trust.${k}Cta`)}&nbsp;<span aria-hidden="true">↗</span>
                </a>
              </p>
            </div>
          </div>
        </article>
      ))
    }
    <article class="card meaning x-tile" data-rv>
      <div class="card-head">
        <Icon name="scale" class="cic" />
        <div class="cbody">
          <span class="idx x-label">03</span>
          <h3 class="ctitle">{t('trust.t3Title')}</h3>
          <p class="cdesc x-copy">{t('trust.t3Lead')}</p>
        </div>
      </div>
      <div class="meaning-body">
        <span class="t3h x-label">{t('trust.t3MeansTitle')}</span>
        <ul class="t3list" role="list">
          {MEANS.map((m) => <li class="x-copy">{t(`trust.t3Means${m}`)}</li>)}
        </ul>
      </div>
    </article>
  </div>

  <dialog class="cert-zoom" aria-label={t('trust.certZoom')} data-lenis-prevent>
    <form method="dialog" class="cert-zoom-close">
      <button class="xbtn" aria-label={t('trust.certClose')}>{t('trust.certClose')}</button>
    </form>
    {/* 1x 屏复用页面里已下好的 660 缩略件(桌面灯箱只渲染约 528px);HiDPI 与手机取 @2x。
        手机档故意写死 1160(远大于适宽后的渲染宽):双指放大不会回源重取,取小图放大就是糊的。
        实测慢网首开 2521ms → 179ms */}
    <a class="cert-orig x-label" target="_blank" rel="noopener noreferrer" href="#">{t('trust.openOriginal')} <span aria-hidden="true">↗</span></a>
    <img alt="" width="1160" height="1548" sizes="(max-width: 860px) 1160px, (min-width: 1441px) 747px, 560px" />
  </dialog>

  <details class="poc" id="poc">
    <summary>
      <span class="q x-q">{t('trust.pocTitle')}</span>
      <span class="mark x-mono" aria-hidden="true">+</span>
    </summary>
    <p class="x-copy">{t('trust.pocBody1')}</p>
    <p class="x-copy">{t('trust.pocBody2')}</p>
  </details>

  <article class="whitepaper" id="whitepaper" data-whitepaper aria-labelledby="whitepaper-title" data-rv>
    <div class="whitepaper-copy">
      <h3 id="whitepaper-title">{t('trust.whitepaper.title')}</h3>
      <p class="whitepaper-summary x-copy">{t('trust.whitepaper.summary')}</p>
      <p class="whitepaper-details x-label">{t('trust.whitepaper.details', { version: WHITEPAPER.version, pages: WHITEPAPER.pages })}</p>
    </div>
    <a class="whitepaper-read xbtn solid" href={WHITEPAPER.url} hreflang={WHITEPAPER.language} type="application/pdf" target="_blank" rel="noopener noreferrer">
      <span class="xbtn-ghost" aria-hidden="true">{t('nex.whitepaper')} <span class="arr">↗</span></span>
      <span class="xbtn-a">{t('nex.whitepaper')} <span class="arr" aria-hidden="true">↗</span></span>
      <span class="xbtn-b" aria-hidden="true">{t('nex.whitepaper')} <span class="arr">↗</span></span>
    </a>
  </article>
</section>

<style>
  .trust {
    padding: 0 var(--x-pad);
  }
  .whitepaper {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(calc(230 * var(--uc)), max-content);
    align-items: center;
    gap: calc(40 * var(--uc));
    margin-top: calc(32 * var(--uc));
    padding: calc(32 * var(--uc));
    border: 1px solid var(--x-line);
    border-radius: var(--x-r);
    background: var(--x-bg);
    scroll-margin-top: calc(var(--x-chrome-h) + 24 * var(--uc));
  }
  .whitepaper-copy {
    min-width: 0;
  }
  .whitepaper-read {
    white-space: normal;
    text-align: center;
  }
  .whitepaper-read .xbtn-ghost {
    min-width: 0;
  }
  .whitepaper-read .xbtn-a,
  .whitepaper-read .xbtn-b {
    padding-inline: calc(22 * var(--uc));
  }
  .whitepaper-copy h3 {
    margin: 0;
    font-family: var(--x-font-display);
    font-size: calc(36 * var(--uc));
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  .whitepaper-copy h3:is(:lang(vi), :lang(zh), :lang(ja), :lang(ko)) {
    line-height: 1.45;
  }
  .whitepaper-summary {
    margin: calc(16 * var(--uc)) 0 0;
    color: var(--x-ink-cap);
    max-width: 44em;
    text-wrap: pretty;
  }
  .whitepaper-details {
    margin: calc(24 * var(--uc)) 0 0;
    color: var(--x-ink-dim);
    line-height: 1.6;
    text-wrap: pretty;
  }
  @media (max-width: 860px) {
    .whitepaper {
      grid-template-columns: minmax(0, 1fr);
      gap: calc(24 * var(--uc));
    }
    .whitepaper-read {
      justify-self: start;
    }
  }
  @media (max-width: 600px) {
    .whitepaper {
      padding: calc(24 * var(--uc)) calc(22 * var(--uc));
    }
    .whitepaper-copy h3 {
      font-size: calc(30 * var(--uc));
    }
    .whitepaper-read {
      justify-self: stretch;
    }
  }
  .head {
    position: relative;
    margin-bottom: max(32px, calc(48 * var(--u)));
  }
  .ghost {
    right: calc(-10 * var(--uc));
    top: calc(-30 * var(--uc));
  }
  .lab {
    color: var(--x-ink);
    margin: 0 0 calc(16 * var(--uc));
    min-height: 1.2em;
  }
  .head h2 {
    position: relative;
    z-index: 1;
    font-size: max(30px, calc(44 * var(--u)));
    color: var(--x-ink);
    margin: 0;
  }

  /* 标题和详情共享两条行轨；编号与验证入口统一收在卡片右下角。 */
  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: calc(24 * var(--uc));
  }
  .card {
    min-width: 0;
    padding: calc(28 * var(--uc)) calc(32 * var(--uc));
  }
  .verification {
    display: grid;
    grid-template-rows: subgrid;
    grid-row: span 2;
    gap: calc(24 * var(--uc));
  }
  .card-head {
    display: flex;
    gap: calc(16 * var(--uc));
    align-items: flex-start;
  }
  .card :global(.cic) {
    width: max(34px, calc(44 * var(--u)));
    height: max(34px, calc(44 * var(--u)));
    color: var(--x-accent);
    flex: 0 0 auto;
    margin-top: calc(2 * var(--uc));
  }
  .cbody {
    display: flex;
    flex-direction: column;
    gap: calc(6 * var(--uc));
    min-width: 0;
    flex: 1;
  }
  .idx {
    color: var(--x-accent-hot);
    font-weight: 400;
  }
  /* 保留既有标题字号；正文的字体、行高与大小写由全站 x-copy 供给。 */
  .ctitle {
    font-family: var(--x-font-display);
    font-size: max(17px, calc(19 * var(--u)));
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.25;
    color: var(--x-ink);
    margin: 0;
    text-wrap: pretty;
    max-width: calc(46 * var(--x-ch-display));
  }
  .ctitle:is(:lang(zh), :lang(ja), :lang(ko)),
  .ctitle:lang(vi) {
    line-height: 1.45;
  }
  .ctitle:is(:lang(zh), :lang(ja), :lang(ko)) {
    max-width: 26em;
    line-break: strict;
  }
  .card-detail {
    display: grid;
    grid-template-columns: calc(160 * var(--uc)) minmax(0, 1fr);
    align-items: start;
    gap: calc(24 * var(--uc));
  }
  .certificate {
    margin: 0;
    min-width: 0;
    padding: calc(8 * var(--uc));
    background: var(--x-white);
    border-radius: var(--x-r-sm);
  }
  .certificate img {
    display: block;
    width: 100%;
    height: auto;
  }
  .detail-copy {
    display: flex;
    flex-direction: column;
    align-self: stretch;
    gap: calc(16 * var(--uc));
    min-width: 0;
  }
  .cdesc {
    margin: 0;
    color: var(--x-ink-dim);
    text-wrap: pretty;
    max-width: 40em;
  }
  .meaning {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
    gap: calc(40 * var(--uc));
  }
  .meaning .cdesc {
    margin-top: calc(10 * var(--uc));
  }
  .meaning-body {
    display: flex;
    flex-direction: column;
    gap: calc(14 * var(--uc));
    min-width: 0;
    padding-left: calc(32 * var(--uc));
    border-left: 1px solid var(--x-line-soft);
  }
  .t3h {
    color: var(--x-accent);
  }
  .t3list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: calc(12 * var(--uc));
  }
  .t3list li {
    color: var(--x-ink-cap);
    display: flex;
    gap: calc(10 * var(--uc));
    text-wrap: pretty;
  }
  /* 方点对齐 x-copy 的 1.6 行高，不依赖字体加载时的字形单位。 */
  .t3list li::before {
    content: '';
    width: calc(6 * var(--uc));
    height: calc(6 * var(--uc));
    margin-top: calc((1.6em - 6 * var(--uc)) / 2);
    border-radius: 1px;
    background: var(--x-accent);
    flex: 0 0 auto;
  }

  /* 锚层:可核验值 chip(方角标签)+ 查册按钮(实心柠檬胶囊 = 可点转化件)。
     chip 曾与按钮同为 999 胶囊 + 同色族 + 同字档 = 标准 ghost button 长相,
     而它并不可点(R3 评审 P2-7):改方角、抬高度,与实心键在形上拉开。 */
  /* 🔴 无条件竖排,不设断点:两卡的 chip+按钮总宽本就不同(内容宽度差),
     断点挪到哪失配带就在新位置复现 —— 设 1200 后它从 <1200 跑到 1201-1395,
     正好吃掉 1280 与 1366 两个最常见笔电宽(R3d 工艺 P1-3 逐 15px 扫描实测)。
     构造统一比找「好断点」可靠:两卡永远同形。 */
  .vrow {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: calc(10 * var(--uc));
    margin: auto 0 0;
  }
  .vchip {
    max-width: 100%;
    overflow-wrap: anywhere;
    color: var(--x-accent);
    border: 1px solid color-mix(in srgb, var(--x-accent) 35%, transparent);
    border-radius: calc(4 * var(--uc));
    padding: calc(9 * var(--uc)) calc(12 * var(--uc));
  }
  .vchip:is(:lang(zh), :lang(ja), :lang(ko)) {
    line-height: 1.6;
  }
  /* 查册按钮:唯一的实心柠檬件(可点转化件分层纪律)。
     行内块而非 flex —— vi@390 文案折两行时,flex 会把 ↗ 甩到按钮最右侧垂直居中、与文字
     脱开一大段,读作坏掉的按钮(R3 评审 D4);行内块下箭头随文本流,由 NBSP 绑住末词。 */
  /* 触达高由**对称内衬**产出,不靠 min-height 兜底:min-height 的余量只加在盒底,
     文字实测偏上 2.13px(en),与同排 chip 的基线差 3.00px,且三语偏上量各不同
     (zh 行盒够高时 min-height 根本不生效)—— R3b 工艺 P1-1。
     内衬按各语言行盒推:44 = 行盒 + 2×padding。 */
  .vcta {
    max-width: 100%;
    color: var(--x-on-accent);
    background: var(--x-accent);
    border-radius: 999px;
    /* 1.45em 而非 1lh:字身单位会在字体就绪前锁死在兜底值(R50 判据);
       1.45 是本元素 line-height 的同值直写。 */
    padding: calc((var(--x-touch) - 1.2em) / 2) calc(16 * var(--uc));
    font-weight: 700; /* 全站体例:按钮 700(tokens 排版尺子) */
    display: inline-block;
    text-align: center;
    text-decoration: none;
    transition: opacity 0.2s;
  }
  .vcta:lang(vi) {
    padding-block: calc((var(--x-touch) - 1.45em) / 2);
  }
  .vcta:is(:lang(zh), :lang(ja), :lang(ko)) {
    line-height: 1.6; /* x-label 与 x-mono 同基座,取同一 zh 档(型类只有 vi 分支) */
    padding-block: calc((var(--x-touch) - 1.6em) / 2);
  }
  .vcta:hover {
    opacity: 0.85;
  }
  .vcta:active {
    opacity: 0.75;
  }
  /* 灯箱内「查看原件」出口(R49-D6):dialog 是亮底,走纸面墨色 */
  .cert-orig {
    display: inline-flex;
    align-items: center;
    gap: calc(4 * var(--uc));
    color: var(--x-accent-ink-paper);
    text-decoration: underline;
    text-underline-offset: calc(3 * var(--uc));
    margin: calc(8 * var(--uc)) 0;
    min-height: var(--x-touch);
  }
  @media (max-width: 900px) {
    .grid,
    .meaning {
      grid-template-columns: minmax(0, 1fr);
    }
    .card {
      padding: calc(24 * var(--uc)) calc(22 * var(--uc));
    }
    .meaning {
      gap: calc(24 * var(--uc));
    }
    .meaning-body {
      padding: calc(24 * var(--uc)) 0 0;
      border-left: 0;
      border-top: 1px solid var(--x-line-soft);
    }
  }
  @media (max-width: 600px) {
    /* 手机正文吃整卡宽度，证书只保留自然比例的预览。 */
    .card-head {
      flex-direction: column;
      gap: calc(14 * var(--uc));
    }
    .card-detail {
      grid-template-columns: minmax(0, 1fr);
    }
    .certificate {
      width: min(100%, calc(220 * var(--uc)));
      justify-self: center;
    }
    .card :global(.cic) {
      margin-top: 0;
    }
  }

  /* —— 证书开启件与灯箱:R44-R46 机制原样(键盘可达 / 无 JS 直开图 / dialog 锁滚)—— */
  .cert-open {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
    position: relative;
    text-decoration: none;
    color: inherit;
  }
  .cert-hint {
    position: absolute;
    inset: auto 0 0 0;
    padding: calc(6 * var(--uc));
    background: var(--x-bg);
    color: var(--x-light);
    opacity: 0;
    transition: opacity 0.18s ease;
  }
  .cert-open:hover .cert-hint,
  .cert-open:focus-visible .cert-hint {
    opacity: 1;
  }
  .cert-zoom {
    border: 0;
    padding: 0 calc(16 * var(--uc)) calc(16 * var(--uc));
    background: var(--x-light);
    /* 第三项(按高度反推宽)在极矮视口会塌穿弹层自身构件宽(1920×360 实测横溢 19px)——
       给 240 下限:装得下关闭行与原件行;纵向富余交给图的 min-height:0 收缩(letterbox 不溢出)。 */
    width: min(
      calc(96vw / var(--x-zoom)),
      calc(760 * var(--uc)),
      max(calc((94vh / var(--x-zoom) - 160 * var(--uc)) * 0.7494), calc(240 * var(--uc)))
    );
    max-width: min(calc(96vw / var(--x-zoom)), calc(760 * var(--uc))); /* 画布内须换算,否则被二次放大 */
    max-height: calc(94vh / var(--x-zoom));
    overscroll-behavior: contain; /* 灯箱滚到端点不串联滚后面的页面 */
  }
  /* 竖向弹性只挂打开态(R49 修门的高度预算 160 机制不变)。
     ⚠️ 禁写回基类:dialog 关闭态靠 UA 的 display:none 藏身,基类 display 会把它顶掉——
     弹层从首帧起常驻可见、吞信任区点击(R49 收线 P0,两路独立审计同时抓到)。 */
  .cert-zoom[open] {
    display: flex;
    flex-direction: column;
  }
  .cert-zoom::backdrop {
    background: rgb(var(--x-bg-rgb) / 0.82);
  }
  .cert-zoom img {
    display: block;
    width: 100%;
    height: auto;
    min-height: 0; /* flex 项默认不缩到内容高以下;与 contain 配合,超预算时收缩不溢出 */
    object-fit: contain;
    background: var(--x-line-soft); /* 大图在慢网要几秒:盒子先显浅底,不是一片空白 */
  }
  .cert-orig {
    flex: 0 0 auto;
  }
  .cert-zoom.is-loading img {
    animation: x-pulse 1.4s ease-in-out infinite;
  }
  @keyframes x-pulse {
    50% {
      opacity: 0.55;
    }
  }
  .cert-zoom-close {
    position: sticky;
    top: 0;
    left: 0;
    z-index: 1;
    display: flex;
    justify-content: flex-end;
    padding: calc(16 * var(--uc)) 0 calc(12 * var(--uc));
    margin-bottom: 0;
    background: var(--x-light);
  }
  /* 灯箱住在浅底上,关闭键按纸面墨色走(玻璃暗版按钮在浅底上会隐形) */
  .cert-zoom-close .xbtn {
    border-color: var(--x-line-dark);
    color: var(--x-dark);
  }

  /* PoC 手风琴 = 与首页 FAQ 同一细线行式(B7 归一;墨色随深带翻回暗系) */
  .poc {
    margin-top: max(20px, calc(28 * var(--u)));
    border-top: 1px solid var(--x-line);
    border-bottom: 1px solid var(--x-line);
  }
  .poc summary {
    cursor: pointer;
    min-height: calc(60 * var(--uc));
    display: flex;
    align-items: center;
    gap: clamp(14px, 2vw, calc(28 * var(--uc)));
    padding: calc(12 * var(--uc)) 0;
    list-style: none;
  }
  .poc summary::-webkit-details-marker {
    display: none;
  }
  .poc .q {
    color: var(--x-ink);
    flex: 1;
  }
  .poc .mark {
    color: var(--x-accent-hot);
    font-weight: 400;
    position: relative;
  }
  .poc[open] .mark {
    visibility: hidden;
  }
  .poc[open] .mark::after {
    content: '−';
    visibility: visible;
    position: absolute;
    left: 0;
    color: var(--x-accent-hot);
  }
  .poc p {
    color: var(--x-ink-cap);
    margin: 0 0 calc(20 * var(--uc));
    max-width: 40em;
    text-wrap: pretty;
  }
  .poc .q {
    transition: opacity 0.2s;
  }
  .poc summary:hover .q,
  .poc summary:focus-visible .q {
    opacity: 0.6;
  }

  /* 手机端灯箱:R46 竖向 flex 收缩方案原样 */
  @media (max-width: 860px) {
    .cert-zoom {
      width: 100vw;
      max-width: 100vw;
      max-height: 100dvh;
      padding: 0 calc(8 * var(--uc)) calc(8 * var(--uc));
    }
    .cert-zoom img {
      width: 100%;
      max-width: 100%;
      min-height: 0; /* flex 项默认不肯缩到内容高以下,不解开这条 max-height 不起作用 */
      object-fit: contain;
    }
    .cert-zoom-close {
      padding: calc(8 * var(--uc)) 0;
    }
  }
  @media (hover: none) {
    .cert-hint {
      opacity: 1;
    }
  }
</style>

<script>
  /* PoC 意图到达自动展开(WEB07):点站内 #poc 链 / 带 #poc 直达 → details 自动打开。
     (此脚本曾被批量替换写成空壳,黑盒审计以「只滚不开」抓回——R49 收线 P1。) */
  const poc = document.getElementById('poc') as HTMLDetailsElement | null;
  if (poc) {
    const openPoc = () => {
      poc.open = true;
    };
    if (location.hash === '#poc') openPoc();
    window.addEventListener('hashchange', () => {
      if (location.hash === '#poc') openPoc();
    });
    document.addEventListener('click', (e) => {
      const hit = e.target instanceof Element && e.target.closest('a[href$="#poc"]');
      if (hit) openPoc();
    });
  }
</script>
