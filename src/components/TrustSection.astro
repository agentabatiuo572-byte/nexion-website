---
/* [FEAT-WEB07] 关于 NexGrid — R48 玻璃重构(章 03,B+C 杂交):
   实体信息来自 O2 资料包(D:\WORKS\公司资料,2026-08-20 主人交付):
   NexGrid LTD · Colorado Corporation · Entity ID 20221592644 · MSB 31000329265856。
   合规软化 2 处(汇报已交底):MSB 用「注册/登记」表述。
   章头 = 幽灵编号 03(右)+ kicker(nav.trust)+ 44 档标题(trust.title);
   证书双图进 5/12 高瓷砖(灯箱/放大机制 R44-R46 原样),五信息卡全文入瓷砖阵
   (卡文一句不删,展示序号按版面顺序重排:01=card1 / 02=card3 / 03=card2 / 04=card5 / 05=card4);
   PoC 手风琴保留细线行式(与 FAQ 同规格,B7 归一)。 */
import { useT, type Locale } from '../i18n';
import Icon from './Icon.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useT(locale);
/* 版面顺序:事实(公司/MSB)→ 核验步骤(Colorado/FinCEN)→ 制度解释;卡 key 不变,只重排。
   R48.7 令②:每卡配语义线性图标(按卡内容不按版面序):注册实体/盾勾/查册/清单查询/天平。
   R49-B1(总审五路之三同报):两张「教你去官方查」的卡此前是纯文本——最想核验的用户
   操作成本反而最高;按 PRD WEB07 ⑥ 补齐阳光路径:官方入口真外链(新标签)+ 编号一键复制。
   链接指检索入口页不指结果页(结果页 URL 不可稳定构造);编号单源在下方常量。 */
const ENTITY_ID = '20221592644';
const MSB_ID = '31000329265856';
const order = [
  { card: 1, span: 's7', icon: 'registry' },
  { card: 3, span: 's7', icon: 'shield' },
  { card: 2, span: 's6', icon: 'verify-search', verify: { url: 'https://www.coloradosos.gov/biz/BusinessEntityCriteriaExt.do', label: 'coloradosos.gov', num: ENTITY_ID } },
  { card: 5, span: 's6', icon: 'lookup', verify: { url: 'https://www.fincen.gov/msb-state-selector', label: 'fincen.gov/msb-state-selector', num: MSB_ID } },
  { card: 4, span: 's12', icon: 'scale' },
] as const;
---

<section class="trust" id="trust">
  <div class="head">
    <span class="x-ghost ghost" aria-hidden="true">03</span>
    <p class="lab x-mono-lg" data-tw>{t('nav.trust')}</p>
    <h2 class="x-display" data-lr>{t('trust.title')}</h2>
  </div>

  <div class="grid">
    <div class="certs x-tile" data-rv>
      <figure>
        <a
          class="cert-open"
          href="/cert-msb@2x.png"
          data-src="/cert-msb@2x.png"
          data-srcset="/cert-msb.png 660w, /cert-msb@2x.png 1160w"
          data-alt={t('trust.certMsbAlt')}
          aria-label={t('trust.certZoom')}
        >
          <img src="/cert-msb.png" alt={t('trust.certMsbAlt')} width="660" height="881" loading="lazy" />
          <span class="cert-hint x-mono">{t('trust.certZoom')}</span>
        </a>
      </figure>
      <figure>
        <a
          class="cert-open"
          href="/cert-colorado@2x.png"
          data-src="/cert-colorado@2x.png"
          data-srcset="/cert-colorado.png 660w, /cert-colorado@2x.png 1160w"
          data-alt={t('trust.certCoAlt')}
          aria-label={t('trust.certZoom')}
        >
          <img src="/cert-colorado.png" alt={t('trust.certCoAlt')} width="660" height="881" loading="lazy" />
          <span class="cert-hint x-mono">{t('trust.certZoom')}</span>
        </a>
      </figure>
    </div>

    {
      order.map(({ card, span, icon, ...rest }, i) => (
        <article class:list={['card', 'x-tile', span]} data-rv style={`--d:${i * 0.08}s`}>
          <span class="crow">
            <span class="idx x-mono">0{i + 1}</span>
            <Icon name={icon} class="cic" />
          </span>
          <p class="x-mono">{t(`trust.card${card}`)}</p>
          {'verify' in rest && rest.verify && (
            <p class="vrow">
              <a class="vout x-mono" href={rest.verify.url} target="_blank" rel="noopener noreferrer">
                {rest.verify.label} <span aria-hidden="true">↗</span>
              </a>
              <button type="button" class="vcopy x-mono" data-copy={rest.verify.num} data-copied-label={t('trust.copied')}>
                {t('trust.copyNum')} · {rest.verify.num}
              </button>
            </p>
          )}
        </article>
      ))
    }
  </div>

  <dialog class="cert-zoom" aria-label={t('trust.certZoom')} data-lenis-prevent>
    <form method="dialog" class="cert-zoom-close">
      <button class="xbtn" aria-label={t('trust.certClose')}>{t('trust.certClose')}</button>
    </form>
    {/* 1x 屏复用页面里已下好的 660 缩略件(桌面灯箱只渲染约 528px);HiDPI 与手机取 @2x。
        手机档故意写死 1160(远大于适宽后的渲染宽):双指放大不会回源重取,取小图放大就是糊的。
        实测慢网首开 2521ms → 179ms */}
    <img alt="" width="1160" height="1548" sizes="(max-width: 860px) 1160px, (min-width: 1441px) 747px, 560px" />
  </dialog>

  <details class="poc" id="poc">
    <summary>
      <span class="q x-q">{t('trust.pocTitle')}</span>
      <span class="mark x-mono" aria-hidden="true">+</span>
    </summary>
    <p class="x-mono">{t('trust.pocBody1')}</p>
    <p class="x-mono">{t('trust.pocBody2')}</p>
  </details>
</section>

<style>
  .trust {
    padding: 0 var(--x-pad);
  }
  .head {
    position: relative;
    margin-bottom: max(32px, calc(48 * var(--u)));
  }
  .ghost {
    right: calc(-10 * var(--uc));
    top: calc(-30 * var(--uc));
  }
  .lab {
    color: var(--x-ink);
    margin: 0 0 calc(16 * var(--uc));
    min-height: 1.2em;
  }
  .head h2 {
    position: relative;
    z-index: 1;
    font-size: max(30px, calc(44 * var(--u)));
    color: var(--x-ink);
    margin: 0;
  }

  /* 瓷砖阵:证书 5/12 占两行,信息卡按版面顺序补位 */
  .grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: calc(18 * var(--uc));
  }
  .certs {
    grid-column: span 5;
    grid-row: span 2;
    display: flex;
    gap: calc(14 * var(--uc));
    padding: calc(20 * var(--uc));
    align-items: flex-start;
  }
  .card {
    display: grid;
    gap: calc(18 * var(--uc));
    align-content: start;
    padding: calc(26 * var(--uc)) calc(30 * var(--uc));
  }
  .s7 {
    grid-column: span 7;
  }
  .s6 {
    grid-column: span 6;
  }
  .s12 {
    grid-column: span 12;
  }
  /* 两端行:编号 ←→ 语义图标(与瓷砖章 metarow 同构;图标退 dim 档,不与编号争柠檬) */
  .crow {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .idx {
    color: var(--x-accent-hot);
    font-weight: 400;
  }
  .crow :global(.cic) {
    width: max(18px, calc(24 * var(--u)));
    height: max(18px, calc(24 * var(--u)));
    color: var(--x-ink-dim);
    flex: 0 0 auto;
  }
  .card p {
    margin: 0;
    color: var(--x-ink-cap);
    text-wrap: pretty;
    line-height: 1.45;
  }
  .card p:lang(zh) {
    line-height: 1.6; /* 全站 CJK 行高不变量 */
  }
  /* R49-B1 核验行:官方外链 + 编号复制;透明底件走 hairline(带 bg 禁边框铁律不涉及) */
  .vrow {
    display: flex;
    flex-wrap: wrap;
    gap: calc(10 * var(--uc)) calc(14 * var(--uc));
    align-items: center;
  }
  .vout {
    color: var(--x-ink);
    text-decoration: underline;
    text-underline-offset: calc(3 * var(--uc));
    min-height: var(--x-touch);
    display: inline-flex;
    align-items: center;
    transition: opacity 0.2s;
  }
  .vout:hover {
    opacity: 0.7;
  }
  .vout:active {
    opacity: 0.6;
  }
  .vcopy {
    font: inherit;
    color: var(--x-ink-dim);
    background: none;
    border: 1px solid var(--x-line);
    border-radius: calc(999 * var(--uc));
    padding: calc(6 * var(--uc)) calc(14 * var(--uc));
    min-height: max(32px, calc(36 * var(--uc)));
    cursor: pointer;
    font-variant-numeric: tabular-nums;
    transition:
      color 0.2s,
      border-color 0.2s;
  }
  .vcopy:hover,
  .vcopy:focus-visible {
    color: var(--x-ink);
    border-color: var(--x-ink-dim);
  }
  .vcopy:active {
    opacity: 0.75;
  }
  .vcopy.done {
    color: var(--x-accent-hot);
    border-color: var(--x-accent-hot);
  }
  @media (max-width: 900px) {
    .certs,
    .s7,
    .s6,
    .s12 {
      grid-column: 1 / -1;
      grid-row: auto;
    }
  }

  /* —— 证书开启件与灯箱:R44-R46 机制原样(键盘可达 / 无 JS 直开图 / dialog 锁滚)—— */
  .cert-open {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
    position: relative;
    text-decoration: none;
    color: inherit;
  }
  .cert-hint {
    position: absolute;
    inset: auto 0 0 0;
    padding: calc(6 * var(--uc));
    background: var(--x-bg);
    color: var(--x-light);
    opacity: 0;
    transition: opacity 0.18s ease;
  }
  .cert-open:hover .cert-hint,
  .cert-open:focus-visible .cert-hint {
    opacity: 1;
  }
  .cert-zoom {
    border: 0;
    padding: 0 calc(16 * var(--uc)) calc(16 * var(--uc));
    background: var(--x-light);
    width: min(
      calc(96vw / var(--x-zoom)),
      calc(760 * var(--uc)),
      calc((94vh / var(--x-zoom) - 100 * var(--uc)) * 0.7494)
    );
    max-width: min(calc(96vw / var(--x-zoom)), calc(760 * var(--uc))); /* 画布内须换算,否则被二次放大 */
    max-height: calc(94vh / var(--x-zoom));
    overscroll-behavior: contain; /* 灯箱滚到端点不串联滚后面的页面 */
  }
  .cert-zoom::backdrop {
    background: rgb(var(--x-bg-rgb) / 0.82);
  }
  .cert-zoom img {
    display: block;
    width: 100%;
    height: auto;
    background: var(--x-line-soft); /* 大图在慢网要几秒:盒子先显浅底,不是一片空白 */
  }
  .cert-zoom.is-loading img {
    animation: x-pulse 1.4s ease-in-out infinite;
  }
  @keyframes x-pulse {
    50% {
      opacity: 0.55;
    }
  }
  .cert-zoom-close {
    position: sticky;
    top: 0;
    left: 0;
    z-index: 1;
    display: flex;
    justify-content: flex-end;
    padding: calc(16 * var(--uc)) 0 calc(12 * var(--uc));
    margin-bottom: 0;
    background: var(--x-light);
  }
  /* 灯箱住在浅底上,关闭键按纸面墨色走(玻璃暗版按钮在浅底上会隐形) */
  .cert-zoom-close .xbtn {
    border-color: var(--x-line-dark);
    color: var(--x-dark);
  }
  .certs figure {
    margin: 0;
    flex: 1;
    min-width: 0;
    padding: calc(8 * var(--uc));
    background: var(--x-white);
    border-radius: var(--x-r-sm);
  }
  .certs img {
    display: block;
    width: 100%;
    height: auto;
  }

  /* PoC 手风琴 = 与首页 FAQ 同一细线行式(B7 归一;墨色随深带翻回暗系) */
  .poc {
    margin-top: max(20px, calc(28 * var(--u)));
    border-top: 1px solid var(--x-line);
    border-bottom: 1px solid var(--x-line);
  }
  .poc summary {
    cursor: pointer;
    min-height: calc(60 * var(--uc));
    display: flex;
    align-items: center;
    gap: clamp(14px, 2vw, calc(28 * var(--uc)));
    padding: calc(12 * var(--uc)) 0;
    list-style: none;
  }
  .poc summary::-webkit-details-marker {
    display: none;
  }
  .poc .q {
    color: var(--x-ink);
    flex: 1;
  }
  .poc .mark {
    color: var(--x-accent-hot);
    font-weight: 400;
    position: relative;
  }
  .poc[open] .mark {
    visibility: hidden;
  }
  .poc[open] .mark::after {
    content: '−';
    visibility: visible;
    position: absolute;
    left: 0;
    color: var(--x-accent-hot);
  }
  .poc p {
    color: var(--x-ink-cap);
    margin: 0 0 calc(20 * var(--uc));
    max-width: calc(760 * var(--uc));
    text-wrap: pretty;
    line-height: 1.45;
  }
  .poc p:lang(zh) {
    line-height: 1.6;
  }
  .poc .q {
    transition: opacity 0.2s;
  }
  .poc summary:hover .q,
  .poc summary:focus-visible .q {
    opacity: 0.6;
  }

  /* 手机端灯箱:R46 竖向 flex 收缩方案原样 */
  @media (max-width: 860px) {
    .cert-zoom {
      display: flex;
      flex-direction: column;
      width: 100vw;
      max-width: 100vw;
      max-height: 100dvh;
      padding: 0 calc(8 * var(--uc)) calc(8 * var(--uc));
    }
    .cert-zoom img {
      width: 100%;
      max-width: 100%;
      min-height: 0; /* flex 项默认不肯缩到内容高以下,不解开这条 max-height 不起作用 */
      object-fit: contain;
    }
    .cert-zoom-close {
      padding: calc(8 * var(--uc)) 0;
    }
  }
  @media (hover: none) {
    .cert-hint {
      opacity: 1;
    }
  }
</style>

<script>
  /* R49-B1 编号一键复制:成功态换标签 1.6s 复原;Clipboard API 被策略拒 → 选中文本退路
     (用户手动 Ctrl+C,比静默失败诚实)。 */
  /* R49-B3 承诺-兑付:How 的「收益怎么被验证 →」落点 #poc;意图到达(点链或带 hash 进页)自动展开,
     默认仍折叠保版面平衡。 */
  {
    const poc = document.getElementById('poc') as HTMLDetailsElement | null;
    if (poc) {
      const openPoc = () => { poc.open = true; };
      if (location.hash === '#poc') openPoc();
      document.addEventListener('click', (e) => {
        const a = (e.target as HTMLElement).closest?.('a[href="#poc"]');
        if (a) openPoc();
      });
    }
  }

  for (const b of document.querySelectorAll<HTMLButtonElement>('.trust .vcopy')) {
    const orig = b.textContent;
    b.addEventListener('click', async () => {
      const num = b.dataset.copy || '';
      let ok = true;
      try {
        await navigator.clipboard.writeText(num);
      } catch {
        ok = false;
        const sel = window.getSelection();
        const range = document.createRange();
        range.selectNodeContents(b);
        sel?.removeAllRanges();
        sel?.addRange(range);
      }
      if (ok) {
        b.classList.add('done');
        b.textContent = `${b.dataset.copiedLabel} · ${num}`;
        setTimeout(() => {
          b.classList.remove('done');
          b.textContent = orig;
        }, 1600);
      }
    });
  }
</script>
