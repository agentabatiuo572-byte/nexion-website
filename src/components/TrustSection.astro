---
/* [FEAT-WEB07] 关于 NexGrid — 实体信息来自 O2 资料包(D:\WORKS\公司资料,2026-08-20 主人交付):
   NexGrid LTD · Colorado Corporation · Entity ID 20221592644 · MSB 31000329265856。
   合规软化 2 处(汇报已交底):MSB 用「注册/登记」表述。
   axiom 方向:反白区块,双证书并排(比例沿用主人已批的 330px 档),
   五信息卡改为序号等宽文块栅格,PoC 手风琴保留。
   R45:证书灯箱锁滚 + 关闭键常驻 + 1160 宽原件;PoC 手风琴改与 FAQ 同一细线行式(B7);zh 卡文行高走全站 CJK 值。 */
import { useT, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useT(locale);
const cards = [1, 2, 3, 4, 5] as const;
---

<section class="trust" id="trust">
  <div class="head">
    <p class="lab x-mono-lg" data-tw>{t('trust.title')}</p>
  </div>

  <div class="certs" data-rv>
    <figure>
      <a
        class="cert-open"
        href="/cert-msb@2x.png"
        data-src="/cert-msb@2x.png"
        data-srcset="/cert-msb.png 660w, /cert-msb@2x.png 1160w"
        data-alt={t('trust.certMsbAlt')}
        aria-label={t('trust.certZoom')}
      >
        <img src="/cert-msb.png" alt={t('trust.certMsbAlt')} width="660" height="881" loading="lazy" />
        <span class="cert-hint x-mono">{t('trust.certZoom')}</span>
      </a>
    </figure>
    <figure>
      <a
        class="cert-open"
        href="/cert-colorado@2x.png"
        data-src="/cert-colorado@2x.png"
        data-srcset="/cert-colorado.png 660w, /cert-colorado@2x.png 1160w"
        data-alt={t('trust.certCoAlt')}
        aria-label={t('trust.certZoom')}
      >
        <img src="/cert-colorado.png" alt={t('trust.certCoAlt')} width="660" height="881" loading="lazy" />
        <span class="cert-hint x-mono">{t('trust.certZoom')}</span>
      </a>
    </figure>
  </div>

  <dialog class="cert-zoom" aria-label={t('trust.certZoom')} data-lenis-prevent>
    <form method="dialog" class="cert-zoom-close">
      <button class="xbtn" aria-label={t('trust.certClose')}>{t('trust.certClose')}</button>
    </form>
    {/* 1x 屏复用页面里已下好的 660 缩略件(桌面灯箱只渲染约 528px);HiDPI 与手机取 @2x。
        手机档故意写死 1160(远大于适宽后的渲染宽):双指放大不会回源重取,取小图放大就是糊的。
        实测慢网首开 2521ms → 179ms */}
    <img alt="" width="1160" height="1548" sizes="(max-width: 860px) 1160px, (min-width: 1441px) 747px, 560px" />
  </dialog>

  <div class="cards">
    {
      cards.map((n, i) => (
        <article class="card" data-rv style={`--d:${i * 0.08}s`}>
          <span class="idx x-mono">0{n}</span>
          <p class="x-mono">{t(`trust.card${n}`)}</p>
        </article>
      ))
    }
  </div>

  <details class="poc">
    <summary>
      <span class="q">{t('trust.pocTitle')}</span>
      <span class="mark x-mono" aria-hidden="true">+</span>
    </summary>
    <p class="x-mono">{t('trust.pocBody1')}</p>
    <p class="x-mono">{t('trust.pocBody2')}</p>
  </details>
</section>

<style>
  .trust {
    padding: 0 var(--x-pad);
  }
  .head {
    margin-bottom: max(48px, calc(120 * var(--u)));
  }
  .lab {
    color: var(--x-ink);
    margin: 0;
    min-height: 1.2em;
  }
  .certs {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(calc(220 * var(--uc)), calc(330 * var(--uc))));
    justify-content: center;
    gap: calc(28 * var(--uc));
    margin-bottom: clamp(36px, 5vw, calc(64 * var(--uc)));
  }
  /* R44:证书此前屏上字高约 3px 且无放大出口 —— 而信任区唯一的作用就是让人核验。
     开启件是 <a href=大图>(键盘可达;无 JS 直接打开图片),有 JS 时 fx 拦截为原生 <dialog>:
     Esc 关闭、焦点管理、背景遮罩全部自带,零框架。 */
  .cert-open {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
    position: relative;
    text-decoration: none;
    color: inherit;
  }
  .cert-hint {
    position: absolute;
    inset: auto 0 0 0;
    padding: calc(6 * var(--uc));
    background: var(--x-dark);
    color: var(--x-light);
    opacity: 0;
    transition: opacity 0.18s ease;
  }
  .cert-open:hover .cert-hint,
  .cert-open:focus-visible .cert-hint {
    opacity: 1;
  }
  .cert-zoom {
    border: 0;
    padding: 0 calc(16 * var(--uc)) calc(16 * var(--uc));
    background: var(--x-light);
    /* 定宽(按内容收缩会让慢网首开先弹只有关闭键宽的小框),且**高度参与**:
       证书原件 1160×1548(比例 0.7494),只按宽度定会让整张高出视口、核验还要在盒内滚。
       第三项 =(可用高 − 关闭行与内衬 ≈100)× 比例,保证整张一眼看全。 */
    width: min(
      calc(96vw / var(--x-zoom)),
      calc(760 * var(--uc)),
      calc((94vh / var(--x-zoom) - 100 * var(--uc)) * 0.7494)
    );
    max-width: min(calc(96vw / var(--x-zoom)), calc(760 * var(--uc))); /* 画布内须换算,否则被二次放大 */
    max-height: calc(94vh / var(--x-zoom));
    overscroll-behavior: contain; /* 灯箱滚到端点不串联滚后面的页面 */
  }
  .cert-zoom::backdrop {
    background: rgb(12 12 13 / 0.82);
  }
  .cert-zoom img {
    display: block;
    width: 100%;
    height: auto;
    background: var(--x-line-soft); /* 大图在慢网要几秒:盒子先显浅底,不是一片空白 */
  }
  .cert-zoom.is-loading img {
    animation: x-pulse 1.4s ease-in-out infinite;
  }
  @keyframes x-pulse {
    50% {
      opacity: 0.55;
    }
  }
  /* R45:灯箱内容高于视口时关闭键随内滚滚走 → 关闭行贴顶常驻 */
  .cert-zoom-close {
    position: sticky;
    top: 0;
    left: 0; /* 双指放大后视觉视口平移,关闭行不被推出屏外 */
    z-index: 1;
    display: flex;
    justify-content: flex-end;
    padding: calc(16 * var(--uc)) 0 calc(12 * var(--uc));
    margin-bottom: 0;
    background: var(--x-light);
  }
  .certs figure {
    margin: 0;
    border: 1px solid var(--x-line-dark);
    padding: calc(8 * var(--uc));
    background: var(--x-white);
  }
  .certs img {
    display: block;
    width: 100%;
    height: auto;
  }
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(calc(280 * var(--uc)), 1fr));
    gap: max(24px, calc(60 * var(--u))); /* 与 #how / #path / #nex 同一条公式;原式的 4.2vw 是画布内的裸视口单位(被上限救着的休眠隐患) */
  }
  /* 无盒开放列(P2-20):左竖线 + pl20;编号墨 0.8/400(P1-25 部分) */
  .card {
    border-left: 1px solid var(--x-line-dark);
    padding-left: calc(20 * var(--uc));
    display: grid;
    gap: max(40px, calc(82 * var(--u))); /* 序号行 → 内容:与同族三组同值(此前 16,窄屏差距反而更大) */
    align-content: start;
  }
  /* R30「纸面编号深柠檬回血」当时落了 #how / #path / #nex 三处、漏了这处 —— 同一屏里 #trust 的 01–05 是灰的、
     正下方 #nex 的 01–03 是柠檬的 */
  .idx {
    color: var(--x-accent-ink);
    font-weight: 400;
  }
  /* 与 #how / #path / #nex 同形栏卡对齐(R45 拍板 ③:卡内正文回 mono 1.2);zh 的 CJK 1.6 由下面另行覆写 */
  .card p {
    margin: 0;
    color: var(--x-dark-cap);
    text-wrap: pretty;
    line-height: 1.2;
  }
  /* zh:全站 CJK 行高不变量(1.6)在此曾被作用域特异度压回 1.45,与 Path/NEX 卡文不一致 */
  /* vi 的叠音符 + 下点与 CJK 同性质:1.2 会把行间墨隙压到 0.33px(en 是 2.0–3.33) */
  .card p:lang(vi):not(html) {
    line-height: 1.45;
  }
  .card p:lang(zh) {
    line-height: 1.6;
  }
  @media (max-width: 768px) {
    .card {
      border-left: 0;
      border-top: 1px solid var(--x-line-dark);
      padding: calc(20 * var(--uc)) 0 0;
    }
  }
  /* PoC 手风琴 = 与首页 FAQ 同一细线行式(B7:同一带内两种手风琴规格归一) */
  .poc {
    margin-top: clamp(28px, 4vw, calc(44 * var(--uc)));
    border-top: 1px solid var(--x-line-dark);
    border-bottom: 1px solid var(--x-line-dark);
  }
  .poc summary {
    cursor: pointer;
    min-height: calc(60 * var(--uc));
    display: flex;
    align-items: center;
    gap: clamp(14px, 2vw, calc(28 * var(--uc))); /* 与 FAQ 同一列几何 */
    padding: calc(12 * var(--uc)) 0;
    list-style: none;
  }
  .poc summary::-webkit-details-marker {
    display: none;
  }
  .poc .q {
    font-family: var(--x-font-display);
    font-size: max(18px, calc(24 * var(--u)));
    font-weight: 400;
    letter-spacing: -0.02em;
    line-height: 1.25;
    color: var(--x-dark);
    flex: 1;
    text-wrap: balance;
  }
  .poc .q:lang(vi):not(html),
  .poc .q:lang(zh):not(html) {
    line-height: 1.45; /* 同 FaqSection */
  }
  /* 不给定宽:12 的盒子里装 7.36 的字形会默认左对齐,记号右缘比行右缘短 4.6px(FAQ 是齐的) */
  .poc .mark {
    color: var(--x-accent-ink);
    font-weight: 400;
    position: relative;
  }
  .poc[open] .mark {
    /* + → − */
    visibility: hidden;
  }
  .poc[open] .mark::after {
    content: '−';
    visibility: visible;
    position: absolute;
    left: 0;
    color: var(--x-accent-ink);
  }
  .poc p {
    color: var(--x-dark-cap);
    /* 记号在右(与 FAQ 同语法),答案左缘 = 问题左缘 */
    margin: 0 0 calc(20 * var(--uc));
    max-width: calc(760 * var(--uc));
    text-wrap: pretty;
    line-height: 1.45;
  }
  .poc p:lang(zh) {
    line-height: 1.6;
  }
  .poc .q {
    transition: opacity 0.2s;
  }
  .poc summary:hover .q,
  .poc summary:focus-visible .q {
    opacity: 0.6;
  }
  /* 手机端灯箱:只比缩略图大 10% 读不了证书 —— 全出血 + 1160 宽原件可平移;触屏无 hover,提示常显 */
  @media (max-width: 860px) {
    .cert-zoom {
      width: 100vw;
      max-width: 100vw;
      max-height: 100dvh;
      padding: 0 calc(8 * var(--uc)) calc(8 * var(--uc));
    }
      /* 手机端默认整张适宽:此前按原件 1160 出图,390 屏一眼只看得到左边三分之一,
         要横向平移才读得完,而灯箱里没有任何提示说它可以平移。适宽后整张一屏可见,
         看清骑缝小字交给系统自带的双指放大(viewport 没锁 user-scalable)。
         🔴 下面 <img sizes> 手机档仍取 1160 原件:放大不会回源重取,取小图放大就是糊的。 */
    .cert-zoom img {
      width: 100%;
      max-width: 100%;
    }
    .cert-zoom-close {
      padding: calc(8 * var(--uc)) 0;
    }
  }
  @media (hover: none) {
    .cert-hint {
      opacity: 1;
    }
  }
</style>
