---
/* [FEAT-WEB01] 全局导航 — R9(主人 2026-08-21 第一屏逐项令):
   ①删 meta 数字列(与第二屏数字条重复);②UTC 时钟贴 LOGO 右侧;
   ③链接横向单行(链接组+语言+下载键一行);翻色/汉堡/锚点/语言逻辑不变。 */
import { useT, locales, type Locale } from '../i18n';

interface Props {
  locale: Locale;
  path?: string;
}
const { locale, path = '/' } = Astro.props;
const t = useT(locale);
const isHome = path === '/';
const prefix = locale === 'en' ? '' : `/${locale}`;
const anchor = (id: string) => (isHome ? `#${id}` : `${prefix}/#${id}`);
const page = (p: string) => `${prefix}${p}`;
const langHref = (l: Locale) => (l === 'en' ? path : `/${l}${path === '/' ? '/' : path}`);

const H5_URL = import.meta.env.PUBLIC_H5_URL ?? '';
const LANG_LABEL: Record<Locale, string> = { en: 'EN', vi: 'VI', zh: '中文' };
---

<header class="site-nav" id="site-nav">
  <nav aria-label={t('nav.ariaMain')}>
    <div class="logo-cell">
      <a class="logo x-dimlink" href={page('/') || '/'}>
        <svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true">
          <g fill="none" stroke="currentColor" stroke-width="1.1">
            <rect x="3" y="3" width="18" height="18" />
            <rect x="7.5" y="7.5" width="9" height="9" />
            <path d="M3 12h4.5M16.5 12H21M12 3v4.5M12 16.5V21" />
            <circle cx="12" cy="12" r="1.6" fill="var(--x-accent)" stroke="none" />
          </g>
        </svg>
        <span>nexgrid</span>
      </a>
      <span class="clock" id="x-clock" aria-hidden="true"></span>
    </div>

    <div class="right">
      <button class="menu-toggle" aria-expanded="false" aria-controls="nav-menu" aria-label={t('nav.ariaMenu')}>
        <span></span><span></span>
      </button>

      <div class="menu" id="nav-menu">
        <div class="links">
          <a class="x-dimlink" data-scr href={anchor('how')}>{t('nav.how')}</a>
          <a class="x-dimlink" data-scr href={anchor('devices')}>{t('nav.devices')}</a>
          <a class="x-dimlink" data-scr href={anchor('trust')}>{t('nav.trust')}</a>
          <a class="x-dimlink" data-scr href={page('/learn')}>{t('nav.learn')}</a>
          <a class="x-dimlink" data-scr href={page('/nex')}>{t('nav.nex')}</a>
        </div>
        <div class="row2">
          <div class="lang" role="group" aria-label={t('nav.ariaLanguage')}>
            {locales.map((l) => (
              <a href={langHref(l)} data-scr class:list={['x-dimlink', { active: l === locale }]} aria-current={l === locale ? 'true' : undefined}>
                {LANG_LABEL[l]}
              </a>
            ))}
          </div>
          {H5_URL && (
            <a class="h5 x-dimlink" data-scr href={H5_URL} target="_blank" rel="noopener">
              {t('nav.launchH5')}
            </a>
          )}
          <a class="xbtn solid dl-btn" href={anchor('download')}>
            <span class="xbtn-ghost">{t('nav.download')} <span class="arr">→</span></span>
            <span class="xbtn-a">{t('nav.download')} <span class="arr">→</span></span>
            <span class="xbtn-b">{t('nav.download')} <span class="arr">→</span></span>
          </a>
        </div>
      </div>
    </div>
  </nav>
</header>

<style>
  /* 常驻最顶层;过浅区整体翻色(currentColor 贯通,脚本置 .on-light) */
  .site-nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 40;
    --x-nav-feather: calc(16 * var(--uc)); /* 幕布羽化带;不透明段 = 条高,故不可能短于导航 */
    color: var(--x-white);
    /* R38:文字换色滞后于幕布(幕布 0.12s 先就位,文字 0.16s 后起步)——
       同步交叉时两灰会在中点擦身(实测瞬时 4.31:1),错峰后文字始终踩在已就位的幕布上 */
    transition: color 0.18s ease 0.16s;
    pointer-events: none;
  }
  /* R35:双幕布伪元素交叉淡切——渐变背景不可过渡,双层 opacity 才能与翻色同步;
     平台段 56px 全不透明(与底色同色)根治「小字压亮丝线」与「翻墨窗黑字压灰」两路实扣 */
  .site-nav::before,
  .site-nav::after {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    /* R41 根治:幕布高度与不透明段**由导航条自身高度驱动**,不再写死数值。
       why:R40 把条高从 14 抬到 30,幕布仍停在写死的 72/56,导航文字下半截失去底板,
       亮区滚动时正文从字缝透出(实测透出率 0%→69%)。改成 100% 派生后,
       「条长高了幕布没跟上」这一族结构上不可能再发生。 */
    height: calc(100% + var(--x-nav-feather));
    pointer-events: none;
    z-index: -1;
    transition: opacity 0.12s ease; /* R38:幕布先行 */
  }
  .site-nav::before {
    /* R36:平台段全不透明(与底色同色=视觉无缝)——90%/94% 半透曾留 15-25% 大字残影 */
    background: linear-gradient(to bottom, var(--x-bg) 0 calc(100% - var(--x-nav-feather)), transparent);
    opacity: 1;
  }
  .site-nav::after {
    background: linear-gradient(to bottom, var(--x-light) 0 calc(100% - var(--x-nav-feather)), transparent);
    opacity: 0;
  }
  .site-nav.on-light {
    color: var(--x-bg);
    /* R31:全局浮层不在白带 DOM 内,纸面强调变体需自随翻墨态切换(下划线/焦点环过白带不隐形) */
    --x-accent-ink: var(--x-accent-ink-paper);
  }
  .site-nav.on-light::before {
    opacity: 0;
  }
  .site-nav.on-light::after {
    opacity: 1;
  }
  .site-nav a,
  .site-nav button {
    pointer-events: auto;
  }
  nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: max(20px, calc(43.2 * var(--u)));
    padding: calc(30 * var(--uc)) calc(var(--x-pad) + var(--x-gut)) 0; /* R39:导航条全出血,内容随画布居中 */
  }
  /* LOGO + 时钟同格(时钟贴 LOGO 右侧) */
  .logo-cell {
    display: flex;
    align-items: center;
    gap: max(20px, calc(36 * var(--u)));
    flex: 0 1 auto;
    min-width: 0;
  }
  /* 画布制排印(参考站 LOGO 块 271×41 @1440):图标+字标同步随视口 */
  .logo {
    display: inline-flex;
    align-items: center;
    gap: calc(12 * var(--uc));
    color: currentColor;
    text-decoration: none;
    font-family: var(--x-font-display);
    font-size: max(20px, calc(28 * var(--u)));
    font-weight: 500;
    letter-spacing: -0.01em;
    min-height: calc(44 * var(--uc));
  }
  .logo svg {
    width: max(30px, calc(41 * var(--u)));
    height: auto;
  }
  .clock {
    font-family: var(--x-font-mono);
    font-size: max(12px, calc(12 * var(--u)));
    font-weight: 400;
    letter-spacing: -0.03em;
    line-height: 1.2;
    color: currentColor;
    min-height: calc(44 * var(--uc));
    display: inline-flex;
    align-items: center;
    white-space: nowrap;
  }
  .right {
    display: flex;
    align-items: center;
    min-width: 0;
  }
  /* 链接组 + 语言 + 下载键:横向单行 */
  .menu {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: max(16px, calc(31.68 * var(--u)));
  }
  .links {
    display: flex;
    gap: max(16px, calc(26 * var(--u)));
  }
  .links a,
  .lang a,
  .h5 {
    font-family: var(--x-font-mono);
    font-size: max(12px, calc(12 * var(--u)));
    font-weight: 400;
    letter-spacing: 0;
    line-height: 1.2;
    text-transform: uppercase;
    color: currentColor;
    text-decoration: none;
    min-height: calc(44 * var(--uc));
    display: inline-flex;
    align-items: center;
    white-space: nowrap;
  }
  .row2 {
    display: flex;
    align-items: center;
    gap: max(12px, calc(23 * var(--u)));
  }
  .lang {
    display: flex;
    gap: calc(10 * var(--uc));
  }
  .lang a {
    opacity: 0.62; /* R35:可交互小字升 dim 档(0.4 档 3.79:1 不过 AA) */
  }
  .lang a.active {
    opacity: 1;
    border-bottom: 1px solid var(--x-accent-ink); /* R30:带纸面变体的档(过白带不隐形) */
  }
  .dl-btn {
    min-height: max(34px, calc(41.76 * var(--u)));
    padding: 0 max(14px, calc(18 * var(--u)));
    font-size: max(11px, calc(12 * var(--u)));
    border-color: var(--x-accent-ink); /* R37:随翻墨态自动深描边(黑区=主柠檬同现状,白带=深柠檬边界补偿) */
    transition:
      background 0.25s ease,
      color 0.25s ease,
      border-color 0.25s ease;
  }
  /* R30:下载键恒柠檬 solid(黑白语境皆成立),on-light 覆写撤销 */
  .menu-toggle {
    display: none;
    background: none;
    border: 0;
    cursor: pointer;
    width: calc(44 * var(--uc));
    height: calc(44 * var(--uc));
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: calc(6 * var(--uc));
    z-index: 60;
  }
  .menu-toggle span {
    display: block;
    width: calc(22 * var(--uc));
    height: 2px;
    background: currentColor;
    transition:
      transform 0.2s,
      opacity 0.2s;
  }

  @media (max-width: 1080px) {
    .clock {
      display: none;
    }
  }
  @media (max-width: 860px) {
    nav {
      align-items: center;
      padding-top: calc(10 * var(--uc));
    }
    .menu-toggle {
      display: flex;
    }
    .menu {
      display: none;
      position: fixed;
      inset: 0;
      z-index: 55;
      background: var(--x-bg);
      color: var(--x-white);
      padding: calc(84 * var(--uc)) var(--x-pad) calc(32 * var(--uc));
      flex-direction: column;
      align-items: flex-start;
      justify-content: flex-start;
      gap: calc(26 * var(--uc));
    }
    .site-nav.menu-open {
      z-index: 100;
      color: var(--x-white);
    }
    .menu.open {
      display: flex;
    }
    .links {
      flex-direction: column;
      gap: calc(6 * var(--uc));
    }
    .links a {
      font-family: var(--x-font-display);
      font-size: clamp(30px, 8.5vw, calc(44 * var(--uc)));
      font-weight: 500;
      letter-spacing: -0.02em;
      text-transform: none;
      min-height: calc(52 * var(--uc));
    }
    .row2 {
      flex-direction: column;
      align-items: flex-start;
      gap: calc(18 * var(--uc));
      margin-top: calc(6 * var(--uc));
    }
    .lang a {
      min-height: calc(44 * var(--uc));
    }
    .dl-btn {
      min-height: calc(48 * var(--uc));
      padding: 0 calc(22 * var(--uc));
      font-size: calc(12 * var(--uc));
    }
  }
</style>

<script>
  // 汉堡开合 + 过浅区翻色(rAF 节流测 .x-invert 与导航带重叠)
  const nav = document.getElementById('site-nav');
  const toggle = nav?.querySelector<HTMLButtonElement>('.menu-toggle');
  const menu = document.getElementById('nav-menu');
  toggle?.addEventListener('click', () => {
    const open = menu?.classList.toggle('open') ?? false;
    nav?.classList.toggle('menu-open', open);
    toggle.setAttribute('aria-expanded', String(open));
    document.documentElement.style.overflow = open ? 'hidden' : '';
  });
  menu?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) {
      menu.classList.remove('open');
      nav?.classList.remove('menu-open');
      toggle?.setAttribute('aria-expanded', 'false');
      document.documentElement.style.overflow = '';
    }
  });

  const lightSections = [...document.querySelectorAll<HTMLElement>('.x-invert')];
  const NAV_BAND = 84;
  let raf = 0;
  const recolor = () => {
    raf = 0;
    let onLight = false;
    for (const s of lightSections) {
      const r = s.getBoundingClientRect();
      if (r.top < NAV_BAND && r.bottom > NAV_BAND) {
        /* R37:bottom 也须过导航带——白带滚出后导航区已是黑区,旧判定迟翻留「白帽压黑」 */
        onLight = true;
        break;
      }
    }
    nav?.classList.toggle('on-light', onLight);
  };
  recolor();
  addEventListener(
    'scroll',
    () => {
      if (!raf) raf = requestAnimationFrame(recolor);
    },
    { passive: true },
  );
</script>
