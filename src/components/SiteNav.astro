---
/* [FEAT-WEB01] 全局导航 — R7(解剖报告 P1-10~14):
   常驻最顶层,滑过反白区整体 0.25s 翻色(currentColor 贯通);
   logo 定宽列 + 时钟独立居中 + meta「标签 0.6 透明/值全亮定宽」+ 值打字机入场;
   时钟排印 -0.03em/400,链接 0 字距/400。锚点/语言/下载逻辑不变。 */
import { useT, locales, type Locale } from '../i18n';
import { STATS_SNAPSHOT, fmtStat } from '../lib/stats';

interface Props {
  locale: Locale;
  path?: string;
}
const { locale, path = '/' } = Astro.props;
const t = useT(locale);
const isHome = path === '/';
const prefix = locale === 'en' ? '' : `/${locale}`;
const anchor = (id: string) => (isHome ? `#${id}` : `${prefix}/#${id}`);
const page = (p: string) => `${prefix}${p}`;
const langHref = (l: Locale) => (l === 'en' ? path : `/${l}${path === '/' ? '/' : path}`);

const H5_URL = import.meta.env.PUBLIC_H5_URL ?? '';
const LANG_LABEL: Record<Locale, string> = { en: 'EN', vi: 'VI', zh: '中文' };
const meta = [
  { label: t('stats.activeDevices'), value: fmtStat(STATS_SNAPSHOT.activeDevices, 0), delay: 1000 },
  { label: t('stats.nodes'), value: fmtStat(STATS_SNAPSHOT.nodes, 0), delay: 1120 },
  { label: t('stats.uptime'), value: `${fmtStat(STATS_SNAPSHOT.uptime, 1)}%`, delay: 1240 },
];
---

<header class="site-nav" id="site-nav">
  <nav aria-label={t('nav.ariaMain')}>
    <div class="logo-cell">
      <a class="logo x-dimlink" href={page('/') || '/'}>
        <svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true">
          <g fill="none" stroke="currentColor" stroke-width="1.1">
            <rect x="3" y="3" width="18" height="18" />
            <rect x="7.5" y="7.5" width="9" height="9" />
            <path d="M3 12h4.5M16.5 12H21M12 3v4.5M12 16.5V21" />
            <circle cx="12" cy="12" r="1.6" fill="var(--x-accent)" stroke="none" />
          </g>
        </svg>
        <span>nexgrid</span>
      </a>
    </div>

    <span class="clock" id="x-clock" aria-hidden="true"></span>

    <div class="right">
      <div class="meta" aria-hidden="true">
        {
          meta.map((m) => (
            <span class="kv">
              <span class="k">{m.label}:</span>
              <b data-tw={isHome ? 'load' : undefined} data-tw-delay={m.delay} style={`width:${m.value.length}ch`}>{m.value}</b>
            </span>
          ))
        }
      </div>

      <button class="menu-toggle" aria-expanded="false" aria-controls="nav-menu" aria-label={t('nav.ariaMenu')}>
        <span></span><span></span>
      </button>

      <div class="menu" id="nav-menu">
        <div class="links">
          <a class="x-dimlink" href={anchor('how')}>{t('nav.how')}</a>
          <a class="x-dimlink" href={anchor('devices')}>{t('nav.devices')}</a>
          <a class="x-dimlink" href={anchor('trust')}>{t('nav.trust')}</a>
          <a class="x-dimlink" href={page('/learn')}>{t('nav.learn')}</a>
          <a class="x-dimlink" href={page('/nex')}>{t('nav.nex')}</a>
        </div>
        <div class="row2">
          <div class="lang" role="group" aria-label={t('nav.ariaLanguage')}>
            {locales.map((l) => (
              <a href={langHref(l)} class:list={['x-dimlink', { active: l === locale }]} aria-current={l === locale ? 'true' : undefined}>
                {LANG_LABEL[l]}
              </a>
            ))}
          </div>
          {H5_URL && (
            <a class="h5 x-dimlink" href={H5_URL} target="_blank" rel="noopener">
              {t('nav.launchH5')}
            </a>
          )}
          <a class="xbtn solid dl-btn" href={anchor('download')}>
            <span class="xbtn-ghost">{t('nav.download')} <span class="arr">→</span></span>
            <span class="xbtn-a">{t('nav.download')} <span class="arr">→</span></span>
            <span class="xbtn-b">{t('nav.download')} <span class="arr">→</span></span>
          </a>
        </div>
      </div>
    </div>
  </nav>
</header>

<style>
  /* 常驻最顶层;过浅区整体翻色(currentColor 贯通,脚本置 .on-light) */
  .site-nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 40;
    color: var(--x-white);
    transition: color 0.25s ease;
    pointer-events: none;
  }
  .site-nav.on-light {
    color: var(--x-bg);
  }
  .site-nav a,
  .site-nav button {
    pointer-events: auto;
  }
  nav {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0;
    padding: 18px var(--x-pad) 0;
  }
  .logo-cell {
    width: clamp(217px, 31.6vw, 455px);
    flex: 0 1 auto;
  }
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: currentColor;
    text-decoration: none;
    font-family: var(--x-font-display);
    font-size: 19px;
    font-weight: 500;
    letter-spacing: -0.01em;
    min-height: 44px;
  }
  .clock {
    font-family: var(--x-font-mono);
    font-size: 12px;
    font-weight: 400;
    letter-spacing: -0.03em;
    line-height: 1.2;
    color: currentColor;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    white-space: nowrap;
  }
  .right {
    display: flex;
    align-items: flex-start;
    gap: clamp(24px, 4vw, 60px);
  }
  .meta {
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-family: var(--x-font-mono);
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 0;
    line-height: 1.2;
    text-transform: uppercase;
    color: currentColor;
    padding-top: 13px;
    white-space: nowrap;
  }
  .kv .k {
    opacity: 0.6;
  }
  .kv b {
    font-weight: 400;
    display: inline-block;
    margin-left: 6px;
  }
  .menu {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 10px;
  }
  .links {
    display: flex;
    gap: 22px;
  }
  .links a,
  .lang a,
  .h5 {
    font-family: var(--x-font-mono);
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 0;
    line-height: 1.2;
    text-transform: uppercase;
    color: currentColor;
    text-decoration: none;
    min-height: 30px;
    display: inline-flex;
    align-items: center;
    white-space: nowrap;
  }
  .row2 {
    display: flex;
    align-items: center;
    gap: 18px;
  }
  .lang {
    display: flex;
    gap: 10px;
  }
  .lang a {
    opacity: 0.4;
  }
  .lang a.active {
    opacity: 1;
    border-bottom: 1px solid var(--x-accent);
  }
  .dl-btn {
    min-height: 34px;
    padding: 0 14px;
    font-size: 11px;
    transition:
      background 0.25s ease,
      color 0.25s ease,
      border-color 0.25s ease;
  }
  .site-nav.on-light .dl-btn {
    background: var(--x-dark);
    color: var(--x-white);
    border-color: var(--x-dark);
  }
  .menu-toggle {
    display: none;
    background: none;
    border: 0;
    cursor: pointer;
    width: 44px;
    height: 44px;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 6px;
    z-index: 60;
  }
  .menu-toggle span {
    display: block;
    width: 22px;
    height: 2px;
    background: currentColor;
    transition:
      transform 0.2s,
      opacity 0.2s;
  }

  @media (max-width: 900px) {
    .meta {
      display: none;
    }
  }
  @media (max-width: 860px) {
    nav {
      align-items: center;
      padding-top: 10px;
    }
    .logo-cell {
      width: auto;
    }
    .clock {
      margin-left: auto;
      margin-right: 14px;
    }
    .menu-toggle {
      display: flex;
    }
    .menu {
      display: none;
      position: fixed;
      inset: 0;
      z-index: 55;
      background: var(--x-bg);
      color: var(--x-white);
      padding: 84px var(--x-pad) 32px;
      align-items: flex-start;
      justify-content: flex-start;
      gap: 26px;
    }
    .site-nav.menu-open {
      z-index: 100;
      color: var(--x-white);
    }
    .menu.open {
      display: flex;
    }
    .links {
      flex-direction: column;
      gap: 6px;
    }
    .links a {
      font-family: var(--x-font-display);
      font-size: clamp(30px, 8.5vw, 44px);
      font-weight: 500;
      letter-spacing: -0.02em;
      text-transform: none;
      min-height: 52px;
    }
    .row2 {
      flex-direction: column;
      align-items: flex-start;
      gap: 18px;
      margin-top: 6px;
    }
    .lang a {
      min-height: 44px;
    }
    .dl-btn {
      min-height: 48px;
      padding: 0 22px;
      font-size: 12px;
    }
  }
</style>

<script>
  // 汉堡开合 + 过浅区翻色(rAF 节流测 .x-invert 与导航带重叠)
  const nav = document.getElementById('site-nav');
  const toggle = nav?.querySelector<HTMLButtonElement>('.menu-toggle');
  const menu = document.getElementById('nav-menu');
  toggle?.addEventListener('click', () => {
    const open = menu?.classList.toggle('open') ?? false;
    nav?.classList.toggle('menu-open', open);
    toggle.setAttribute('aria-expanded', String(open));
    document.documentElement.style.overflow = open ? 'hidden' : '';
  });
  menu?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) {
      menu.classList.remove('open');
      nav?.classList.remove('menu-open');
      toggle?.setAttribute('aria-expanded', 'false');
      document.documentElement.style.overflow = '';
    }
  });

  const lightSections = [...document.querySelectorAll<HTMLElement>('.x-invert')];
  const NAV_BAND = 84;
  let raf = 0;
  const recolor = () => {
    raf = 0;
    let onLight = false;
    for (const s of lightSections) {
      const r = s.getBoundingClientRect();
      if (r.top < NAV_BAND && r.bottom > 0) {
        onLight = true;
        break;
      }
    }
    nav?.classList.toggle('on-light', onLight);
  };
  recolor();
  addEventListener(
    'scroll',
    () => {
      if (!raf) raf = requestAnimationFrame(recolor);
    },
    { passive: true },
  );
</script>
