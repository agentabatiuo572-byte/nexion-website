---
/* [FEAT-WEB01] 全局导航 — axiom 方向:fixed 透明 chrome(无底无边),
   小写字标 + UTC 时钟 + 键值元数据(复用 stats.* 既有 key,零新文案)
   + 等宽大写链接。锚点项在 Home 用 #id,子页自动落 /#id;空配置键不渲染。 */
import { useT, locales, type Locale } from '../i18n';
import { STATS_SNAPSHOT, fmtStat } from '../lib/stats';

interface Props {
  locale: Locale;
  /** 当前页 path(不含 locale 前缀),锚点链接与语言切换都靠它 */
  path?: string;
}
const { locale, path = '/' } = Astro.props;
const t = useT(locale);
const isHome = path === '/';
const prefix = locale === 'en' ? '' : `/${locale}`;
const anchor = (id: string) => (isHome ? `#${id}` : `${prefix}/#${id}`);
const page = (p: string) => `${prefix}${p}`;
const langHref = (l: Locale) => (l === 'en' ? path : `/${l}${path === '/' ? '/' : path}`);

// PRD §2.4 O3:H5 URL 未配置 → 按钮不渲染(零死链)
const H5_URL = import.meta.env.PUBLIC_H5_URL ?? '';
const LANG_LABEL: Record<Locale, string> = { en: 'EN', vi: 'VI', zh: '中文' };
---

<header class="site-nav" id="site-nav">
  <nav aria-label={t('nav.ariaMain')}>
    <a class="logo x-dimlink" href={page('/') || '/'}>
      <svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true">
        <g fill="none" stroke="currentColor" stroke-width="1.1">
          <rect x="3" y="3" width="18" height="18" />
          <rect x="7.5" y="7.5" width="9" height="9" />
          <path d="M3 12h4.5M16.5 12H21M12 3v4.5M12 16.5V21" />
          <circle cx="12" cy="12" r="1.6" fill="var(--x-accent)" stroke="none" />
        </g>
      </svg>
      <span>nexgrid</span>
    </a>

    <span class="clock" id="x-clock" aria-hidden="true"></span>

    <div class="meta x-kv" aria-hidden="true">
      <span>{t('stats.activeDevices')}:<b>{fmtStat(STATS_SNAPSHOT.activeDevices, 0)}</b></span>
      <span>{t('stats.nodes')}:<b>{fmtStat(STATS_SNAPSHOT.nodes, 0)}</b></span>
      <span>{t('stats.uptime')}:<b>{fmtStat(STATS_SNAPSHOT.uptime, 1)}%</b></span>
    </div>

    <button class="menu-toggle" aria-expanded="false" aria-controls="nav-menu" aria-label={t('nav.ariaMenu')}>
      <span></span><span></span>
    </button>

    <div class="menu" id="nav-menu">
      <div class="links">
        <a class="x-dimlink" href={anchor('how')}>{t('nav.how')}</a>
        <a class="x-dimlink" href={anchor('devices')}>{t('nav.devices')}</a>
        <a class="x-dimlink" href={anchor('trust')}>{t('nav.trust')}</a>
        <a class="x-dimlink" href={page('/learn')}>{t('nav.learn')}</a>
        <a class="x-dimlink" href={page('/nex')}>{t('nav.nex')}</a>
      </div>
      <div class="row2">
        <div class="lang" role="group" aria-label={t('nav.ariaLanguage')}>
          {locales.map((l) => (
            <a href={langHref(l)} class:list={['x-dimlink', { active: l === locale }]} aria-current={l === locale ? 'true' : undefined}>
              {LANG_LABEL[l]}
            </a>
          ))}
        </div>
        {H5_URL && (
          <a class="h5 x-dimlink" href={H5_URL} target="_blank" rel="noopener">
            {t('nav.launchH5')}
          </a>
        )}
        <a class="xbtn solid dl-btn" href={anchor('download')}>
          <span class="xbtn-ghost">{t('nav.download')} <span class="arr">→</span></span>
          <span class="xbtn-a">{t('nav.download')} <span class="arr">→</span></span>
          <span class="xbtn-b">{t('nav.download')} <span class="arr">→</span></span>
        </a>
      </div>
    </div>
  </nav>
</header>

<style>
  .site-nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
  }
  nav {
    display: flex;
    align-items: flex-start;
    gap: clamp(16px, 2.4vw, 40px);
    padding: 18px var(--x-pad) 0;
  }
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--x-white);
    text-decoration: none;
    font-family: var(--x-font-display);
    font-size: 19px;
    font-weight: 500;
    letter-spacing: -0.01em;
    min-height: 44px;
  }
  .logo svg {
    flex: 0 0 auto;
  }
  .clock {
    font-family: var(--x-font-mono);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--x-white);
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    white-space: nowrap;
  }
  .clock :global(.colon) {
    animation: x-blink 1s steps(1) infinite;
  }
  @keyframes x-blink {
    50% {
      opacity: 0;
    }
  }
  .meta {
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-family: var(--x-font-mono);
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--x-white);
    padding-top: 13px;
    white-space: nowrap;
  }
  .menu {
    margin-left: auto;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 10px;
  }
  .links {
    display: flex;
    gap: 22px;
  }
  .links a,
  .lang a,
  .h5 {
    font-family: var(--x-font-mono);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--x-white);
    text-decoration: none;
    min-height: 30px;
    display: inline-flex;
    align-items: center;
    white-space: nowrap;
  }
  .row2 {
    display: flex;
    align-items: center;
    gap: 18px;
  }
  .lang {
    display: flex;
    gap: 10px;
  }
  .lang a {
    color: var(--x-ink-faint);
  }
  .lang a.active {
    color: var(--x-white);
    border-bottom: 1px solid var(--x-accent);
  }
  .dl-btn {
    min-height: 34px;
    padding: 0 14px;
    font-size: 11px;
  }
  .menu-toggle {
    display: none;
    background: none;
    border: 0;
    cursor: pointer;
    width: 44px;
    height: 44px;
    margin-left: auto;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 6px;
    z-index: 60;
  }
  .menu-toggle span {
    display: block;
    width: 22px;
    height: 2px;
    background: var(--x-white);
    transition:
      transform 0.2s,
      opacity 0.2s;
  }

  @media (max-width: 1280px) {
    .meta {
      display: none;
    }
  }
  @media (max-width: 1060px) {
    .clock {
      display: none;
    }
  }
  @media (max-width: 860px) {
    nav {
      align-items: center;
      padding-top: 10px;
    }
    .clock {
      display: inline-flex;
      margin-left: auto;
    }
    .menu-toggle {
      display: flex;
      margin-left: 0;
    }
    .menu {
      display: none;
      position: fixed;
      inset: 0;
      z-index: 55;
      background: var(--x-bg);
      padding: 84px var(--x-pad) 32px;
      align-items: flex-start;
      justify-content: flex-start;
      gap: 26px;
    }
    .menu.open {
      display: flex;
    }
    .links {
      flex-direction: column;
      gap: 6px;
    }
    .links a {
      font-family: var(--x-font-display);
      font-size: clamp(30px, 8.5vw, 44px);
      font-weight: 500;
      letter-spacing: -0.02em;
      text-transform: none;
      min-height: 52px;
    }
    .row2 {
      flex-direction: column;
      align-items: flex-start;
      gap: 18px;
      margin-top: 6px;
    }
    .lang a {
      min-height: 44px;
    }
    .dl-btn {
      min-height: 48px;
      padding: 0 22px;
      font-size: 12px;
    }
  }
</style>

<script>
  // 汉堡开合(全屏菜单);菜单内点击(锚点/切页)后收起
  const nav = document.getElementById('site-nav');
  const toggle = nav?.querySelector<HTMLButtonElement>('.menu-toggle');
  const menu = document.getElementById('nav-menu');
  toggle?.addEventListener('click', () => {
    const open = menu?.classList.toggle('open') ?? false;
    toggle.setAttribute('aria-expanded', String(open));
    document.documentElement.style.overflow = open ? 'hidden' : '';
  });
  menu?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) {
      menu.classList.remove('open');
      toggle?.setAttribute('aria-expanded', 'false');
      document.documentElement.style.overflow = '';
    }
  });
</script>
