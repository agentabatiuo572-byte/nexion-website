---
/* [FEAT-WEB12] Home FAQ — 6 问手风琴(原生 details)+ FAQPage JSON-LD。
   涉收益答案一律引导 App 内查看 + PoC,不给数字(PRD §1.4-1)。
   axiom 方向:黑底细线行式手风琴 + 序号 + 琥珀 +/− 记号。 */
import { useT, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useT(locale);
const qs = [1, 2, 3, 4, 5, 6] as const;
const ld = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: qs.map((n) => ({
    '@type': 'Question',
    name: t(`faq.q${n}`),
    acceptedAnswer: { '@type': 'Answer', text: t(`faq.a${n}`) },
  })),
};
---

<section class="faq-sec" id="faq">
  <div class="head">
    <span class="x-label lab" data-rv>{t('faq.title')}</span>
  </div>
  {
    qs.map((n, i) => (
      <details class="item" data-rv style={`--d:${i * 0.05}s`}>
        <summary>
          <span class="idx x-mono">Q{n}</span>
          <span class="q">{t(`faq.q${n}`)}</span>
          <span class="mark x-mono" aria-hidden="true">+</span>
        </summary>
        <p class="x-mono">{t(`faq.a${n}`)}</p>
      </details>
    ))
  }
  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
</section>

<style>
  .faq-sec {
    position: relative;
    z-index: 1;
    padding: var(--x-section-gap) var(--x-pad);
    max-width: 1100px;
    /* 小字密集板块必须有不透明底,禁止文字直压粒子线(主人 R2 指令) */
    background: var(--x-bg);
  }
  .head {
    border-top: 1px solid var(--x-line);
    padding-top: 18px;
    margin-bottom: clamp(22px, 3vw, 36px);
  }
  .lab {
    color: var(--x-white);
  }
  .item {
    border-bottom: 1px solid var(--x-line-soft);
  }
  .item summary {
    cursor: pointer;
    min-height: 60px;
    display: flex;
    align-items: center;
    gap: clamp(14px, 2vw, 28px);
    list-style: none;
    padding: 10px 0;
  }
  .item summary::-webkit-details-marker {
    display: none;
  }
  .idx {
    color: var(--x-accent);
    font-weight: 700;
    flex: 0 0 30px;
  }
  .q {
    font-family: var(--x-font-display);
    font-size: clamp(17px, 1.8vw, 23px);
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--x-white);
    flex: 1;
    line-height: 1.25;
    text-wrap: balance;
  }
  .mark {
    color: var(--x-ink-faint);
    font-weight: 700;
    position: relative;
  }
  .item[open] .mark {
    visibility: hidden;
  }
  .item[open] .mark::after {
    content: '−';
    visibility: visible;
    position: absolute;
    left: 0;
    color: var(--x-accent);
  }
  .item p {
    color: var(--x-ink-dim);
    margin: 0 0 20px calc(30px + clamp(14px, 2vw, 28px));
    max-width: 720px;
    text-wrap: pretty;
  }
</style>
