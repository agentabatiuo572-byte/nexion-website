---
/* [FEAT-WEB12] Home FAQ — R48 玻璃重构(章 06):6 问手风琴(原生 details)+ FAQPage JSON-LD 原样,
   行阵装进一块玻璃瓷砖(细线行式 + 序号 + 柠檬 +/− 记号保留;墨色翻回暗系)。
   涉收益答案一律引导 App 内查看 + PoC,不给数字(PRD §1.4-1)。
   本规格仍是 /nex FAQ 与信任区 PoC 手风琴的样板(R45 B7 归一)。 */
import { useT, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useT(locale);
const qs = [1, 2, 3, 4, 5, 6] as const;
const ld = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: qs.map((n) => ({
    '@type': 'Question',
    name: t(`faq.q${n}`),
    acceptedAnswer: { '@type': 'Answer', text: t(`faq.a${n}`) },
  })),
};
---

<section class="faq-sec" id="faq">
  <div class="head">
    <span class="x-ghost ghost" aria-hidden="true">06</span>
    <p class="lab x-mono-lg" data-tw>{t('faq.title')}</p>
  </div>
  <div class="panel x-tile x-tile-paper">
    {
      qs.map((n, i) => (
        <details class="item" data-rv style={`--d:${i * 0.05}s`}>
          <summary>
            <span class="idx x-mono">Q{n}</span>
            <span class="q x-q">{t(`faq.q${n}`)}</span>
            <span class="mark x-mono" aria-hidden="true">+</span>
          </summary>
          <p class="x-mono">{t(`faq.a${n}`)}</p>
        </details>
      ))
    }
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
</section>

<style>
  .faq-sec {
    padding: 0 var(--x-pad);
  }
  .head {
    position: relative;
    margin-bottom: max(32px, calc(48 * var(--u)));
  }
  /* R48.1 主人改令③:面板(1100 宽)在左会压住左置编号 → 编号移右侧空区 */
  .ghost {
    right: calc(-10 * var(--uc));
    top: calc(-30 * var(--uc));
  }
  .lab {
    position: relative;
    z-index: 1;
    color: var(--x-ink);
    margin: 0;
    min-height: 1.2em;
  }
  .panel {
    max-width: calc(1100 * var(--uc));
    padding: calc(8 * var(--uc)) calc(30 * var(--uc));
    z-index: 1;
  }
  .item {
    border-top: 1px solid var(--x-line-soft);
  }
  .item:first-of-type {
    border-top: 0; /* 瓷砖边界已是首行上缘 */
  }
  .item summary {
    cursor: pointer;
    min-height: calc(60 * var(--uc));
    display: flex;
    align-items: center;
    gap: clamp(14px, 2vw, calc(28 * var(--uc)));
    list-style: none;
    padding: calc(12 * var(--uc)) 0;
  }
  .item summary::-webkit-details-marker {
    display: none;
  }
  .idx {
    color: var(--x-ink-cap);
    font-weight: 400;
    flex: 0 0 calc(30 * var(--uc));
  }
  /* 字族/字重/字距/行高与 vi·zh 分支全部交给 .x-q 型类;这里只留本处特有的 */
  .q {
    color: var(--x-ink);
    flex: 1;
  }
  .mark {
    color: var(--x-accent-hot);
    font-weight: 400;
    position: relative;
  }
  .item[open] .mark {
    visibility: hidden;
  }
  .item[open] .mark::after {
    content: '−';
    visibility: visible;
    position: absolute;
    left: 0;
    color: var(--x-accent-hot);
  }
  .item p {
    color: var(--x-ink-cap);
    margin: 0 0 calc(20 * var(--uc)) calc(calc(30 * var(--uc)) + clamp(14px, 2vw, calc(28 * var(--uc))));
    max-width: calc(760 * var(--uc));
    text-wrap: pretty;
    line-height: 1.45;
  }
  .item p:lang(zh) {
    line-height: 1.6; /* 全站 CJK 行高不变量 */
  }
  .q {
    transition: opacity 0.2s;
  }
  .item summary:hover .q,
  .item summary:focus-visible .q {
    opacity: 0.6;
  }
</style>
