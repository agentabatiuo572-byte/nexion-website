---
/* [FEAT-WEB12] Home FAQ — 6 问手风琴(原生 details)+ FAQPage JSON-LD。
   涉收益答案一律引导 App 内查看 + PoC,不给数字(PRD §1.4-1)。
   axiom 方向:黑底细线行式手风琴 + 序号 + 琥珀 +/− 记号。 */
import { useT, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useT(locale);
const qs = [1, 2, 3, 4, 5, 6] as const;
const ld = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: qs.map((n) => ({
    '@type': 'Question',
    name: t(`faq.q${n}`),
    acceptedAnswer: { '@type': 'Answer', text: t(`faq.a${n}`) },
  })),
};
---

<section class="faq-sec" id="faq">
  <div class="head">
    <p class="lab x-mono-lg" data-tw>{t('faq.title')}</p>
  </div>
  {
    qs.map((n, i) => (
      <details class="item" data-rv style={`--d:${i * 0.05}s`}>
        <summary>
          <span class="idx x-mono">Q{n}</span>
          <span class="q">{t(`faq.q${n}`)}</span>
          <span class="mark x-mono" aria-hidden="true">+</span>
        </summary>
        <p class="x-mono">{t(`faq.a${n}`)}</p>
      </details>
    ))
  }
  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
</section>

<style>
  .faq-sec {
    padding: 0 var(--x-pad);
  }
  .faq-sec > * {
    max-width: calc(1100 * var(--uc));
  }
  .head {
    margin-bottom: max(48px, calc(120 * var(--u)));
  }
  .lab {
    color: var(--x-ink);
    margin: 0;
    min-height: 1.2em;
  }
  .item {
    border-top: 1px solid var(--x-line-dark);
  }
  .item:last-of-type {
    border-bottom: 1px solid var(--x-line-dark);
  }
  .item summary {
    cursor: pointer;
    min-height: calc(60 * var(--uc));
    display: flex;
    align-items: center;
    gap: clamp(14px, 2vw, calc(28 * var(--uc)));
    list-style: none;
    padding: calc(12 * var(--uc)) 0;
  }
  .item summary::-webkit-details-marker {
    display: none;
  }
  .idx {
    color: var(--x-dark-cap);
    font-weight: 400;
    flex: 0 0 calc(30 * var(--uc));
  }
  .q {
    font-family: var(--x-font-display);
    font-size: max(18px, calc(24 * var(--u)));
    font-weight: 400;
    letter-spacing: -0.02em;
    color: var(--x-ink);
    flex: 1;
    line-height: 1.25;
    text-wrap: balance;
  }
  .mark {
    color: var(--x-accent-ink); /* R30:与信任区手风琴记号统一档 */
    font-weight: 400;
    position: relative;
  }
  .item[open] .mark {
    visibility: hidden;
  }
  .item[open] .mark::after {
    content: '−';
    visibility: visible;
    position: absolute;
    left: 0;
    color: var(--x-accent-ink);
  }
  .item p {
    color: var(--x-dark-cap);
    margin: 0 0 calc(20 * var(--uc)) calc(calc(30 * var(--uc)) + clamp(14px, 2vw, calc(28 * var(--uc))));
    max-width: calc(760 * var(--uc));
    text-wrap: pretty;
    line-height: 1.45;
  }
</style>
