---
/* [FEAT-WEB03] 实时平台数字条 — 五数字进视口 count-up;snapshot/sse 双模(lib/stats.ts 契约)。
   axiom 方向:全出血暗带 + display 大数字 + 等宽大写标签 + 序号。逻辑不变。
   R45:数字千分位随语言(B8);有动效时注册即归零(此前 SSR 终值先淡入再跳回 0 重数)。 */
import { useT, type Locale } from '../i18n';
import { daysSince } from '../../schema/src/stats-growth';
import { STATS_SNAPSHOT, STATS_SNAPSHOT_AT, STATS_GROWTH, statsMode, fmtStat, localeTag } from '../lib/stats';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useT(locale);
const mode = statsMode();
/* 构建期已经把「起算日 → 构建那天」这段增长算进 STATS_SNAPSHOT 了。
   页内脚本要反推基准值,就得知道构建时算了多少天 —— 否则它会在已增长的值上再加一遍。 */
const BUILT_DAYS = STATS_GROWTH ? daysSince(STATS_GROWTH.since, Date.now()) : 0;
const items = [
  { key: 'activeDevices', label: t('stats.activeDevices'), value: STATS_SNAPSHOT.activeDevices, decimals: 0 },
  { key: 'activeJobs', label: t('stats.activeJobs'), value: STATS_SNAPSHOT.activeJobs, decimals: 0 },
  { key: 'nodes', label: t('stats.nodes'), value: STATS_SNAPSHOT.nodes, decimals: 0 },
  { key: 'countries', label: t('stats.countries'), value: STATS_SNAPSHOT.countries, decimals: 0 },
  { key: 'uptime', label: t('stats.uptime'), value: STATS_SNAPSHOT.uptime, decimals: 1, suffix: '%' },
];
---

<section
  class="stats"
  id="stats"
  data-mode={mode}
  data-locale={localeTag(locale)}
  data-sse-url={mode === 'sse' ? import.meta.env.PUBLIC_STATS_URL : undefined}
>
  <div class="grid x-tile x-tile-clear">
    {
      items.map((it, i) => (
        <div class="cell" data-rv style={`--d:${i * 0.08}s`}>
          <span class="idx x-mono">{String(i + 1).padStart(2, '0')}</span>
          <span
            class="num"
            data-key={it.key}
            data-target={it.value}
            data-decimals={it.decimals}
            data-suffix={it.suffix ?? ''}
            data-built-days={BUILT_DAYS}
          >
            {fmtStat(it.value, it.decimals, locale)}{it.suffix ?? ''}
          </span>
          <span class="label x-label">{it.label}</span>
        </div>
      ))
    }
  </div>
  {mode === 'snapshot' && <p class="asof x-mono">{t('stats.asOf')} {STATS_SNAPSHOT_AT}</p>}
</section>

{
  /* 🔴 静态产物只会停在**构建那一刻**,所以日期漂移在页内补(主人 2026-09-01 拍板:
     数字全后台模拟、不接真实数据,但要有线性增长)。
     公式与构建期用的是 schema 里同一份(`grownValue`),这里内联展开成三行算术 ——
     零依赖、零框架,和站上那段埋点脚本同体例。
     顺序要紧:必须跑在 count-up 之前改 `data-target`,否则数字会先数到旧值再跳一下。
     脚本没跑(禁用 JS / 出错)时页面保留构建期的值 —— 旧一点,但不会空、不会错位。 */
  STATS_GROWTH && (
    <script
      is:inline
      define:vars={{ since: STATS_GROWTH.since, daily: STATS_GROWTH.daily, tag: localeTag(locale) }}
    >
      (function () {
        var t0 = Date.parse(since + 'T00:00:00Z');
        if (!isFinite(t0)) return;
        var days = Math.max(0, Math.floor((Date.now() - t0) / 86400000));
        document.querySelectorAll('#stats .num[data-key]').forEach(function (el) {
          var per = daily[el.dataset.key];
          if (!per) return;
          // data-target 上现在是「构建那天」的值 —— 反推基准值再按今天重算,不做二次累加
          var built = Number(el.dataset.target);
          var builtDays = Number(el.dataset.builtDays || 0);
          var base = built - per * builtDays;
          var now = Math.round(base + per * days);
          if (now === built) return;
          el.dataset.target = String(now);
          el.textContent = now.toLocaleString(tag) + (el.dataset.suffix || '');
        });
      })();
    </script>
  )
}

<style>
  .stats {
    position: relative;
    z-index: 1;
    padding: calc(54 * var(--uc)) var(--x-pad);
  }
  /* R48 换皮:开放五列装进一条玻璃横带(结构与数字逻辑不动,只换表面)。
     R48.7:x-tile-clear 清透膜(主人拍板把「返回首页」那种不磨砂的透亮观感转正为默认)。 */
  .grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: calc(24 * var(--uc));
    padding: calc(30 * var(--uc)) calc(14 * var(--uc));
  }
  .cell {
    display: grid;
    gap: calc(8 * var(--uc));
    justify-items: start;
    border-left: 1px solid var(--x-line-soft);
    padding-left: calc(24 * var(--uc));
  }
  .cell:first-child {
    border-left: 0; /* 带内首格不再画左线(带边框已是边界) */
  }
  .idx {
    color: var(--x-accent-hot); /* 黑底编号走亮柠檬热档(R38 换系后正名,原注「亮金」为琥珀时代残留) */
  }
  .num {
    font-family: var(--x-font-display);
    font-size: max(30px, calc(54 * var(--u)));
    font-weight: 500;
    color: var(--x-white);
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.02em;
    line-height: 1;
  }
  .label {
    color: var(--x-ink-dim);
    text-wrap: pretty;
  }
  .asof {
    color: var(--x-ink-dim);
    margin: calc(26 * var(--uc)) 0 0;
  }
  @media (max-width: 900px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: calc(32 * var(--uc));
    }
    .grid .cell:last-child {
      grid-column: 1 / -1;
    }
  }
</style>

<script>
  // count-up(进视口一次)+ SSE 热更新(mode=sse 时)。数值格式与服务端 fmtStat 同语义(含语言千分位)。
  const root = document.getElementById('stats');
  const nums = [...(root?.querySelectorAll<HTMLElement>('.num') ?? [])];
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const tag = root?.dataset.locale || 'en-US';

  const fmt = (n: number, d: number) =>
    n >= 999_500
      ? `${(n / 1_000_000).toLocaleString(tag, { minimumFractionDigits: 2, maximumFractionDigits: 2 })}M`
      : n >= 99_950
        ? `${(n / 1_000).toLocaleString(tag, { minimumFractionDigits: 1, maximumFractionDigits: 1 })}K`
        : n.toLocaleString(tag, { minimumFractionDigits: d, maximumFractionDigits: d });

  const render = (el: HTMLElement, v: number) => {
    el.textContent = fmt(v, Number(el.dataset.decimals || 0)) + (el.dataset.suffix || '');
  };

  if (!reduced && nums.length) {
    /* R49-D4「任何一帧都是海报」:起点 0 曾让快滚用户只带走一屏「0 设备/0 国家」(截图包实证);
       起点改 70% 终值、时长 1200→800——中间帧永远是像样的数字 */
    for (const el of nums) render(el, Number(el.dataset.target) * 0.7);
    const io = new IntersectionObserver(
      ([e]) => {
        if (!e.isIntersecting) return;
        io.disconnect();
        const t0 = performance.now();
        const DUR = 800;
        const tick = (now: number) => {
          const p = Math.min(1, (now - t0) / DUR);
          const ease = 1 - Math.pow(1 - p, 3);
          for (const el of nums) render(el, Number(el.dataset.target) * (0.7 + 0.3 * ease));
          if (p < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      },
      { threshold: 0.4 },
    );
    io.observe(root!);
  }

  // SSE 热更新:断连静默重试交给 EventSource 自身;数据坏(非有限数)忽略该字段(宁旧勿假)
  if (root?.dataset.mode === 'sse' && root.dataset.sseUrl) {
    try {
      const es = new EventSource(root.dataset.sseUrl);
      es.onmessage = (ev) => {
        try {
          const data: unknown = JSON.parse(ev.data);
          if (typeof data !== 'object' || data === null) return;
          for (const el of nums) {
            const v = (data as Record<string, unknown>)[el.dataset.key || ''];
            if (typeof v === 'number' && Number.isFinite(v)) {
              el.dataset.target = String(v);
              render(el, v);
            }
          }
        } catch {
          /* 坏帧忽略,保留旧值 */
        }
      };
    } catch {
      /* EventSource 不可用 → 保持快照 */
    }
  }
</script>
