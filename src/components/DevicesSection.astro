---
/* [FEAT-WEB06] 设备阶梯 — 预热面纯展示(不承载购买);🔴 卡上无任何收益金额,
   只展示价格与算力倍数(事实性);legacy=Classic 角标;板块尾统一下载 CTA。 */
import { useT, type Locale } from '../i18n';
import { SKUS, fmtPrice, fmtMultiplier } from '../lib/skus';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useT(locale);
---

<section class="devices" id="devices">
  <h2 class="title">{t('devices.title')}</h2>
  <p class="sub">{t('devices.subtitle')}</p>
  <div class="rail" role="list">
    {
      SKUS.map((s) => (
        <article class="card" class:list={[{ coming: s.status === 'coming' }]} role="listitem">
          {s.status === 'legacy' && <span class="chip">{t('devices.classicBadge')}</span>}
          {s.status === 'coming' && <span class="chip coming-chip">{t('devices.comingBadge')}</span>}
          <h3>{s.name}</h3>
          <p class="price">{s.free ? t('devices.free') : fmtPrice(s.priceUSD)}</p>
          <p class="mult">
            <span class="mult-num">{fmtMultiplier(s.multiplier)}</span> {t('devices.multiplierLabel')}
          </p>
          <p class="tag">{t(`devices.tagline.${s.id}`)}</p>
        </article>
      ))
    }
  </div>
  <div class="cta-row">
    <a class="pill primary" href="#download">{t('devices.cta')}</a>
  </div>
</section>

<style>
  .devices {
    max-width: var(--w-content-max);
    margin: 0 auto;
    padding: var(--w-space-section) 20px 0;
  }
  .title {
    font-size: clamp(24px, 3vw, 30px);
    font-weight: 600;
    color: var(--v5-ink);
    margin: 0 0 8px;
    text-align: center;
    text-wrap: balance;
  }
  .sub {
    color: var(--v5-ink-3);
    font-size: 14px;
    text-align: center;
    margin: 0 0 26px;
    text-wrap: pretty;
  }
  .rail {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(196px, 1fr);
    gap: 14px;
    overflow-x: auto;
    padding-bottom: 10px;
    scroll-snap-type: x proximity;
    /* 滚动阴影提示(320px 横滑,PRD ⑤ 极限) */
    background:
      linear-gradient(90deg, var(--v5-bg) 30%, transparent) left/40px 100% no-repeat local,
      linear-gradient(270deg, var(--v5-bg) 30%, transparent) right/40px 100% no-repeat local;
  }
  .card {
    background: var(--v5-surface);
    border-radius: var(--w-radius-card);
    padding: 22px 20px;
    display: grid;
    gap: 6px;
    align-content: start;
    scroll-snap-align: start;
    position: relative;
  }
  .card.coming {
    opacity: 0.6;
  }
  .chip {
    justify-self: start;
    font-size: 10.5px;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--v5-ink-3);
    background: var(--v5-surface-2);
    border-radius: var(--w-radius-pill);
    padding: 3px 10px;
  }
  .coming-chip {
    color: var(--v5-warning);
    background: var(--v5-warning-soft);
  }
  h3 {
    font-size: 15px;
    font-weight: 600;
    color: var(--v5-ink);
    margin: 4px 0 0;
    text-wrap: balance;
  }
  .price {
    font-size: 20px;
    font-weight: 600;
    color: var(--v5-ink);
    margin: 0;
    font-variant-numeric: tabular-nums;
  }
  .mult {
    margin: 0;
    color: var(--v5-ink-3);
    font-size: 12.5px;
  }
  .mult-num {
    color: var(--v5-brand);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .tag {
    color: var(--v5-ink-3);
    font-size: 12.5px;
    margin: 4px 0 0;
    text-wrap: pretty;
  }
  .cta-row {
    text-align: center;
    margin-top: 26px;
  }
  .pill {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    padding: 0 26px;
    border-radius: var(--w-radius-pill);
    font-size: 15px;
    font-weight: 600;
    text-decoration: none;
    transition:
      transform 0.15s,
      opacity 0.15s;
  }
  .pill.primary {
    background: var(--v5-brand);
    color: var(--v5-on-brand);
  }
  .pill:active {
    transform: scale(0.98);
    opacity: 0.85;
  }
  .pill:focus-visible {
    outline: 2px solid var(--v5-brand);
    outline-offset: 2px;
  }
</style>
