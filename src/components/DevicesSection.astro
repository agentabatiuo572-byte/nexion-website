---
/* [FEAT-WEB06] 设备阶梯 — 预热面纯展示(不承载购买);🔴 卡上无任何收益金额,
   只展示价格与算力倍数(事实性);legacy=Classic 角标。
   axiom 方向:pinned 横向轨(fx.ts ⑥;移动/reduced 原生横滑),
   暗底上的反白 SKU 卡 + NX 序号。 */
import { useT, type Locale } from '../i18n';
import { SKUS, fmtPrice, fmtMultiplier } from '../lib/skus';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useT(locale);
---

<section class="devices" id="devices" data-rail>
  <div class="pin">
    <div class="head">
      <span class="x-label lab" data-rv>{t('devices.title')}</span>
      <p class="sub x-mono" data-rv style="--d:.1s">{t('devices.subtitle')}</p>
    </div>
    <div class="track" data-rail-track role="list">
      {
        SKUS.map((s, i) => (
          <article class="card" class:list={[{ coming: s.status === 'coming' }]} role="listitem">
            <div class="top">
              <span class="serial x-mono">NX-{String(i + 1).padStart(2, '0')}</span>
              {s.status === 'legacy' && <span class="chip x-mono">{t('devices.classicBadge')}</span>}
              {s.status === 'coming' && <span class="chip x-mono">{t('devices.comingBadge')}</span>}
            </div>
            <h3>{s.name}</h3>
            <p class="price">{s.free ? t('devices.free') : fmtPrice(s.priceUSD)}</p>
            <p class="mult x-mono">
              <b>{fmtMultiplier(s.multiplier)}</b> {t('devices.multiplierLabel')}
            </p>
            <p class="tag x-mono">{t(`devices.tagline.${s.id}`)}</p>
          </article>
        ))
      }
      <div class="cta-card">
        <a class="xbtn solid" href="#download">
          <span class="xbtn-ghost">{t('devices.cta')} <span class="arr">→</span></span>
          <span class="xbtn-a">{t('devices.cta')} <span class="arr">→</span></span>
          <span class="xbtn-b">{t('devices.cta')} <span class="arr">→</span></span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .devices {
    position: relative;
    z-index: 1;
  }
  .pin {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: clamp(26px, 4vh, 48px);
    padding: 90px 0 40px;
  }
  /* fx.ts 激活横向轨(desktop):pin 钉满一屏,track 由 transform 驱动 */
  .devices:global(.railed) .pin {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: hidden;
  }
  .head {
    padding: 0 var(--x-pad);
    display: grid;
    gap: 10px;
  }
  .lab {
    color: var(--x-white);
  }
  .sub {
    color: var(--x-ink-dim);
    margin: 0;
    max-width: 520px;
    text-wrap: pretty;
  }
  .track {
    display: flex;
    gap: clamp(14px, 1.6vw, 24px);
    padding: 0 var(--x-pad) 14px;
    overflow-x: auto;
    scroll-snap-type: x proximity;
    will-change: transform;
  }
  .devices:global(.railed) .track {
    overflow: visible;
    scroll-snap-type: none;
    width: max-content;
  }
  .card {
    flex: 0 0 clamp(280px, 26vw, 380px);
    background: var(--x-light);
    color: var(--x-dark);
    padding: clamp(20px, 2vw, 30px);
    display: grid;
    gap: 10px;
    align-content: start;
    min-height: clamp(320px, 46vh, 430px);
    scroll-snap-align: start;
  }
  .card.coming {
    opacity: 0.66;
  }
  .top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
  }
  .serial {
    color: var(--x-dark-dim);
    font-weight: 700;
  }
  .chip {
    font-weight: 700;
    background: var(--x-accent);
    color: var(--x-on-accent);
    padding: 1px 7px;
  }
  .card h3 {
    font-family: var(--x-font-display);
    font-size: clamp(24px, 2.3vw, 32px);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.08;
    color: var(--x-dark);
    margin: 0;
    text-wrap: balance;
  }
  .price {
    font-family: var(--x-font-display);
    font-size: clamp(20px, 1.9vw, 26px);
    font-weight: 500;
    color: var(--x-dark);
    margin: 0;
    font-variant-numeric: tabular-nums;
  }
  .mult {
    margin: 2px 0 0;
    color: var(--x-dark-dim);
  }
  .mult b {
    color: var(--x-accent);
    font-weight: 700;
    white-space: nowrap;
  }
  .tag {
    margin: auto 0 0;
    padding-top: 16px;
    color: var(--x-dark-dim);
    border-top: 1px solid var(--x-line-dark);
    text-wrap: pretty;
  }
  .cta-card {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    padding: 0 clamp(20px, 4vw, 80px);
  }

  @media (max-width: 860px) {
    .pin {
      padding-top: 60px;
    }
    .card {
      flex-basis: 82vw;
      min-height: 340px;
    }
  }
</style>
