---
/* [FEAT-WEB06] 设备叠卡 — R8(画布 1440 等比,几何全对齐):
   钉屏高 --x-sec-h;卡锚位 left 27.43% / top 16.63%,卡宽 45.14%、比例 650/534;
   卡=浅框内衬(10/10/20)+ 白底图区 + 序号章切口 + 标题 40 档 + 双列 12 mono;
   区头=左 gutter:16 mono 打字机标题 + 12 mono 副题 + CTA(钉屏全程可见);
   移动/coarse/reduced 兜底:全部卡竖向依次排开(520 宽)。
   🔴 卡上无任何收益金额,只展示价格与算力倍数(事实性)。 */
import { useT, type Locale } from '../i18n';
import { SKUS, fmtPrice, fmtMultiplier } from '../lib/skus';
import { contour } from '../lib/contour';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useT(locale);

// App product-card.vue PRODUCT_PHOTO 映射的官网镜像(pro 复用 pro-v2 图、p2 复用 p1 图,同 App)
const PHOTO: Record<string, string | undefined> = {
  phone: '/devices/phone.png',
  's1': '/devices/s1.jpg',
  'pro': '/devices/pro.jpg',
  'pro-v2': '/devices/pro.jpg',
  'rack-p1': '/devices/rack.jpg',
  'rack-p2': '/devices/rack.jpg',
};
const shareArt = contour(77, 12, 640, 400);
---

<section class="devices" id="devices" data-deck>
  <div class="pin" data-deck-pin>
    <div class="gutter">
      <h2 class="lab x-mono-lg" data-tw>{t('devices.title')}</h2>
      <p class="sub x-mono">{t('devices.subtitle')}</p>
      <a class="xbtn solid on-dark cta" href="#download">
        <span class="xbtn-ghost">{t('devices.cta')} <span class="arr">→</span></span>
        <span class="xbtn-a">{t('devices.cta')} <span class="arr">→</span></span>
        <span class="xbtn-b">{t('devices.cta')} <span class="arr">→</span></span>
      </a>
    </div>

    <div class="stage">
      {
        SKUS.map((s, i) => (
          <article class="card x-paper" class:list={[{ coming: s.status === 'coming' }]} data-deck-card style={`--i:${i}`}>
            <div class="media">
              {PHOTO[s.id] ? (
                <img src={PHOTO[s.id]} alt={s.name} loading="lazy" width="960" height="640" />
              ) : (
                <svg viewBox={shareArt.viewBox} preserveAspectRatio="xMidYMid slice" aria-hidden="true">
                  {shareArt.paths.map((d) => (
                    <path d={d} fill="none" stroke="var(--x-dark)" stroke-width="1" opacity="0.5" />
                  ))}
                </svg>
              )}
              <span class="serial x-mono" data-tw>NX-{String(i + 1).padStart(2, '0')}</span>
              {s.status === 'legacy' && <span class="chip x-mono">{t('devices.classicBadge')}</span>}
              {s.status === 'coming' && <span class="chip x-mono">{t('devices.comingBadge')}</span>}
            </div>
            <div class="body">
              <h3>{s.name}</h3>
              <div class="cols">
                <p class="col x-mono">
                  <b class="price">{s.free ? t('devices.free') : fmtPrice(s.priceUSD)}</b>
                  <span class="mult">
                    <b>{fmtMultiplier(s.multiplier)}</b> {t('devices.multiplierLabel')}
                  </span>
                </p>
                <p class="col x-mono">{t(`devices.tagline.${s.id}`)}</p>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .devices {
    position: relative;
    z-index: 1;
  }

  /* —— 静态兜底(移动/coarse/reduced/无 JS):区头在上,卡竖向依次排开 —— */
  .pin {
    display: flex;
    flex-direction: column;
    padding: 60px var(--x-pad) 100px;
    gap: clamp(40px, 6vw, 80px);
  }
  .gutter {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
  }
  .lab {
    color: var(--x-white);
    margin: 0;
    min-height: 1.2em;
  }
  .sub {
    color: var(--x-ink-dim);
    margin: 0;
    max-width: 340px;
    text-wrap: pretty;
    line-height: 1.5;
  }
  .cta {
    margin-top: 10px;
  }
  /* R30:CTA 恒柠檬 solid,on-dark 白底覆写撤销 */
  .stage {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(48px, 8vw, 80px);
  }

  /* —— 卡:浅框内衬(10/10/20)+ 白底图区 + 图下文块 —— */
  .card {
    width: min(520px, 100%);
    aspect-ratio: 650 / 534;
    padding: 10px 10px 20px;
    display: flex;
    flex-direction: column;
    gap: 20px;
    box-sizing: border-box;
  }
  .card.coming .body {
    opacity: 0.66;
  }
  .media {
    position: relative;
    flex: 1;
    min-height: 0;
    background: var(--x-white);
    overflow: hidden;
  }
  .media img,
  .media svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  /* 序号章贴死图区左上角,与卡框同底色成「切口」 */
  .serial {
    position: absolute;
    top: 0;
    left: 0;
    background: var(--x-light);
    color: var(--x-dark);
    font-weight: 400;
    font-size: 16px;
    letter-spacing: -0.36px;
    min-width: 5ch;
    padding: 10px;
    text-align: center;
  }
  .chip {
    position: absolute;
    top: 10px;
    right: 10px;
    font-weight: 700;
    /* R35:章底改不透明浅面(soft 半透明底在深色产品照上会隐没)——
       非满饱和柠檬不稀释转化件,与序号章同族浅面体例 */
    background: var(--x-light);
    color: var(--x-accent-ink);
    padding: 3px 9px;
  }
  .body {
    flex: 0 0 auto;
    padding: 0 10px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: clamp(16px, 2.5vw, 48px);
  }
  h3 {
    font-family: var(--x-font-display);
    font-size: clamp(24px, 2.78vw, 53px);
    font-weight: 400;
    letter-spacing: -0.03em;
    line-height: 1;
    color: var(--x-ink);
    margin: 0;
    text-wrap: balance;
  }
  .cols {
    display: flex;
    gap: 20px;
    width: 100%;
    align-items: flex-start;
  }
  .col {
    flex: 1;
    min-width: 0;
    margin: 0;
    color: var(--x-ink-cap);
    text-wrap: pretty;
  }
  .price {
    display: block;
    font-family: var(--x-font-display);
    font-size: clamp(17px, 1.4vw, 27px);
    font-weight: 500;
    color: var(--x-ink);
    font-variant-numeric: tabular-nums;
    margin-bottom: 4px;
  }
  .mult b {
    color: var(--x-accent-ink);
    font-weight: 700;
    white-space: nowrap;
  }

  /* —— decked 桌面编舞(fx.ts 置 .decked):画布几何,卡绝对锚位,fx 写 transform —— */
  .devices:global(.decked) .pin {
    position: sticky;
    top: 0;
    height: var(--x-sec-h);
    padding: 0;
    overflow: hidden;
    box-sizing: border-box;
    display: block;
  }
  .devices:global(.decked) .gutter {
    position: absolute;
    left: var(--x-pad);
    top: 18.4%;
    width: calc(27.4% - var(--x-pad) - 20px);
    z-index: 20;
  }
  .devices:global(.decked) .stage {
    position: absolute;
    inset: 0;
    display: block;
  }
  .devices:global(.decked) .card {
    position: absolute;
    left: 27.43%;
    top: 16.63%;
    width: 45.14%;
    z-index: calc(1 + var(--i));
    transform: translate3d(160vw, 0, 0);
    will-change: transform;
  }

  @media (max-width: 860px) {
    .pin {
      padding-top: 50px;
      padding-bottom: 80px;
    }
    .stage {
      gap: clamp(40px, 9vw, 60px);
    }
  }
</style>
