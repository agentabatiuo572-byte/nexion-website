---
/* [FEAT-WEB06] 设备叠卡 — R8(画布 1440 等比,几何全对齐):
   钉屏高 --x-sec-h;卡锚位 left 27.43% / top 16.63%,卡宽 45.14%、比例 650/534;
   卡=浅框内衬(10/10/20)+ 白底图区 + 序号章切口 + 标题 40 档 + 双列 12 mono;
   区头=左 gutter:16 mono 打字机标题 + 12 mono 副题 + CTA(钉屏全程可见);
   移动/coarse/reduced 兜底:全部卡竖向依次排开(520 宽)。
   R45:序号章脱离全局 .x-mono(zh 曾被压成 12.5/1.6),5ch 最小宽算上内衬;phone 图白底对白底改 contain 整机可见(B9 过渡);
   桌面编舞卡图 eager 由 fx 负责;数字格式随语言(B8)。
   🔴 卡上无任何收益金额,只展示价格与算力倍数(事实性)。 */
import { useT, type Locale } from '../i18n';
import { SKUS, fmtPrice, fmtMultiplier } from '../lib/skus';
import { contour } from '../lib/contour';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useT(locale);

// App product-card.vue PRODUCT_PHOTO 映射的官网镜像(pro 复用 pro-v2 图、p2 复用 p1 图,同 App)
const PHOTO: Record<string, string | undefined> = {
  phone: '/devices/phone.png',
  's1': '/devices/s1.jpg',
  'pro': '/devices/pro.jpg',
  'pro-v2': '/devices/pro.jpg',
  'rack-p1': '/devices/rack.jpg',
  'rack-p2': '/devices/rack.jpg',
};
/* 正方形白底产品图(手机)cover 会切掉上下 42%——白底对白底,contain 整机可见;黑底摄影图保持 cover */
const CONTAIN = new Set(['phone']);
const shareArt = contour(77, 12, 640, 400);
---

<section class="devices" id="devices" data-deck>
  <div class="pin" data-deck-pin>
    <div class="gutter">
      <h2 class="lab x-mono-lg" data-tw>{t('devices.title')}</h2>
      <p class="sub x-mono">{t('devices.subtitle')}</p>
      <a class="xbtn solid on-dark cta" href="#download">
        <span class="xbtn-ghost" aria-hidden="true">{t('devices.cta')} <span class="arr">→</span></span>
        <span class="xbtn-a">{t('devices.cta')} <span class="arr">→</span></span>
        <span class="xbtn-b" aria-hidden="true">{t('devices.cta')} <span class="arr">→</span></span>
      </a>
    </div>

    <div class="stage">
      {
        SKUS.map((s, i) => (
          <article class="card x-paper" class:list={[{ coming: s.status === 'coming' }]} data-deck-card style={`--i:${i}`}>
            <div class="media">
              {PHOTO[s.id] ? (
                <img src={PHOTO[s.id]} alt={s.name} loading="lazy" width="960" height="640" class:list={[{ contain: CONTAIN.has(s.id) }]} />
              ) : (
                <svg viewBox={shareArt.viewBox} preserveAspectRatio="xMidYMid slice" aria-hidden="true">
                  {shareArt.paths.map((d) => (
                    <path d={d} fill="none" stroke="var(--x-dark)" stroke-width="1" opacity="0.5" />
                  ))}
                </svg>
              )}
              <span class="serial" data-tw>NX-{String(i + 1).padStart(2, '0')}</span>
              {s.status === 'legacy' && <span class="chip x-mono">{t('devices.classicBadge')}</span>}
              {s.status === 'coming' && <span class="chip x-mono">{t('devices.comingBadge')}</span>}
            </div>
            <div class="body">
              <h3>{s.name}</h3>
              <div class="cols">
                <p class="col x-mono">
                  <b class="price">{s.free ? t('devices.free') : fmtPrice(s.priceUSD)}</b>
                  <span class="mult">
                    <b>{fmtMultiplier(s.multiplier, locale)}</b> {t('devices.multiplierLabel')}
                  </span>
                </p>
                <p class="col x-mono">{t(`devices.tagline.${s.id}`)}</p>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .devices {
    position: relative;
    z-index: 1;
  }

  /* —— 静态兜底(移动/coarse/reduced/无 JS):区头在上,卡竖向依次排开 —— */
  .pin {
    display: flex;
    flex-direction: column;
    padding: clamp(40px, 9vw, calc(60 * var(--uc))) var(--x-pad) calc(100 * var(--uc));
    gap: clamp(40px, 6vw, calc(80 * var(--uc)));
  }
  .gutter {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: calc(14 * var(--uc));
  }
  .lab {
    color: var(--x-white);
    margin: 0;
    min-height: 1.2em;
  }
  .sub {
    color: var(--x-ink-dim);
    margin: 0;
    max-width: calc(340 * var(--uc));
    text-wrap: pretty;
    line-height: 1.5;
  }
  .cta {
    margin-top: calc(10 * var(--uc));
  }
  /* R30:CTA 恒柠檬 solid,on-dark 白底覆写撤销 */
  /* 🔴 静态兜底档改栅格,不再是一根竖列:竖列在 1440 上是 515 宽居中、左右各空 455px 全黑,
     7 张卡把这一段撑到 3848px(全页 29%)。这一档服务的是「减少动态 / coarse / 无 JS」,
     不是只服务手机 —— 桌面上开了「减少动态」的人看到的就是这个塌掉的版本。
     auto-fit + minmax 让列数由可用宽自己算:窄屏仍是一列,不需要另写断点。 */
  .stage {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(calc(360 * var(--uc)), calc(520 * var(--uc))));
    justify-content: center;
    align-items: start;
    gap: clamp(48px, 8vw, calc(80 * var(--uc)));
  }

  /* —— 卡:浅框内衬(10/10/20)+ 白底图区 + 图下文块 —— */
  .card {
    width: min(calc(520 * var(--uc)), 100%);
    aspect-ratio: 650 / 534;
    padding: calc(10 * var(--uc)) calc(10 * var(--uc)) calc(20 * var(--uc));
    display: flex;
    flex-direction: column;
    gap: calc(20 * var(--uc));
    box-sizing: border-box;
  }
  .card.coming .body {
    opacity: 0.66;
  }
  .media {
    position: relative;
    flex: 1;
    min-height: 0;
    background: var(--x-white);
    overflow: hidden;
  }
  .media img,
  .media svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .media img.contain {
    object-fit: contain;
  }
  /* 序号章贴死图区左上角,与卡框同底色成「切口」。
     不挂 .x-mono:全局 zh 覆写(12.5/1.6)曾压过本规则,章是 ASCII 编号,不该吃 CJK 豁免 */
  .serial {
    position: absolute;
    top: 0;
    left: 0;
    background: var(--x-light);
    color: var(--x-dark);
    font-family: var(--x-font-mono);
    font-weight: 400;
    font-size: calc(16 * var(--uc));
    line-height: 1.2; /* 等宽零字距是仓规(tokens.css 三处型类都是 0);此前 −0.36 让 16 档有两套字身格,与 .x-mono-lg 同屏 */
    text-transform: uppercase;
    min-width: calc(5ch + 20 * var(--uc)); /* 5ch 是文字最小宽;border-box 下要算上两侧内衬 */
    padding: calc(10 * var(--uc));
    text-align: center;
  }
  .chip {
    position: absolute;
    top: calc(10 * var(--uc));
    right: calc(10 * var(--uc));
    font-weight: 400;
    /* R35:章底改不透明浅面(soft 半透明底在深色产品照上会隐没)——
       非满饱和柠檬不稀释转化件,与序号章同族浅面体例 */
    background: var(--x-light);
    color: var(--x-accent-ink);
    padding: calc(3 * var(--uc)) calc(9 * var(--uc));
  }
  .body {
    flex: 0 0 auto;
    padding: 0 calc(10 * var(--uc));
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: max(16px, calc(36 * var(--u)));
  }
  h3 {
    font-family: var(--x-font-display);
    font-size: max(24px, calc(40 * var(--u)));
    font-weight: 400;
    letter-spacing: -0.03em;
    line-height: 1;
    color: var(--x-ink);
    margin: 0;
    text-wrap: balance;
  }
  .cols {
    display: flex;
    gap: calc(20 * var(--uc));
    width: 100%;
    /* 站内「小号 mono + 大号 display 同排」一律 baseline(Mission / NexContent / LearnTeaser / LearnArticle);
       flex-start 让两列盒顶齐而基线差 8px,说明行整体浮高 */
    align-items: baseline;
  }
  .col {
    flex: 1;
    min-width: 0;
    margin: 0;
    color: var(--x-ink-cap);
    text-wrap: pretty;
  }
  .price {
    line-height: 1.2; /* zh 会继承 .x-mono:lang(zh) 的 CJK 1.6,卡片比 en/vi 高 8px */
    display: block;
    font-family: var(--x-font-display);
    font-size: max(17px, calc(20 * var(--u)));
    font-weight: 500;
    color: var(--x-ink);
    font-variant-numeric: tabular-nums;
    text-transform: none; /* 展示体价格不吃 .x-mono 的大写传染(「FREE」) */
    margin-bottom: calc(4 * var(--uc));
  }
  .mult b {
    color: var(--x-accent-ink);
    font-weight: 400;
    white-space: nowrap;
  }

  /* —— decked 桌面编舞(fx.ts 置 .decked):画布几何,卡绝对锚位,fx 写 transform —— */
  .devices:global(.decked) .pin {
    position: sticky;
    /* R45(主人 2026-08-26 拍板):改回**顶部定锚**,与参考站同口径 —— 卡顶恒在 141,
       屏比钉屏区高时多出来的高度全留在卡下方,而不是上下对半。
       R41 当初改居中是为了消掉屏底死区,但代价是卡顶随屏高漂(900 高屏 192、1300 高屏 407,差近半张卡);
       🔴 钉件 top 必须是 **0**:参考站的画布常数 133 是**卡自身**在钉件内的偏移(我方 .card 的 top:133.03 就是它),
       钉件本身贴屏顶。第一版把「141」当画布常数写在钉件上 —— 那 141 其实是参考站在 ~1520 宽窗口下
       **卡顶的屏幕像素**读数(133×1.06),既取错常数又加错位置,叠加后卡顶 =141+133=274 比参考站低 141,
       1366×700 / 1920×900 下品名、价格、倍率行被切在折叠线外且滚不进来。
       R41「卡片不紧贴导航条」的诉求由参考站自己的数字满足(74 高导航 + 59 空当)。
       仍然不改区高本身:pinH 一旦跟屏高走,叠卡节奏就会因屏而异,与「宽度驱动画布」冲突。 */
    top: 0;
    height: var(--x-sec-h);
    padding: 0;
    /* R39-fix:停放卡的横向裁切交给全宽壳 .x-frame 的 overflow-x:clip(裁在屏缘;Base.astro);
       此处再裁一次会把裁切边拉回画布边 = 卡在屏内硬边处凭空出现 */
    overflow: visible;
    box-sizing: border-box;
    display: block;
  }
  .devices:global(.decked) .gutter {
    position: absolute;
    left: var(--x-pad);
    top: 18.4%;
    width: calc(27.4% - var(--x-pad) - calc(20 * var(--uc)));
    z-index: 20;
  }
  .devices:global(.decked) .stage {
    position: absolute;
    inset: 0;
    display: block;
  }
  .devices:global(.decked) .card {
    position: absolute;
    left: 27.43%;
    top: 16.63%;
    width: 45.14%;
    z-index: calc(1 + var(--i));
    transform: translate3d(3000px, 0, 0); /* R42:画布内禁视口单位;停放位只需「足够远」,由 .x-frame 裁在屏缘 */
    will-change: transform;
  }

  @media (max-width: 860px) {
    .pin {
      padding-top: calc(50 * var(--uc));
      padding-bottom: calc(80 * var(--uc));
    }
    .stage {
      gap: clamp(40px, 9vw, calc(60 * var(--uc)));
    }
  }
</style>
