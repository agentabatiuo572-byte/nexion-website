---
/* [FEAT-WEB06] 设备阶梯 — 预热面纯展示(不承载购买);🔴 卡上无任何收益金额,
   只展示价格与算力倍数(事实性);legacy=Classic 角标。
   R4(主人依参考站卡板块截图定):横排轨道,多卡同屏、随滚动整排左移;
   卡=图上文下、序号章贴图角、底部两栏小字(R3 版式);CTA 钉在屏内不提前滚走;
   移动/reduced 原生横滑。产品图沿用 App 映射。 */
import { useT, type Locale } from '../i18n';
import { SKUS, fmtPrice, fmtMultiplier } from '../lib/skus';
import { contour } from '../lib/contour';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useT(locale);

// App product-card.vue PRODUCT_PHOTO 映射的官网镜像(pro 复用 pro-v2 图、p2 复用 p1 图,同 App)
const PHOTO: Record<string, string | undefined> = {
  phone: '/devices/phone.png',
  's1': '/devices/s1.jpg',
  'pro': '/devices/pro.jpg',
  'pro-v2': '/devices/pro.jpg',
  'rack-p1': '/devices/rack.jpg',
  'rack-p2': '/devices/rack.jpg',
};
const shareArt = contour(77, 12, 640, 400);
---

<section class="devices" id="devices" data-deck>
  <div class="pin" data-deck-pin>
    <div class="head">
      <span class="x-label lab" data-tw>{t('devices.title')}</span>
      <p class="sub x-mono" data-rv style="--d:.1s">{t('devices.subtitle')}</p>
    </div>

    <div class="viewport">
      <div class="track" data-deck-track>
        {
          SKUS.map((s, i) => (
            <article class="card x-paper" class:list={[{ coming: s.status === 'coming' }]} data-deck-card style={`--i:${i}`}>
              <div class="media">
                {PHOTO[s.id] ? (
                  <img src={PHOTO[s.id]} alt={s.name} loading="lazy" width="960" height="640" />
                ) : (
                  <svg viewBox={shareArt.viewBox} preserveAspectRatio="xMidYMid slice" aria-hidden="true">
                    {shareArt.paths.map((d) => (
                      <path d={d} fill="none" stroke="var(--x-accent)" stroke-width="1" opacity="0.45" />
                    ))}
                  </svg>
                )}
                <span class="serial x-mono" data-tw>NX-{String(i + 1).padStart(2, '0')}</span>
                {s.status === 'legacy' && <span class="chip x-mono">{t('devices.classicBadge')}</span>}
                {s.status === 'coming' && <span class="chip x-mono">{t('devices.comingBadge')}</span>}
              </div>
              <div class="body">
                <h3>{s.name}</h3>
                <div class="cols">
                  <div class="col x-mono">
                    <b class="price">{s.free ? t('devices.free') : fmtPrice(s.priceUSD)}</b>
                    <span class="mult">
                      <b>{fmtMultiplier(s.multiplier)}</b> {t('devices.multiplierLabel')}
                    </span>
                  </div>
                  <p class="col tagcol x-mono">{t(`devices.tagline.${s.id}`)}</p>
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </div>

    <div class="cta-row" data-rv>
      <a class="xbtn solid on-dark" href="#download">
        <span class="xbtn-ghost">{t('devices.cta')} <span class="arr">→</span></span>
        <span class="xbtn-a">{t('devices.cta')} <span class="arr">→</span></span>
        <span class="xbtn-b">{t('devices.cta')} <span class="arr">→</span></span>
      </a>
    </div>
  </div>
</section>

<style>
  .devices {
    position: relative;
    z-index: 1;
  }
  .pin {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: clamp(18px, 3vh, 30px);
    padding: 90px var(--x-pad) 26px;
    min-height: 86svh;
  }
  .devices:global(.decked) .pin {
    position: sticky;
    top: 0;
    height: 100svh;
    min-height: 0;
    overflow: hidden;
    box-sizing: border-box;
  }
  .head {
    border-top: 1px solid var(--x-line);
    padding-top: 18px;
    display: grid;
    gap: 10px;
  }
  .lab {
    color: var(--x-white);
  }
  .sub {
    color: var(--x-ink-dim);
    margin: 0;
    max-width: 520px;
    text-wrap: pretty;
  }

  /* —— 轨道:默认原生横滑(移动/reduced/无 JS);decked 后由 fx 平移 —— */
  .viewport {
    margin: 0 calc(-1 * var(--x-pad));
    overflow-x: auto;
    scroll-snap-type: x proximity;
    padding: 0 var(--x-pad);
  }
  .devices:global(.decked) .viewport {
    overflow: visible;
    scroll-snap-type: none;
    flex: 1;
    min-height: 0;
    position: relative;
  }
  .track {
    display: flex;
    align-items: stretch;
    gap: clamp(20px, 2.6vw, 44px);
    width: max-content;
  }
  /* 收叠编舞(fx.ts initPile):卡绝对定位于同一锚位,层级按序号,
     进场偏移与缩放全由 JS 写 transform(初始置于场外右) */
  .devices:global(.decked) .track {
    display: block;
    width: auto;
    height: 100%;
    position: relative;
  }
  .devices:global(.decked) .card {
    position: absolute;
    left: clamp(120px, 26vw, 460px);
    top: 52%;
    width: min(45vw, 660px);
    z-index: calc(1 + var(--i));
    transform: translate3d(120vw, -50%, 0);
    will-change: transform;
  }

  /* —— 卡:图上文下(R3 版式),x-paper 自动纸面配色 —— */
  .card {
    flex: 0 0 min(40vw, 640px);
    display: grid;
    grid-template-rows: auto 1fr;
    scroll-snap-align: start;
  }
  .card.coming .body {
    opacity: 0.66;
  }
  .media {
    position: relative;
    aspect-ratio: 13 / 7;
    background: var(--x-bg);
    overflow: hidden;
  }
  .media img,
  .media svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  /* 序号章贴死图区左上角,与卡框同底色成「切口」(P2-23) */
  .serial {
    position: absolute;
    top: 0;
    left: 0;
    background: var(--x-light);
    color: var(--x-dark);
    font-weight: 400;
    font-size: 16px;
    letter-spacing: -0.36px;
    min-width: 5ch;
    padding: 10px;
  }
  .chip {
    position: absolute;
    top: 10px;
    right: 10px;
    font-weight: 700;
    background: var(--x-accent);
    color: var(--x-on-accent);
    padding: 3px 9px;
  }
  .body {
    padding: 20px 10px;
    display: grid;
    gap: 14px;
    align-content: start;
  }
  h3 {
    font-family: var(--x-font-display);
    font-size: clamp(26px, 2.78vw, 40px);
    font-weight: 400;
    letter-spacing: -0.03em;
    line-height: 1;
    color: var(--x-ink);
    margin: 0;
    text-wrap: balance;
  }
  .cols {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
    gap: clamp(16px, 2vw, 32px);
    align-items: start;
  }
  .col {
    margin: 0;
    color: var(--x-ink-dim);
  }
  .price {
    display: block;
    font-family: var(--x-font-display);
    font-size: clamp(19px, 1.8vw, 24px);
    font-weight: 500;
    color: var(--x-ink);
    font-variant-numeric: tabular-nums;
    margin-bottom: 4px;
  }
  .mult b {
    color: var(--x-accent-ink);
    font-weight: 700;
    white-space: nowrap;
  }
  .tagcol {
    text-wrap: pretty;
  }

  /* CTA 常驻钉屏区底部(decked 时随 pin 全程可见,不提前滚走) */
  .cta-row {
    display: flex;
    justify-content: center;
  }
  /* 暗底上的 xbtn 强制暗色系(卡是 x-paper,但按钮在轨道外的黑底上) */
  .cta-row .xbtn.on-dark {
    background: var(--x-white);
    color: var(--x-dark);
    border-color: var(--x-white);
  }

  @media (max-width: 860px) {
    .pin {
      padding-top: 70px;
      min-height: auto;
    }
    .track {
      padding-left: 0;
    }
    .card {
      flex-basis: 82vw;
    }
    .cols {
      grid-template-columns: 1fr;
      gap: 10px;
    }
  }
</style>
