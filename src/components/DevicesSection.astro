---
/* [FEAT-WEB06] 设备叠卡 — R8(画布 1440 等比,几何全对齐):
   钉屏高 --x-sec-h;卡锚位 left 27.43% / top 16.63%,卡宽 45.14%、比例 650/534;
   卡=浅框内衬(10/10/20)+ 白底图区 + 序号章切口 + 标题 40 档 + 双列 12 mono;
   区头=左 gutter:16 mono 打字机标题 + 12 mono 副题 + CTA(钉屏全程可见);
   移动/coarse/reduced 兜底:全部卡竖向依次排开(520 宽)。
   R45:序号章脱离全局 .x-mono(zh 曾被压成 12.5/1.6),5ch 最小宽算上内衬;phone 图白底对白底改 contain 整机可见(B9 过渡);
   桌面编舞卡图 eager 由 fx 负责;数字格式随语言(B8)。
   🔴 卡上无任何收益金额,只展示价格与算力倍数(事实性)。 */
import { useT, type Locale } from '../i18n';
import { SKUS, fmtPrice, fmtMultiplier } from '../lib/skus';
import { contour } from '../lib/contour';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useT(locale);

// App product-card.vue PRODUCT_PHOTO 映射的官网镜像(pro 复用 pro-v2 图、p2 复用 p1 图,同 App)
// R48.12(主人定调「信任感+真实感」):四档设备照全换真实白底棚拍风生成图(gpt-image-2,同族工业设计,
// 无灯条/发光设计,身价随档位递增:掌上节点→小盒→方塔→2U 机架);旧 jpg 移 .trash/20260829-device-jpg/
const PHOTO: Record<string, string | undefined> = {
  phone: '/devices/phone.webp', // R49 拍板9:iPhone 官方渲染图→匿名无品牌手机(IP/审核观感)
  'cloud-share': '/devices/cloud-share.webp',
  's1': '/devices/s1.webp',
  'pro': '/devices/pro.webp',
  'pro-v2': '/devices/pro-v2.webp', // R49-D2:v2 独立图(双段方塔),孪生卡拆分
  'rack-p1': '/devices/rack.webp',
  'rack-p2': '/devices/rack-p2.webp', // R49-D2:P2 独立图(四仓 2U)
};
/* 正方形白底产品图(手机)cover 会切掉上下 42%——白底对白底,contain 整机可见;黑底摄影图保持 cover */
const CONTAIN = new Set(['phone']);
const shareArt = contour(77, 12, 640, 400);
---

<section class="devices" id="devices" data-deck>
  <div class="pin" data-deck-pin>
    <div class="gutter">
      <h2 class="lab x-mono-lg" data-tw>{t('devices.title')}</h2>
      <p class="sub x-mono">{t('devices.subtitle')}</p>
      <a class="xbtn solid on-dark cta" href="#download">
        <span class="xbtn-ghost" aria-hidden="true">{t('devices.cta')} <span class="arr">→</span></span>
        <span class="xbtn-a">{t('devices.cta')} <span class="arr">→</span></span>
        <span class="xbtn-b" aria-hidden="true">{t('devices.cta')} <span class="arr">→</span></span>
      </a>
    </div>

    <div class="stage">
      {
        SKUS.map((s, i) => (
          <article class="card x-tile" class:list={[{ coming: s.status === 'coming' }]} data-deck-card style={`--i:${i}`}>
            <div class="media">
              {PHOTO[s.id] ? (
                <img src={PHOTO[s.id]} alt={s.name} loading="lazy" width="960" height="640" class:list={[{ contain: CONTAIN.has(s.id) }]} />
              ) : (
                <svg viewBox={shareArt.viewBox} preserveAspectRatio="xMidYMid slice" aria-hidden="true">
                  {shareArt.paths.map((d) => (
                    <path d={d} fill="none" stroke="var(--x-dark)" stroke-width="1" opacity="0.5" />
                  ))}
                </svg>
              )}
              <span class="serial" data-tw>NX-{String(i + 1).padStart(2, '0')}</span>
              {s.status === 'legacy' && <span class="chip x-mono">{t('devices.classicBadge')}</span>}
              {s.status === 'coming' && <span class="chip x-mono">{t('devices.comingBadge')}</span>}
            </div>
            <div class="body">
              <h3 class="x-display">{s.name}</h3>
              <div class="cols">
                <p class="col x-mono">
                  <b class="price">{s.free ? t('devices.free') : fmtPrice(s.priceUSD)}</b>
                  <span class="mult">
                    <b>{fmtMultiplier(s.multiplier, locale)}</b> {t('devices.multiplierLabel')}
                  </span>
                </p>
                <p class="col x-mono">{t(`devices.tagline.${s.id}`)}</p>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .devices {
    position: relative;
    z-index: 1;
  }

  /* —— 静态兜底(移动/coarse/reduced/无 JS):区头在上,卡竖向依次排开 —— */
  .pin {
    display: flex;
    flex-direction: column;
    padding: clamp(40px, 9vw, calc(60 * var(--uc))) var(--x-pad) calc(100 * var(--uc));
    gap: clamp(40px, 6vw, calc(80 * var(--uc)));
  }
  .gutter {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: calc(14 * var(--uc));
  }
  .lab {
    color: var(--x-white);
    margin: 0;
    min-height: 1.2em;
  }
  .sub {
    color: var(--x-ink-dim);
    margin: 0;
    max-width: calc(340 * var(--uc));
    text-wrap: pretty;
    line-height: 1.5;
  }
  .cta {
    margin-top: calc(10 * var(--uc));
  }
  /* R30:CTA 恒柠檬 solid,on-dark 白底覆写撤销 */
  /* 🔴 静态兜底档改栅格,不再是一根竖列:竖列在 1440 上是 515 宽居中、左右各空 455px 全黑,
     7 张卡把这一段撑到 3848px(全页 29%)。这一档服务的是「减少动态 / coarse / 无 JS」,
     不是只服务手机 —— 桌面上开了「减少动态」的人看到的就是这个塌掉的版本。
     auto-fit + minmax 让列数由可用宽自己算:窄屏仍是一列,不需要另写断点。 */
  .stage {
    display: grid;
    /* 🔴 上限必须是 1fr,不能是定长:`minmax(min, 定长max)` 让栅格**按上限**算能放几列 ——
       写 520 时 1024 宽放两列要 2×520+79 = 1119px,放不下就整档回落单列(独立复核实测
       1024 仍是 1 列、段高 3829px 占全页 34.2%,与修前同形,只是换了个宽度发生)。
       下限也必须夹一层 min(100%, …):写死 420 时 390 宽的可用宽只有 350,轨道被撑到 420,
       卡片反而向左外凸 12px 越过手机版心。
       420 的取法是两端各留余量:1024 上 2×420+80 = 920 ≤ 947(余 47),
       1440 上 3×420+160 = 1420 > 1360(余 60,保证不会挤出第三列)。
       不写 justify-content:center —— 居中会让卡片左缘脱离版心(实测 1440 上按钮 x=40 而卡片 x=158)。 */
    grid-template-columns: repeat(auto-fit, minmax(min(100%, calc(420 * var(--uc))), 1fr));
    /* 上限 = 两列卡加一道间隙(2×520 + 80)。封这个上限是为了让**轨道宽正好等于卡宽**:
       不封的话 1440 上轨道有 640,卡 520 靠左、右边空 120,间距读起来忽宽忽窄;
       而如果改成让卡铺满轨道,单列档(768–1000)的卡会被拉到 710–835 宽,
       卡是固定比例的,越宽越高 —— 实测那一段从占全页 30.7% 涨到 36.5% / 41%。两头都不行,所以封轨道。 */
    max-width: calc(1120 * var(--uc));
    align-items: start;
    gap: clamp(48px, 8vw, calc(80 * var(--uc)));
  }
  /* 铺满轨道,但不超过卡自己的设计宽 520 —— 单列档轨道比卡宽时,多出来的宽度不该由卡吃掉。
     ⚠️ max-width 不参与特异度竞争:编舞档的 width:45.14% 覆写不掉这里的封顶,
     必须在 .decked 作用域显式 max-width:none(R47.6 教训,9e24b27 曾靠这句注释误判「不受影响」)。 */
  .stage > .card {
    width: 100%;
    max-width: calc(520 * var(--uc));
  }

  /* —— 卡:玻璃框内衬(10/10/20)+ 白底图区 + 图下文块 ——
     R48 换皮:x-paper 白卡 → x-tile 玻璃卡(墨色 token 回暗系,几何/编舞判据一个不动) */
  .card {
    width: min(calc(520 * var(--uc)), 100%);
    aspect-ratio: 650 / 534;
    padding: calc(10 * var(--uc)) calc(10 * var(--uc)) calc(20 * var(--uc));
    display: flex;
    flex-direction: column;
    gap: calc(20 * var(--uc));
    box-sizing: border-box;
    /* 叠卡是全站唯一「玻璃叠玻璃」处:通用 5% 白玻璃会把**下层卡的白色图区**采样成一条亮带,
       价格字压上去对比骤降 —— 换半透暗底(与页脚面板同族),点阵仍透、任意下层内容上文字可读 */
    background: rgb(var(--x-bg-rgb) / 0.5);
  }
  .media {
    border-radius: var(--x-r-sm); /* 圆角随卡(overflow:hidden 已裁) */
  }
  .card.coming .body {
    opacity: 0.66;
  }
  .media {
    position: relative;
    flex: 1;
    min-height: 0;
    background: var(--x-white);
    overflow: hidden;
  }
  .media img,
  .media svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .media img.contain {
    object-fit: contain;
  }
  /* 序号章贴死图区左上角,与卡框同底色成「切口」。
     不挂 .x-mono:全局 zh 覆写(12.5/1.6)曾压过本规则,章是 ASCII 编号,不该吃 CJK 豁免 */
  .serial {
    position: absolute;
    top: 0;
    left: 0;
    /* R48:浅面切口 → 暗玻璃章(玻璃卡上浅切口会读成破洞;photo 上暗章 + 白字任意图底可读) */
    background: rgb(var(--x-bg-rgb) / 0.62);
    color: var(--x-white);
    border-radius: 0 0 calc(12 * var(--uc)) 0;
    font-family: var(--x-font-mono);
    font-weight: 400;
    font-size: calc(16 * var(--uc));
    /* 三处等宽型类的字距都是 0,本处跟型类。
       ⚠️ 「仓规」这个说法不准:导航时钟 / 首屏滚动提示 / 页脚版权行三处 12px 等宽是 −0.03em,
       那是照参考站的另一类 12px 字距刻意保留的,不是漏改。 */
    line-height: 1.2;
    text-transform: uppercase;
    /* 5 字身是文字最小宽(禁 ch,见 tokens.css);border-box 下要算上两侧内衬 */
    min-width: calc(5 * var(--x-ch-mono) + 20 * var(--uc));
    padding: calc(10 * var(--uc));
    text-align: center;
  }
  .chip {
    position: absolute;
    top: calc(10 * var(--uc));
    right: calc(10 * var(--uc));
    font-weight: 400;
    /* R48:与序号章同族暗玻璃胶囊(R35 的浅面体例随白卡一起退役);
       柠檬字压 0.62 暗底,产品照上任意图底可读 */
    background: rgb(var(--x-bg-rgb) / 0.62);
    color: var(--x-accent);
    border-radius: calc(999 * var(--uc));
    padding: calc(3 * var(--uc)) calc(10 * var(--uc));
  }
  .body {
    flex: 0 0 auto;
    padding: 0 calc(10 * var(--uc));
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: max(16px, calc(36 * var(--u)));
  }
  /* 这一处逐字就是 .x-display 的值,却手抄了一份 —— 手抄等于绕开型类层的 vi/zh 行高补偿,
     结果设备卡标题在越南语/中文下一直是 1.0。挂上型类后自动拿到 vi 1.25 / zh 1.15。 */
  h3 {
    font-size: max(24px, calc(40 * var(--u)));
    color: var(--x-ink);
    margin: 0;
  }
  .cols {
    display: flex;
    gap: calc(20 * var(--uc));
    width: 100%;
    /* 站内「小号 mono + 大号 display 同排」一律 baseline(Mission / NexContent / LearnTeaser / LearnArticle);
       flex-start 让两列盒顶齐而基线差 8px,说明行整体浮高 */
    align-items: baseline;
  }
  .col {
    flex: 1;
    min-width: 0;
    margin: 0;
    color: var(--x-ink-cap);
    text-wrap: pretty;
  }
  .price {
    line-height: 1.2; /* zh 会继承 .x-mono:lang(zh) 的 CJK 1.6,卡片比 en/vi 高 8px */
    display: block;
    font-family: var(--x-font-display);
    font-size: max(17px, calc(20 * var(--u)));
    font-weight: 500;
    color: var(--x-ink);
    font-variant-numeric: tabular-nums;
    text-transform: none; /* 展示体价格不吃 .x-mono 的大写传染(「FREE」) */
    margin-bottom: calc(4 * var(--uc));
  }
  .mult b {
    color: var(--x-accent-ink);
    font-weight: 400;
    white-space: nowrap;
  }

  /* —— decked 桌面编舞(fx.ts 置 .decked):画布几何,卡绝对锚位,fx 写 transform —— */
  .devices:global(.decked) .pin {
    position: sticky;
    /* R45(主人 2026-08-26 拍板):改回**顶部定锚**,与参考站同口径 —— 卡顶恒在 141,
       屏比钉屏区高时多出来的高度全留在卡下方,而不是上下对半。
       R41 当初改居中是为了消掉屏底死区,但代价是卡顶随屏高漂(900 高屏 192、1300 高屏 407,差近半张卡);
       🔴 钉件 top 必须是 **0**:参考站的画布常数 133 是**卡自身**在钉件内的偏移(我方 .card 的 top:133.03 就是它),
       钉件本身贴屏顶。第一版把「141」当画布常数写在钉件上 —— 那 141 其实是参考站在 ~1520 宽窗口下
       **卡顶的屏幕像素**读数(133×1.06),既取错常数又加错位置,叠加后卡顶 =141+133=274 比参考站低 141,
       1366×700 / 1920×900 下品名、价格、倍率行被切在折叠线外且滚不进来。
       R41「卡片不紧贴导航条」的诉求由参考站自己的数字满足(74 高导航 + 59 空当)。
       仍然不改区高本身:pinH 一旦跟屏高走,叠卡节奏就会因屏而异,与「宽度驱动画布」冲突。 */
    top: 0;
    height: var(--x-sec-h);
    padding: 0;
    /* R39-fix:停放卡的横向裁切交给全宽壳 .x-frame 的 overflow-x:clip(裁在屏缘;Base.astro);
       此处再裁一次会把裁切边拉回画布边 = 卡在屏内硬边处凭空出现 */
    overflow: visible;
    box-sizing: border-box;
    display: block;
  }
  .devices:global(.decked) .gutter {
    position: absolute;
    left: var(--x-pad);
    top: 18.4%;
    width: calc(27.4% - var(--x-pad) - calc(20 * var(--uc)));
    z-index: 20;
  }
  .devices:global(.decked) .stage {
    position: absolute;
    inset: 0;
    display: block;
    /* 🔴 R47.6:兜底栅格档的 1120 轨道封顶必须在编舞档显式解除 —— max-width 不参与特异度竞争,
       上面那条会把卡片的包含块从全画布缩到 1120,27.43%/45.14% 全按小轨道算
       (9e24b27 引入,实测卡 650→505、锚 395→307,压进左栏文字 67px,主人抓到)。 */
    max-width: none;
  }
  .devices:global(.decked) .card {
    position: absolute;
    left: 27.43%;
    top: 16.63%;
    width: 45.14%;
    max-width: none; /* 同上:兜底档的 520 卡封顶只属于兜底档,编舞档 45.14% 必须原样落地 */
    z-index: calc(1 + var(--i));
    transform: translate3d(3000px, 0, 0); /* R42:画布内禁视口单位;停放位只需「足够远」,由 .x-frame 裁在屏缘 */
    will-change: transform;
  }

  @media (max-width: 860px) {
    .pin {
      padding-top: calc(50 * var(--uc));
      padding-bottom: calc(80 * var(--uc));
    }
    .stage {
      gap: clamp(40px, 9vw, calc(60 * var(--uc)));
    }
  }
</style>
