---
/* [FEAT-WEB11] 文章页正文 — 渲染 md;缺译顶部提示条(WEB01 异常2);
   尾部 Get the app CTA + App 版本标注。axiom 方向:display 标题 + 等宽正文。 */
import { render } from 'astro:content';
import { useT, type Locale } from '../../i18n';
import type { LearnEntry } from '../../lib/learn';

interface Props {
  locale: Locale;
  entry: LearnEntry;
  fallback: boolean;
}
const { locale, entry, fallback } = Astro.props;
const t = useT(locale);
const prefix = locale === 'en' ? '' : `/${locale}`;
const { Content } = await render(entry);
---

<main class="article">
  {fallback && <p class="notice x-mono">{t('learn.untranslated')}</p>}
  <a class="back x-mono x-dimlink" href={`${prefix}/learn`}>← {t('learn.backToList')}</a>
  <article>
    <h1 class="x-display">{entry.data.title}</h1>
    <p class="meta x-mono">
      {t(`learn.topics.${entry.data.topic}`)} · {t('learn.appVersionLabel')} {entry.data.appVersion} · {entry.data.updatedAt}
    </p>
    <div class="prose x-paper">
      <Content />
    </div>
  </article>
  <div class="cta">
    <a class="xbtn solid" href={`${prefix}/#download`}>
      <span class="xbtn-ghost">{t('nex.getApp')} <span class="arr">→</span></span>
      <span class="xbtn-a">{t('nex.getApp')} <span class="arr">→</span></span>
      <span class="xbtn-b">{t('nex.getApp')} <span class="arr">→</span></span>
    </a>
  </div>
</main>

<style>
  .article {
    position: relative;
    z-index: 1;
    max-width: 780px;
    margin: 0;
    margin-top: 84px;
    /* R39-fix:画布留白必须加在盒外。本站 box-sizing:border-box,把 gut 塞进 padding
       会从 max-width 的 780 里倒扣 —— 2560 视口下正文被挤成 33px(三路评审独立实测)。 */
    margin-left: var(--x-gut);
    padding: 46px var(--x-pad) 40px;
  }
  .notice {
    border: 1px solid var(--x-accent-ink);
    color: var(--x-accent-ink);
    padding: 10px 16px;
    margin: 0 0 18px;
  }
  .back {
    color: var(--x-ink-dim);
    text-decoration: none;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    font-weight: 700;
  }
  h1 {
    font-size: clamp(30px, 4.6vw, 54px);
    color: var(--x-ink);
    margin: 10px 0 12px;
  }
  .meta {
    color: var(--x-ink-dim);
    margin: 0 0 30px;
  }
  .prose {
    padding: clamp(20px, 2.6vw, 34px);
    margin-top: 10px;
  }
  .prose :global(h2:first-child) {
    margin-top: 0;
  }
  .prose :global(h2) {
    font-family: var(--x-font-display);
    font-size: clamp(19px, 2vw, 25px);
    font-weight: 500;
    letter-spacing: -0.015em;
    color: var(--x-ink);
    margin: 34px 0 12px;
  }
  .prose :global(p),
  .prose :global(li) {
    font-family: var(--x-font-mono);
    color: var(--x-ink-dim);
    font-size: 13px;
    line-height: 1.85;
    text-wrap: pretty;
  }
  .prose :global(ul) {
    padding-left: 20px;
  }
  .prose :global(blockquote) {
    margin: 20px 0;
    padding: 12px 18px;
    border-left: 2px solid var(--x-accent-ink);
  }
  .prose :global(blockquote p) {
    color: var(--x-ink-dim);
    margin: 0;
  }
  .prose :global(b),
  .prose :global(strong) {
    color: var(--x-ink);
    font-weight: 700;
  }
  .cta {
    margin-top: 40px;
  }
</style>
