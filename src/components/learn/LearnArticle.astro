---
/* [FEAT-WEB11] 文章页正文 — 渲染 md;缺译顶部提示条(WEB01 异常2);
   尾部 Get the app CTA + App 版本标注。axiom 方向:display 标题 + 等宽正文。 */
import { render } from 'astro:content';
import { useT, type Locale } from '../../i18n';
import type { LearnEntry } from '../../lib/learn';

interface Props {
  locale: Locale;
  entry: LearnEntry;
  fallback: boolean;
}
const { locale, entry, fallback } = Astro.props;
const t = useT(locale);
const prefix = locale === 'en' ? '' : `/${locale}`;
const { Content } = await render(entry);
---

<main class="article">
  {fallback && <p class="notice x-mono">{t('learn.untranslated')}</p>}
  <a class="back x-mono x-dimlink" href={`${prefix}/learn`}>← {t('learn.backToList')}</a>
  <article>
    <h1 class="x-display">{entry.data.title}</h1>
    <p class="meta x-mono">
      {t(`learn.topics.${entry.data.topic}`)} · {t('learn.appVersionLabel')} {entry.data.appVersion} · {entry.data.updatedAt}
    </p>
    <div class="prose x-paper">
      <Content />
    </div>
  </article>
  <div class="cta">
    <a class="xbtn solid" href={`${prefix}/#download`}>
      <span class="xbtn-ghost">{t('nex.getApp')} <span class="arr">→</span></span>
      <span class="xbtn-a">{t('nex.getApp')} <span class="arr">→</span></span>
      <span class="xbtn-b">{t('nex.getApp')} <span class="arr">→</span></span>
    </a>
  </div>
</main>

<style>
  .article {
    position: relative;
    z-index: 1;
    max-width: calc(780 * var(--uc));
    margin: 0;
    margin-top: calc(84 * var(--uc));
    /* R39-fix:画布留白必须加在盒外。本站 box-sizing:border-box,把 gut 塞进 padding
       会从 max-width 的 780 里倒扣 —— 2560 视口下正文被挤成 33px(三路评审独立实测)。 */
    padding: calc(46 * var(--uc)) var(--x-pad) calc(40 * var(--uc));
  }
  .notice {
    border: 1px solid var(--x-accent-ink);
    color: var(--x-accent-ink);
    padding: calc(10 * var(--uc)) calc(16 * var(--uc));
    margin: 0 0 calc(18 * var(--uc));
  }
  .back {
    color: var(--x-ink-dim);
    text-decoration: none;
    min-height: calc(44 * var(--uc));
    display: inline-flex;
    align-items: center;
    font-weight: 700;
  }
  h1 {
    font-size: max(30px, calc(54 * var(--u)));
    color: var(--x-ink);
    margin: calc(10 * var(--uc)) 0 calc(12 * var(--uc));
  }
  .meta {
    color: var(--x-ink-dim);
    margin: 0 0 calc(30 * var(--uc));
  }
  .prose {
    padding: max(20px, calc(34 * var(--u)));
    margin-top: calc(10 * var(--uc));
  }
  .prose :global(h2:first-child) {
    margin-top: 0;
  }
  .prose :global(h2) {
    font-family: var(--x-font-display);
    font-size: max(19px, calc(25 * var(--u)));
    font-weight: 500;
    letter-spacing: -0.015em;
    color: var(--x-ink);
    margin: calc(34 * var(--uc)) 0 calc(12 * var(--uc));
  }
  .prose :global(p),
  .prose :global(li) {
    font-family: var(--x-font-mono);
    color: var(--x-ink-dim);
    font-size: calc(13 * var(--uc));
    line-height: 1.85;
    text-wrap: pretty;
  }
  .prose :global(ul) {
    padding-left: calc(20 * var(--uc));
  }
  .prose :global(blockquote) {
    margin: calc(20 * var(--uc)) 0;
    padding: calc(12 * var(--uc)) calc(18 * var(--uc));
    border-left: 2px solid var(--x-accent-ink);
  }
  .prose :global(blockquote p) {
    color: var(--x-ink-dim);
    margin: 0;
  }
  .prose :global(b),
  .prose :global(strong) {
    color: var(--x-ink);
    font-weight: 700;
  }
  .cta {
    margin-top: calc(40 * var(--uc));
  }
</style>
