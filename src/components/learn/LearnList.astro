---
/* [FEAT-WEB11] /learn 列表 — 按 order 排列;缺译条目标注回退语言。
   axiom 方向:display 大标题 + 细线卡栅格 + 等宽 topic 标记。
   R45:补下载 CTA(此前是唯一没有转化出口的内容页);内链尾斜杠。 */
import { useT, type Locale } from '../../i18n';
import { learnList } from '../../lib/learn';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useT(locale);
const prefix = locale === 'en' ? '' : `/${locale}`;
const items = await learnList(locale);
---

<main class="learn">
  <header class="head">
    <h1 class="x-display">{t('learn.title')}</h1>
    <p class="x-copy">{t('learn.subtitle')}</p>
  </header>
  <div class="grid">
    {
      items.map(({ entry, slug, fallback }, i) => (
        <a class="card x-tile x-tile-calm" href={`${prefix}/learn/${slug}/`} data-rv style={`--d:${(i % 3) * 0.08}s`}>
          <span class="row1">
            <span class="idx x-mono">{String(i + 1).padStart(2, '0')}</span>
            <span class="topic x-mono">{t(`learn.topics.${entry.data.topic}`)}</span>
          </span>
          <h2 class="x-h24" lang={fallback ? 'en' : undefined}>{entry.data.title}</h2>
          <p class="x-copy" lang={fallback ? 'en' : undefined}>{entry.data.description}</p>
          {fallback && <span class="fb x-mono">{t('learn.enOnly')}</span>}
        </a>
      ))
    }
  </div>
  <div class="cta">
    <a class="xbtn solid" href={`${prefix}/#download`}>
      <span class="xbtn-ghost" aria-hidden="true">{t('nex.getApp')} <span class="arr">→</span></span>
      <span class="xbtn-a">{t('nex.getApp')} <span class="arr">→</span></span>
      <span class="xbtn-b" aria-hidden="true">{t('nex.getApp')} <span class="arr">→</span></span>
    </a>
  </div>
</main>

<style>
  .learn {
    position: relative;
    z-index: 1;
    margin-top: calc(84 * var(--uc));
    padding: calc(46 * var(--uc)) var(--x-pad) calc(40 * var(--uc)); /* R39:内页 main 用简写会盖掉全局画布留白,显式补回 */
  }
  .head {
    margin-bottom: clamp(30px, 5vw, calc(56 * var(--uc)));
  }
  h1 {
    font-size: clamp(40px, 6.4vw, calc(88 * var(--uc)));
    color: var(--x-ink);
    margin: 0 0 calc(14 * var(--uc));
  }
  .head p {
    color: var(--x-ink-dim);
    margin: 0;
    max-width: calc(520 * var(--uc));
    text-wrap: pretty;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, calc(280 * var(--uc))), 1fr));
    gap: clamp(14px, 1.8vw, calc(24 * var(--uc)));
  }
  .card {
    padding: calc(22 * var(--uc));
    display: grid;
    gap: calc(12 * var(--uc));
    align-content: start;
    text-decoration: none;
    transition: opacity 0.2s;
  }
  .card:hover {
    opacity: 0.92;
  }
  .card:active {
    opacity: 0.85;
  }
  .row1 {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .idx {
    color: var(--x-accent-ink);
    font-weight: 400;
  }
  .topic {
    color: var(--x-ink-dim);
    font-weight: 400;
  }
  h2 {
    font-size: clamp(19px, 1.8vw, calc(24 * var(--uc)));
    color: var(--x-ink);
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-wrap: balance;
  }

  .card > p {
    color: var(--x-ink-dim);
    margin: 0;
    text-wrap: pretty;
  }
  .fb {
    color: var(--x-ink-dim);
  }
  .cta {
    margin-top: calc(40 * var(--uc));
  }
</style>
