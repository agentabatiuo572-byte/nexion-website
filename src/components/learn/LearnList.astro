---
/* [FEAT-WEB11] /learn 列表 — 按 order 排列;缺译条目标注回退语言。
   axiom 方向:display 大标题 + 细线卡栅格 + 等宽 topic 标记。 */
import { useT, type Locale } from '../../i18n';
import { learnList } from '../../lib/learn';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useT(locale);
const prefix = locale === 'en' ? '' : `/${locale}`;
const items = await learnList(locale);
---

<main class="learn">
  <header class="head">
    <h1 class="x-display">{t('learn.title')}</h1>
    <p class="x-mono">{t('learn.subtitle')}</p>
  </header>
  <div class="grid">
    {
      items.map(({ entry, slug, fallback }, i) => (
        <a class="card" href={`${prefix}/learn/${slug}`} data-rv style={`--d:${(i % 3) * 0.08}s`}>
          <span class="row1">
            <span class="idx x-mono">{String(i + 1).padStart(2, '0')}</span>
            <span class="topic x-mono">{t(`learn.topics.${entry.data.topic}`)}</span>
          </span>
          <h2>{entry.data.title}</h2>
          <p class="x-mono">{entry.data.description}</p>
          {fallback && <span class="fb x-mono">{t('learn.enOnly')}</span>}
        </a>
      ))
    }
  </div>
</main>

<style>
  .learn {
    position: relative;
    z-index: 1;
    padding: 130px var(--x-pad) 0;
  }
  .head {
    margin-bottom: clamp(30px, 5vw, 56px);
  }
  h1 {
    font-size: clamp(40px, 6.4vw, 88px);
    color: var(--x-white);
    margin: 0 0 14px;
  }
  .head p {
    color: var(--x-ink-dim);
    margin: 0;
    max-width: 520px;
    text-wrap: pretty;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: clamp(14px, 1.8vw, 24px);
  }
  .card {
    border: 1px solid var(--x-line-soft);
    padding: 22px;
    display: grid;
    gap: 12px;
    align-content: start;
    text-decoration: none;
    transition: border-color 0.2s;
  }
  .card:hover {
    border-color: var(--x-accent);
  }
  .card:active {
    opacity: 0.85;
  }
  .row1 {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .idx {
    color: var(--x-accent);
    font-weight: 700;
  }
  .topic {
    color: var(--x-ink-faint);
    font-weight: 700;
  }
  h2 {
    font-family: var(--x-font-display);
    font-size: clamp(19px, 1.8vw, 24px);
    font-weight: 500;
    letter-spacing: -0.015em;
    line-height: 1.18;
    color: var(--x-white);
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-wrap: balance;
  }
  .card > p {
    color: var(--x-ink-dim);
    margin: 0;
    text-wrap: pretty;
  }
  .fb {
    color: var(--x-ink-faint);
  }
</style>
