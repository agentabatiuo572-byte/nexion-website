---
/* [FEAT-WEB11 + §2.3 ⑩] Home 学习中心入口卡 — 3 篇精选 + Browse all */
import { useT, type Locale } from '../../i18n';
import { learnList } from '../../lib/learn';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useT(locale);
const prefix = locale === 'en' ? '' : `/${locale}`;
const picks = (await learnList(locale)).filter((x) => [1, 2, 4].includes(x.entry.data.order));
---

<section class="learn-entry" id="learn-entry">
  <h2 class="title">{t('learn.homeTitle')}</h2>
  <div class="cards">
    {
      picks.map(({ entry, slug }) => (
        <a class="card" href={`${prefix}/learn/${slug}`}>
          <span class="topic">{t(`learn.topics.${entry.data.topic}`)}</span>
          <h3>{entry.data.title}</h3>
        </a>
      ))
    }
  </div>
  <div class="more">
    <a class="pill" href={`${prefix}/learn`}>{t('learn.browseAll')} →</a>
  </div>
</section>

<style>
  .learn-entry {
    max-width: var(--w-content-max);
    margin: 0 auto;
    padding: var(--w-space-section) 20px 0;
  }
  .title {
    font-size: clamp(24px, 3vw, 30px);
    font-weight: 600;
    color: var(--v5-ink);
    margin: 0 0 24px;
    text-align: center;
    text-wrap: balance;
  }
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 14px;
  }
  .card {
    background: var(--v5-surface);
    border-radius: var(--w-radius-card);
    padding: 22px 20px;
    display: grid;
    gap: 8px;
    align-content: start;
    text-decoration: none;
    transition:
      transform 0.15s,
      opacity 0.15s;
  }
  .card:active {
    transform: scale(0.99);
    opacity: 0.9;
  }
  .card:focus-visible {
    outline: 2px solid var(--v5-brand);
    outline-offset: 2px;
  }
  .topic {
    justify-self: start;
    font-size: 10.5px;
    font-weight: 500;
    letter-spacing: 0.05em;
    color: var(--v5-brand);
    background: var(--v5-brand-soft);
    border-radius: var(--w-radius-pill);
    padding: 3px 10px;
  }
  h3 {
    font-size: 15px;
    font-weight: 600;
    color: var(--v5-ink);
    margin: 0;
    text-wrap: balance;
  }
  .more {
    text-align: center;
    margin-top: 22px;
  }
  .pill {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 22px;
    border-radius: var(--w-radius-pill);
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    color: var(--v5-ink-2);
    border: 1px solid var(--v5-border-strong);
    transition:
      transform 0.15s,
      opacity 0.15s;
  }
  .pill:active {
    transform: scale(0.98);
    opacity: 0.85;
  }
  .pill:focus-visible {
    outline: 2px solid var(--v5-brand);
    outline-offset: 2px;
  }
</style>
