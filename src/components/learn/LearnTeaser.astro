---
/* [FEAT-WEB11 + §2.3 ⑩] Home 学习中心入口卡 — R8(白带块):
   头行 16 mono 打字机;行卡改细线行式(上缘 hairline、无底色),
   编号 0.8 墨 + display 标题 + 箭头。 */
import { useT, type Locale } from '../../i18n';
import { learnList } from '../../lib/learn';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useT(locale);
const prefix = locale === 'en' ? '' : `/${locale}`;
const picks = (await learnList(locale)).filter((x) => [1, 2, 4].includes(x.entry.data.order));
---

<section class="learn-entry" id="learn-entry">
  <div class="head">
    <p class="lab x-mono-lg" data-tw>{t('learn.homeTitle')}</p>
  </div>
  <div class="rows">
    {
      picks.map(({ entry, slug }, i) => (
        <a class="row x-dimlink" href={`${prefix}/learn/${slug}`} data-rv style={`--d:${i * 0.08}s`}>
          <span class="idx x-mono">0{i + 1}</span>
          <span class="topic x-mono">{t(`learn.topics.${entry.data.topic}`)}</span>
          <span class="name">{entry.data.title}</span>
          <span class="arr x-mono" aria-hidden="true">→</span>
        </a>
      ))
    }
  </div>
  <div class="more" data-rv>
    <a class="xbtn" href={`${prefix}/learn`}>
      <span class="xbtn-ghost">{t('learn.browseAll')} <span class="arr">→</span></span>
      <span class="xbtn-a">{t('learn.browseAll')} <span class="arr">→</span></span>
      <span class="xbtn-b">{t('learn.browseAll')} <span class="arr">→</span></span>
    </a>
  </div>
</section>

<style>
  .learn-entry {
    padding: 0 var(--x-pad);
  }
  .head {
    margin-bottom: max(48px, calc(120 * var(--u)));
  }
  .lab {
    color: var(--x-ink);
    margin: 0;
    min-height: 1.2em;
  }
  .rows {
    display: grid;
    border-bottom: 1px solid var(--x-line-dark);
  }
  .row {
    display: flex;
    align-items: baseline;
    gap: max(14px, calc(34.56 * var(--u)));
    padding: clamp(18px, 2vw, calc(28 * var(--uc))) 0;
    border-top: 1px solid var(--x-line-dark);
    text-decoration: none;
    color: var(--x-ink);
    min-height: calc(44 * var(--uc));
  }
  .idx {
    color: var(--x-dark-cap);
    flex: 0 0 30px;
  }
  .topic {
    color: var(--x-dark-dim);
    flex: 0 0 clamp(90px, 12vw, calc(150 * var(--uc)));
  }
  .name {
    font-family: var(--x-font-display);
    font-size: max(20px, calc(32 * var(--u)));
    font-weight: 400;
    letter-spacing: -0.03em;
    line-height: 1.1;
    flex: 1;
    text-wrap: balance;
  }
  .arr {
    color: var(--x-dark-dim);
  }
  .more {
    margin-top: max(32px, calc(57.6 * var(--u)));
  }
  @media (max-width: 640px) {
    .topic {
      display: none;
    }
  }
</style>
