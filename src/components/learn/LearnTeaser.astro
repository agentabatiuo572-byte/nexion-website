---
/* [FEAT-WEB11 + §2.3 ⑩] Home 学习中心入口卡 — 3 篇精选 + Browse all。
   axiom 方向:序号行列表(等宽 topic + display 标题 + 箭头)。 */
import { useT, type Locale } from '../../i18n';
import { learnList } from '../../lib/learn';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useT(locale);
const prefix = locale === 'en' ? '' : `/${locale}`;
const picks = (await learnList(locale)).filter((x) => [1, 2, 4].includes(x.entry.data.order));
---

<section class="learn-entry" id="learn-entry">
  <div class="head">
    <span class="x-label lab" data-tw>{t('learn.homeTitle')}</span>
  </div>
  <div class="rows">
    {
      picks.map(({ entry, slug }, i) => (
        <a class="row x-paper x-dimlink" href={`${prefix}/learn/${slug}`} data-rv style={`--d:${i * 0.08}s`}>
          <span class="idx x-mono">0{i + 1}</span>
          <span class="topic x-mono">{t(`learn.topics.${entry.data.topic}`)}</span>
          <span class="name">{entry.data.title}</span>
          <span class="arr x-mono" aria-hidden="true">→</span>
        </a>
      ))
    }
  </div>
  <div class="more" data-rv>
    <a class="xbtn" href={`${prefix}/learn`}>
      <span class="xbtn-ghost">{t('learn.browseAll')} <span class="arr">→</span></span>
      <span class="xbtn-a">{t('learn.browseAll')} <span class="arr">→</span></span>
      <span class="xbtn-b">{t('learn.browseAll')} <span class="arr">→</span></span>
    </a>
  </div>
</section>

<style>
  .learn-entry {
    /* R4:板块底回黑透出粒子,白底只给信息行卡(x-paper)——主人定调 */
    position: relative;
    z-index: 1;
    padding: var(--x-section-gap) var(--x-pad);
  }
  .head {
    border-top: 1px solid var(--x-line);
    padding-top: 18px;
    margin-bottom: clamp(24px, 3vw, 40px);
  }
  .lab {
    color: var(--x-ink);
  }
  .rows {
    display: grid;
    gap: 10px;
  }
  .row {
    display: flex;
    align-items: baseline;
    gap: clamp(14px, 2.4vw, 36px);
    padding: clamp(14px, 1.8vw, 22px) clamp(16px, 1.8vw, 26px);
    text-decoration: none;
    color: var(--x-ink);
    min-height: 44px;
  }
  .idx {
    color: var(--x-accent-ink);
    font-weight: 700;
    flex: 0 0 30px;
  }
  .topic {
    color: var(--x-ink-faint);
    flex: 0 0 clamp(90px, 12vw, 150px);
  }
  .name {
    font-family: var(--x-font-display);
    font-size: clamp(18px, 2.2vw, 28px);
    font-weight: 500;
    letter-spacing: -0.015em;
    line-height: 1.2;
    flex: 1;
    text-wrap: balance;
  }
  .arr {
    color: var(--x-ink-faint);
  }
  .more {
    margin-top: clamp(24px, 3vw, 40px);
  }
  @media (max-width: 640px) {
    .topic {
      display: none;
    }
  }
</style>
