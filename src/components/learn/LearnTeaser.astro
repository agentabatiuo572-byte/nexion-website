---
/* [FEAT-WEB11 + §2.3 ⑩] Home 学习中心入口卡 — R48 玻璃瓷砖 + R49b 重排(主人:
   「三行太空旷,大小字对比过大,加图标改排版」):行式改为 [主题图标(柠檬)] +
   [标题(降档)+ 主题小注(竖排双层)] + [右端 dim 编号 + 箭头];行距收紧。 */
import { useT, type Locale } from '../../i18n';
import { learnList } from '../../lib/learn';
import Icon from '../Icon.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useT(locale);
const prefix = locale === 'en' ? '' : `/${locale}`;
const picks = (await learnList(locale)).filter((x) => [1, 2, 4].includes(x.entry.data.order));
/* 主题→图标(六主题全配,入选三篇之外的换选也不掉图) */
const TOPIC_ICON = { start: 'edu', earn: 'coin-bolt', devices: 'mech', wallet: 'swap', team: 'ai', nex: 'token' } as const;
---

<section class="learn-entry" id="learn-entry">
  <div class="head">
    <span class="x-ghost ghost" aria-hidden="true">05</span>
    <p class="lab x-mono-lg" data-tw>{t('nav.learn')}</p>
    <h2 class="x-display" data-lr>{t('learn.homeTitle')}</h2>
  </div>
  <div class="rows x-tile">
    {
      picks.map(({ entry, slug }, i) => (
        <a class="row x-dimlink" href={`${prefix}/learn/${slug}/`} data-rv style={`--d:${i * 0.08}s`}>
          <Icon name={TOPIC_ICON[entry.data.topic as keyof typeof TOPIC_ICON] ?? 'edu'} class="tic" />
          <span class="txt">
            <span class="name x-display">{entry.data.title}</span>
            <span class="topic x-mono">{t(`learn.topics.${entry.data.topic}`)}</span>
          </span>
          <span class="idx x-mono">0{i + 1}</span>
          <span class="arr x-mono" aria-hidden="true">→</span>
        </a>
      ))
    }
  </div>
  <div class="more" data-rv>
    <a class="xbtn" href={`${prefix}/learn/`}>
      <span class="xbtn-ghost" aria-hidden="true">{t('learn.browseAll')} <span class="arr">→</span></span>
      <span class="xbtn-a">{t('learn.browseAll')} <span class="arr">→</span></span>
      <span class="xbtn-b" aria-hidden="true">{t('learn.browseAll')} <span class="arr">→</span></span>
    </a>
  </div>
</section>

<style>
  .learn-entry {
    padding: 0 var(--x-pad);
  }
  .head {
    position: relative;
    margin-bottom: max(32px, calc(48 * var(--u)));
  }
  .ghost {
    right: calc(-10 * var(--uc));
    top: calc(-30 * var(--uc));
  }
  .lab {
    color: var(--x-ink);
    margin: 0 0 calc(16 * var(--uc));
    min-height: 1.2em;
  }
  .head h2 {
    position: relative;
    z-index: 1;
    font-size: max(30px, calc(44 * var(--u)));
    color: var(--x-ink);
    margin: 0;
  }
  .rows {
    display: grid;
    padding: calc(4 * var(--uc)) calc(26 * var(--uc));
    z-index: 1;
  }
  /* R49b:行 = 图标 + (标题/主题小注) + 编号 + 箭头;行距收紧、标题降档,消「空旷 + 大小字断崖」 */
  .row {
    display: flex;
    align-items: center;
    gap: max(12px, calc(18 * var(--u)));
    padding: clamp(14px, 1.6vw, calc(20 * var(--uc))) 0;
    border-top: 1px solid var(--x-line-soft);
    text-decoration: none;
    color: var(--x-ink);
    min-height: var(--x-touch);
  }
  .row:first-child {
    border-top: 0; /* 瓷砖边界已是首行上缘 */
  }
  .row :global(.tic) {
    width: max(22px, calc(28 * var(--u)));
    height: max(22px, calc(28 * var(--u)));
    flex: 0 0 auto;
    color: var(--x-accent-hot); /* 图标接住编号让出的柠檬位(一行一个柠檬体例) */
  }
  .txt {
    flex: 1 1 auto;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: calc(4 * var(--uc));
  }
  /* 字族/字重/行高交回 .x-display 型类(vi/zh 行高补偿),这里只留尺寸;30→21 档(主人:大字太大) */
  .name {
    font-size: max(16px, calc(21 * var(--u)));
  }
  .topic {
    color: var(--x-ink-dim);
    font-size: max(11px, calc(12 * var(--u))); /* 几何门可读地板 11px(10.5 曾 6 档全红) */
    /* 字距不加正值:tokens 排版尺明文「字距无正值」,uppercase+dim 色差已足够立住(R49 收线 D7) */
    text-transform: uppercase;
  }
  .idx {
    color: var(--x-ink-dim);
    flex: 0 0 auto;
  }
  .arr {
    color: var(--x-ink-dim);
  }
  .more {
    margin-top: max(24px, calc(40 * var(--u)));
  }
  .more .xbtn {
    scroll-margin-block: 8px;
  }
</style>
