---
/* [FEAT-WEB08] 社证板块 — R7(解剖报告 P1-20/21):整屏一句话尺度,
   垂直居中、内容列右置(与使命区左置成之字);双段同字号同纯白,
   层级靠断行+20px 组距+第二段延迟 220ms 行滑。证言素材未到位(O4)→ 子区隐藏。 */
import { useT, type Locale } from '../i18n';
import { STATS_SNAPSHOT, fmtStat } from '../lib/stats';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useT(locale);

interface Testimonial {
  name: string;
  country: string;
  quote: string;
}
const TESTIMONIALS: Testimonial[] = [];
---

<section class="social" id="social">
  <div class="col">
    <h2 class="x-display" data-lr>
      {t('social.scaleLine', { devices: fmtStat(STATS_SNAPSHOT.activeDevices), countries: STATS_SNAPSHOT.countries })}
    </h2>
    <p class="roles x-display" data-lr data-lr-delay="220">{t('social.rolesLine')}</p>

    {
      TESTIMONIALS.length > 0 && (
        <div class="quotes">
          {TESTIMONIALS.map((q) => (
            <blockquote class="quote">
              <p class="x-mono">{q.quote}</p>
              <footer class="x-mono">
                {q.name} · {q.country}
              </footer>
            </blockquote>
          ))}
        </div>
      )
    }
  </div>
</section>

<style>
  .social {
    position: relative;
    z-index: 1;
    min-height: 100svh;
    padding: var(--x-section-gap) var(--x-pad);
    display: flex;
    align-items: center;
    justify-content: flex-end;
  }
  .col {
    width: min(725px, 100%);
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  h2,
  .roles {
    font-size: clamp(32px, 3.33vw, 64px);
    color: var(--x-white);
    margin: 0;
  }
  .quotes {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 20px;
    margin-top: 28px;
  }
  .quote {
    margin: 0;
    border: 1px solid var(--x-line);
    padding: 20px;
  }
  .quote p {
    color: var(--x-ink-dim);
    margin: 0 0 12px;
  }
  .quote footer {
    color: var(--x-ink-faint);
  }
  @media (max-width: 851px) {
    .social {
      align-items: flex-end;
      padding-bottom: 60px;
      min-height: 80svh;
    }
  }
</style>
