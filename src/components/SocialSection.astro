---
/* [FEAT-WEB08] 社证板块 — 规模句(复用 stats 快照,同源)+ 职业多样性 + 证言。
   证言素材未到位(O4)→ 子区隐藏(分层降级,不放假证言);数组填充即渲染。
   axiom 方向:黑底陈述式大字,粒子层透底。 */
import { useT, type Locale } from '../i18n';
import { STATS_SNAPSHOT, fmtStat } from '../lib/stats';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useT(locale);

// O4 素材到位后填充(name/country/quote 须真实授权)
interface Testimonial {
  name: string;
  country: string;
  quote: string;
}
const TESTIMONIALS: Testimonial[] = [];
---

<section class="social" id="social">
  <h2 class="title x-display" data-rv>
    {t('social.scaleLine', { devices: fmtStat(STATS_SNAPSHOT.activeDevices), countries: STATS_SNAPSHOT.countries })}
  </h2>
  <p class="roles x-display" data-rv style="--d:.15s">{t('social.rolesLine')}</p>

  {
    TESTIMONIALS.length > 0 && (
      <div class="quotes">
        {TESTIMONIALS.map((q) => (
          <blockquote class="quote">
            <p class="x-mono">{q.quote}</p>
            <footer class="x-mono">
              {q.name} · {q.country}
            </footer>
          </blockquote>
        ))}
      </div>
    )
  }
</section>

<style>
  .social {
    position: relative;
    z-index: 1;
    padding: var(--x-section-gap) var(--x-pad);
    min-height: 66svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: clamp(20px, 3vh, 34px);
  }
  .title {
    font-size: clamp(30px, 4.4vw, 58px);
    color: var(--x-white);
    margin: 0;
    max-width: 20ch;
  }
  .roles {
    font-size: clamp(20px, 2.6vw, 34px);
    color: var(--x-ink-dim);
    margin: 0;
    max-width: 34ch;
    font-weight: 400;
  }
  .quotes {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 20px;
    margin-top: 28px;
  }
  .quote {
    margin: 0;
    border: 1px solid var(--x-line);
    padding: 20px;
  }
  .quote p {
    color: var(--x-ink-dim);
    margin: 0 0 12px;
  }
  .quote footer {
    color: var(--x-ink-faint);
  }
</style>
