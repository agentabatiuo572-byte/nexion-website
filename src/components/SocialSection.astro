---
/* [FEAT-WEB08] 社证板块 — R8(statement 带,画布 1440 等比):
   定高 --x-sec-h、内容右置列 725→50.35vw、列距 48→3.33vw;
   新增 16 mono 打字机 kicker(social.kicker);双段陈述同字号(48 档),
   第二段行滑延迟 120ms,陈述块宽 645/725=89%。证言素材未到位(O4)→ 子区隐藏。 */
import { useT, type Locale } from '../i18n';
import { STATS_SNAPSHOT, fmtStat } from '../lib/stats';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useT(locale);
const scaleTemplate = t('social.scaleLine');

interface Testimonial {
  name: string;
  country: string;
  quote: string;
}
const TESTIMONIALS: Testimonial[] = [];
---

<section class="social" id="social">
  <div class="col">
    <p class="kicker">
      <span class="ktick" aria-hidden="true"></span>
      <span class="x-mono-lg" data-tw>{t('social.kicker')}</span>
    </p>
    <div class="disp x-display">
      <h2 data-lr data-scale-template={scaleTemplate} data-locale={locale}>
        {t('social.scaleLine', { devices: fmtStat(STATS_SNAPSHOT.activeDevices, 0, locale), countries: STATS_SNAPSHOT.countries })}
      </h2>
    </div>
    <p class="roles x-mono-lg" data-rv>{t('social.rolesLine')}</p>

    {
      TESTIMONIALS.length > 0 && (
        <div class="quotes">
          {TESTIMONIALS.map((q) => (
            <blockquote class="quote">
              <p class="x-mono">{q.quote}</p>
              <footer class="x-mono">
                {q.name} · {q.country}
              </footer>
            </blockquote>
          ))}
        </div>
      )
    }
  </div>
</section>

<script is:inline>
  /* StatsBar 在同页更早位置按访问日重算后把原始值放到 window；这里在 fx 拆行前同步整句。 */
  (function () {
    var el = document.querySelector('#social [data-scale-template]');
    var live = window.__xLiveStats;
    if (!el) return;
    var tag = el.dataset.locale === 'vi' ? 'vi-VN' : el.dataset.locale === 'zh' ? 'zh-CN' : 'en-US';
    var fmt = function (n) {
      return n >= 999500
        ? (n / 1000000).toLocaleString(tag, { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + 'M'
        : n >= 99950
          ? (n / 1000).toLocaleString(tag, { minimumFractionDigits: 1, maximumFractionDigits: 1 }) + 'K'
          : n.toLocaleString(tag);
    };
    var render = function (stats) {
      if (typeof stats.activeDevices !== 'number' || typeof stats.countries !== 'number') return;
      el.textContent = el.dataset.scaleTemplate
        .replace('{devices}', fmt(stats.activeDevices))
        .replace('{countries}', fmt(stats.countries));
    };
    if (live) render(live);
    document.addEventListener('x:stats-update', function (event) {
      render(event.detail || {});
    });
  })();
</script>

<style>
  .social {
    position: relative;
    z-index: 1;
    height: var(--x-sec-h);
    overflow: hidden;
    padding: max(60px, calc(100 * var(--u))) var(--x-pad);
    display: flex;
    align-items: center;
    justify-content: flex-end;
  }
  .col {
    width: calc(725 * var(--u));
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: max(28px, calc(48 * var(--u)));
  }
  /* 层级(R17 主人令):琥珀刻度+眉标(锚点)→ 大白数字句(唯一大字)→ 暗色小注 */
  .kicker {
    color: var(--x-white);
    margin: 0;
    min-height: 1.2em;
    display: flex;
    align-items: center;
    gap: calc(10 * var(--uc));
  }
  .ktick {
    width: max(2px, calc(2 * var(--u)));
    height: max(20px, calc(20.16 * var(--u)));
    background: linear-gradient(to bottom, var(--x-accent-hot), color-mix(in srgb, var(--x-accent-hot) 10%, transparent));
    flex: 0 0 auto;
  }
  .disp {
    max-width: 89%;
    font-size: max(32px, calc(48 * var(--u))); /* R45 拍板:区块与卡标题回参考站的 48 档(档位数不变,只换值) */
    color: var(--x-white);
  }
  .disp h2 {
    font-size: inherit;
    font-weight: inherit;
    margin: 0;
    white-space: pre-line; /* zh 焊定断点(「正在」不拆行) */
  }
  /* ⚠️ 下面这条 line-height **只对英文生效**:本元素挂着 .x-mono-lg,而型类的
     `:lang(vi)` / `:lang(zh)` 分支特异度更高(0,2,1 > 0,2,0),vi 拿 1.45、zh 拿 1.5。
     值保留是有意的 —— 这是多行的次要正文,1.5 比型类默认的 1.2 好读;三语实际落点 1.5/1.45/1.5 本就接近。
     写明是为了下次有人看到「改了没反应」时不必再查一遍层叠。 */
  .roles {
    color: var(--x-ink-dim);
    margin: 0;
    max-width: min(calc(46 * var(--x-ch-mono)), 100%); /* 46 字身行长上限,禁 ch(见 tokens.css) */
    text-wrap: pretty;
    line-height: 1.5;
  }
  .quotes {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(calc(260 * var(--uc)), 1fr));
    gap: calc(20 * var(--uc));
    margin-top: calc(28 * var(--uc));
  }
  .quote {
    margin: 0;
    border: 1px solid var(--x-line);
    padding: calc(20 * var(--uc));
  }
  .quote p {
    color: var(--x-ink-dim);
    margin: 0 0 calc(12 * var(--uc));
  }
  .quote footer {
    color: var(--x-ink-dim);
  }
  @media (max-width: 860px) {
    .social {
      height: auto;
      min-height: 72svh;
      align-items: flex-end;
      padding-bottom: calc(60 * var(--uc));
    }
    .col {
      width: 100%;
    }
    .disp {
      max-width: 100%;
    }
  }
</style>
