---
/* [FEAT-WEB08] 社证板块 — R8(statement 带,画布 1440 等比):
   定高 --x-sec-h、内容右置列 725→50.35vw、列距 48→3.33vw;
   新增 16 mono 打字机 kicker(social.kicker);双段陈述同字号(48 档),
   第二段行滑延迟 120ms,陈述块宽 645/725=89%。证言素材未到位(O4)→ 子区隐藏。 */
import { useT, type Locale } from '../i18n';
import { STATS_SNAPSHOT, fmtStat } from '../lib/stats';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useT(locale);

interface Testimonial {
  name: string;
  country: string;
  quote: string;
}
const TESTIMONIALS: Testimonial[] = [];
---

<section class="social" id="social">
  <div class="col">
    <p class="kicker x-mono-lg" data-tw>{t('social.kicker')}</p>
    <div class="disp x-display">
      <h2 data-lr>
        {t('social.scaleLine', { devices: fmtStat(STATS_SNAPSHOT.activeDevices), countries: STATS_SNAPSHOT.countries })}
      </h2>
      <p data-lr data-lr-delay="120">{t('social.rolesLine')}</p>
    </div>

    {
      TESTIMONIALS.length > 0 && (
        <div class="quotes">
          {TESTIMONIALS.map((q) => (
            <blockquote class="quote">
              <p class="x-mono">{q.quote}</p>
              <footer class="x-mono">
                {q.name} · {q.country}
              </footer>
            </blockquote>
          ))}
        </div>
      )
    }
  </div>
</section>

<style>
  .social {
    position: relative;
    z-index: 1;
    height: var(--x-sec-h);
    overflow: hidden;
    padding: clamp(60px, 6.94vw, 133px) var(--x-pad);
    display: flex;
    align-items: center;
    justify-content: flex-end;
  }
  .col {
    width: min(50.35vw, 967px);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: clamp(28px, 3.33vw, 64px);
  }
  .kicker {
    color: var(--x-white);
    margin: 0;
    min-height: 1.2em;
  }
  .disp {
    max-width: 89%;
    font-size: clamp(32px, 3.33vw, 64px);
    color: var(--x-white);
  }
  .disp h2,
  .disp p {
    font-size: inherit;
    font-weight: inherit;
    margin: 0;
  }
  .disp h2 {
    margin-bottom: 20px;
  }
  .quotes {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 20px;
    margin-top: 28px;
  }
  .quote {
    margin: 0;
    border: 1px solid var(--x-line);
    padding: 20px;
  }
  .quote p {
    color: var(--x-ink-dim);
    margin: 0 0 12px;
  }
  .quote footer {
    color: var(--x-ink-faint);
  }
  @media (max-width: 860px) {
    .social {
      height: auto;
      min-height: 72svh;
      align-items: flex-end;
      padding-bottom: 60px;
    }
    .col {
      width: 100%;
    }
    .disp {
      max-width: 100%;
    }
  }
</style>
