---
import DownloadCard from './DownloadCard.astro';
import type { Locale } from '../../i18n';
interface Props { locale: Locale }
const { locale } = Astro.props;
---
<dialog id="distribution-dialog" aria-labelledby="distribution-dialog-title" data-presentation="modal" data-open="false" data-placement="bottom" data-lenis-prevent>
  <span class="distribution-boot-glow" aria-hidden="true"></span>
  <div class="distribution-panel">
    <DownloadCard locale={locale} modal />
  </div>
</dialog>
<script src="../../scripts/distribution.ts"></script>
