---
/* [R48.7] 全站线性图标单源(主人 2026-08-28 令②:全站太素,补图形元素)。
   规格:32 网格 · stroke 1.6 · 圆帽圆角 · fill none · currentColor(颜色由使用处定,不写死)。
   自绘不引库:与等高线图/幽灵编号同属「单色线条」语言,不与品牌柠檬争色。
   新增图标往 GLYPHS 里加条目即可;name 不存在时静默不渲染(构建期 astro check 能看见拼写)。 */
interface Props {
  name: keyof typeof GLYPHS;
  class?: string;
}
const { name, class: cls } = Astro.props;

const GLYPHS = {
  /* —— 算力去向(mission f1-f6)—— */
  /* 神经网络:三层节点 + 收边连线(线段停在节点外缘,交叠不脏) */
  ai: `<circle cx="8" cy="10" r="2.6"/><circle cx="8" cy="22" r="2.6"/><circle cx="16" cy="16" r="2.6"/><circle cx="24" cy="10" r="2.6"/><circle cx="24" cy="22" r="2.6"/><path d="M10.1 11.6 13.9 14.4M10.1 20.4 13.9 17.6M18.1 14.4 21.9 11.6M18.1 17.6 21.9 20.4"/>`,
  /* 原子:双椭圆轨道 + 核 */
  sci: `<circle cx="16" cy="16" r="2.2"/><ellipse cx="16" cy="16" rx="11" ry="4.6" transform="rotate(60 16 16)"/><ellipse cx="16" cy="16" rx="11" ry="4.6" transform="rotate(-60 16 16)"/>`,
  /* 气候:地球经纬 + 底部气流 */
  climate: `<circle cx="16" cy="13.5" r="8.5"/><ellipse cx="16" cy="13.5" rx="3.6" ry="8.5"/><path d="M8.2 13.5h15.6M6.5 27c3-2.2 6-2.2 9 0s6 2.2 9 0"/>`,
  /* 生物医药:苯环 + 侧链节点 */
  bio: `<path d="M21 17l-3.25 5.63h-6.5L8 17l3.25-5.63h6.5Z"/><path d="M17.75 11.37 21.78 7.58"/><circle cx="23.9" cy="5.6" r="2.2"/>`,
  /* 语言:对话气泡 + 声纹 */
  lang: `<rect x="5" y="6" width="22" height="15" rx="4.5"/><path d="M10.5 21v5l5.5-5M11.4 12.2v3.1M14.8 9.8v7.2M18.2 11.4v4.7M21.6 12.6v2.3"/>`,
  /* 教育:摊开的书 */
  edu: `<path d="M16 9.8V25M16 10c-3-2.2-6.5-2.8-10-2.4v15c3.5-.4 7 .2 10 2.4M16 10c3-2.2 6.5-2.8 10-2.4v15c-3.5-.4-7 .2-10 2.4"/>`,

  /* —— 信任(trust card1-5,按卡号不按版面序)—— */
  /* 注册实体:柱式登记处 */
  registry: `<path d="M5.5 12 16 5.5 26.5 12M8 12.6h16M9.5 16v7M16 16v7M22.5 16v7M7 26.5h18"/>`,
  /* 官网查册:文档 + 放大镜 */
  'verify-search': `<rect x="7" y="5" width="13.5" height="18" rx="2"/><path d="M10 10h7.5M10 13.5h7.5"/><circle cx="20.5" cy="19.5" r="4.6"/><path d="M23.9 22.9 27 26"/>`,
  /* MSB 已登记:盾 + 勾 */
  shield: `<path d="M16 5.5 25 8.8V15c0 6.8-3.6 10.6-9 12.5C10.6 25.6 7 21.8 7 15V8.8Z"/><path d="M12 15.8l3 3 5.4-5.9"/>`,
  /* 监管制度:天平 */
  scale: `<path d="M16 6.5v20M11 26.5h10M8 9.5h16M8 9.5 5 15.5M8 9.5l3 6M24 9.5l-3 6M24 9.5l3 6"/><path d="M5 15.5a3.2 3.2 0 0 0 6 0M21 15.5a3.2 3.2 0 0 0 6 0"/>`,
  /* 登记查询:清单 + 放大镜 */
  lookup: `<path d="M6.5 8.5H20M6.5 13.5h10M6.5 18.5h7.5"/><circle cx="20.5" cy="17.5" r="5"/><path d="M24.2 21.2 27.5 24.5"/>`,

  /* —— NEX(teaser 侧卡 + 内容页块头)—— */
  /* 产生/获得:代币 + 能量闪电 */
  'coin-bolt': `<circle cx="14" cy="17.5" r="7.5"/><path d="M15.2 13.8l-3.4 4.9h2.6l-1.4 4 3.4-4.9h-2.6Z"/><path d="M24.5 6.5v6M21.5 9.5h6"/>`,
  /* 用途:双向兑换箭头 */
  swap: `<path d="M6 11.5h18M20.5 8l3.5 3.5-3.5 3.5M26 20.5H8M11.5 17 8 20.5l3.5 3.5"/>`,
  /* 对比:双栏 */
  compare: `<rect x="6.5" y="7" width="8" height="18" rx="2"/><rect x="17.5" y="7" width="8" height="18" rx="2"/><path d="M9 12h3M20 12h3"/>`,
  /* 机制:电路节点 */
  mech: `<circle cx="16" cy="16" r="4"/><path d="M16 12V7.5M16 20v4.5M12 16H7.5M20 16h4.5"/><circle cx="16" cy="6" r="1.4"/><circle cx="16" cy="26" r="1.4"/><circle cx="6" cy="16" r="1.4"/><circle cx="26" cy="16" r="1.4"/>`,
  /* 常见问题:圆环问号 */
  faq: `<circle cx="16" cy="16" r="10.5"/><path d="M12.8 13c0-2.3 1.6-3.7 3.5-3.7 2 0 3.4 1.3 3.4 3.1 0 2.9-3.2 2.8-3.2 5.5M16.4 21.6v.01"/>`,
} as const;
---

{
  GLYPHS[name] && (
    <svg class={cls} viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={GLYPHS[name]} />
  )
}
