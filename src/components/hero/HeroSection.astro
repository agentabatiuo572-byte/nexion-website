---
/* [FEAT-WEB02] Hero — R8(画布 1440 等比制,对齐参考站首屏几何):
   区高 900→62.5vw;右置内容簇 725→50.35vw 列,标题左对齐 Mega 档(164→11.39vw)行遮罩,
   副题 16 mono 391→27.2vw 宽贴簇右缘,底部留白 220→15.28vw;
   scroll 指示器居左同底线;下载键(我方转化内容)挂副题下。文案 key 不变。 */
import DownloadButtons from './DownloadButtons.astro';
import { useT, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useT(locale);
---

<section class="hero" id="download">
  <div class="spacer" aria-hidden="true"></div>

  <div class="foot">
    <div class="left">
      <a class="scroll-hint x-mono" href="#stats">
        <span class="tick" aria-hidden="true"></span>
        <span class="txt">{t('hero.scrollHint')}</span>
      </a>
      <p class="note x-mono">{t('hero.note')}</p>
    </div>

    <div class="cluster">
      <h1 class="x-display-mega" data-lr="load" data-lr-delay="500">{t('hero.title')}</h1>
      <p class="sub x-mono-lg">{t('hero.subtitle')}</p>
      <div class="dl-wrap">
        <DownloadButtons locale={locale} />
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    z-index: 1;
    height: max(640px, calc(900 * var(--u)));
    display: flex;
    flex-direction: column;
    overflow: hidden;
    /* 底空 11.5vw:比画布 220 略收,换取 3 行标题簇整体让开右上导航列 */
    padding: calc(96 * var(--uc)) var(--x-pad) max(60px, calc(165.6 * var(--u)));
  }
  .spacer {
    flex: 1;
  }
  .foot {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: calc(32 * var(--uc));
  }
  .left {
    display: flex;
    flex-direction: column;
    gap: calc(18 * var(--uc));
    flex: 0 1 auto; /* 上限交给子元素各自的 max-width(hint 129 画布 / note 50ch) */
  }
  /* 刻度式指示器:竖线 + 两行小字(保留 a 壳与 44px 热区) */
  /* 画布制小字(R13):原版 12px @1440,随视口 ×1.333 上限 */
  .scroll-hint {
    color: var(--x-ink-dim);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: calc(6 * var(--uc));
    min-height: calc(44 * var(--uc));
    letter-spacing: -0.03em;
    font-size: max(12px, calc(12 * var(--u)));
  }
  :global(html[lang='zh']) .scroll-hint {
    font-size: max(12.5px, calc(12.5 * var(--u)));
  }
  /* 竖线=琥珀顶亮、向下淡出 10%;粗细 2px 起随画布放大(主人 R16 加粗) */
  .scroll-hint .tick {
    width: max(2px, calc(2 * var(--u)));
    height: max(24px, calc(24 * var(--u)));
    background: linear-gradient(to bottom, var(--x-accent-hot), color-mix(in srgb, var(--x-accent-hot) 10%, transparent));
    flex: 0 0 auto;
  }
  .scroll-hint .txt {
    max-width: max(129px, calc(129 * var(--u)));
  }
  .note {
    color: var(--x-ink-dim);
    margin: 0;
    max-width: 50ch; /* 容住焊定断行的首段(en/vi 各 48ch;zh 短句仍单行) */
    text-wrap: pretty;
    line-height: 1.5;
    white-space: pre-line; /* 文案内 \n 生效(en/vi 两行制,主人 R12/R13) */
    font-size: max(12px, calc(12 * var(--u)));
  }
  :global(html[lang='zh']) .note {
    font-size: max(12.5px, calc(12.5 * var(--u)));
  }
  /* 内容簇:右置列,标题左对齐、副题/下载键贴列右缘。
     宽度按语言定:en/vi 第二行长 → 列加宽(整体左移)换字号(主人 R9-4)。 */
  .cluster {
    width: calc(892.8 * var(--u));
    flex: 0 0 auto;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: max(24px, calc(48 * var(--u)));
  }
  :global(html[lang='vi']) .cluster {
    width: calc(950.4 * var(--u));
  }
  :global(html[lang='zh']) .cluster {
    width: calc(725 * var(--u));
  }
  /* 标题:i18n 文案带 \n 强制「NexGrid」独行(pre-line);
     vi 与 en 同字号(主人 R11 拍板),第二句自然折行、全题最多三行 */
  h1 {
    width: 100%;
    font-size: max(44px, calc(100.8 * var(--u)));
    color: var(--x-white);
    margin: 0;
    text-align: left;
    white-space: pre-line;
  }
  :global(html[lang='zh']) h1 {
    font-size: max(48px, calc(115.2 * var(--u)));
  }
  .sub {
    color: var(--x-white);
    margin: 0;
    /* R14:标准视口两行(45ch 容量);窄桌面字号撞 16px 下限后自然变三行,
       300px 下限保证最窄桌面也不落到四行 */
    width: max(300px, calc(439.2 * var(--u)));
    text-wrap: pretty;
    font-size: calc(16 * var(--uc)); /* 原版副题 16 @1440,随视口放大(R13) */
  }
  .dl-wrap :global(.dl) {
    justify-content: flex-end;
  }

  @media (max-width: 860px) {
    .hero {
      height: auto;
      min-height: 92svh;
      padding-top: calc(80 * var(--uc));
      padding-bottom: 10svh;
    }
    .foot {
      flex-direction: column;
      align-items: flex-start;
    }
    .cluster {
      width: 100% !important; /* 覆盖桌面按语言定宽 */
      align-items: flex-start;
    }
    h1 {
      font-size: max(40px, calc(88 * var(--u)));
    }
    :global(html[lang='zh']) h1 {
      font-size: max(44px, calc(92 * var(--u)));
    }
    .sub {
      width: auto;
      max-width: calc(420 * var(--uc));
    }
    .dl-wrap :global(.dl) {
      justify-content: flex-start;
    }
    .scroll-hint {
      display: none;
    }
  }
</style>
