---
/* [FEAT-WEB02] Hero — R8(画布 1440 等比制,对齐参考站首屏几何):
   区高 900→62.5vw;右置内容簇 725→50.35vw 列,标题左对齐 Mega 档(164→11.39vw)行遮罩,
   副题 16 mono 391→27.2vw 宽贴簇右缘,底部留白 220→15.28vw;
   scroll 指示器居左同底线;下载键(我方转化内容)挂副题下。文案 key 不变。 */
import DownloadButtons from './DownloadButtons.astro';
import { useT, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useT(locale);
---

<section class="hero">
  <div class="spacer" aria-hidden="true"></div>

  <div class="foot">
    <div class="left">
      <a class="scroll-hint x-mono" href="#stats">
        <span class="tick" aria-hidden="true"></span>
        <span class="txt">{t('hero.scrollHint')}</span>
      </a>
      {/* 两套文案各自成组,组内层级=首句亮、次句暗。
          2026-09-01 主人令「位置对调」:左下=toB 背书套装(subtitle/subtitle2),
          右下=品牌口号套装(note/note2,贴 h1 与下载键)。容器体制不动——
          左列恒为小字左对齐、右列恒为大字右对齐,对调的是文案不是版式。 */}
      <p class="note x-mono">{t('hero.subtitle')}</p>
      <p class="note2 x-mono">{t('hero.subtitle2')}</p>
    </div>

    <div class="cluster">
      <h1 class="x-display-mega" data-lr="load" data-lr-delay="200">{t('hero.title')}</h1>
      <div class="subs">
        <p class="sub x-mono-lg">{t('hero.note')}</p>
        <p class="sub2 x-mono">{t('hero.note2')}</p>
      </div>
      <div class="dl-wrap" id="download">
        <DownloadButtons locale={locale} />
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    z-index: 1;
    height: max(640px, calc(900 * var(--u)));
    display: flex;
    flex-direction: column;
    overflow: hidden;
    /* R49c 主人令(2026-08-31,附 vi 实景):vi 三行标题顶到导航、屏底大片空白——整组内容下沉屏底,
       底空 220→72(R45-B2 的 220 为护 1366×673 折叠线,本令覆盖;上方留白交给地球,标题随组下落) */
    padding: calc(96 * var(--uc)) var(--x-pad) max(48px, calc(72 * var(--u)));
  }
  .spacer {
    flex: 1;
  }
  .foot {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: calc(32 * var(--uc));
  }
  .left {
    display: flex;
    flex-direction: column;
    gap: calc(18 * var(--uc));
    flex: 0 1 auto; /* 上限交给子元素各自的 max-width(hint 129 画布 / note 50ch) */
  }
  /* 刻度式指示器:竖线 + 两行小字(保留 a 壳与 44px 热区) */
  /* 画布制小字(R13):原版 12px @1440,随视口 ×1.333 上限 */
  .scroll-hint {
    color: var(--x-ink-dim);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: calc(6 * var(--uc));
    min-height: var(--x-touch);
    letter-spacing: -0.03em; /* 参考站滚动提示同为 −0.03em(它的 12px 字距分两类,这一类保留) */
    font-size: max(12px, calc(12 * var(--u)));
  }
  .scroll-hint:lang(zh) {
    font-size: max(12.5px, calc(12.5 * var(--u)));
  }
  /* 竖线=琥珀顶亮、向下淡出 10%;粗细 2px 起随画布放大(主人 R16 加粗) */
  .scroll-hint .tick {
    width: max(2px, calc(2 * var(--u)));
    height: max(24px, calc(24 * var(--u)));
    background: linear-gradient(to bottom, var(--x-accent-hot), color-mix(in srgb, var(--x-accent-hot) 10%, transparent));
    flex: 0 0 auto;
  }
  .scroll-hint .txt {
    max-width: max(129px, calc(129 * var(--u)));
  }
  .note {
    color: var(--x-ink); /* R49b:第一套首句(主张)提亮,组内分层 */
    margin: 0;
    max-width: 50ch; /* 容住首段(09-01 对调后装 toB 首句:en/vi 自然折两行、zh 单行) */
    text-wrap: pretty;
    line-height: 1.5;
    white-space: pre-line; /* 文案内 \n 生效(en/vi 两行制,主人 R12/R13) */
    font-size: max(12px, calc(12 * var(--u)));
  }
  .note:lang(zh) {
    font-size: max(12.5px, calc(12.5 * var(--u)));
  }
  /* 内容簇:右置列,标题左对齐、副题/下载键贴列右缘。
     宽度按语言定:en/vi 第二行长 → 列加宽(整体左移)换字号(主人 R9-4)。 */
  .cluster {
    width: calc(892.8 * var(--u));
    flex: 0 0 auto;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: max(24px, calc(48 * var(--u)));
  }
  .cluster:lang(vi) {
    width: calc(950.4 * var(--u));
  }
  .cluster:lang(zh) {
    width: calc(725 * var(--u));
  }
  /* 标题:i18n 文案带 \n 强制「NexGrid」独行(pre-line);
     vi 与 en 同字号(主人 R11 拍板),第二句自然折行、全题最多三行 */
  h1 {
    width: 100%;
    font-size: max(44px, calc(100.8 * var(--u)));
    color: var(--x-white);
    margin: 0;
    text-align: left;
    white-space: pre-line;
  }
  h1:lang(zh) {
    font-size: max(48px, calc(115.2 * var(--u)));
  }
  /* 右下双层组:首句亮 + 次句暗一档小一档,右缘对齐成一组(09-01 起装品牌口号套装) */
  .subs {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: calc(10 * var(--uc));
  }
  .sub {
    color: var(--x-white);
    margin: 0;
    /* R14:标准视口两行(45ch 容量);窄桌面字号撞 16px 下限后自然变三行,
       300px 下限保证最窄桌面也不落到四行 */
    width: max(300px, calc(439.2 * var(--u)));
    text-wrap: pretty;
    text-align: right; /* R49b 主人令:右下套装整组右对齐(vi 两行曾左齐与次句错茬) */
    /* 🔴 pre-line 不能省(09-01 对调后):品牌口号的 vi 版焊了 \n 断在逗号处(语义断点),
       右列原先不认 \n(它装的 toB 首句没有焊断行)——不补这条,搬过来的断点会被静默折叠。 */
    white-space: pre-line;
    font-size: calc(16 * var(--uc)); /* 原版副题 16 @1440,随视口放大(R13) */
  }
  .sub2 {
    color: var(--x-ink-dim);
    margin: 0;
    width: max(300px, calc(439.2 * var(--u)));
    text-wrap: pretty;
    white-space: pre-line; /* 焊断行随文案走(09-01 对调后装零门槛句,三语均单行) */
    font-size: max(11px, calc(12 * var(--u)));
    text-align: right;
  }
  .note2 {
    color: var(--x-ink-dim);
    margin: 0;
    max-width: 50ch;
    text-wrap: pretty;
    line-height: 1.5;
    white-space: pre-line;
    font-size: max(11px, calc(11.5 * var(--u)));
    opacity: 0.85;
  }
  .dl-wrap :global(.dl) {
    justify-content: flex-end;
  }

  /* 窄屏共有的版式(与视口高无关):列改竖排、簇满宽、副题不定宽、滚动提示收起。
     🔴 与视口高有关的四个属性(.hero 高/上下内衬、h1 两档字号)**不写在这里** ——
     它们下面按高分档,两边抢同一个属性时若都靠 max-width 与 max-height 相交决胜,
     答案就藏在「谁写在后面」里,读单独一块永远看不出来。见下一块。 */
  @media (max-width: 860px) {
    .foot {
      flex-direction: column;
      align-items: flex-start;
    }
    .cluster {
      width: 100% !important; /* 覆盖桌面按语言定宽 */
      align-items: flex-start;
    }
    .subs {
      align-items: flex-start;
    }
    .sub,
    .sub2 {
      width: auto;
      max-width: calc(420 * var(--uc));
      text-align: left;
    }
    .dl-wrap :global(.dl) {
      justify-content: flex-start;
    }
    .scroll-hint {
      display: none;
    }
  }
  /* 竖屏手机档。与下面的矮视口块**互斥**(521 / 520 是同一条边界的两侧),不靠源序决胜 ——
     把「谁在这个视口赢」写进条件本身,读一块就知道它管哪片,挪动块的位置也不会改变行为。
     此前这四个属性和矮视口块正交相交:竖屏赢在高视口、横屏赢在矮视口,靠的是横屏块写在后面,
     一旦有人为了别的原因调整块序,横屏分支会整片静默失效(R45 前身就是这么坏的,而且没有任何反馈)。
     🔴 改 520 必须同步改这里的 521。 */
  @media (max-width: 860px) and (min-height: 521px) {
    .hero {
      height: auto;
      min-height: 92svh;
      padding-top: calc(80 * var(--uc));
      padding-bottom: 10svh;
    }
    /* 上限 = 断点另一侧的实算值取整下调,不是另挑一个好看的数:
       861 宽走桌面档 max(44px, 100.8·--u),--u = 0.0694444vw → 60.27px(zh 走 115.2·--u → 68.88px)。
       此前封顶 88 / 92,于是「窄一个像素反而大 46%」——尺寸随视口变窄而变大,是全站唯一的反向跳变。
       两档窄面本来就整体高于桌面梯子(11vw 恒大于 ≈7vw),所以边界必然有台阶,能做的是把台阶
       压到一像素内**并保证方向朝前**(窄的那侧更小);取整下调就是留这点方向余量。
       上限只在 ≥545px 宽处咬合(11vw = 60),手机档 390 仍是 42.9px,不受影响。
       改桌面档 h1 的系数会让这两个上限失配 —— 由门 render-fit 判据 D 逐档实测钉住,漂了会红。 */
    h1 {
      font-size: clamp(40px, 11vw, calc(60 * var(--uc)));
    }
    h1:lang(zh) {
      font-size: clamp(44px, 14vw, calc(68 * var(--uc)));
    }
  }
  /* 矮视口档(手机横放,也含被压扁的桌面窗口)。三条约束互相牵制,必须一起满足:
       ① 上内衬**从导航实高派生**,不写死 —— 导航高随宽度分档(画布单位 ≤860 是 54、>860 是 74),
          写死任何一个数都有一档错:此前写 80/64,1920×360 上标题的墨顶 68.5 对导航底沿 97.9,被压 29.4px。
          余量 22 是给大标题的墨留的:mega 档行高小于 1,墨会**冒出行盒顶部**,贴着底沿仍会被压。
          「--x-nav-h」的值由门 render-fit 判据 C 拿实测钉住,漂了会红。
       ② 腾地方从标题要 —— 844×390 下 h1 高 en 139 / zh 193 / vi 208.5,只按 en 配边距必然让 vi 与 zh 出屏;
       ③ 不限宽 —— 写 and (max-width:860px) 会漏掉两类:926×428 一类大屏横屏手机,以及被压扁的桌面窗口
          (桌面档 .hero 是定高 max(640px,900·--u) 且 overflow:hidden,不接管高度就直接把整簇裁掉)。 */
  @media (max-height: 520px) {
    .hero {
      height: auto; /* 接管桌面定高:>860 宽的矮窗口不走上面的竖屏档 */
      padding-top: calc(var(--x-nav-h) + 22 * var(--uc));
      padding-bottom: calc(24 * var(--uc)); /* 画布像素:本块不再限宽,svh 会在 ≥1440 被 zoom 二次放大 */
    }
    .cluster {
      gap: calc(12 * var(--uc));
    }
    /* 标题是矮视口里唯一还能腾出地方的东西(上内衬被导航底沿钉死、簇内间距已收到 12)。
       尺子按最吃高的那一面配:844×390 上 vi 是三行,en 两行 —— 只按 en 配,vi 与 zh 的下载键必掉出折叠线。
       🔴 vi 不单开小灶(主人 R11 拍板 vi 与 en 同字号),所以降的是共用档,en 因此比它自己需要的更小一点。 */
    h1 {
      font-size: clamp(26px, 6.6vw, calc(48 * var(--uc)));
    }
    h1:lang(zh) {
      font-size: clamp(26px, 7.2vw, calc(48 * var(--uc)));
    }
  }
  @media (max-height: 380px) {
    .hero {
      padding-top: calc(var(--x-nav-h) + 14 * var(--uc)); /* 同上;更矮的档余量收一点 */
      padding-bottom: calc(16 * var(--uc)); /* 同上 */
    }
    h1 {
      font-size: clamp(22px, 5.6vw, calc(40 * var(--uc)));
    }
    h1:lang(zh) {
      font-size: clamp(22px, 6.2vw, calc(40 * var(--uc)));
    }
  }
</style>
