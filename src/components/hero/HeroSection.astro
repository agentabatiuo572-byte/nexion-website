---
/* [FEAT-WEB02] Hero — R8(画布 1440 等比制,对齐参考站首屏几何):
   区高 900→62.5vw;右置内容簇 725→50.35vw 列,标题左对齐 Mega 档(164→11.39vw)行遮罩,
   副题 16 mono 391→27.2vw 宽贴簇右缘,底部留白 220→15.28vw;
   scroll 指示器居左同底线;下载键(我方转化内容)挂副题下。文案 key 不变。 */
import DownloadButtons from './DownloadButtons.astro';
import { useT, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useT(locale);
---

<section class="hero" id="download">
  <div class="spacer" aria-hidden="true"></div>

  <div class="foot">
    <div class="left">
      <a class="scroll-hint x-mono" href="#stats">
        <span class="tick" aria-hidden="true"></span>
        <span class="txt">{t('hero.scrollHint')}</span>
      </a>
      <p class="note x-mono">{t('hero.note')}</p>
    </div>

    <div class="cluster">
      <h1 class="x-display-mega" data-lr="load" data-lr-delay="500">{t('hero.title')}</h1>
      <p class="sub x-mono-lg">{t('hero.subtitle')}</p>
      <div class="dl-wrap">
        <DownloadButtons locale={locale} />
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    z-index: 1;
    height: clamp(640px, 62.5vw, 1200px);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    /* 底空 11.5vw:比画布 220 略收,换取 3 行标题簇整体让开右上导航列 */
    padding: 96px var(--x-pad) clamp(60px, 11.5vw, 220px);
  }
  .spacer {
    flex: 1;
  }
  .foot {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 32px;
  }
  .left {
    display: flex;
    flex-direction: column;
    gap: 18px;
    max-width: 320px;
    flex: 0 1 auto;
  }
  :global(html[lang='vi']) .left {
    max-width: 52ch; /* 随 note 两行制放宽(R12) */
  }
  /* 刻度式指示器:竖线 + 两行小字(保留 a 壳与 44px 热区) */
  .scroll-hint {
    color: var(--x-ink-dim);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    letter-spacing: -0.03em;
  }
  .scroll-hint .tick {
    width: 1px;
    height: 24px;
    background: var(--x-ink-faint);
    flex: 0 0 auto;
  }
  .scroll-hint .txt {
    max-width: 129px;
  }
  .note {
    color: var(--x-ink-dim);
    margin: 0;
    max-width: 300px;
    text-wrap: pretty;
    line-height: 1.5;
    white-space: pre-line; /* 文案内 \n 生效(vi 两行制,主人 R12) */
  }
  :global(html[lang='vi']) .note {
    max-width: 50ch; /* 容住焊定的第一行(48ch),恒两行 */
  }
  /* 内容簇:右置列,标题左对齐、副题/下载键贴列右缘。
     宽度按语言定:en/vi 第二行长 → 列加宽(整体左移)换字号(主人 R9-4)。 */
  .cluster {
    width: min(62vw, 1190px);
    flex: 0 0 auto;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: clamp(24px, 3.33vw, 64px);
  }
  :global(html[lang='vi']) .cluster {
    width: min(66vw, 1268px);
  }
  :global(html[lang='zh']) .cluster {
    width: min(50.35vw, 967px);
  }
  /* 标题:i18n 文案带 \n 强制「NexGrid」独行(pre-line);
     vi 与 en 同字号(主人 R11 拍板),第二句自然折行、全题最多三行 */
  h1 {
    width: 100%;
    font-size: clamp(44px, 7vw, 134px);
    color: var(--x-white);
    margin: 0;
    text-align: left;
    white-space: pre-line;
  }
  :global(html[lang='zh']) h1 {
    font-size: clamp(48px, 8vw, 154px);
  }
  .sub {
    color: var(--x-white);
    margin: 0;
    width: min(27.2vw, 521px);
    text-wrap: pretty;
  }
  .dl-wrap :global(.dl) {
    justify-content: flex-end;
  }

  @media (max-width: 860px) {
    .hero {
      height: auto;
      min-height: 92svh;
      padding-top: 80px;
      padding-bottom: 10svh;
    }
    .foot {
      flex-direction: column;
      align-items: flex-start;
    }
    .cluster {
      width: 100% !important; /* 覆盖桌面按语言定宽 */
      align-items: flex-start;
    }
    h1 {
      font-size: clamp(40px, 11vw, 88px);
    }
    :global(html[lang='zh']) h1 {
      font-size: clamp(44px, 14vw, 92px);
    }
    .sub {
      width: auto;
      max-width: 420px;
    }
    .dl-wrap :global(.dl) {
      justify-content: flex-start;
    }
    .scroll-hint {
      display: none;
    }
  }
</style>
