---
/* [FEAT-WEB02] Hero — axiom 方向:全屏陈述式首屏,固定洛伦兹粒子层透底,
   巨型 display 标题右锚 + 等宽角注 + 下载键。文案 key 一个不变。 */
import DownloadButtons from './DownloadButtons.astro';
import { useT, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useT(locale);
---

<section class="hero" id="download">
  <div class="spacer" aria-hidden="true"></div>

  <h1 data-rv>{t('hero.title')}</h1>

  <div class="foot">
    <div class="left">
      <a class="scroll-hint x-mono x-dimlink" href="#stats" data-rv style="--d:.25s">
        {t('hero.scrollHint')}<span class="arr" aria-hidden="true">↓</span>
      </a>
      <p class="note x-mono" data-rv style="--d:.35s">{t('hero.note')}</p>
    </div>
    <div class="right">
      <p class="sub x-mono" data-rv style="--d:.15s">{t('hero.subtitle')}</p>
      <div data-rv style="--d:.3s">
        <DownloadButtons locale={locale} />
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    z-index: 1;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    padding: 96px var(--x-pad) 40px;
  }
  .spacer {
    flex: 1;
  }
  h1 {
    font-family: var(--x-font-display);
    font-size: clamp(52px, 9.6vw, 148px);
    line-height: 1.02;
    font-weight: 500;
    letter-spacing: -0.035em;
    color: var(--x-white);
    margin: 0 0 clamp(28px, 5vh, 56px);
    text-align: right;
    text-wrap: balance;
  }
  .foot {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 32px;
  }
  .left {
    display: flex;
    flex-direction: column;
    gap: 18px;
    max-width: 320px;
  }
  .scroll-hint {
    color: var(--x-ink-faint);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
  }
  .scroll-hint .arr {
    color: var(--x-accent);
  }
  .note {
    color: var(--x-ink-dim);
    margin: 0;
    text-wrap: pretty;
  }
  .right {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 22px;
  }
  .sub {
    color: var(--x-white);
    margin: 0;
    max-width: 430px;
    text-align: right;
    text-wrap: pretty;
  }
  .right :global(.dl) {
    justify-content: flex-end;
  }

  @media (max-width: 860px) {
    .hero {
      padding-top: 80px;
      min-height: 92svh;
    }
    h1 {
      text-align: left;
      font-size: clamp(44px, 12.5vw, 84px);
    }
    .foot {
      flex-direction: column;
      align-items: flex-start;
    }
    .right {
      align-items: flex-start;
    }
    .sub {
      text-align: left;
    }
    .right :global(.dl) {
      justify-content: flex-start;
    }
    .scroll-hint {
      display: none;
    }
  }
</style>
