---
/* [FEAT-WEB02/12] Shared entry links: desktop QR, mobile OS routing.
   Missing/disabled destinations open an explanatory state; no fake download URLs.
   Hero and final CTA consume the same config and distribution controller. */
import { useT, type Locale } from '../../i18n';
import { DOWNLOAD_URLS } from '../../lib/downloads';
import { distributionPath } from '../../lib/distribution';
import PlatformGlyph from '../download/PlatformGlyph.astro';

interface Props {
  locale: Locale;
  /** Hero controls can use the compact floating layout on narrow screens. */
  compact?: boolean;
  /** Keep the dark glass readable when used over a light section. */
  onLight?: boolean;
}
const { locale, onLight = false, compact = false } = Astro.props;
const t = useT(locale);
const IOS = DOWNLOAD_URLS.ios;
const ANDROID = DOWNLOAD_URLS.android;
const H5 = DOWNLOAD_URLS.h5;
const btns = [
  { id: 'auto', url: IOS || ANDROID, label: t('distribution.downloadApp'), accessibleLabel: t('distribution.downloadApp') },
  { id: 'ios', url: IOS, label: 'iOS', accessibleLabel: t('download.ios') },
  { id: 'android', url: ANDROID, label: 'Android', accessibleLabel: t('download.android') },
  { id: 'h5', url: H5, label: t('nav.launchH5'), accessibleLabel: t('distribution.openH5') },
] as const;
---

<div class:list={['dl', { 'dl-compact': compact }]}>
  {
    btns.map((b) => (
      /* Keep xbtn as the existing hero/floating layout hook, without slide-swap layers. */
      <a
        class:list={['xbtn', 'dl-button', { 'on-light': onLight }]}
        aria-label={b.accessibleLabel}
        title={compact ? b.accessibleLabel : undefined}
        data-m={b.url ? `cta:${b.id}` : undefined}
        data-download-entry={b.id}
        href={distributionPath(locale, b.id)}
      >
        <span class="ic">
          {b.id === 'auto' ? (
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 3v12m-5-5 5 5 5-5M5 16v5h14v-5" />
            </svg>
          ) : <PlatformGlyph platform={b.id} />}
        </span>
        <span class="dl-label">{b.label}</span>
      </a>
    ))
  }
</div>

<style>
  .dl {
    display: flex;
    gap: calc(12 * var(--uc));
    flex-wrap: wrap;
  }
  .dl .dl-button {
    --platform-glyph-cutout: var(--x-bg);
    position: relative;
    isolation: isolate;
    overflow: visible;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: calc(10 * var(--uc));
    min-width: var(--x-touch);
    min-height: max(44px, var(--x-touch));
    padding: 0 calc(22 * var(--uc));
    border: 1px solid color-mix(in srgb, var(--x-white) 44%, transparent);
    border-radius: calc(999 * var(--uc));
    background:
      linear-gradient(135deg, color-mix(in srgb, var(--x-white) 10%, transparent), transparent 48%, color-mix(in srgb, var(--x-white) 3%, transparent)),
      rgb(var(--x-bg-rgb) / 0.32);
    color: var(--x-white);
    box-shadow:
      inset 0 1px 0 color-mix(in srgb, var(--x-white) 18%, transparent),
      inset 0 -1px 0 color-mix(in srgb, var(--x-white) 4%, transparent);
    -webkit-backdrop-filter: blur(12px) saturate(1.4);
    backdrop-filter: blur(12px) saturate(1.4);
    font-family: var(--x-font-display);
    font-size: max(14px, calc(14 * var(--uc)));
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: 0;
    text-transform: none;
    text-decoration: none;
    opacity: 1;
    transition: border-color 480ms ease-out;
  }
  .dl .dl-button[data-download-entry='auto'] {
    display: none;
  }
  .dl-button::before,
  .dl-button::after {
    content: '';
    position: absolute;
    inset: -1px;
    border-radius: inherit;
    pointer-events: none;
    opacity: 0;
    transition: opacity 480ms ease-out;
  }
  /* Close rim and broad diffused halo fade separately; content stays crisp and still. */
  .dl-button::before {
    z-index: 0;
    box-shadow:
      0 0 10px color-mix(in srgb, var(--x-accent) 24%, transparent),
      inset 0 0 12px color-mix(in srgb, var(--x-accent) 7%, transparent);
  }
  .dl-button::after {
    z-index: -1;
    box-shadow: 0 0 24px 6px color-mix(in srgb, var(--x-accent) 14%, transparent);
    filter: blur(12px);
  }
  .dl .dl-button:is(:hover, :focus-visible, [aria-expanded='true']) {
    border-color: color-mix(in srgb, var(--x-accent) 88%, var(--x-white));
    transition-duration: 360ms;
  }
  .dl-button:is(:hover, :focus-visible, [aria-expanded='true'])::before,
  .dl-button:is(:hover, :focus-visible, [aria-expanded='true'])::after {
    opacity: 1;
    transition-duration: 360ms;
  }
  .dl .dl-button.on-light {
    background:
      linear-gradient(135deg, color-mix(in srgb, var(--x-white) 6%, transparent), transparent 60%),
      rgb(var(--x-bg-rgb) / 0.72);
  }
  .ic,
  .dl-label {
    position: relative;
    z-index: 1;
  }
  .ic {
    width: calc(20 * var(--uc));
    height: calc(20 * var(--uc));
    flex: 0 0 auto;
    display: block;
  }
  .ic :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }
  @media (max-width: 860px) {
    /* The floating controls cross white certificate images. Keep a transparent
       smoked surface there so white labels retain contrast over any page content. */
    :global(.floating) .dl-compact .dl-button {
      background-color: rgb(var(--x-bg-rgb) / 0.64);
    }
    :global(.floating) .dl-compact .ic {
      width: 24px;
      height: 24px;
    }
  }
  @media (max-width: 760px) {
    .dl .dl-button:is([data-download-entry='ios'], [data-download-entry='android']) {
      display: none;
    }
    .dl .dl-button[data-download-entry='auto'] {
      display: inline-flex;
    }
  }
  @media (max-width: 520px) {
    .dl {
      flex-direction: column;
      align-items: stretch;
    }
    .dl .dl-button {
      justify-content: center;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .dl .dl-button,
    .dl .dl-button::before,
    .dl .dl-button::after {
      transition: none;
    }
  }
</style>
