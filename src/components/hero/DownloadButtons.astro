---
/* [FEAT-WEB02/12] 下载三键 — hero 与收尾 CTA 共用同组件同配置(PRD ⑦ 单源)。
   URL 未配置的键:iOS/Android → Coming soon 禁用态;H5 → 不渲染。零死链(异常1)。
   axiom 方向:slide-swap 等宽按钮(hover 文字滑出/滑入)。 */
import { useT, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
  /** 反白区块内使用时置 true(边框/文字换深色) */
  onLight?: boolean;
}
const { locale, onLight = false } = Astro.props;
const t = useT(locale);
const IOS = import.meta.env.PUBLIC_IOS_URL ?? '';
const ANDROID = import.meta.env.PUBLIC_ANDROID_URL ?? '';
const H5 = import.meta.env.PUBLIC_H5_URL ?? '';
const allEmpty = !IOS && !ANDROID && !H5;
const lightCls = onLight ? 'on-light' : '';
---

<div class="dl" data-empty={allEmpty ? 'true' : undefined}>
  {
    IOS ? (
      <a class:list={['xbtn', 'solid', lightCls]} href={IOS} target="_blank" rel="noopener">
        <span class="xbtn-ghost">{t('download.appStore')} <span class="arr">→</span></span>
        <span class="xbtn-a">{t('download.appStore')} <span class="arr">→</span></span>
        <span class="xbtn-b">{t('download.appStore')} <span class="arr">→</span></span>
      </a>
    ) : (
      <span class:list={['xbtn', 'disabled', lightCls]} aria-disabled="true">
        <span class="static">{t('download.comingSoonIos')}</span>
      </span>
    )
  }
  {
    ANDROID ? (
      <a class:list={['xbtn', 'solid', lightCls]} href={ANDROID} target="_blank" rel="noopener">
        <span class="xbtn-ghost">{t('download.googlePlay')} <span class="arr">→</span></span>
        <span class="xbtn-a">{t('download.googlePlay')} <span class="arr">→</span></span>
        <span class="xbtn-b">{t('download.googlePlay')} <span class="arr">→</span></span>
      </a>
    ) : (
      <span class:list={['xbtn', 'disabled', lightCls]} aria-disabled="true">
        <span class="static">{t('download.comingSoonAndroid')}</span>
      </span>
    )
  }
  {
    H5 && (
      <a class:list={['xbtn', lightCls]} href={H5} target="_blank" rel="noopener">
        <span class="xbtn-ghost">{t('nav.launchH5')} <span class="arr">↗</span></span>
        <span class="xbtn-a">{t('nav.launchH5')} <span class="arr">↗</span></span>
        <span class="xbtn-b">{t('nav.launchH5')} <span class="arr">↗</span></span>
      </a>
    )
  }
</div>

<style>
  .dl {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }
  .static {
    display: inline-flex;
    align-items: center;
  }
  @media (max-width: 520px) {
    .dl {
      flex-direction: column;
      align-items: stretch;
    }
    .dl :global(.xbtn) {
      justify-content: center;
    }
  }
</style>
