---
/* [FEAT-WEB02/12] 下载三键 — R9(主人 2026-08-21 第一屏令⑤):
   文案改「iOS 下载 / Android 下载 / H5 版入口」,iOS/Android 带自绘平台图标;
   H5 键恒渲染。URL 未配置 → 同文案禁用态(零死链,异常1)。
   hero 与收尾 CTA 共用同组件同配置(PRD ⑦ 单源)。
   R49b(主人 2026-08-31):coming-soon 说明行撤除——下载地址后台即将接配,禁用态为纯开发期过渡;
   data-empty 钩子随之退役(钩子与消费方同生同灭,state-hook 门 0 EMIT 即静默)。 */
import { useT, type Locale } from '../../i18n';
import { DOWNLOAD_URLS } from '../../lib/downloads';

interface Props {
  locale: Locale;
  /** 反白区块内使用时置 true(边框/文字换深色) */
  onLight?: boolean;
}
const { locale, onLight = false } = Astro.props;
const t = useT(locale);
const IOS = DOWNLOAD_URLS.ios;
const ANDROID = DOWNLOAD_URLS.android;
const H5 = DOWNLOAD_URLS.h5;
const lightCls = onLight ? 'on-light' : '';

const btns = [
  { id: 'ios', url: IOS, label: t('download.ios'), icon: 'apple', solid: true, arr: '→' },
  { id: 'android', url: ANDROID, label: t('download.android'), icon: 'android', solid: true, arr: '→' },
  { id: 'h5', url: H5, label: t('nav.launchH5'), icon: 'h5', solid: false, arr: '↗' },
];
---

<div class="dl">
  {
    btns.map((b) => {
      const inner = (
        <>
          {b.icon === 'apple' && (
            <svg class="ic" viewBox="0 0 24 24" aria-hidden="true">
              <path
                fill="currentColor"
                d="M16.9 12.7c0-2 1.6-3 1.7-3.1-.9-1.4-2.4-1.6-2.9-1.6-1.3-.1-2.5.7-3.1.7-.6 0-1.6-.7-2.7-.7-1.4 0-2.7.8-3.4 2.1-1.4 2.5-.4 6.2 1 8.2.7 1 1.5 2.1 2.6 2.1 1 0 1.4-.7 2.7-.7 1.2 0 1.6.7 2.7.7 1.1 0 1.8-1 2.5-2 .8-1.2 1.1-2.3 1.1-2.4 0-.1-2.2-.9-2.2-3.3z"
              />
              <path fill="currentColor" d="M14.2 6c.6-.7 1-1.7.9-2.7-.9 0-1.9.6-2.5 1.3-.5.6-1 1.6-.9 2.6 1 .1 1.9-.5 2.5-1.2z" />
            </svg>
          )}
          {b.icon === 'android' && (
            <svg class="ic" viewBox="0 0 24 24" aria-hidden="true">
              <path
                d="M5.8 14.2c.3-3.1 3-5.4 6.2-5.4s5.9 2.3 6.2 5.4z"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linejoin="round"
              />
              <path d="M8.4 9.7 7 7.4M15.6 9.7 17 7.4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
              <circle cx="9.4" cy="12.3" r="0.9" fill="currentColor" />
              <circle cx="14.6" cy="12.3" r="0.9" fill="currentColor" />
            </svg>
          )}
          {b.label} <span class="arr">{b.arr}</span>
        </>
      );
      /* 未配 URL 的档走 aria-disabled 而不是原生 disabled —— 按 APG,禁用态的键**仍要可聚焦**:
         不给 tabindex,键盘与朗读器的焦点模式就永远碰不到它,也就听不到「不可用」这件事。
         独立可用性评审实测:390 档 Tab 序从汉堡键直接跳到页尾 CTA,三颗主键整段被跳过。 */
      return b.url ? (
        // data-m:埋点标识(官网后台 PRD CON15;hero+收尾 CTA 共用本单源,禁用态不计转化)
        <a class:list={['xbtn', { solid: b.solid }, lightCls]} data-m={`cta:${b.id}`} href={b.url} target="_blank" rel="noopener">
          <span class="xbtn-ghost" aria-hidden="true">{inner}</span>
          <span class="xbtn-a">{inner}</span>
          <span class="xbtn-b" aria-hidden="true">{inner}</span>
        </a>
      ) : (
        // 原生 button 而不是 span[role=button]:后者按空格会滚页(独立评审实测 scrollY 0 → 738),
        // 空格正是这类件的标准激活键,按下去既无反馈又把人甩下大半屏。原生按钮不滚页。
        // 仍用 aria-disabled 而非原生 disabled —— 原生 disabled 会连焦点一起拿掉。
        <button type="button" class:list={['xbtn', 'disabled', lightCls]} aria-disabled="true">
          <span class="static">{inner}</span>
        </button>
      );
    })
  }
</div>

<style>
  .dl {
    display: flex;
    gap: calc(12 * var(--uc));
    flex-wrap: wrap;
  }
  /* 保留品牌拼写(iOS/Android 小写规范),不吃 xbtn 的全大写制式 */
  .dl :global(.xbtn) {
    text-transform: none;
  }
  .ic {
    width: calc(15 * var(--uc));
    height: calc(15 * var(--uc));
    flex: 0 0 auto;
    display: block;
  }
  .static {
    display: inline-flex;
    align-items: center;
    gap: calc(8 * var(--uc));
  }
  @media (max-width: 520px) {
    .dl {
      flex-direction: column;
      align-items: stretch;
    }
    .dl :global(.xbtn) {
      justify-content: center;
    }
  }
</style>
