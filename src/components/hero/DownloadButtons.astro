---
/* [FEAT-WEB02/12] 首页与收尾共用下载入口。
   iOS/Android 点击时由同源 API 读取 A3，H5 指向正式 Web App。 */
import { useT, type Locale } from '../../i18n';
import { DOWNLOAD_URLS } from '../../lib/downloads';

interface Props {
  locale: Locale;
  /** Hero controls can switch to compact platform icons on narrow screens. */
  compact?: boolean;
  /** 反白区块内使用时置 true(边框/文字换深色) */
  onLight?: boolean;
}
const { locale, onLight = false, compact = false } = Astro.props;
const t = useT(locale);
const IOS = DOWNLOAD_URLS.ios;
const ANDROID = DOWNLOAD_URLS.android;
const H5 = DOWNLOAD_URLS.h5;
const lightCls = onLight ? 'on-light' : '';

const btns = [
  { id: 'ios', url: IOS, label: t('download.ios'), icon: 'apple', solid: true, arr: '→' },
  { id: 'android', url: ANDROID, label: t('download.android'), icon: 'android', solid: true, arr: '→' },
  { id: 'h5', url: H5, label: t('nav.launchH5'), icon: 'h5', solid: false, arr: '↗' },
];
---

<div class="dl">
  {
    btns.map((b) => {
      const inner = (
        <>
          {b.icon === 'apple' && (
            <svg class="ic" viewBox="0 0 24 24" aria-hidden="true">
              <path
                fill="currentColor"
                d="M16.9 12.7c0-2 1.6-3 1.7-3.1-.9-1.4-2.4-1.6-2.9-1.6-1.3-.1-2.5.7-3.1.7-.6 0-1.6-.7-2.7-.7-1.4 0-2.7.8-3.4 2.1-1.4 2.5-.4 6.2 1 8.2.7 1 1.5 2.1 2.6 2.1 1 0 1.4-.7 2.7-.7 1.2 0 1.6.7 2.7.7 1.1 0 1.8-1 2.5-2 .8-1.2 1.1-2.3 1.1-2.4 0-.1-2.2-.9-2.2-3.3z"
              />
              <path fill="currentColor" d="M14.2 6c.6-.7 1-1.7.9-2.7-.9 0-1.9.6-2.5 1.3-.5.6-1 1.6-.9 2.6 1 .1 1.9-.5 2.5-1.2z" />
            </svg>
          )}
          {b.icon === 'android' && (
            <svg class="ic" viewBox="0 0 24 24" aria-hidden="true">
              <path
                d="M5.8 14.2c.3-3.1 3-5.4 6.2-5.4s5.9 2.3 6.2 5.4z"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linejoin="round"
              />
              <path d="M8.4 9.7 7 7.4M15.6 9.7 17 7.4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
              <circle cx="9.4" cy="12.3" r="0.9" fill="currentColor" />
              <circle cx="14.6" cy="12.3" r="0.9" fill="currentColor" />
            </svg>
          )}
          {compact && b.icon === 'h5' && (
            <svg class="ic web-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <circle cx="12" cy="12" r="9" />
              <ellipse cx="12" cy="12" rx="4" ry="9" />
              <path d="M3 12h18M5 6.5h14M5 17.5h14" />
            </svg>
          )}
          <span class="dl-label">{b.label}</span> <span class="arr">{b.arr}</span>
        </>
      );
      return (
        // data-m:埋点标识(官网后台 PRD CON15;hero+收尾 CTA 共用本单源,禁用态不计转化)
        <a class:list={['xbtn', { solid: b.solid }, lightCls]} aria-label={compact ? b.label : undefined} title={compact ? b.label : undefined} data-m={`cta:${b.id}`} href={b.url} target="_blank" rel="noopener">
          <span class="xbtn-ghost" aria-hidden="true">{inner}</span>
          <span class="xbtn-a">{inner}</span>
          <span class="xbtn-b" aria-hidden="true">{inner}</span>
        </a>
      );
    })
  }
</div>

<style>
  .dl {
    display: flex;
    gap: calc(12 * var(--uc));
    flex-wrap: wrap;
  }
  /* 保留品牌拼写(iOS/Android 小写规范),不吃 xbtn 的全大写制式 */
  .dl :global(.xbtn) {
    text-transform: none;
  }
  .ic {
    width: calc(15 * var(--uc));
    height: calc(15 * var(--uc));
    flex: 0 0 auto;
    display: block;
  }
  .web-icon {
    display: none;
  }
  @media (max-width: 860px) {
    :global(.floating) .dl-label,
    :global(.floating) .arr {
      display: none;
    }
    :global(.floating) .ic {
      width: 24px;
      height: 24px;
    }
    :global(.floating) .web-icon {
      display: block;
    }
  }
  @media (max-width: 520px) {
    .dl {
      flex-direction: column;
      align-items: stretch;
    }
    .dl :global(.xbtn) {
      justify-content: center;
    }
  }
</style>
