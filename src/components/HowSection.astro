---
/* [FEAT-WEB05] How it works — R7(解剖报告 P1-24/25 部分/26/28,P2-19):
   无盒左线开放列;标题升 48 档行遮罩(100ms×卡序);编号墨 0.8 打字机;
   等高线图入流;三列滚动视差 k=[0.06,0.11,0.16]。
   机制表述与 App PRD §1.1/§6 一致;不提具体金额(PRD §1.4-1)。 */
import { useT, type Locale } from '../i18n';
import { contour } from '../lib/contour';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useT(locale);
const steps = [1, 2, 3] as const;
const arts = [contour(101, 12, 393, 237), contour(202, 12, 393, 237), contour(303, 12, 393, 237)];
const ks = [0.06, 0.11, 0.16];
---

<section class="how x-invert" id="how">
  <div class="head">
    <span class="x-label lab" data-tw>{t('how.title')}</span>
  </div>
  <div class="steps">
    {
      steps.map((n) => (
        <article class="step rv-fade" data-rv data-plx={ks[n - 1]}>
          <p class="meta x-mono" data-tw data-tw-delay={160 * (n - 1)}>0{n}</p>
          <h3 class="x-display" data-lr data-lr-delay={100 * (n - 1)}>{t(`how.step${n}Title`)}</h3>
          <svg class="art" viewBox={arts[n - 1].viewBox} preserveAspectRatio="xMidYMid slice" aria-hidden="true">
            {arts[n - 1].paths.map((d) => (
              <path d={d} fill="none" stroke="var(--x-dark)" stroke-width="1" opacity="0.5" />
            ))}
          </svg>
          <p class="x-mono body">
            {t(`how.step${n}Desc`)}
            {n === 3 && (
              <>
                {' '}
                <a class="vlink" href="#trust">
                  {t('how.verifyLink')} →
                </a>
              </>
            )}
          </p>
        </article>
      ))
    }
  </div>
</section>

<style>
  .how {
    padding: 0 var(--x-pad) var(--x-section-gap);
  }
  .head {
    border-top: 1px solid var(--x-line-dark);
    padding-top: 18px;
    margin-bottom: clamp(28px, 4vw, 52px);
  }
  .lab {
    color: var(--x-ink);
  }
  .steps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: clamp(24px, 4.2vw, 60px);
  }
  .step {
    border-left: 1px solid var(--x-line-dark);
    padding-left: 20px;
    display: grid;
    gap: 24px;
    align-content: start;
    will-change: transform;
  }
  .meta {
    color: var(--x-dark-cap);
    margin: 0;
  }
  .step h3 {
    font-size: clamp(28px, 3.33vw, 48px);
    color: var(--x-ink);
    margin: 0;
  }
  .art {
    width: 100%;
    aspect-ratio: 393 / 237;
    display: block;
  }
  .step .body {
    color: var(--x-dark-cap);
    margin: 0;
    text-wrap: pretty;
    line-height: 1.45;
  }
  .vlink {
    color: var(--x-ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .vlink:hover {
    opacity: 0.6;
  }
  .vlink:active {
    opacity: 0.45;
  }
  @media (max-width: 768px) {
    .step {
      border-left: 0;
      border-top: 1px solid var(--x-line-dark);
      padding: 20px 0 0;
    }
  }
</style>
