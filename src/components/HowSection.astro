---
/* [FEAT-WEB05] How it works — 三步机制卡。axiom 方向:反白区块延续,
   序号 01-03 + display 标题 + 等宽正文 + 等高线纹样。
   机制表述与 App PRD §1.1/§6 一致;不提具体金额(PRD §1.4-1)。 */
import { useT, type Locale } from '../i18n';
import { contour } from '../lib/contour';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useT(locale);
const steps = [1, 2, 3] as const;
const arts = [contour(101, 12, 360, 220), contour(202, 12, 360, 220), contour(303, 12, 360, 220)];
---

<section class="how x-invert" id="how">
  <div class="head">
    <span class="x-label lab" data-rv>{t('how.title')}</span>
  </div>
  <div class="steps">
    {
      steps.map((n) => (
        <article class="step" data-rv style={`--d:${(n - 1) * 0.12}s`}>
          <svg class="art" viewBox={arts[n - 1].viewBox} preserveAspectRatio="xMidYMid slice" aria-hidden="true">
            {arts[n - 1].paths.map((d) => (
              <path d={d} fill="none" stroke="var(--x-dark)" stroke-width="1" opacity="0.5" />
            ))}
          </svg>
          <span class="n x-mono">0{n}</span>
          <h3>{t(`how.step${n}Title`)}</h3>
          <p class="x-mono">
            {t(`how.step${n}Desc`)}
            {n === 3 && (
              <>
                {' '}
                <a class="vlink" href="#trust">
                  {t('how.verifyLink')} →
                </a>
              </>
            )}
          </p>
        </article>
      ))
    }
  </div>
</section>

<style>
  .how {
    padding: 0 var(--x-pad) var(--x-section-gap);
  }
  .head {
    border-top: 1px solid var(--x-line-dark);
    padding-top: 18px;
    margin-bottom: clamp(28px, 4vw, 52px);
  }
  .lab {
    color: var(--x-dark);
  }
  .steps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: clamp(20px, 3vw, 40px);
  }
  .step {
    position: relative;
    border: 1px solid var(--x-line-dark);
    padding: clamp(22px, 2.6vw, 34px);
    display: grid;
    gap: 14px;
    align-content: start;
    overflow: hidden;
    min-height: 300px;
  }
  .art {
    position: absolute;
    left: -10%;
    bottom: -14%;
    width: 80%;
    height: 60%;
    opacity: 0.14;
    pointer-events: none;
  }
  .n {
    color: var(--x-accent);
    font-weight: 700;
  }
  .step h3 {
    font-family: var(--x-font-display);
    font-size: clamp(22px, 2.2vw, 30px);
    font-weight: 500;
    letter-spacing: -0.015em;
    line-height: 1.12;
    color: var(--x-dark);
    margin: 0;
    text-wrap: balance;
    position: relative;
  }
  .step p {
    color: var(--x-dark-dim);
    margin: 0;
    text-wrap: pretty;
    position: relative;
  }
  .vlink {
    color: var(--x-dark);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .vlink:hover {
    opacity: 0.6;
  }
  .vlink:active {
    opacity: 0.45;
  }
</style>
