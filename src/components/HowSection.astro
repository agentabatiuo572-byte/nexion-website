---
/* [FEAT-WEB05] How it works — R48 玻璃重构(章 01,B+C 杂交):
   章头 = 幽灵编号 01(右)+ 16 mono 打字机 kicker + 44 档双段陈述(head1 亮 / head2 dim);
   三步改玻璃瓷砖(x-tile),瓷砖内保留「编号↔类目」两端行、48→24 档标题、等高线图、正文;
   打字机 / 行遮罩 / 进场 / 三列视差钩子(data-tw/lr/rv/plx)全部沿用,k 值不变。
   机制表述与 App PRD §1.1/§6 一致;不提具体金额(PRD §1.4-1)。
   正文使用共享 x-copy；验证链接继续由 padding 保证至少 44px 的命中高度。 */
import { useT, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useT(locale);
const steps = [1, 2, 3] as const;
/* R48.9 主人令:等高线占位图换实景生成图(gpt-image-2,黑底柠檬光同族)——
   按步内容配景:接入=手机+光缆 / 计算=GPU 散热鳍 / 结算=光纤光点;纯装饰 alt 空 */
const arts = ['/art-how-connect.webp', '/art-how-compute.webp', '/art-how-settle.webp'];
/* 抄参考站实测的三段视差系数,R48 沿用(瓷砖化不改滚动手感) */
const ks = [0.057, 0.099, 0.138];
---

<section class="how" id="how">
  <div class="head">
    <span class="x-ghost ghost" aria-hidden="true">01</span>
    <p class="lab x-mono-lg" data-tw>{t('how.title')}</p>
    <div class="statements x-display">
      <h2 data-lr>{t('how.head1')}</h2>
      <p data-lr data-lr-delay="120">{t('how.head2')}</p>
    </div>
  </div>

  <div class="steps">
    {
      steps.map((n) => (
        <article class="step x-tile rv-fade" data-rv data-plx={ks[n - 1]}>
          <p class="metarow x-mono">
            <span data-tw data-tw-delay={160 * (n - 1)}>0{n}</span>
            <span data-tw data-tw-delay={160 * (n - 1) + 120}>{t(`how.cat${n}`)}</span>
          </p>
          <div class="stack">
            <h3 class="x-display" data-lr data-lr-delay={100 * (n - 1)}>{t(`how.step${n}Title`)}</h3>
            <img class="art" src={arts[n - 1]} alt="" width="1280" height="853" loading="lazy" decoding="async" />
            <p class="x-copy body">
              {t(`how.step${n}Desc`)}
              {n === 3 && (
                <>
                  {' '}
                  <a class="vlink" href="#poc">
                    {t('how.verifyLink')} →
                  </a>
                </>
              )}
            </p>
          </div>
        </article>
      ))
    }
  </div>
</section>

<style>
  .how {
    padding: 0 var(--x-pad);
  }
  /* 章头:幽灵编号右侧压底,kicker + 双段陈述左对齐(章头间距与各章统一 48) */
  .head {
    position: relative;
    margin-bottom: max(32px, calc(48 * var(--u)));
  }
  .ghost {
    right: calc(-10 * var(--uc));
    top: calc(-30 * var(--uc));
  }
  .lab {
    color: var(--x-ink);
    margin: 0 0 calc(16 * var(--uc));
    min-height: 1.2em;
    white-space: nowrap;
  }
  .statements {
    position: relative;
    z-index: 1;
    width: calc(900 * var(--u));
    max-width: 100%;
    font-size: max(30px, calc(44 * var(--u)));
    color: var(--x-ink);
  }
  .statements h2,
  .statements p {
    font-size: inherit;
    font-weight: inherit;
    margin: 0;
  }
  .statements p {
    color: var(--x-ink-dim);
  }
  .steps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(calc(260 * var(--uc)), 1fr));
    gap: calc(18 * var(--uc));
  }
  /* 玻璃瓷砖列(R48;原「无盒开放列」退役):tile 自带边界,竖线随白带一起退场 */
  .step {
    padding: calc(30 * var(--uc)) calc(30 * var(--uc)) calc(34 * var(--uc));
    /* 同排卡片共享四行，标题自然折行也不会推歪图片区；外层视差不变。 */
    display: grid;
    grid-row: span 4;
    grid-template-rows: subgrid;
    row-gap: calc(20 * var(--uc));
    will-change: transform;
    z-index: 1;
  }
  .metarow {
    display: flex;
    justify-content: space-between;
    margin: 0 0 calc(max(32px, calc(56 * var(--u))) - 20 * var(--uc));
    color: var(--x-ink-cap);
    white-space: nowrap;
  }
  .metarow span:first-child {
    color: var(--x-accent-hot); /* 黑区编号亮柠檬热档(与数据条序号同体例) */
  }
  .stack {
    display: contents;
  }
  .stack h3 {
    font-size: max(22px, calc(30 * var(--u))); /* 瓷砖内标题降一档(瓷砖比开放列窄,48 档会两行起步) */
    color: var(--x-ink);
    margin: 0;
  }
  .art {
    width: 100%;
    height: auto; /* 压掉 img 宽高属性的表现层提示,aspect-ratio 才生效(R48.7 已踩) */
    aspect-ratio: 393 / 237;
    object-fit: cover;
    display: block;
    border-radius: var(--x-r-sm);
  }
  .stack .body {
    color: var(--x-ink-cap);
    margin: 0;
    text-wrap: pretty;
  }
  .stack .body:is(:lang(zh), :lang(ja), :lang(ko)) {
    text-wrap: balance; /* CJK 短段孤行控制(R49 收线 D1:step2 曾 355px 整行下吊 3 字孤行) */
  }
  .vlink {
    color: var(--x-ink);
    text-decoration: underline;
    text-underline-offset: calc(3 * var(--uc));
    display: block;
    width: fit-content;
    position: relative;
    /* 内衬与负外边距同量抵消，扩大命中盒而不挪动正文；x-copy 行高下仍高于 44px。 */
    padding: calc(13.3 * var(--uc)) 0;
    margin: calc(-13.3 * var(--uc)) 0;
    transition: opacity 0.2s;
  }
  .vlink:hover {
    opacity: 0.6;
  }
  .vlink:active {
    opacity: 0.58;
  }
  @media (max-width: 860px) {
    .statements {
      width: 100%;
    }
  }
</style>
