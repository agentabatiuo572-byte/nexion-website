---
/* [FEAT-WEB01] 页脚 — R8(画布 1440 等比构图):
   定高 660→45.83vw 房间;上行=左品牌记号(90→6.25vw)+ 右列 723→50.2vw
   (wordmark 120→8.33vw 行遮罩 + 信息列 585→40.6vw:披露 + legal 链);
   版权行钉底。key 不变,零死链。 */
import { useT, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useT(locale);
const prefix = locale === 'en' ? '' : `/${locale}`;
const CONTACT = import.meta.env.PUBLIC_CONTACT_EMAIL ?? '';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="top">
    <svg class="mark" viewBox="0 0 24 24" aria-hidden="true">
      <g fill="none" stroke="currentColor" stroke-width="1.1">
        <rect x="3" y="3" width="18" height="18"></rect>
        <rect x="7.5" y="7.5" width="9" height="9"></rect>
        <path d="M3 12h4.5M16.5 12H21M12 3v4.5M12 16.5V21"></path>
        <circle cx="12" cy="12" r="1.6" fill="var(--x-accent)" stroke="none"></circle>
      </g>
    </svg>

    <div class="colr">
      <div class="wordmark x-display-mega" data-lr>NexGrid</div>
      <div class="info">
        <p class="disclaimer x-mono">{t('footer.disclaimer')}</p>
        <nav aria-label={t('footer.ariaLegal')}>
          <a class="x-mono x-dimlink" href={`${prefix}/legal/privacy`}>{t('footer.privacy')}</a>
          <a class="x-mono x-dimlink" href={`${prefix}/legal/terms`}>{t('footer.terms')}</a>
          {CONTACT && <a class="x-mono x-dimlink" href={`mailto:${CONTACT}`}>{t('footer.contact')}</a>}
        </nav>
      </div>
    </div>
  </div>

  <p class="copy x-mono">© {year} NexGrid. {t('footer.rights')}</p>
</footer>

<style>
  .site-footer {
    position: relative;
    z-index: 1;
    border-top: 1px solid var(--x-line);
    height: clamp(560px, 45.83vw, 880px);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: clamp(60px, 5.56vw, 107px) var(--x-pad) 30px;
    overflow: hidden;
  }
  .top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 40px;
  }
  .mark {
    width: clamp(48px, 6.25vw, 120px);
    height: auto;
    color: var(--x-white);
    flex: 0 0 auto;
  }
  .colr {
    width: min(50.2vw, 964px);
    display: flex;
    flex-direction: column;
    gap: clamp(28px, 4.17vw, 80px);
  }
  .wordmark {
    font-size: clamp(56px, 8.33vw, 160px);
    color: var(--x-white);
    white-space: nowrap;
    user-select: none;
  }
  .info {
    width: min(40.6vw, 780px);
    max-width: 100%;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .disclaimer {
    color: var(--x-ink-dim);
    margin: 0;
    text-wrap: pretty;
    line-height: 1.5;
  }
  nav {
    display: flex;
    gap: 22px;
    flex-wrap: wrap;
  }
  nav a {
    color: var(--x-ink-dim);
    text-decoration: none;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    white-space: nowrap;
    text-transform: uppercase;
    letter-spacing: 0;
  }
  .copy {
    color: var(--x-ink-faint);
    margin: 0;
    letter-spacing: -0.03em;
  }
  @media (max-width: 860px) {
    .site-footer {
      height: auto;
      min-height: 70svh;
      padding-top: 60px;
      gap: 60px;
    }
    .top {
      flex-direction: column;
    }
    .colr {
      width: 100%;
    }
    .wordmark {
      font-size: clamp(48px, 13vw, 96px);
    }
    .info {
      width: 100%;
    }
  }
</style>
