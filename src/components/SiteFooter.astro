---
/* [FEAT-WEB01] 页脚 — Legal 链 / 联系 / 风险披露(措辞待 Legal 定稿统一,key 先行)。
   社媒未配置不渲染(PRD 异常口径:零死链)。 */
import { useT, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useT(locale);
const prefix = locale === 'en' ? '' : `/${locale}`;
const CONTACT = import.meta.env.PUBLIC_CONTACT_EMAIL ?? '';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="inner">
    <p class="disclaimer">{t('footer.disclaimer')}</p>
    <nav aria-label="Legal">
      <a href={`${prefix}/legal/privacy`}>{t('footer.privacy')}</a>
      <a href={`${prefix}/legal/terms`}>{t('footer.terms')}</a>
      {CONTACT && <a href={`mailto:${CONTACT}`}>{t('footer.contact')}</a>}
    </nav>
    <p class="copy">© {year} NexGrid. {t('footer.rights')}</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--v5-border);
    margin-top: var(--w-space-section);
  }
  .inner {
    max-width: var(--w-content-max);
    margin: 0 auto;
    padding: 40px 20px 48px;
    display: grid;
    gap: 16px;
  }
  .disclaimer {
    color: var(--v5-ink-3);
    font-size: 13px;
    max-width: 640px;
    margin: 0;
    text-wrap: pretty;
  }
  nav {
    display: flex;
    gap: 20px;
    flex-wrap: wrap;
  }
  nav a {
    color: var(--v5-ink-3);
    text-decoration: none;
    font-size: 13px;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }
  nav a:hover,
  nav a:focus-visible {
    color: var(--v5-ink);
  }
  nav a:active {
    opacity: 0.8;
  }
  nav a:focus-visible {
    outline: 2px solid var(--v5-brand);
    outline-offset: 2px;
  }
  .copy {
    color: var(--v5-ink-4);
    font-size: 12px;
    margin: 0;
  }
</style>
