---
/* [FEAT-WEB01] 页脚 — R48.1(主人改令④):深磨砂面板内容化 ——
   品牌方标与字标**锁成一组**(lockup),右侧披露 + legal 链;版权行走底部细线行;
   面板高度随内容(不再 600 定高留大片空白);「暂停/播放背景」键按主人令删除
   (⚠️ 交底:该键是 WCAG 2.2.2 的暂停出口,删后自动播放动画仅剩系统「减少动态」一条豁免路径;
   fx 的 data-bg-toggle 监听保留为无害空转,后续要恢复只需把键加回来)。key 不变,零死链。 */
import { useT, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useT(locale);
const prefix = locale === 'en' ? '' : `/${locale}`;
const CONTACT = import.meta.env.PUBLIC_CONTACT_EMAIL ?? '';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="panel x-tile">
    <div class="top">
      {/* 品牌组:方标 + 字标紧挨(主人改令④);读屏读字标,方标 aria-hidden */}
      <div class="lockup">
        <span class="mark">
          <img src="/logo-mark-dark.webp" width="90" height="89" alt="" aria-hidden="true" />
        </span>
        <div class="wordmark x-display-mega" data-lr>NexGrid</div>
      </div>

      <div class="info">
        <p class="disclaimer x-mono">{t('footer.disclaimer')}</p>
        <nav aria-label={t('footer.ariaLegal')}>
          <a class="x-mono x-dimlink" href={`${prefix}/legal/privacy/`}>{t('footer.privacy')}</a>
          <a class="x-mono x-dimlink" href={`${prefix}/legal/app-privacy/`}>{t('footer.appPrivacy')}</a>
          <a class="x-mono x-dimlink" href={`${prefix}/legal/terms/`}>{t('footer.terms')}</a>
          {CONTACT && <a class="x-mono x-dimlink" href={`mailto:${CONTACT}`}>{t('footer.contact')}</a>}
        </nav>
      </div>
    </div>

    <p class="copy x-mono">© {year} NexGrid. {t('footer.rights')}</p>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    z-index: 1;
    padding: 0 var(--x-pad) calc(30 * var(--uc));
  }
  /* 深磨砂面板:比通用 .x-tile 更暗(0.55 底);高度随内容(R48.1 撤 600 定高) */
  .panel {
    background: rgb(var(--x-bg-rgb) / 0.55);
    padding: max(40px, calc(56 * var(--u))) max(32px, calc(56 * var(--u))) calc(24 * var(--uc));
  }
  .top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: calc(48 * var(--uc));
  }
  .lockup {
    display: flex;
    align-items: center;
    gap: max(16px, calc(24 * var(--u)));
    flex: 0 1 auto;
    min-width: 0;
  }
  .mark {
    display: block;
    width: max(44px, calc(72 * var(--u)));
    flex: 0 0 auto;
  }
  .mark img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--x-r-sm); /* 素材是带砖底的 app-icon 形态,圆角与面板同语 */
  }
  .wordmark {
    font-size: max(40px, calc(72 * var(--u)));
    color: var(--x-white);
    white-space: nowrap;
    user-select: none;
  }
  .info {
    width: calc(560 * var(--u));
    max-width: 100%;
    flex: 0 0 auto;
    display: flex;
    flex-direction: column;
    gap: calc(18 * var(--uc));
  }
  .disclaimer {
    color: var(--x-ink-dim);
    margin: 0;
    text-wrap: pretty;
    line-height: 1.5;
  }
  nav {
    display: flex;
    gap: calc(22 * var(--uc));
    flex-wrap: wrap;
  }
  nav a {
    color: var(--x-ink-dim);
    text-decoration: none;
    min-height: var(--x-touch);
    display: inline-flex;
    align-items: center;
    white-space: nowrap;
    text-transform: uppercase;
    letter-spacing: 0;
  }
  /* 预暗链接的 hover 走提亮(0.62 → 1);按下 0.75(对 #0c0c0d 12:1) */
  nav a:hover,
  nav a:focus-visible {
    color: var(--x-white);
    opacity: 1;
  }
  nav a:active {
    color: var(--x-white);
    opacity: 0.75;
  }
  /* 版权行:细线行钉底,与上方内容拉开一段呼吸 */
  .copy {
    color: var(--x-ink-dim);
    margin: max(32px, calc(48 * var(--u))) 0 0;
    padding-top: calc(20 * var(--uc));
    border-top: 1px solid var(--x-line-soft);
    letter-spacing: -0.03em; /* 参考站版权行同为 −0.03em(它的 12px 字距分两类,这一类保留) */
  }
  @media (max-width: 860px) {
    .panel {
      padding: calc(36 * var(--uc)) calc(24 * var(--uc)) calc(20 * var(--uc));
    }
    .top {
      flex-direction: column;
      align-items: flex-start;
      gap: calc(32 * var(--uc));
    }
    /* 上限接断点另一侧的实算值取整下调(861 宽 = 72·--u = 43.05 → 43):窄一像素不许反向变大。
       与首屏标题同一族,由门 render-fit 判据 D 逐档实测钉住。 */
    .wordmark {
      font-size: clamp(34px, 10vw, calc(43 * var(--uc)));
    }
    .info {
      width: 100%;
    }
  }
</style>
