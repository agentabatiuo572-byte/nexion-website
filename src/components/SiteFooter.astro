---
/* [FEAT-WEB01] 页脚 — Legal 链 / 联系 / 风险披露(key 不变,零死链)。
   axiom 方向:等宽信息层 + 巨型 wordmark 收底。 */
import { useT, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useT(locale);
const prefix = locale === 'en' ? '' : `/${locale}`;
const CONTACT = import.meta.env.PUBLIC_CONTACT_EMAIL ?? '';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="upper">
    <p class="disclaimer x-mono">{t('footer.disclaimer')}</p>
    <nav aria-label={t('footer.ariaLegal')}>
      <a class="x-mono x-dimlink" href={`${prefix}/legal/privacy`}>{t('footer.privacy')}</a>
      <a class="x-mono x-dimlink" href={`${prefix}/legal/terms`}>{t('footer.terms')}</a>
      {CONTACT && <a class="x-mono x-dimlink" href={`mailto:${CONTACT}`}>{t('footer.contact')}</a>}
    </nav>
  </div>
  <div class="wordmark x-display-mega" data-lr>NexGrid</div>
  <p class="copy x-mono">© {year} NexGrid. {t('footer.rights')}</p>
</footer>

<style>
  /* 定高房间 + 弹性空气钉底(P1-31 最小参数版:保留满宽大甲板) */
  .site-footer {
    position: relative;
    z-index: 1;
    border-top: 1px solid var(--x-line);
    min-height: 660px;
    display: flex;
    flex-direction: column;
    padding: 80px var(--x-pad) 30px;
    overflow: hidden;
  }
  .upper {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 32px;
    margin-bottom: clamp(30px, 5vh, 60px);
  }
  .disclaimer {
    color: var(--x-ink-dim);
    max-width: 560px;
    margin: 0;
    text-wrap: pretty;
  }
  nav {
    display: flex;
    gap: 22px;
    flex-wrap: wrap;
  }
  nav a {
    color: var(--x-ink-dim);
    text-decoration: none;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    white-space: nowrap;
    text-transform: uppercase;
    font-weight: 700;
    letter-spacing: 0;
  }
  .wordmark {
    font-size: clamp(72px, 16.5vw, 250px);
    color: var(--x-white);
    white-space: nowrap;
    text-align: right;
    user-select: none;
    margin-top: auto;
  }
  .copy {
    color: var(--x-ink-faint);
    margin: clamp(24px, 4vh, 40px) 0 0;
    letter-spacing: -0.03em;
  }
  @media (max-width: 720px) {
    .site-footer {
      min-height: 0;
      padding-top: 60px;
    }
    .upper {
      flex-direction: column;
    }
    .wordmark {
      text-align: left;
      margin-top: 80px;
    }
  }
</style>
