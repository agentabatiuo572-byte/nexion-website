---
/* [FEAT-WEB04 v1.1] 收益路径 — 纯静态双卡(计算器已删,主人 2026-08-20 裁决)。
   🔴 全板块无任何收益数字。axiom 方向:反白区块 + 序号大卡 + 等高线纹样。 */
import { useT, type Locale } from '../i18n';
import { contour } from '../lib/contour';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useT(locale);
const cards = [
  { n: '01', title: t('path.freeTitle'), desc: t('path.freeDesc'), cta: t('path.freeCta'), href: '#download', solid: true, art: contour(11) },
  { n: '02', title: t('path.scaleTitle'), desc: t('path.scaleDesc'), cta: t('path.scaleLink'), href: '#devices', solid: false, art: contour(47) },
];
---

<section class="path x-invert" id="path">
  <div class="cards">
    {
      cards.map((c, i) => (
        <article class="card" data-rv style={`--d:${i * 0.12}s`}>
          <svg class="art" viewBox={c.art.viewBox} preserveAspectRatio="xMidYMid slice" aria-hidden="true">
            {c.art.paths.map((d) => (
              <path d={d} fill="none" stroke="var(--x-dark)" stroke-width="1" opacity="0.55" />
            ))}
          </svg>
          <span class="idx x-mono">{c.n}</span>
          <h2>{c.title}</h2>
          <p class="desc x-mono">{c.desc}</p>
          <a class:list={['xbtn', 'on-light', { solid: c.solid }]} href={c.href}>
            <span class="xbtn-ghost">{c.cta} <span class="arr">→</span></span>
            <span class="xbtn-a">{c.cta} <span class="arr">→</span></span>
            <span class="xbtn-b">{c.cta} <span class="arr">→</span></span>
          </a>
        </article>
      ))
    }
  </div>
  <p class="note x-mono" data-rv>{t('path.note')}</p>
</section>

<style>
  .path {
    padding: var(--x-section-gap) var(--x-pad);
  }
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: clamp(20px, 3vw, 40px);
  }
  .card {
    position: relative;
    border: 1px solid var(--x-line-dark);
    padding: clamp(24px, 3vw, 40px);
    display: grid;
    gap: 16px;
    align-content: start;
    overflow: hidden;
    min-height: 340px;
  }
  .art {
    position: absolute;
    right: -12%;
    top: -8%;
    width: 68%;
    height: 78%;
    opacity: 0.16;
    pointer-events: none;
  }
  .idx {
    color: var(--x-accent);
    font-weight: 700;
  }
  .card h2 {
    font-family: var(--x-font-display);
    font-size: clamp(26px, 2.8vw, 38px);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.1;
    color: var(--x-dark);
    margin: 0;
    text-wrap: balance;
    position: relative;
  }
  .desc {
    color: var(--x-dark-dim);
    margin: 0;
    max-width: 420px;
    text-wrap: pretty;
    position: relative;
  }
  .card .xbtn {
    justify-self: start;
    margin-top: 8px;
  }
  .note {
    color: var(--x-dark-dim);
    margin: clamp(28px, 4vw, 48px) 0 0;
    text-wrap: pretty;
  }
</style>
