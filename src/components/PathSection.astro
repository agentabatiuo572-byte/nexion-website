---
/* [FEAT-WEB04] 收益路径 — R48 玻璃重构(章 02,B+C 杂交):
   章头 = 幽灵编号 02(左,正文右让)+ 16 mono 打字机 kicker + 44 档陈述(path.headline,R48 新 key);
   双卡改非对称玻璃瓷砖:免费档 7/12 柠檬 lit 瓷砖(转化主位)+ 扩容档 5/12 素瓷砖;
   瓷砖内保留「编号↔类目」两端行、标题、等高线图、正文、slide-swap 按钮;视差 k 不变。
   🔴 全板块无任何收益数字。 */
import { useT, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useT(locale);
/* R48.9 主人令:等高线占位图换实景生成图(黑底柠檬光同族)——免费档=手机竖立轮廓光,扩容档=机架小盒阵列 */
const cards = [
  { n: '01', cat: t('path.cat1'), title: t('path.freeTitle'), desc: t('path.freeDesc'), cta: t('path.freeCta'), href: '#download', solid: true, art: '/art-path-free.webp', k: 0.057, lit: true },
  { n: '02', cat: t('path.cat2'), title: t('path.scaleTitle'), desc: t('path.scaleDesc'), cta: t('path.scaleLink'), href: '#devices', solid: false, art: '/art-path-scale.webp', k: 0.099, lit: false },
];
---

<section class="path" id="path">
  <div class="head">
    <span class="x-ghost ghost" aria-hidden="true">02</span>
    <div class="lead">
      <p class="lab x-mono-lg" data-tw>{t('path.title')}</p>
      <h2 class="x-display" data-lr>{t('path.headline')}</h2>
    </div>
  </div>
  <div class="cards">
    {
      cards.map((c, i) => (
        <article class:list={['card', 'x-tile', 'rv-fade', { 'x-tile-lit': c.lit }]} data-rv data-plx={c.k}>
          <p class="metarow x-mono">
            <span data-tw data-tw-delay={160 * i}>{c.n}</span>
            <span data-tw data-tw-delay={160 * i + 120}>{c.cat}</span>
          </p>
          <div class="stack">
            <h3 class="x-display" data-lr data-lr-delay={100 * i}>{c.title}</h3>
            <img class="art" src={c.art} alt="" width="1280" height="853" loading="lazy" decoding="async" />
            <p class="desc x-mono">{c.desc}</p>
            <a class:list={['xbtn', { solid: c.solid }]} href={c.href}>
              <span class="xbtn-ghost" aria-hidden="true">{c.cta} <span class="arr">→</span></span>
              <span class="xbtn-a">{c.cta} <span class="arr">→</span></span>
              <span class="xbtn-b" aria-hidden="true">{c.cta} <span class="arr">→</span></span>
            </a>
          </div>
        </article>
      ))
    }
  </div>
  <p class="note x-mono" data-rv>{t('path.note')}</p>
</section>

<style>
  .path {
    padding: 0 var(--x-pad);
  }
  .head {
    position: relative;
    margin-bottom: max(32px, calc(48 * var(--u)));
  }
  .ghost {
    left: calc(-16 * var(--uc));
    top: calc(-30 * var(--uc));
  }
  /* 章头左置幽灵编号,正文右让一格(与 04 章同式,与 01/03 章的右置交替) */
  .lead {
    position: relative;
    z-index: 1;
    margin-left: max(0px, calc(170 * var(--u)));
  }
  @media (max-width: 640px) {
    .lead {
      margin-left: 0; /* 幽灵编号收掉后不再右让 */
    }
  }
  .lab {
    color: var(--x-ink);
    margin: 0 0 calc(16 * var(--uc));
    min-height: 1.2em;
  }
  .lead h2 {
    font-size: max(30px, calc(44 * var(--u)));
    color: var(--x-ink);
    margin: 0;
  }
  .cards {
    display: grid;
    grid-template-columns: 7fr 5fr; /* 非对称:免费档主位(转化优先),扩容档次位 */
    gap: calc(18 * var(--uc));
  }
  .card {
    padding: calc(30 * var(--uc)) calc(34 * var(--uc)) calc(34 * var(--uc));
    display: flex;
    flex-direction: column;
    gap: max(28px, calc(48 * var(--u)));
    will-change: transform;
    z-index: 1;
  }
  .metarow {
    display: flex;
    justify-content: space-between;
    margin: 0;
    color: var(--x-ink-cap);
    white-space: nowrap;
  }
  .metarow span:first-child {
    color: var(--x-accent-hot);
  }
  .stack {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: calc(20 * var(--uc));
  }
  .stack h3 {
    font-size: max(24px, calc(34 * var(--u)));
    color: var(--x-ink);
    margin: 0;
  }
  .art {
    width: 100%;
    height: auto; /* 压掉 img 宽高属性的表现层提示,aspect-ratio 才生效(R48.7 已踩) */
    aspect-ratio: 393 / 160; /* 双宽卡里压扁一点,免得图区喧宾夺主 */
    object-fit: cover;
    display: block;
    border-radius: var(--x-r-sm);
  }
  .desc {
    color: var(--x-ink-cap);
    margin: 0;
    max-width: calc(480 * var(--uc));
    text-wrap: pretty;
    line-height: 1.45;
  }
  .desc:lang(zh) {
    line-height: 1.6;
  }
  .note {
    color: var(--x-ink-dim);
    margin: max(20px, calc(28 * var(--u))) 0 0;
    text-wrap: pretty;
  }
  @media (max-width: 860px) {
    .cards {
      grid-template-columns: 1fr; /* 窄屏竖排,免费档仍在前 */
    }
  }
</style>
