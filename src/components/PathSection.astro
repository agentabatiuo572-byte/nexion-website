---
/* [FEAT-WEB04 v1.1] 收益路径 — R7(解剖报告 P1-24/25 部分/26/28,P2-19):
   盒卡改无盒左线开放列;标题升 48 档行遮罩;编号去琥珀去粗改墨 0.8;
   等高线图入流(标题↔正文之间);双列滚动视差 k=[0.06,0.11]。
   🔴 全板块无任何收益数字。 */
import { useT, type Locale } from '../i18n';
import { contour } from '../lib/contour';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useT(locale);
const cards = [
  { n: '01', title: t('path.freeTitle'), desc: t('path.freeDesc'), cta: t('path.freeCta'), href: '#download', solid: true, art: contour(11, 12, 393, 237), k: 0.06 },
  { n: '02', title: t('path.scaleTitle'), desc: t('path.scaleDesc'), cta: t('path.scaleLink'), href: '#devices', solid: false, art: contour(47, 12, 393, 237), k: 0.11 },
];
---

<section class="path x-invert" id="path">
  <div class="cards">
    {
      cards.map((c) => (
        <article class="card rv-fade" data-rv data-plx={c.k}>
          <p class="meta x-mono" data-tw>{c.n}</p>
          <h2 class="x-display" data-lr>{c.title}</h2>
          <svg class="art" viewBox={c.art.viewBox} preserveAspectRatio="xMidYMid slice" aria-hidden="true">
            {c.art.paths.map((d) => (
              <path d={d} fill="none" stroke="var(--x-dark)" stroke-width="1" opacity="0.5" />
            ))}
          </svg>
          <p class="desc x-mono">{c.desc}</p>
          <a class:list={['xbtn', { solid: c.solid }]} href={c.href}>
            <span class="xbtn-ghost">{c.cta} <span class="arr">→</span></span>
            <span class="xbtn-a">{c.cta} <span class="arr">→</span></span>
            <span class="xbtn-b">{c.cta} <span class="arr">→</span></span>
          </a>
        </article>
      ))
    }
  </div>
  <p class="note x-mono" data-rv>{t('path.note')}</p>
</section>

<style>
  .path {
    padding: var(--x-section-gap) var(--x-pad) calc(var(--x-section-gap) * 0.6);
  }
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: clamp(24px, 4.2vw, 60px);
  }
  /* 无盒开放列:仅左竖线 + pl20(参考站「编辑部感」核心) */
  .card {
    border-left: 1px solid var(--x-line-dark);
    padding-left: 20px;
    display: grid;
    gap: 24px;
    align-content: start;
    will-change: transform;
  }
  .meta {
    color: var(--x-dark-cap);
    margin: 0;
  }
  .card h2 {
    font-size: clamp(28px, 3.33vw, 48px);
    color: var(--x-ink);
    margin: 0;
  }
  .art {
    width: 100%;
    aspect-ratio: 393 / 237;
    display: block;
  }
  .desc {
    color: var(--x-dark-cap);
    margin: 0;
    max-width: 420px;
    text-wrap: pretty;
    line-height: 1.45;
  }
  .card .xbtn {
    justify-self: start;
  }
  .note {
    color: var(--x-dark-dim);
    margin: clamp(28px, 4vw, 48px) 0 0;
    text-wrap: pretty;
  }
  @media (max-width: 768px) {
    .card {
      border-left: 0;
      border-top: 1px solid var(--x-line-dark);
      padding: 20px 0 0;
    }
  }
</style>
