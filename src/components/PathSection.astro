---
/* [FEAT-WEB04] 收益路径 — R8(白带块):
   头行=16 mono 打字机标签(path.title,新 key);
   双列各带「编号↔类目词」两端行(path.cat1/2,新 key),
   标题 48 档行遮罩、等高线图入流、双列视差 k=[0.06,0.11]。
   🔴 全板块无任何收益数字。 */
import { useT, type Locale } from '../i18n';
import { contour } from '../lib/contour';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useT(locale);
const cards = [
  { n: '01', cat: t('path.cat1'), title: t('path.freeTitle'), desc: t('path.freeDesc'), cta: t('path.freeCta'), href: '#download', solid: true, art: contour(11, 12, 393, 237), k: 0.06 },
  { n: '02', cat: t('path.cat2'), title: t('path.scaleTitle'), desc: t('path.scaleDesc'), cta: t('path.scaleLink'), href: '#devices', solid: false, art: contour(47, 12, 393, 237), k: 0.11 },
];
---

<section class="path" id="path">
  <div class="headrow">
    <p class="lab x-mono-lg" data-tw>{t('path.title')}</p>
  </div>
  <div class="cards">
    {
      cards.map((c, i) => (
        <article class="card rv-fade" data-rv data-plx={c.k}>
          <p class="metarow x-mono">
            <span data-tw data-tw-delay={160 * i}>{c.n}</span>
            <span data-tw data-tw-delay={160 * i + 120}>{c.cat}</span>
          </p>
          <div class="stack">
            <h3 class="x-display" data-lr data-lr-delay={100 * i}>{c.title}</h3>
            <svg class="art" viewBox={c.art.viewBox} preserveAspectRatio="xMidYMid slice" aria-hidden="true">
              {c.art.paths.map((d) => (
                <path d={d} fill="none" stroke="var(--x-dark)" stroke-width="1" opacity="0.5" />
              ))}
            </svg>
            <p class="desc x-mono">{c.desc}</p>
            <a class:list={['xbtn', { solid: c.solid }]} href={c.href}>
              <span class="xbtn-ghost">{c.cta} <span class="arr">→</span></span>
              <span class="xbtn-a">{c.cta} <span class="arr">→</span></span>
              <span class="xbtn-b">{c.cta} <span class="arr">→</span></span>
            </a>
          </div>
        </article>
      ))
    }
  </div>
  <p class="note x-mono" data-rv>{t('path.note')}</p>
</section>

<style>
  .path {
    padding: 0 var(--x-pad);
  }
  .headrow {
    margin-bottom: max(48px, calc(120 * var(--u)));
  }
  .lab {
    color: var(--x-ink);
    margin: 0;
    min-height: 1.2em;
  }
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(calc(300 * var(--uc)), 1fr));
    gap: max(24px, calc(60 * var(--u)));
  }
  /* 无盒开放列:左竖线 + pl20;列首「编号↔类目」两端行 */
  .card {
    border-left: 1px solid var(--x-line-dark);
    padding-left: calc(20 * var(--uc));
    display: flex;
    flex-direction: column;
    gap: max(40px, calc(82 * var(--u)));
    will-change: transform;
  }
  .metarow {
    display: flex;
    justify-content: space-between;
    margin: 0;
    color: var(--x-dark-cap);
    white-space: nowrap;
  }
  .metarow span:first-child {
    color: var(--x-accent-ink); /* R30:纸面编号深柠檬回血(镜像黑区亮柠檬编号体例) */
  }
  .stack {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: calc(24 * var(--uc));
  }
  .stack h3 {
    font-size: max(32px, calc(48 * var(--u)));
    color: var(--x-ink);
    margin: 0;
  }
  .art {
    width: 100%;
    aspect-ratio: 393 / 237;
    display: block;
  }
  .desc {
    color: var(--x-dark-cap);
    margin: 0;
    max-width: calc(420 * var(--uc));
    text-wrap: pretty;
    line-height: 1.45;
  }
  .note {
    color: var(--x-dark-dim);
    margin: clamp(28px, 4vw, calc(48 * var(--uc))) 0 0;
    text-wrap: pretty;
  }
  @media (max-width: 768px) {
    .card {
      border-left: 0;
      border-top: 1px solid var(--x-line-dark);
      padding: calc(20 * var(--uc)) 0 0;
      gap: calc(40 * var(--uc));
    }
  }
</style>
