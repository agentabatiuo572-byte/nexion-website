---
/* [FEAT-WEB10] /nex 轻页正文 — 蓝本 App PRD §11.3.1 合规裁剪:
   无价格行/无实时行情;上市信息只写可验证事实(v1 不列交易所);App 内第 5 用法的
   措辞按官网 PRD §1.4-3 中性化为「长期持有」(App 原措辞属投机语态,官网禁用);
   App 内链一律改「下载 App」CTA。白皮书入口条件渲染(O6 无资产不渲染)。
   axiom 方向:display 大标题 + 细线表格/行列表 + 等宽正文。
   R45 B7:子页标题不再继承正文行高 1.6(display 档行高 ≤1.1);FAQ 规格与首页 FAQ 归一(字重/字距/编号色/记号色/行高)。 */
import { useT, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useT(locale);
const prefix = locale === 'en' ? '' : `/${locale}`;
const WHITEPAPER_URL = import.meta.env.PUBLIC_WHITEPAPER_URL ?? '';
const sources = [1, 2, 3, 4] as const;
const uses = [1, 2, 3, 4, 5] as const;
const faqs = [1, 2, 3, 4] as const;
---

<main class="nex-page">
  <header class="hero">
    <span class="tag x-label" data-rv>{t('nex.pageTag')}</span>
    <h1 class="x-display" data-rv style="--d:.08s">{t('nex.pageTitle')}</h1>
    <p class="lead x-mono" data-rv style="--d:.16s">{t('nex.pageLead')}</p>
  </header>

  <section class="block x-paper" aria-labelledby="nex-compare">
    <h2 id="nex-compare" class="x-h24">{t('nex.compareTitle')}</h2>
    <div class="table-wrap">
      <table>
        <thead>
          <tr><th class="x-label">{t('nex.cmpProp')}</th><th class="x-label">USDT</th><th class="x-label">NEX</th></tr>
        </thead>
        <tbody class="x-mono">
          <tr><td>{t('nex.cmpType')}</td><td>{t('nex.cmpTypeUsdt')}</td><td>{t('nex.cmpTypeNex')}</td></tr>
          <tr><td>{t('nex.cmpVol')}</td><td>{t('nex.cmpVolUsdt')}</td><td>{t('nex.cmpVolNex')}</td></tr>
          <tr><td>{t('nex.cmpUse')}</td><td>{t('nex.cmpUseUsdt')}</td><td>{t('nex.cmpUseNex')}</td></tr>
        </tbody>
      </table>
    </div>
  </section>

  <section class="block x-paper" aria-labelledby="nex-sources">
    <h2 id="nex-sources" class="x-h24">{t('nex.sourcesTitle')}</h2>
    <ul class="list" role="list">
      {sources.map((n) => (
        <li data-rv style={`--d:${(n - 1) * 0.06}s`}>
          <span class="idx x-mono">0{n}</span>
          <b class="x-h24">{t(`nex.src${n}Title`)}</b>
          <span class="x-mono">{t(`nex.src${n}Desc`)}</span>
        </li>
      ))}
    </ul>
  </section>

  <section class="block x-paper" aria-labelledby="nex-uses">
    <h2 id="nex-uses" class="x-h24">{t('nex.usesTitle')}</h2>
    <ul class="list" role="list">
      {uses.map((n) => (
        <li data-rv style={`--d:${(n - 1) * 0.06}s`}>
          <span class="idx x-mono">0{n}</span>
          <b class="x-h24">{t(`nex.use${n}Title`)}</b>
          <span class="x-mono">{t(`nex.use${n}Desc`)}</span>
        </li>
      ))}
    </ul>
  </section>

  <section class="block x-paper" aria-labelledby="nex-mech">
    <h2 id="nex-mech" class="x-h24">{t('nex.mechTitle')}</h2>
    <div class="mech">
      <article class="mcard" data-rv>
        <h3 class="x-h24">{t('nex.mech1Title')}</h3>
        <p class="x-mono">{t('nex.mech1Desc')}</p>
      </article>
      <article class="mcard" data-rv style="--d:.1s">
        <h3 class="x-h24">{t('nex.mech2Title')}</h3>
        <p class="x-mono">{t('nex.mech2Desc')}</p>
      </article>
    </div>
  </section>

  <section class="block x-paper" aria-labelledby="nex-faq">
    <h2 id="nex-faq" class="x-h24">{t('nex.faqTitle')}</h2>
    {faqs.map((n) => (
      <details class="faq">
        <summary>
          <span class="idx x-mono">Q{n}</span>
          <span class="q x-q">{t(`nex.faq${n}Q`)}</span>
          <span class="mark x-mono" aria-hidden="true">+</span>
        </summary>
        <p class="x-mono">{t(`nex.faq${n}A`)}</p>
      </details>
    ))}
  </section>

  <div class="cta-row">
    <a class="xbtn solid" href={`${prefix}/#download`}>
      <span class="xbtn-ghost" aria-hidden="true">{t('nex.getApp')} <span class="arr">→</span></span>
      <span class="xbtn-a">{t('nex.getApp')} <span class="arr">→</span></span>
      <span class="xbtn-b" aria-hidden="true">{t('nex.getApp')} <span class="arr">→</span></span>
    </a>
    {WHITEPAPER_URL && (
      <a class="xbtn" href={WHITEPAPER_URL} target="_blank" rel="noopener">
        <span class="xbtn-ghost" aria-hidden="true">{t('nex.whitepaper')} <span class="arr">↗</span></span>
        <span class="xbtn-a">{t('nex.whitepaper')} <span class="arr">↗</span></span>
        <span class="xbtn-b" aria-hidden="true">{t('nex.whitepaper')} <span class="arr">↗</span></span>
      </a>
    )}
  </div>
</main>

<style>
  .nex-page {
    /* R3:内容页=纸白;顶部留 84px 黑带,导航在暗带上可见,滚动后按层叠哲学被盖 */
    margin-top: calc(84 * var(--uc));
    padding: calc(46 * var(--uc)) var(--x-pad) clamp(24px, 3vw, calc(40 * var(--uc))); /* R39:内页 main 用简写会盖掉全局画布留白,显式补回 */
  }
  .nex-page > * {
    max-width: calc(1100 * var(--uc));
  }
  .hero {
    margin-bottom: clamp(36px, 6vw, calc(64 * var(--uc)));
  }
  .tag {
    color: var(--x-accent-ink);
    display: inline-block;
    margin-bottom: calc(16 * var(--uc));
  }
  h1 {
    font-size: clamp(34px, 5.2vw, calc(54 * var(--uc)));
    color: var(--x-ink);
    margin: 0 0 calc(14 * var(--uc));
    max-width: 22ch;
  }
  .lead {
    color: var(--x-ink-dim);
    margin: 0;
    max-width: calc(560 * var(--uc));
    text-wrap: pretty;
  }
  .block {
    margin-bottom: calc(40 * var(--uc));
    padding: clamp(18px, 2.2vw, calc(30 * var(--uc)));
  }
  /* 型类给字族/字重/字距/行高与语言分支;这里只留本处特有的字号与边框。
     原来没有 vi/zh 分支,行高补偿静默失效。 */
  .block h2 {
    font-size: clamp(22px, 2.6vw, calc(32 * var(--uc)));
    color: var(--x-ink);
    border-top: 1px solid var(--x-line);
    padding-top: calc(16 * var(--uc));
    margin: 0 0 calc(18 * var(--uc));
  }
  .table-wrap {
    overflow-x: auto;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    min-width: calc(520 * var(--uc));
  }
  th,
  td {
    text-align: left;
    padding: calc(12 * var(--uc)) calc(16 * var(--uc)) calc(12 * var(--uc)) 0;
    border-bottom: 1px solid var(--x-line-soft);
    vertical-align: top;
  }
  /* 手机:520 的定宽让第三列整列停在屏外,而横滚没有任何提示 → 放开定宽,三列各自折行 */
  @media (max-width: 640px) {
    table {
      min-width: 0;
    }
    th,
    td {
      padding-right: calc(8 * var(--uc));
    }
  }
  th {
    color: var(--x-accent-ink);
  }
  td {
    color: var(--x-ink-dim);
  }
  td:first-child {
    color: var(--x-ink);
  }
  .list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .list li {
    display: grid;
    grid-template-columns: calc(36 * var(--uc)) minmax(calc(140 * var(--uc)), calc(220 * var(--uc))) 1fr;
    gap: calc(14 * var(--uc));
    align-items: baseline;
    border-bottom: 1px solid var(--x-line-soft);
    padding: calc(14 * var(--uc)) 0;
  }
  .list .idx {
    color: var(--x-accent-ink);
    font-weight: 400;
  }
  .list b {
    text-wrap: balance; /* 中列被 minmax 卡住必然折行,不平衡则第二行只剩一个词 */
    font-size: clamp(16px, 1.6vw, calc(20 * var(--uc)));
    color: var(--x-ink);
  }
  .list span:last-child {
    color: var(--x-ink-dim);
    text-wrap: pretty;
  }
  .mech {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(calc(260 * var(--uc)), 1fr));
    gap: clamp(16px, 2vw, calc(28 * var(--uc)));
  }
  .mcard {
    border: 1px solid var(--x-line-soft);
    padding: calc(22 * var(--uc));
  }
  /* 原来没有 vi/zh 分支 —— 挂型类后语言行高补偿才生效 */
  .mcard h3 {
    font-size: clamp(17px, 1.7vw, calc(24 * var(--uc)));
    color: var(--x-ink);
    margin: 0 0 calc(10 * var(--uc));
  }
  .mcard p {
    color: var(--x-ink-dim);
    margin: 0;
    text-wrap: pretty;
  }
  /* FAQ 手风琴:与首页 FAQ 同规格(问题 400/-0.02em/1.25、编号墨 0.8、记号深柠檬、行高 60、答案 1.45) */
  /* 行线与收口语法同首页 FAQ:逐条上线 + 末条下线,墨阶用 --x-line-dark
     (原来只有 0.10 的下线且首条无上线,与同块 .block 的 0.23 上线打架) */
  .faq {
    border-top: 1px solid var(--x-line-dark);
  }
  .faq:last-of-type {
    border-bottom: 1px solid var(--x-line-dark);
  }
  .faq summary {
    cursor: pointer;
    min-height: calc(60 * var(--uc));
    display: flex;
    align-items: center;
    gap: clamp(14px, 2vw, calc(28 * var(--uc))); /* 列几何与首页 FAQ 同 */
    list-style: none;
    padding: calc(12 * var(--uc)) 0;
  }
  .faq summary::-webkit-details-marker {
    display: none;
  }
  .faq .idx {
    color: var(--x-dark-cap);
    font-weight: 400;
    flex: 0 0 calc(30 * var(--uc));
  }
  /* 同 FaqSection:型类给字族/字重/字距/行高与语言分支,这里只留本处特有的 */
  .faq .q {
    color: var(--x-ink);
    flex: 1;
  }

  .faq .mark {
    color: var(--x-accent-ink);
    font-weight: 400;
    position: relative;
  }
  .faq[open] .mark {
    visibility: hidden;
  }
  .faq[open] .mark::after {
    content: '−';
    visibility: visible;
    position: absolute;
    left: 0;
    color: var(--x-accent-ink);
  }
  .faq > p {
    max-width: calc(760 * var(--uc)); /* 与首页 FAQ 同(此前 680,是「同规格」漏掉的一项) */
    color: var(--x-dark-cap);
    margin: 0 0 calc(20 * var(--uc)) calc(calc(30 * var(--uc)) + clamp(14px, 2vw, calc(28 * var(--uc))));
    text-wrap: pretty;
    line-height: 1.45;
  }
  .faq > p:lang(zh) {
    line-height: 1.6;
  }
  .faq .q {
    transition: opacity 0.2s;
  }
  .faq summary:hover .q,
  .faq summary:focus-visible .q {
    opacity: 0.6;
  }
  .cta-row {
    display: flex;
    gap: calc(14 * var(--uc));
    flex-wrap: wrap;
    margin-top: calc(8 * var(--uc));
  }

  @media (max-width: 640px) {
    .list li {
      grid-template-columns: calc(30 * var(--uc)) 1fr;
    }
    .list span:last-child {
      grid-column: 2;
    }
  }
</style>
