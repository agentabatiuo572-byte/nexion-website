---
/* [FEAT-WEB10] /nex 轻页正文 — 蓝本 App PRD §11.3.1 合规裁剪:
   无价格行/无实时行情;上市信息只写可验证事实(v1 不列交易所);App 内第 5 用法的
   措辞按官网 PRD §1.4-3 中性化为「长期持有」(App 原措辞属投机语态,官网禁用);
   App 内链一律改「下载 App」CTA。白皮书入口条件渲染(O6 无资产不渲染)。 */
import { useT, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useT(locale);
const prefix = locale === 'en' ? '' : `/${locale}`;
const WHITEPAPER_URL = import.meta.env.PUBLIC_WHITEPAPER_URL ?? '';
const sources = [1, 2, 3, 4] as const;
const uses = [1, 2, 3, 4, 5] as const;
const faqs = [1, 2, 3, 4] as const;
---

<main class="nex-page">
  <header class="hero">
    <span class="tag">{t('nex.pageTag')}</span>
    <h1>{t('nex.pageTitle')}</h1>
    <p class="lead">{t('nex.pageLead')}</p>
  </header>

  <section class="block" aria-labelledby="nex-compare">
    <h2 id="nex-compare">{t('nex.compareTitle')}</h2>
    <div class="table-wrap">
      <table>
        <thead>
          <tr><th>{t('nex.cmpProp')}</th><th>USDT</th><th>NEX</th></tr>
        </thead>
        <tbody>
          <tr><td>{t('nex.cmpType')}</td><td>{t('nex.cmpTypeUsdt')}</td><td>{t('nex.cmpTypeNex')}</td></tr>
          <tr><td>{t('nex.cmpVol')}</td><td>{t('nex.cmpVolUsdt')}</td><td>{t('nex.cmpVolNex')}</td></tr>
          <tr><td>{t('nex.cmpUse')}</td><td>{t('nex.cmpUseUsdt')}</td><td>{t('nex.cmpUseNex')}</td></tr>
        </tbody>
      </table>
    </div>
  </section>

  <section class="block" aria-labelledby="nex-sources">
    <h2 id="nex-sources">{t('nex.sourcesTitle')}</h2>
    <ul class="list" role="list">
      {sources.map((n) => (
        <li><b>{t(`nex.src${n}Title`)}</b><span>{t(`nex.src${n}Desc`)}</span></li>
      ))}
    </ul>
  </section>

  <section class="block" aria-labelledby="nex-uses">
    <h2 id="nex-uses">{t('nex.usesTitle')}</h2>
    <ul class="list" role="list">
      {uses.map((n) => (
        <li><b>{t(`nex.use${n}Title`)}</b><span>{t(`nex.use${n}Desc`)}</span></li>
      ))}
    </ul>
  </section>

  <section class="block" aria-labelledby="nex-mech">
    <h2 id="nex-mech">{t('nex.mechTitle')}</h2>
    <div class="mech">
      <article class="mcard">
        <h3>{t('nex.mech1Title')}</h3>
        <p>{t('nex.mech1Desc')}</p>
      </article>
      <article class="mcard">
        <h3>{t('nex.mech2Title')}</h3>
        <p>{t('nex.mech2Desc')}</p>
      </article>
    </div>
  </section>

  <section class="block" aria-labelledby="nex-faq">
    <h2 id="nex-faq">{t('nex.faqTitle')}</h2>
    {faqs.map((n) => (
      <details class="faq">
        <summary>{t(`nex.faq${n}Q`)}</summary>
        <p>{t(`nex.faq${n}A`)}</p>
      </details>
    ))}
  </section>

  <div class="cta-row">
    <a class="pill primary" href={`${prefix}/#download`}>{t('nex.getApp')}</a>
    {WHITEPAPER_URL && (
      <a class="pill" href={WHITEPAPER_URL} target="_blank" rel="noopener">{t('nex.whitepaper')}</a>
    )}
  </div>
</main>

<style>
  .nex-page {
    max-width: 760px;
    margin: 0 auto;
    padding: 48px 20px 0;
  }
  .hero {
    text-align: center;
    margin-bottom: 44px;
  }
  .tag {
    display: inline-block;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.08em;
    color: var(--v5-nex);
    background: var(--v5-nex-soft);
    border-radius: var(--w-radius-pill);
    padding: 5px 14px;
    margin-bottom: 14px;
  }
  h1 {
    font-size: clamp(28px, 4vw, 40px);
    font-weight: 600;
    color: var(--v5-ink);
    margin: 0 0 12px;
    line-height: 1.15;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }
  .lead {
    color: var(--v5-ink-2);
    font-size: 15px;
    margin: 0 auto;
    max-width: 560px;
    text-wrap: pretty;
  }
  .block {
    margin-bottom: 40px;
  }
  .block h2 {
    font-size: 20px;
    font-weight: 600;
    color: var(--v5-ink);
    margin: 0 0 16px;
  }
  .table-wrap {
    overflow-x: auto;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    background: var(--v5-surface);
    border-radius: var(--w-radius-card);
    overflow: hidden;
    font-size: 14px;
    min-width: 420px;
  }
  th,
  td {
    text-align: left;
    padding: 13px 16px;
  }
  thead th {
    color: var(--v5-ink-3);
    font-weight: 500;
    font-size: 12.5px;
    border-bottom: 1px solid var(--v5-border);
  }
  tbody td {
    color: var(--v5-ink-2);
  }
  tbody td:first-child {
    color: var(--v5-ink-3);
    font-size: 13px;
  }
  tbody tr + tr td {
    border-top: 1px solid var(--v5-border);
  }
  .list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }
  .list li {
    background: var(--v5-surface);
    border-radius: 16px;
    padding: 16px 18px;
    display: grid;
    gap: 4px;
  }
  .list b {
    color: var(--v5-ink);
    font-size: 14px;
    font-weight: 600;
  }
  .list span {
    color: var(--v5-ink-3);
    font-size: 13.5px;
    text-wrap: pretty;
  }
  .mech {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 14px;
  }
  .mcard {
    background: var(--v5-surface);
    border-radius: var(--w-radius-card);
    padding: 22px 20px;
  }
  .mcard h3 {
    font-size: 14px;
    font-weight: 600;
    color: var(--v5-nex);
    margin: 0 0 8px;
  }
  .mcard p {
    color: var(--v5-ink-2);
    font-size: 13.5px;
    margin: 0;
    text-wrap: pretty;
  }
  .faq {
    background: var(--v5-surface);
    border-radius: 16px;
    padding: 2px 18px;
    margin-bottom: 10px;
  }
  .faq summary {
    cursor: pointer;
    min-height: 46px;
    display: flex;
    align-items: center;
    font-size: 14px;
    font-weight: 600;
    color: var(--v5-ink);
    list-style: none;
  }
  .faq summary::before {
    content: '+';
    color: var(--v5-nex);
    margin-right: 10px;
    font-weight: 600;
  }
  .faq[open] summary::before {
    content: '−';
  }
  .faq summary:focus-visible {
    outline: 2px solid var(--v5-brand);
    outline-offset: 2px;
  }
  .faq p {
    color: var(--v5-ink-2);
    font-size: 13.5px;
    margin: 0 0 14px;
    text-wrap: pretty;
  }
  .cta-row {
    display: flex;
    gap: 12px;
    justify-content: center;
    flex-wrap: wrap;
    margin-top: 8px;
  }
  .pill {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    padding: 0 26px;
    border-radius: var(--w-radius-pill);
    font-size: 15px;
    font-weight: 600;
    text-decoration: none;
    color: var(--v5-ink-2);
    border: 1px solid var(--v5-border-strong);
    transition:
      transform 0.15s,
      opacity 0.15s;
  }
  .pill.primary {
    background: var(--v5-brand);
    color: var(--v5-on-brand);
    border: 0;
  }
  .pill:active {
    transform: scale(0.98);
    opacity: 0.85;
  }
  .pill:focus-visible {
    outline: 2px solid var(--v5-brand);
    outline-offset: 2px;
  }
</style>
