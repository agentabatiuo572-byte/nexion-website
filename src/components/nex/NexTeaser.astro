---
/* [FEAT-WEB10] Home NEX 锚点板块 — 三卡速览 + Learn more → /nex。
   axiom 方向:黑底三列(等宽 tag + display 标题 + 等宽正文)。 */
import { useT, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useT(locale);
const prefix = locale === 'en' ? '' : `/${locale}`;
const cards = ['what', 'earn', 'use'] as const;
---

<section class="nex-teaser" id="nex">
  <div class="head">
    <span class="x-label lab" data-rv>{t('nex.teaserTitle')}</span>
  </div>
  <div class="cards">
    {
      cards.map((c, i) => (
        <article class="card" data-rv style={`--d:${i * 0.1}s`}>
          <span class="idx x-mono">0{i + 1}</span>
          <h3>{t(`nex.teaser.${c}Title`)}</h3>
          <p class="x-mono">{t(`nex.teaser.${c}Desc`)}</p>
        </article>
      ))
    }
  </div>
  <div class="more" data-rv>
    <a class="xbtn" href={`${prefix}/nex`}>
      <span class="xbtn-ghost">{t('nex.teaserCta')} <span class="arr">→</span></span>
      <span class="xbtn-a">{t('nex.teaserCta')} <span class="arr">→</span></span>
      <span class="xbtn-b">{t('nex.teaserCta')} <span class="arr">→</span></span>
    </a>
  </div>
</section>

<style>
  .nex-teaser {
    position: relative;
    z-index: 1;
    padding: var(--x-section-gap) var(--x-pad);
  }
  .head {
    border-top: 1px solid var(--x-line);
    padding-top: 18px;
    margin-bottom: clamp(28px, 4vw, 48px);
  }
  .lab {
    color: var(--x-white);
  }
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: clamp(20px, 3vw, 40px);
  }
  .card {
    border: 1px solid var(--x-line-soft);
    padding: clamp(20px, 2.4vw, 30px);
    display: grid;
    gap: 12px;
    align-content: start;
  }
  .idx {
    color: var(--x-accent);
    font-weight: 700;
  }
  .card h3 {
    font-family: var(--x-font-display);
    font-size: clamp(20px, 2vw, 26px);
    font-weight: 500;
    letter-spacing: -0.015em;
    color: var(--x-white);
    margin: 0;
    line-height: 1.15;
    text-wrap: balance;
  }
  .card p {
    color: var(--x-ink-dim);
    margin: 0;
    text-wrap: pretty;
  }
  .more {
    margin-top: clamp(24px, 3vw, 40px);
  }
</style>
