---
/* [FEAT-WEB10] Home NEX 锚点板块 — R8(白带块):
   头行 16 mono 打字机;三卡改无盒左线开放列(编号 0.8 墨 + 48 档标题行遮罩 + 12 mono 说明),
   三列视差 k=[0.06,0.11,0.16] + Learn more → /nex。 */
import { useT, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useT(locale);
const prefix = locale === 'en' ? '' : `/${locale}`;
const cards = ['what', 'earn', 'use'] as const;
const ks = [0.06, 0.11, 0.16];
---

<section class="nex-teaser" id="nex">
  <div class="head">
    <p class="lab x-mono-lg" data-tw>{t('nex.teaserTitle')}</p>
  </div>
  <div class="cards">
    {
      cards.map((c, i) => (
        <article class="card rv-fade" data-rv data-plx={ks[i]}>
          <p class="idx x-mono" data-tw data-tw-delay={160 * i}>
            0{i + 1}
          </p>
          <div class="stack">
            <h3 class="x-display" data-lr data-lr-delay={100 * i}>{t(`nex.teaser.${c}Title`)}</h3>
            <p class="x-mono desc">{t(`nex.teaser.${c}Desc`)}</p>
          </div>
        </article>
      ))
    }
  </div>
  <div class="more" data-rv>
    <a class="xbtn" href={`${prefix}/nex`}>
      <span class="xbtn-ghost">{t('nex.teaserCta')} <span class="arr">→</span></span>
      <span class="xbtn-a">{t('nex.teaserCta')} <span class="arr">→</span></span>
      <span class="xbtn-b">{t('nex.teaserCta')} <span class="arr">→</span></span>
    </a>
  </div>
</section>

<style>
  .nex-teaser {
    padding: 0 var(--x-pad);
  }
  .head {
    margin-bottom: clamp(48px, 8.33vw, 160px);
  }
  .lab {
    color: var(--x-ink);
    margin: 0;
    min-height: 1.2em;
  }
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: clamp(24px, 4.17vw, 80px);
  }
  .card {
    border-left: 1px solid var(--x-line-dark);
    padding-left: 20px;
    display: flex;
    flex-direction: column;
    gap: clamp(40px, 5.7vw, 110px);
    will-change: transform;
  }
  .idx {
    color: var(--x-accent-ink); /* R30:纸面编号深柠檬回血 */
    margin: 0;
  }
  .stack {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .stack h3 {
    font-size: clamp(28px, 2.78vw, 53px);
    color: var(--x-ink);
    margin: 0;
  }
  .desc {
    color: var(--x-dark-cap);
    margin: 0;
    text-wrap: pretty;
    line-height: 1.45;
  }
  .more {
    margin-top: clamp(32px, 4vw, 60px);
  }
  @media (max-width: 768px) {
    .card {
      border-left: 0;
      border-top: 1px solid var(--x-line-dark);
      padding: 20px 0 0;
      gap: 40px;
    }
  }
</style>
