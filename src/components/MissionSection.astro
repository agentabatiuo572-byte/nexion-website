---
/* [FEAT-WEB09] 使命升华 — 宣言 + 领域组(内容自创,手法借鉴;与 App PRD §1.1
   任务类型兼容,不虚构具名合作)。v1 文字 chip 结构(PRD ⑤:图标缺失不破版,
   图标位归视觉精修 T11)。纯展示无可点。 */
import { useT, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useT(locale);
const fields = [1, 2, 3, 4, 5, 6] as const;
---

<section class="mission" id="mission">
  <h2 class="title">{t('mission.title')}</h2>
  <p class="lead">{t('mission.lead')}</p>
  <ul class="fields" role="list">
    {fields.map((n) => <li class="chip">{t(`mission.f${n}`)}</li>)}
  </ul>
</section>

<style>
  .mission {
    max-width: var(--w-content-max);
    margin: 0 auto;
    padding: var(--w-space-section) 20px 0;
    text-align: center;
  }
  .title {
    font-size: clamp(22px, 2.8vw, 28px);
    font-weight: 600;
    color: var(--v5-ink);
    margin: 0 0 10px;
    text-wrap: balance;
  }
  .lead {
    color: var(--v5-ink-3);
    font-size: 14px;
    max-width: 620px;
    margin: 0 auto 24px;
    text-wrap: pretty;
  }
  .fields {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
  }
  .chip {
    background: var(--v5-surface-2);
    color: var(--v5-ink-2);
    border-radius: var(--w-radius-pill);
    padding: 10px 18px;
    font-size: 13.5px;
    white-space: nowrap;
  }
</style>
