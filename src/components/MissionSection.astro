---
/* [FEAT-WEB09] 使命板块(算力去向)— R48.7 重构(主人 2026-08-28 令③):
   眉标(柠檬刻度+16 档保形)→ 大陈述 48 档(zh 焊两行)→ 说明段 16 档纯白紧行距 —— 三件保留;
   答案层从「竖标夹持的编号列表」改为 **2×3 玻璃图标格**:每格 = 线性图标(Icon.astro 单源)
   + 24 档领域名 + 右端 01-06 编号(两端行体例与瓷砖章 metarow 同构)。
   地球在本拍停右侧 65%(fx poseB),图格宽压在 660 画布内不压球心。
   打字机眉标 / 行遮罩标题 / 进场钩子沿用;编号仍走 data-tw 打字机(错峰 80ms)。
   R45 手机放开(nowrap/画布上限)判例照旧。 */
import { useT, type Locale } from '../i18n';
import Icon from './Icon.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useT(locale);
const fields = [
  { n: 1, icon: 'ai' },
  { n: 2, icon: 'sci' },
  { n: 3, icon: 'climate' },
  { n: 4, icon: 'bio' },
  { n: 5, icon: 'lang' },
  { n: 6, icon: 'edu' },
] as const;
const leadParas = t('mission.lead').split('\n');
---

<section class="mission" id="mission">
  <div class="col">
    <p class="kicker">
      <span class="ktick" aria-hidden="true"></span>
      <span class="ktxt x-mono-lg" data-tw>{t('mission.kicker')}</span>
    </p>

    <h2 class="state x-display" data-lr>{t('mission.title')}</h2>

    <div class="body" data-rv>
      {leadParas.map((p) => <p>{p}</p>)}
    </div>
  </div>

  <ol class="fgrid" role="list">
    {
      fields.map(({ n, icon }, i) => (
        <li class="chip x-tile" data-rv style={`--d:${0.06 * i}s`}>
          <Icon name={icon} class="fic" />
          <span class="name x-h24">{t(`mission.f${n}`)}</span>
          <span class="idx x-mono" data-tw data-tw-delay={80 * i}>
            0{n}
          </span>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .mission {
    position: relative;
    z-index: 1;
    height: var(--x-sec-h);
    overflow: hidden;
    padding: 0 var(--x-pad);
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    gap: max(24px, calc(36 * var(--u)));
  }
  .col {
    width: calc(538.56 * var(--u));
    display: flex;
    flex-direction: column;
    gap: max(24px, calc(40 * var(--u))); /* cap 精确(R27) */
  }
  /* 章节眉(全站体例:柠檬刻度 + 16 档保形眉标) */
  .kicker {
    color: var(--x-white);
    margin: 0;
    min-height: 1.2em;
    display: flex;
    align-items: center;
    gap: calc(10 * var(--uc)); /* R26:px-clamp 保形(em 基曾挂死在根 16px,弃用) */
  }
  .ktick {
    width: max(2px, calc(2 * var(--u)));
    height: max(20px, calc(20.16 * var(--u)));
    background: linear-gradient(to bottom, var(--x-accent-hot), color-mix(in srgb, var(--x-accent-hot) 10%, transparent));
    flex: 0 0 auto;
  }
  /* 大陈述 48 档:能单行则单行(可越出列宽,参考站同构;主人 R24),zh 焊两行成块 */
  .state {
    font-size: max(32px, calc(48 * var(--u))); /* R45 拍板:区块与卡标题回参考站的 48 档 */
    color: var(--x-white);
    margin: 0;
    white-space: pre-line;
    width: max-content;
    max-width: calc(835.2 * var(--u));
  }
  /* 说明段:16 档纯白紧行距(高反差),容器随字号 em 流动(单尺) */
  .body {
    font-family: var(--x-font-mono);
    font-size: calc(16 * var(--uc));
    letter-spacing: 0;
    text-transform: uppercase;
    line-height: 1.2; /* R26:与眉标同尺;两句密簇贴参考质感 */
    color: var(--x-white);
    max-width: 31em; /* en 两句各自单行(主人 R24);随字号 em 流动 */
    display: flex;
    flex-direction: column;
    gap: 0.55em; /* 两句收成一组,消左轨碎节奏(R25) */
  }
  /* vi 句长必折(见下方 .body p:lang(vi)),折了就吃行距;zh 侧已有 1.5,vi 这里补齐 */
  .body:lang(vi) {
    line-height: 1.45;
  }
  .body p {
    margin: 0;
    text-wrap: pretty;
    white-space: nowrap; /* 一行能展示的不换行(主人 R24);超长语言在下方按语言放开 */
  }
  .body p:lang(vi) {
    white-space: normal; /* vi 句长必折,保自然折行 */
  }
  .body:lang(zh) {
    font-size: max(16.5px, calc(16.56 * var(--u)));
    line-height: 1.5; /* 与眉标同尺(R25 统一) */
    word-spacing: -0.36em; /* 等宽空格 0.61em → 视觉 0.25em,收中西混排空洞 */
    max-width: 26em;
  }
  /* 答案层 R48.7:2×3 玻璃图标格。小格用小圆角(--x-r-sm),两端行 = 图标+名 ←→ 编号 */
  .fgrid {
    list-style: none;
    margin: 0;
    padding: 0;
    width: calc(660 * var(--u));
    max-width: 100%;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: calc(12 * var(--uc));
  }
  .chip {
    border-radius: var(--x-r-sm);
    padding: calc(16 * var(--uc)) calc(18 * var(--uc));
    display: flex;
    align-items: center;
    gap: calc(14 * var(--uc));
  }
  .chip :global(.fic) {
    width: max(20px, calc(26 * var(--u)));
    height: max(20px, calc(26 * var(--u)));
    flex: 0 0 auto;
    color: var(--x-accent-hot); /* 图标走柠檬热档:黑区点睛体例(与编号同族) */
  }
  .name {
    font-size: max(16px, calc(20 * var(--u))); /* 格内领域名降半档(24 档在半宽格里 en 两行起步) */
    color: var(--x-white);
    flex: 1 1 auto;
    min-width: 0;
  }
  .idx {
    line-height: 1.2;
    font-family: var(--x-font-mono);
    font-size: max(12px, calc(12 * var(--u)));
    letter-spacing: 0;
    color: var(--x-ink-dim); /* 编号让位给图标(一格双柠檬会吵),退暗档 */
    flex: 0 0 auto;
  }
  @media (max-width: 860px) {
    .mission {
      height: auto;
      min-height: 60svh;
      padding: calc(80 * var(--uc)) var(--x-pad);
      justify-content: flex-end;
    }
    .col {
      width: 100%;
    }
    /* R45:桌面 nowrap 在 ≤480 把说明段裁掉 50–140px(区块 overflow:hidden);手机自然折行 */
    .body p {
      white-space: normal;
    }
    /* R45:桌面的 835 画布上限在手机缩到列宽 58%,把能单行的标题折成 2–3 行;手机只受列宽约束 */
    .state {
      max-width: 100%;
    }
    /* 660 画布宽在 390 视口只剩 ~179px(u 随画布缩),图格放开吃满列宽 */
    .fgrid {
      width: 100%;
    }
  }
  @media (max-width: 560px) {
    .fgrid {
      grid-template-columns: 1fr;
    }
  }
</style>
