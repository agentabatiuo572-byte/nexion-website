---
/* [FEAT-WEB09] 使命板块(算力去向)— R48.7 六宫格 + R48.19 实景小图(主人令:
   「增加实际场景类图片,小图即可,用户看着有信任感,不要只是图标」)。
   每格 = 实景缩略图(gpt-image-2 生成,真实感铁则:实景摄影/无文字/无人脸)+ 领域名 + 右端编号;
   线性图标在本板块退役(Icon.astro 其余消费面不动)。
   眉标/大陈述/说明段三件保留;地球在本拍停右侧 65%(fx poseB),图格宽压在 660 画布内不压球心。
   R45 手机放开(nowrap/画布上限)判例照旧。 */
import { useT, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useT(locale);
const fields = [
  { n: 1, img: '/mission/ai.webp' },
  { n: 2, img: '/mission/sci.webp' },
  { n: 3, img: '/mission/climate.webp' },
  { n: 4, img: '/mission/bio.webp' },
  { n: 5, img: '/mission/lang.webp' },
  { n: 6, img: '/mission/edu.webp' },
] as const;
const leadParas = t('mission.lead').split('\n');
---

<section class="mission" id="mission">
  <div class="col">
    <p class="kicker">
      <span class="ktick" aria-hidden="true"></span>
      <span class="ktxt x-mono-lg" data-tw>{t('mission.kicker')}</span>
    </p>

    <h2 class="state x-display" data-lr>{t('mission.title')}</h2>

    <div class="body" data-rv>
      {leadParas.map((p) => <p>{p}</p>)}
    </div>
  </div>

  {/* R48.8 主人改令:六宫格 —— 单块玻璃底,细线分区(与数据条内分线同族),不再一格一底 */}
  <ol class="fgrid x-tile" role="list" data-rv>
    {
      fields.map(({ n, img }) => (
        <li class="cell">
          <img class="thumb" src={img} alt="" width="640" height="427" loading="lazy" decoding="async" />
          <span class="name x-h24">{t(`mission.f${n}`)}</span>
          <span class="idx x-mono" data-tw data-tw-delay={80 * (n - 1)}>
            0{n}
          </span>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .mission {
    position: relative;
    z-index: 1;
    height: var(--x-sec-h);
    overflow: hidden;
    padding: 0 var(--x-pad);
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    gap: max(24px, calc(36 * var(--u)));
  }
  .col {
    width: calc(538.56 * var(--u));
    display: flex;
    flex-direction: column;
    gap: max(24px, calc(40 * var(--u))); /* cap 精确(R27) */
  }
  /* 章节眉(全站体例:柠檬刻度 + 16 档保形眉标) */
  .kicker {
    color: var(--x-white);
    margin: 0;
    min-height: 1.2em;
    display: flex;
    align-items: center;
    gap: calc(10 * var(--uc)); /* R26:px-clamp 保形(em 基曾挂死在根 16px,弃用) */
  }
  .ktick {
    width: max(2px, calc(2 * var(--u)));
    height: max(20px, calc(20.16 * var(--u)));
    background: linear-gradient(to bottom, var(--x-accent-hot), color-mix(in srgb, var(--x-accent-hot) 10%, transparent));
    flex: 0 0 auto;
  }
  /* 大陈述 48 档:能单行则单行(可越出列宽,参考站同构;主人 R24),zh 焊两行成块 */
  .state {
    font-size: max(32px, calc(48 * var(--u))); /* R45 拍板:区块与卡标题回参考站的 48 档 */
    color: var(--x-white);
    margin: 0;
    white-space: pre-line;
    width: max-content;
    max-width: calc(835.2 * var(--u));
  }
  /* 说明段:16 档纯白紧行距(高反差),容器随字号 em 流动(单尺) */
  .body {
    font-family: var(--x-font-mono);
    font-size: calc(16 * var(--uc));
    letter-spacing: 0;
    text-transform: uppercase;
    line-height: 1.2; /* R26:与眉标同尺;两句密簇贴参考质感 */
    color: var(--x-white);
    max-width: 31em; /* en 两句各自单行(主人 R24);随字号 em 流动 */
    display: flex;
    flex-direction: column;
    gap: 0.55em; /* 两句收成一组,消左轨碎节奏(R25) */
  }
  /* vi 句长必折(见下方 .body p:lang(vi)),折了就吃行距;zh 侧已有 1.5,vi 这里补齐 */
  .body:lang(vi) {
    line-height: 1.45;
  }
  .body p {
    margin: 0;
    text-wrap: pretty;
    white-space: nowrap; /* 一行能展示的不换行(主人 R24);超长语言在下方按语言放开 */
  }
  .body p:lang(vi) {
    white-space: normal; /* vi 句长必折,保自然折行 */
  }
  .body:is(:lang(zh), :lang(ja), :lang(ko)) {
    font-size: max(16.5px, calc(16.56 * var(--u)));
    line-height: 1.5; /* 与眉标同尺(R25 统一) */
    word-spacing: -0.36em; /* 等宽空格 0.61em → 视觉 0.25em,收中西混排空洞 */
    max-width: 26em;
  }
  /* 答案层 R48.8:六宫格 —— 一块玻璃底 + 细线分区(简洁大气;线用 --x-line-soft 与数据条内分线同族)。
     分线走单元自身边:偶数格吃左线成两条纵线段位,第二行起吃顶线成横线;无 gap,线即区界。 */
  .fgrid {
    list-style: none;
    margin: 0;
    padding: 0;
    width: calc(660 * var(--u));
    max-width: 100%;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .cell {
    padding: calc(16 * var(--uc)) calc(22 * var(--uc));
    display: flex;
    align-items: center;
    gap: calc(16 * var(--uc));
    border-top: 1px solid var(--x-line-soft);
  }
  .cell:nth-child(-n + 2) {
    border-top: 0; /* 首行上缘 = 玻璃边界 */
  }
  .cell:nth-child(even) {
    border-left: 1px solid var(--x-line-soft);
  }
  /* R48.19 实景缩略图:4/3 小图,height:auto 压掉宽高属性钉轴(R48.7 已踩 aspect-ratio 失效坑) */
  .thumb {
    width: max(72px, calc(96 * var(--u)));
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: calc(10 * var(--uc));
    flex: 0 0 auto;
  }
  .name {
    font-size: max(16px, calc(20 * var(--u))); /* 格内领域名降半档(24 档在半宽格里 en 两行起步) */
    color: var(--x-white);
    flex: 1 1 auto;
    min-width: 0;
  }
  .idx {
    line-height: 1.2;
    font-family: var(--x-font-mono);
    font-size: max(12px, calc(12 * var(--u)));
    letter-spacing: 0;
    color: var(--x-ink-dim); /* 编号让位给图标(一格双柠檬会吵),退暗档 */
    flex: 0 0 auto;
  }
  @media (max-width: 860px) {
    .mission {
      height: auto;
      min-height: 60svh;
      padding: calc(80 * var(--uc)) var(--x-pad);
      justify-content: flex-end;
    }
    .col {
      width: 100%;
    }
    /* R45:桌面 nowrap 在 ≤480 把说明段裁掉 50–140px(区块 overflow:hidden);手机自然折行 */
    .body p {
      white-space: normal;
    }
    /* R45:桌面的 835 画布上限在手机缩到列宽 58%,把能单行的标题折成 2–3 行;手机只受列宽约束 */
    .state {
      max-width: 100%;
    }
    /* 660 画布宽在 390 视口只剩 ~179px(u 随画布缩),图格放开吃满列宽 */
    .fgrid {
      width: 100%;
    }
  }
  @media (max-width: 560px) {
    .fgrid {
      grid-template-columns: 1fr;
    }
    /* 单列后区界只剩横线:第 2 格起全部吃顶线,纵线退场 */
    .cell:nth-child(2) {
      border-top: 1px solid var(--x-line-soft);
    }
    .cell:nth-child(even) {
      border-left: 0;
    }
  }
</style>
