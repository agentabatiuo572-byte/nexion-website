---
/* [FEAT-WEB09] 使命升华 — R7(解剖报告 P1-22a 宣言化):
   自创的序号行表撤销;lead 升宣言档(clamp(28,2.78vw,53))行遮罩进场,
   左置(与社证区右置成之字),板块 py140(<851 80)+底缘细线;
   领域组改等宽点列 + 竖条纹装饰。内容 key 全不变。 */
import { useT, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useT(locale);
const fields = [1, 2, 3, 4, 5, 6] as const;
---

<section class="mission" id="mission">
  <div class="col">
    <span class="x-label lab" data-tw>{t('mission.title')}</span>
    <p class="lead x-display" data-lr>{t('mission.lead')}</p>
    <div class="aside">
      <span class="bars" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></span>
      <ul class="fields x-mono" role="list">
        {fields.map((n) => <li>{t(`mission.f${n}`)}</li>)}
      </ul>
    </div>
  </div>
</section>

<style>
  .mission {
    position: relative;
    z-index: 1;
    padding: 140px var(--x-pad);
    border-bottom: 1px solid var(--x-line);
  }
  .col {
    display: flex;
    flex-direction: column;
    gap: 20px;
    width: min(725px, 100%);
  }
  .lab {
    color: var(--x-white);
  }
  .lead {
    font-size: clamp(28px, 2.78vw, 53px);
    color: var(--x-white);
    margin: 0;
  }
  .aside {
    display: flex;
    gap: 16px;
    margin-top: 40px;
    margin-left: clamp(0px, 5.5vw, 80px);
  }
  .bars {
    display: flex;
    gap: 4px;
    flex: 0 0 auto;
    padding-top: 4px;
  }
  .bars i {
    width: 1px;
    height: 70px;
    background: var(--x-ink);
    display: block;
  }
  .fields {
    list-style: disc;
    margin: 0;
    padding-left: 18px;
    color: var(--x-ink);
    display: grid;
    gap: 6px;
  }
  @media (max-width: 851px) {
    .mission {
      padding: 80px var(--x-pad);
    }
  }
</style>
