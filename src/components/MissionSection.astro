---
/* [FEAT-WEB09] 使命板块 — R23 v3(三路复审合并 + 体例仲裁:站内体例>单屏还原、内容语义>参考站语义):
   眉标(琥珀刻度+16 档保形)→ 大陈述 48 档(zh 焊两行)→ 说明段 16 档纯白紧行距(高反差回归)→
   答案层=琥珀编号网格(01-06 + 展示体域名,两列;全站编号体例,去 disc 双记号),
   「[」竖标夹持整网格、缩进精确 80 画布。设备特写姿态延迟起混在 fx(R23)。 */
import { useT, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useT(locale);
const fields = [1, 2, 3, 4, 5, 6] as const;
const leadParas = t('mission.lead').split('\n');
---

<section class="mission" id="mission">
  <div class="col">
    <p class="kicker">
      <span class="ktick" aria-hidden="true"></span>
      <span class="ktxt x-mono-lg" data-tw>{t('mission.kicker')}</span>
    </p>

    <h2 class="state x-display" data-lr>{t('mission.title')}</h2>

    <div class="body" data-rv>
      {leadParas.map((p) => <p>{p}</p>)}
    </div>

    <div class="cluster" data-rv style="--d:.12s">
      <span class="bullet" aria-hidden="true"></span>
      <ol class="fields" role="list">
        {
          fields.map((n, i) => (
            <li>
              <span class="idx" data-tw data-tw-delay={80 * i}>
                0{n}
              </span>
              <span class="name">{t(`mission.f${n}`)}</span>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  .mission {
    position: relative;
    z-index: 1;
    height: var(--x-sec-h);
    overflow: hidden;
    padding: 0 var(--x-pad);
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
  }
  .col {
    width: calc(538.56 * var(--u));
    display: flex;
    flex-direction: column;
    gap: max(24px, calc(40 * var(--u))); /* cap 精确(R27) */
  }
  /* 章节眉(全站体例:琥珀刻度 + 16 档保形眉标) */
  .kicker {
    color: var(--x-white);
    margin: 0;
    min-height: 1.2em;
    display: flex;
    align-items: center;
    gap: clamp(10px, 0.69vw, calc(13.3 * var(--uc))); /* R26:px-clamp 保形(em 基曾挂死在根 16px,弃用) */
  }
  .ktick {
    width: max(2px, calc(2 * var(--u)));
    height: max(20px, calc(20.16 * var(--u)));
    background: linear-gradient(to bottom, var(--x-accent-hot), color-mix(in srgb, var(--x-accent-hot) 10%, transparent));
    flex: 0 0 auto;
  }
  /* 大陈述 48 档:能单行则单行(可越出列宽,参考站同构;主人 R24),zh 焊两行成块 */
  .state {
    font-size: max(32px, calc(48 * var(--u)));
    color: var(--x-white);
    margin: 0;
    white-space: pre-line;
    width: max-content;
    max-width: calc(835.2 * var(--u));
  }
  /* 说明段:16 档纯白紧行距(高反差),容器随字号 em 流动(单尺) */
  .body {
    font-family: var(--x-font-mono);
    font-size: clamp(16px, 1.11vw, calc(22 * var(--uc)));
    letter-spacing: 0;
    text-transform: uppercase;
    line-height: 1.2; /* R26:与眉标同尺(zh 侧 1.5 对 1.5 已齐);两句密簇贴参考质感 */
    color: var(--x-white);
    max-width: 31em; /* en 两句各自单行(主人 R24);随字号 em 流动 */
    display: flex;
    flex-direction: column;
    gap: 0.55em; /* 两句收成一组,消左轨碎节奏(R25) */
  }
  .body p {
    margin: 0;
    text-wrap: pretty;
    white-space: nowrap; /* 一行能展示的不换行(主人 R24);超长语言在下方按语言放开 */
  }
  :global(html[lang='vi']) .body p {
    white-space: normal; /* vi 句长必折,保自然折行 */
  }
  :global(html[lang='zh']) .body {
    font-size: max(16.5px, calc(16.56 * var(--u)));
    line-height: 1.5; /* 与眉标同尺(R25 统一) */
    word-spacing: -0.36em; /* 等宽空格 0.61em → 视觉 0.25em,收中西混排空洞 */
    max-width: 26em;
  }
  /* 答案层:琥珀编号网格(两列 3×2),「[」竖标夹持,缩进 80 画布 */
  .cluster {
    display: flex;
    gap: max(14px, calc(20 * var(--u)));
    align-items: stretch;
    margin-left: max(0px, calc(80 * var(--u))); /* cap=80×1.3333 精确(R26) */
  }
  .bullet {
    width: max(5px, calc(5 * var(--u)));
    align-self: stretch;
    flex: 0 0 auto;
    border-style: solid;
    border-width: 1px 0 1px 1px; /* 与参考竖标同为 1px 线(R25 明示,DPR1 下不再降级) */
    /* 渐变只暗 ~25%(对齐参考竖标顶亮→微暗比例,R24 收敛) */
    border-image: linear-gradient(to bottom, var(--x-accent-hot), color-mix(in srgb, var(--x-accent-hot) 78%, var(--x-bg))) 1;
  }
  /* R27:单列(参考站同构)——en 双列曾越列压图、双列行序有歧义、左下空场,单列三消 */
  .fields {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    row-gap: max(12px, calc(16 * var(--u)));
    align-content: center;
  }
  .fields li {
    display: flex;
    align-items: baseline;
    gap: clamp(10px, 0.69vw, calc(13.3 * var(--uc))); /* R26:px-clamp 保形(em 基曾挂死,弃用) */
    white-space: nowrap;
  }
  .idx {
    font-family: var(--x-font-mono);
    font-size: max(13px, calc(14 * var(--u)));
    letter-spacing: 0;
    color: var(--x-accent-hot); /* 黑底编号走亮柠檬热档(R38 换系后正名) */
  }
  .name {
    font-family: var(--x-font-display);
    font-size: max(21px, calc(24 * var(--u))); /* 24 档:答案层权重对齐语义(R24;cap 精确 R26) */
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1.15;
    color: var(--x-white);
  }
  @media (max-width: 860px) {
    .mission {
      height: auto;
      min-height: 60svh;
      padding: calc(80 * var(--uc)) var(--x-pad);
      justify-content: flex-end;
    }
    .col {
      width: 100%;
    }
    .cluster {
      margin-left: clamp(12px, 5vw, calc(60 * var(--uc)));
    }
  }
  @media (max-width: 560px) {
    .fields {
      grid-template-columns: 1fr;
    }
  }
</style>
