---
/* [FEAT-WEB09] 使命板块 — R8(about 带,画布 1440 等比):
   定高 --x-sec-h、左置列 538→37.4vw 垂直居中;
   眉标升 16 mono 打字机,lead 升 48 档行遮罩;
   领域组保持竖条 + 点列(画布 pl-80/mt-40)。内容 key 全不变。 */
import { useT, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useT(locale);
const fields = [1, 2, 3, 4, 5, 6] as const;
---

<section class="mission" id="mission">
  <div class="col">
    <p class="kicker x-mono-lg" data-tw>{t('mission.title')}</p>
    <p class="lead x-display" data-lr>{t('mission.lead')}</p>
    <div class="aside">
      <span class="bars" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></span>
      <ul class="fields x-mono" role="list">
        {fields.map((n) => <li>{t(`mission.f${n}`)}</li>)}
      </ul>
    </div>
  </div>
</section>

<style>
  .mission {
    position: relative;
    z-index: 1;
    height: var(--x-sec-h);
    overflow: hidden;
    padding: 0 var(--x-pad);
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
  }
  .col {
    width: min(37.4vw, 717px);
    display: flex;
    flex-direction: column;
    gap: clamp(24px, 2.78vw, 53px);
  }
  .kicker {
    color: var(--x-white);
    margin: 0;
    min-height: 1.2em;
  }
  .lead {
    font-size: clamp(32px, 3.33vw, 64px);
    color: var(--x-white);
    margin: 0;
  }
  .aside {
    display: flex;
    gap: 16px;
    align-items: center;
    margin-top: clamp(16px, 1.4vw, 27px);
    margin-left: clamp(0px, 5.56vw, 107px);
  }
  .bars {
    display: flex;
    gap: 4px;
    flex: 0 0 auto;
  }
  .bars i {
    width: 1px;
    height: 70px;
    background: var(--x-ink);
    display: block;
  }
  .fields {
    list-style: disc;
    margin: 0;
    padding-left: 18px;
    color: var(--x-ink);
    display: grid;
    gap: 6px;
    white-space: nowrap;
  }
  @media (max-width: 860px) {
    .mission {
      height: auto;
      min-height: 60svh;
      padding: 80px var(--x-pad);
      justify-content: flex-end;
    }
    .col {
      width: 100%;
    }
    .aside {
      margin-left: 0;
    }
  }
</style>
