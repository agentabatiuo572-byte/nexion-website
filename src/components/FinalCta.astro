---
/* [FEAT-WEB12] 收尾 CTA — 收束宣言 + 下载键(与 hero 同组件同配置,PRD ⑦ 单源)。
   axiom 方向:黑底大陈述 + slide-swap 下载键。 */
import DownloadButtons from './hero/DownloadButtons.astro';
import { useT, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useT(locale);
---

<section class="final" id="final-cta">
  <h2 class="x-display" data-lr>{t('final.title')}</h2>
  <div class="btns" data-rv style="--d:.3s">
    <DownloadButtons locale={locale} />
  </div>
</section>

<style>
  /* R8:manifesto 位(画布 py-140,40 档陈述) */
  .final {
    position: relative;
    z-index: 1;
    padding: max(80px, calc(140 * var(--u))) var(--x-pad);
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: max(28px, calc(43.2 * var(--u)));
  }
  h2 {
    font-size: max(28px, calc(40 * var(--u)));
    color: var(--x-white);
    margin: 0;
    /* R45(B3b):去 24ch 上限——参考站宣言行跑满画布;vi 曾因此被折成两行 */
  }
</style>
