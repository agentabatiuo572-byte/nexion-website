---
/* [FEAT-WEB12] 收尾 CTA — 收束宣言 + 下载键(与 hero 同组件同配置,PRD ⑦ 单源)。
   axiom 方向:黑底大陈述 + slide-swap 下载键。 */
import DownloadButtons from './hero/DownloadButtons.astro';
import { useT, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useT(locale);
---

<section class="final" id="final-cta">
  <h2 class="x-display" data-lr>{t('final.title')}</h2>
  <div class="btns" data-rv style="--d:.3s">
    <DownloadButtons locale={locale} />
  </div>
</section>

<style>
  /* R8:manifesto 位(画布 py-140,40 档陈述) */
  .final {
    position: relative;
    z-index: 1;
    padding: clamp(80px, 9.72vw, 187px) var(--x-pad);
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: clamp(28px, 3vw, 56px);
  }
  h2 {
    font-size: clamp(28px, 2.78vw, 53px);
    color: var(--x-white);
    margin: 0;
    max-width: 24ch;
  }
</style>
