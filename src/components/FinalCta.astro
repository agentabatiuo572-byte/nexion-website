---
/* [FEAT-WEB12] 收尾 CTA — 收束宣言 + 下载键(与 hero 同组件同配置,PRD ⑦ 单源)。
   axiom 方向:黑底大陈述 + slide-swap 下载键。 */
import DownloadButtons from './hero/DownloadButtons.astro';
import { useT, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useT(locale);
---

<section class="final" id="final-cta">
  <h2 class="x-display" data-rv>{t('final.title')}</h2>
  <div class="btns" data-rv style="--d:.15s">
    <DownloadButtons locale={locale} />
  </div>
</section>

<style>
  .final {
    position: relative;
    z-index: 1;
    padding: var(--x-section-gap) var(--x-pad);
    min-height: 52svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: clamp(24px, 4vh, 40px);
  }
  h2 {
    font-size: clamp(34px, 5.4vw, 72px);
    color: var(--x-white);
    margin: 0;
    max-width: 18ch;
  }
</style>
