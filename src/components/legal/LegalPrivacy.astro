---
/* [FEAT-WEB12] Privacy Policy — en 权威文本(主人 2026-08-20 批准起草;2026-09-01 主人授权按项目实际行为定稿)。
   🔴 2026-09-01 修订缘由:官网后台上线了**访问统计埋点**与**区域屏蔽**,而这份文本仍写着
   「不收集任何数据 / 不设 cookie / 未提区域屏蔽」——**文本在否认本站正在做的事**。
   本次只做一件事:把已经存在的行为如实写出来,**不新增任何承诺**。三处改动都逐条回源核实过:
     §2 采集面 —— `src/scripts/metrics.ts`(DNT=1 整体不启动)+ `worker/src/ingest.ts`(IP 只瞬时参与
        每日轮换的去重哈希、不落库)+ `worker/src/rollup.ts`(原始记录 90 天清理,只留每日汇总)。
     §3 cookie/本地存储 —— 全站仅两枚 cookie:`gx_bypass`(区域直通,30 天)与 `nx_sid`(后台登录,7 天滑动);
        访客本地存储仅 `x-bg-paused`(关闭背景动画的偏好,无障碍开关,不上传)。
     §6 区域可用性 —— `worker/src/geo.ts`:按连接来源国家拒绝访问,被拒请求只记国家与页面大类、无任何标识。
   ⚠️ 起草人不是律师:内容只描述已有行为,仍建议法务复核。
   实体信息按 O2 资料包填充(NexGrid LTD / Denver, CO)。vi/zh 页由壳挂「以英文版为准」说明后渲染本组件。
   R45 B7:标题挂全站 display 尺(88 档=内页「名称型」标题,与 /learn 同档)、meta 行挂 .x-mono、小标题行高 1.1;
   英文正文标 lang=en(vi/zh 路由的 html lang 是本语)。 */
import { useT, type Locale } from '../../i18n';
import { SOURCE_LOCALE } from '../../../schema/src/locales';
import { SITE_CONFIG } from '../../lib/site-config';
import LegalDocument from './LegalDocument.astro';
import LegalToc from './LegalToc.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useT(locale);
const configured = SITE_CONFIG.legal?.privacy;
const hasConfigured = Boolean(configured?.md[locale]?.trim() || configured?.md[SOURCE_LOCALE]?.trim() || configured?.md.en?.trim());
const headings = [
  '1. Scope',
  '2. What this Site collects',
  '3. Cookies and browser storage',
  '4. Server logs',
  '5. External links',
  '6. Availability by region',
  '7. Changes',
  '8. Contact',
].map((text, index) => ({ id: `legal-section-${index + 1}`, text }));
---

{hasConfigured ? <LegalDocument locale={locale} document="privacy" fallbackTitle="Privacy Policy" /> : <main class="legal" lang="en">
  {locale !== 'en' && <p class="prevails x-mono" lang={locale}>{t('legal.enPrevails')}</p>}
  <h1 class="x-display">Privacy Policy</h1>
  <p class="updated x-mono">Last updated: 2026-09-01</p>

  <LegalToc locale={locale} headings={headings} />
  <div class="sheet x-copy x-tile x-tile-calm">
  <h2 id={headings[0].id}>{headings[0].text}</h2>
  <p>
    This policy covers the Uvel marketing website (the "Site"). The Uvel application (the "App") has its own
    privacy policy, shown in the App — data practices inside the App are governed by that document, not this one.
  </p>

  <h2 id={headings[1].id}>{headings[1].text}</h2>
  <p>
    The Site has no visitor accounts and no forms. It does not use advertising trackers, and it loads no third-party
    analytics scripts.
  </p>
  <p>
    The Site uses its own analytics to understand how the Site is used. It records: the pages viewed, which sections,
    buttons and questions were interacted with, the display language, whether the device is a phone or a desktop, a
    broad category for how the visit arrived (for example: search, social, direct), campaign parameters if they are
    present in the address, basic page-performance measurements, and the country associated with the connection.
  </p>
  <p>
    Your IP address is not stored. It is used only to derive a short identifier that lets us count repeat visits within
    a single day; that identifier is regenerated every day, so visits cannot be linked from one day to the next. No
    name, email address, account, or other directly identifying information is collected by the Site.
  </p>
  <p>
    If your browser sends a "Do Not Track" signal, the Site's analytics do not run at all.
  </p>
  <p>
    Individual records are deleted after 90 days. Only aggregate daily counts are kept after that.
  </p>

  <h2 id={headings[2].id}>{headings[2].text}</h2>
  <p>
    Ordinary browsing sets no cookies. If you reach the Site through a regional access link, a single cookie is set for
    up to 30 days for the sole purpose of allowing that access; it carries no information about you. Administrators
    signing in to the Site's management area receive a session cookie for that purpose only.
  </p>
  <p>
    The Site stores one preference in your browser: whether you have turned off the animated background. It stays on
    your device and is not sent to us.
  </p>
  <p>
    Your language choice is reflected in the address (for example /vi/ or /zh/) rather than stored on your device.
  </p>

  <h2 id={headings[3].id}>{headings[3].text}</h2>
  <p>
    Our hosting infrastructure may record standard technical logs (such as IP address, user agent, and requested URL)
    for security and operational purposes. These logs are retained only as long as operationally necessary and are not
    used to identify individuals.
  </p>

  <h2 id={headings[4].id}>{headings[4].text}</h2>
  <p>
    The Site links to app stores and to the Uvel App. Once you leave the Site, the destination's own privacy terms
    apply.
  </p>

  <h2 id={headings[5].id}>{headings[5].text}</h2>
  <p>
    The Site is not available in some regions. Availability is determined by the country associated with your
    connection.
  </p>
  <p>
    Requests that are turned away are counted, recording only the country and the kind of page requested. No identifier
    is recorded for them.
  </p>

  <h2 id={headings[6].id}>{headings[6].text}</h2>
  <p>We may update this policy from time to time. The "Last updated" date above reflects the current version.</p>

  <h2 id={headings[7].id}>{headings[7].text}</h2>
  <p>The Site is operated by NexGrid LTD, a Colorado corporation. Registered address: 1670 Bwayroad, Denver, CO 80202, United States.</p>
  </div>
</main>}

<style>
  .legal {
    position: relative;
    z-index: 1;
    max-width: calc(780 * var(--uc));
    margin-top: calc(84 * var(--uc));
    /* R39-fix:画布留白必须加在盒外。本站 box-sizing:border-box,把 gut 塞进 padding
       会从 max-width 的 780 里倒扣 —— 2560 视口下正文被挤成 33px(三路评审独立实测)。 */
    padding: calc(46 * var(--uc)) var(--x-pad) calc(40 * var(--uc));
  }
  .prevails {
    border: 1px solid var(--x-line);
    color: var(--x-ink-dim);
    line-height: 1.2;
    padding: calc(10 * var(--uc)) calc(16 * var(--uc));
    margin: 0 0 calc(20 * var(--uc));
  }
  h1 {
    font-size: clamp(32px, calc(54 * var(--u)), calc(54 * var(--uc)));
    color: var(--x-ink);
    margin: 0 0 calc(14 * var(--uc));
  }
  .updated {
    color: var(--x-ink-dim);
    line-height: 1.2;
    margin: 0 0 calc(30 * var(--uc));
  }
  h2 {
    font-family: var(--x-font-display);
    font-size: clamp(18px, 1.9vw, calc(24 * var(--uc)));
    font-weight: 500;
    line-height: 1.1;
    color: var(--x-ink);
    margin: calc(30 * var(--uc)) 0 calc(10 * var(--uc));
    letter-spacing: -0.02em; /* 24 档统一 -0.02em(与 FAQ 问题同) */
  }
  p {
    color: var(--x-ink-dim);
    margin: 0 0 calc(12 * var(--uc));
    text-wrap: pretty;
  }
  .sheet {
    padding: clamp(20px, 2.6vw, calc(34 * var(--uc)));
    margin-top: calc(8 * var(--uc));
  }
  .sheet > h2:first-child {
    margin-top: 0;
  }
</style>
