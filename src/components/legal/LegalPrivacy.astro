---
/* [FEAT-WEB12] Privacy Policy — en 权威文本(主人 2026-08-20 批准起草,初稿供审;
   上线前建议法务过目)。实体信息已按 O2 资料包填充(NexGrid LTD / Denver, CO)。
   vi/zh 页由壳挂「以英文版为准」说明后渲染本组件。
   R45 B7:标题挂全站 display 尺(88 档=内页「名称型」标题,与 /learn 同档)、meta 行挂 .x-mono、小标题行高 1.1;
   英文正文标 lang=en(vi/zh 路由的 html lang 是本语)。 */
import { useT, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useT(locale);
---

<main class="legal" lang="en">
  {locale !== 'en' && <p class="prevails x-mono" lang={locale}>{t('legal.enPrevails')}</p>}
  <h1 class="x-display">Privacy Policy</h1>
  <p class="updated x-mono">Last updated: 2026-08-20</p>

  <div class="sheet x-paper">
  <h2>1. Scope</h2>
  <p>
    This policy covers the NexGrid marketing website (the "Site"). The NexGrid application (the "App") has its own
    privacy policy, shown in the App — data practices inside the App are governed by that document, not this one.
  </p>

  <h2>2. What this Site collects</h2>
  <p>
    The Site is a static informational website. It has no user accounts, no forms, and does not collect, store, or
    process personal data. We do not use advertising trackers or third-party analytics scripts on the Site.
  </p>

  <h2>3. Cookies</h2>
  <p>
    The Site does not set cookies. Your language choice is reflected in the URL (for example /vi/ or /zh/) rather than
    stored on your device.
  </p>

  <h2>4. Server logs</h2>
  <p>
    Our hosting infrastructure may record standard technical logs (such as IP address, user agent, and requested URL)
    for security and operational purposes. These logs are retained only as long as operationally necessary and are not
    used to identify individuals.
  </p>

  <h2>5. External links</h2>
  <p>
    The Site links to app stores and to the NexGrid App. Once you leave the Site, the destination's own privacy terms
    apply.
  </p>

  <h2>6. Changes</h2>
  <p>We may update this policy from time to time. The "Last updated" date above reflects the current version.</p>

  <h2>7. Contact</h2>
  <p>The Site is operated by NexGrid LTD, a Colorado corporation. Registered address: 1670 Bwayroad, Denver, CO 80202, United States.</p>
  </div>
</main>

<style>
  .legal {
    position: relative;
    z-index: 1;
    max-width: calc(780 * var(--uc));
    margin-top: calc(84 * var(--uc));
    /* R39-fix:画布留白必须加在盒外。本站 box-sizing:border-box,把 gut 塞进 padding
       会从 max-width 的 780 里倒扣 —— 2560 视口下正文被挤成 33px(三路评审独立实测)。 */
    padding: calc(46 * var(--uc)) var(--x-pad) calc(40 * var(--uc));
  }
  .prevails {
    border: 1px solid var(--x-line);
    color: var(--x-ink-dim);
    line-height: 1.2;
    padding: calc(10 * var(--uc)) calc(16 * var(--uc));
    margin: 0 0 calc(20 * var(--uc));
  }
  h1 {
    font-size: clamp(40px, 6.4vw, calc(88 * var(--uc)));
    color: var(--x-ink);
    margin: 0 0 calc(14 * var(--uc)); /* 88 档标题降部与 meta 小字的呼吸(此前 8) */
  }
  .updated {
    color: var(--x-ink-dim);
    line-height: 1.2;
    margin: 0 0 calc(30 * var(--uc));
  }
  h2 {
    font-family: var(--x-font-display);
    font-size: clamp(18px, 1.9vw, calc(24 * var(--uc)));
    font-weight: 500;
    line-height: 1.1;
    color: var(--x-ink);
    margin: calc(30 * var(--uc)) 0 calc(10 * var(--uc));
    letter-spacing: -0.02em; /* 24 档统一 -0.02em(与 FAQ 问题同) */
  }
  p {
    font-family: var(--x-font-mono);
    color: var(--x-ink-dim);
    font-size: calc(12 * var(--uc));
    line-height: 1.85;
    margin: 0 0 calc(12 * var(--uc));
    text-wrap: pretty;
  }
  .sheet {
    padding: clamp(20px, 2.6vw, calc(34 * var(--uc)));
    margin-top: calc(8 * var(--uc));
  }
  .sheet > h2:first-child {
    margin-top: 0;
  }
</style>
