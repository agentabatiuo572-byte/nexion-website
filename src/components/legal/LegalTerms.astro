---
/* [FEAT-WEB12] Terms of Service — en 权威文本(初稿供主人审;上线前建议法务过目)。
   管辖条款已按 O2 资料包填充(Colorado, USA)。
   R45 B7:标题挂全站 display 尺(88 档=内页「名称型」标题)、meta 行挂 .x-mono、小标题行高 1.1;英文正文标 lang=en。 */
import { useT, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useT(locale);
---

<main class="legal" lang="en">
  {locale !== 'en' && <p class="prevails x-mono" lang={locale}>{t('legal.enPrevails')}</p>}
  <h1 class="x-display">Terms of Service</h1>
  <p class="updated x-mono">Last updated: 2026-08-20</p>

  <div class="sheet x-tile x-tile-calm">
  <h2>1. What this Site is</h2>
  <p>
    The NexGrid marketing website (the "Site") provides information about the NexGrid platform and links to download
    the NexGrid application (the "App"). Use of the App is governed by the terms presented inside the App.
  </p>

  <h2>2. Informational content only</h2>
  <p>
    Content on the Site describes how the platform works. It is not financial, investment, tax, or legal advice, and it
    is not an offer or solicitation of any kind. Earnings on the platform vary with network demand, device performance,
    and uptime, and are not guaranteed. Figures shown on the Site (such as network statistics) are informational
    snapshots or live values as labeled.
  </p>

  <h2>3. Digital assets</h2>
  <p>
    References to USDT and NEX describe platform mechanics. Digital asset values can go down as well as up. Nothing on
    the Site should be read as a prediction of value.
  </p>

  <h2>4. Intellectual property</h2>
  <p>
    The Site's content, branding, and design are the property of the operator. You may not copy or reuse them for
    commercial purposes without permission.
  </p>

  <h2>5. Acceptable use</h2>
  <p>You may not attempt to disrupt the Site, scrape it at abusive volume, or misrepresent its content.</p>

  <h2>6. No warranty; limitation of liability</h2>
  <p>
    The Site is provided "as is" without warranties of any kind. To the maximum extent permitted by law, the operator is
    not liable for damages arising from use of the Site or reliance on its content.
  </p>

  <h2>7. Changes</h2>
  <p>We may update these terms; the "Last updated" date reflects the current version.</p>

  <h2>8. Governing law</h2>
  <p>These terms are governed by the laws of the State of Colorado, United States. The Site is operated by NexGrid LTD, 1670 Bwayroad, Denver, CO 80202, United States.</p>
  </div>
</main>

<style>
  .legal {
    position: relative;
    z-index: 1;
    max-width: calc(780 * var(--uc));
    margin-top: calc(84 * var(--uc));
    /* R39-fix:画布留白必须加在盒外。本站 box-sizing:border-box,把 gut 塞进 padding
       会从 max-width 的 780 里倒扣 —— 2560 视口下正文被挤成 33px(三路评审独立实测)。 */
    padding: calc(46 * var(--uc)) var(--x-pad) calc(40 * var(--uc));
  }
  .prevails {
    border: 1px solid var(--x-line);
    color: var(--x-ink-dim);
    line-height: 1.2;
    padding: calc(10 * var(--uc)) calc(16 * var(--uc));
    margin: 0 0 calc(20 * var(--uc));
  }
  h1 {
    font-size: clamp(40px, 6.4vw, calc(88 * var(--uc)));
    color: var(--x-ink);
    margin: 0 0 calc(14 * var(--uc)); /* 88 档标题降部与 meta 小字的呼吸(此前 8) */
  }
  .updated {
    color: var(--x-ink-dim);
    line-height: 1.2;
    margin: 0 0 calc(30 * var(--uc));
  }
  h2 {
    font-family: var(--x-font-display);
    font-size: clamp(18px, 1.9vw, calc(24 * var(--uc)));
    font-weight: 500;
    line-height: 1.1;
    color: var(--x-ink);
    margin: calc(30 * var(--uc)) 0 calc(10 * var(--uc));
    letter-spacing: -0.02em; /* 24 档统一 -0.02em(与 FAQ 问题同) */
  }
  p {
    font-family: var(--x-font-mono);
    color: var(--x-ink-dim);
    font-size: calc(12 * var(--uc));
    line-height: 1.85;
    margin: 0 0 calc(12 * var(--uc));
    text-wrap: pretty;
  }
  .sheet {
    padding: clamp(20px, 2.6vw, calc(34 * var(--uc)));
    margin-top: calc(8 * var(--uc));
  }
  .sheet > h2:first-child {
    margin-top: 0;
  }
</style>
