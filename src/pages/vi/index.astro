---
/* Home(vi)— hero 已落地(T3);其余板块 HomeSkeleton 占位,T4-T12 逐板块替换 */
import Base from '../../layouts/Base.astro';
import HeroSection from '../../components/hero/HeroSection.astro';
import StatsBar from '../../components/StatsBar.astro';
import PathSection from '../../components/PathSection.astro';
import HowSection from '../../components/HowSection.astro';
import DevicesSection from '../../components/DevicesSection.astro';
import TrustSection from '../../components/TrustSection.astro';
import SocialSection from '../../components/SocialSection.astro';
import MissionSection from '../../components/MissionSection.astro';
import NexTeaser from '../../components/nex/NexTeaser.astro';
import HomeSkeleton from '../../components/HomeSkeleton.astro';
import { useT } from '../../i18n';
const t = useT('vi');
---

<Base locale="vi" title={`${t('site.name')} — ${t('site.tagline')}`} description={t('site.description')} path="/">
  <main>
    <HeroSection locale="vi" />
    <StatsBar locale="vi" />
    <PathSection locale="vi" />
    <HowSection locale="vi" />
    <DevicesSection locale="vi" />
    <TrustSection locale="vi" />
    <SocialSection locale="vi" />
    <MissionSection locale="vi" />
    <NexTeaser locale="vi" />
    <HomeSkeleton locale="vi" />
  </main>
</Base>
