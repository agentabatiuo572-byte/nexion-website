---
/* 404 — 静态托管对任意缺失路径返回 dist/404.html,无法知道来访语言,故三语并列(en 在前)。
   noindex,不发 canonical/hreflang。文案 key:notfound.* (R45 新增,三语 parity 门守)。 */
import Base from '../layouts/Base.astro';
import { useT, locales } from '../i18n';
const t = useT('en');
const home = (l: string) => (l === 'en' ? '/' : `/${l}/`);
---

{/* 标题用语言中性形式:三语并列的页面,标签页不该只说英文那一句 */}
<Base locale="en" title="404 — NexGrid" description={t('notfound.body')} path="/404" noindex>
  <main class="nf">
    {
      locales.map((l, i) => {
        const tt = useT(l);
        const Heading = i === 0 ? 'h1' : 'p';
        return (
          <section class="blk" lang={l}>
            <Heading class="title x-display">{tt('notfound.title')}</Heading>
            <p class="body x-mono">{tt('notfound.body')}</p>
            {/* 三块结构完全平行,按钮也平行:只用一个属性打破平行读起来像疏漏而不是层级 */}
            <a class="xbtn solid" href={home(l)}>
              <span class="xbtn-ghost" aria-hidden="true">{tt('notfound.home')} <span class="arr">→</span></span>
              <span class="xbtn-a">{tt('notfound.home')} <span class="arr">→</span></span>
              <span class="xbtn-b" aria-hidden="true">{tt('notfound.home')} <span class="arr">→</span></span>
            </a>
          </section>
        );
      })
    }
  </main>
  {/* 静态托管对 /vi/... 与 /zh/... 的缺失路径也返回这一份 404:导航是按英文站渲染的,
      按真实路径把整页链与锚点链补上语言前缀(语言切换链本身已是 / /vi/ /zh/,跳过)。 */}
  <script is:inline>
    (function () {
      var m = location.pathname.match(/^\/(vi|zh)\//);
      if (!m) return;
      var p = '/' + m[1];
      var nav = document.getElementById('site-nav');
      if (!nav) return;
      var links = nav.querySelectorAll('a[href^="/"]');
      for (var i = 0; i < links.length; i++) {
        var h = links[i].getAttribute('href');
        if (h === '/' || h.indexOf('/vi/') === 0 || h.indexOf('/zh/') === 0) continue;
        links[i].setAttribute('href', p + h);
      }
    })();
  </script>
</Base>

<style>
  .nf {
    position: relative;
    z-index: 1;
    margin-top: calc(84 * var(--uc));
    padding: calc(46 * var(--uc)) var(--x-pad) calc(80 * var(--uc));
    display: grid;
    gap: calc(56 * var(--uc));
  }
  /* 三块都直压粒子(实测 VI 54px 白标题 1.40:1、EN 说明行 1.22:1),而本轮自己刚按
     「小字密集板块禁直压粒子线」把目录/相关文章搬进纸面板;这里不套白卡(会破坏 404 的暗调),
     用与页脚同配方的局部护字层。 */
  .blk::before {
    content: '';
    position: absolute;
    inset: calc(-18 * var(--uc)) calc(-28 * var(--uc));
    background: var(--x-scrim);
    filter: blur(calc(14 * var(--uc))); /* 护字层全站同一组参数:-18/-28 + blur14 */
    z-index: -1;
  }
  .blk {
    position: relative;
    display: grid;
    gap: calc(16 * var(--uc));
    justify-items: start;
    max-width: calc(640 * var(--uc));
  }
  .title {
    font-size: clamp(34px, 5.2vw, calc(54 * var(--uc)));
    color: var(--x-ink);
    margin: 0;
  }
  .body {
    color: var(--x-ink-dim);
    margin: 0;
    text-wrap: pretty;
    line-height: 1.5;
  }
</style>
