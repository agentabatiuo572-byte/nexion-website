---
/* 每个语言目录提供自己的 404.html，由静态托管按缺失路径就近选择。 */
import Base from '../layouts/Base.astro';
import { useT, type Locale } from '../i18n';
import { localizedPath } from '../lib/locale-policy';
interface Props { locale?: Locale }
const { locale = 'en' } = Astro.props;
const t = useT(locale);
---

<Base locale={locale} title={t('notfound.title')} description={t('notfound.body')} path="/404" noindex>
  <main class="nf">
    <section class="blk" lang={locale}>
      <h1 class="title x-display">{t('notfound.title')}</h1>
      <p class="body x-mono">{t('notfound.body')}</p>
      <a class="xbtn solid" href={localizedPath(locale, '/')}>
        <span class="xbtn-ghost" aria-hidden="true">{t('notfound.home')} <span class="arr">→</span></span>
        <span class="xbtn-a">{t('notfound.home')} <span class="arr">→</span></span>
        <span class="xbtn-b" aria-hidden="true">{t('notfound.home')} <span class="arr">→</span></span>
      </a>
    </section>
  </main>
</Base>

<style>
  .nf {
    position: relative;
    z-index: 1;
    margin-top: calc(84 * var(--uc));
    padding: calc(46 * var(--uc)) var(--x-pad) calc(80 * var(--uc));
    display: grid;
    gap: calc(56 * var(--uc));
  }
  /* 沿用页脚的局部护字层，避免粒子线压住提示文案。 */
  .blk::before {
    content: '';
    position: absolute;
    inset: calc(-18 * var(--uc)) calc(-28 * var(--uc));
    background: var(--x-scrim);
    filter: blur(calc(14 * var(--uc))); /* 护字层全站同一组参数:-18/-28 + blur14 */
    z-index: -1;
  }
  .blk {
    position: relative;
    display: grid;
    gap: calc(16 * var(--uc));
    justify-items: start;
    max-width: calc(640 * var(--uc));
  }
  .title {
    font-size: clamp(34px, 5.2vw, calc(54 * var(--uc)));
    color: var(--x-ink);
    margin: 0;
  }
  .body {
    color: var(--x-ink-dim);
    margin: 0;
    text-wrap: pretty;
    line-height: 1.5;
  }
</style>
