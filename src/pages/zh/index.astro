---
/* Home(zh)— R8 区带结构:黑带(hero/stats/statement/about/叠卡)→ 白幕布带(六块)→ 黑收尾 */
import Base from '../../layouts/Base.astro';
import HeroSection from '../../components/hero/HeroSection.astro';
import StatsBar from '../../components/StatsBar.astro';
import SocialSection from '../../components/SocialSection.astro';
import MissionSection from '../../components/MissionSection.astro';
import DevicesSection from '../../components/DevicesSection.astro';
import HowSection from '../../components/HowSection.astro';
import PathSection from '../../components/PathSection.astro';
import TrustSection from '../../components/TrustSection.astro';
import NexTeaser from '../../components/nex/NexTeaser.astro';
import LearnTeaser from '../../components/learn/LearnTeaser.astro';
import FaqSection from '../../components/FaqSection.astro';
import FinalCta from '../../components/FinalCta.astro';
import { useT } from '../../i18n';
const t = useT('zh');
---

<Base locale="zh" title={`${t('site.name')} — ${t('site.tagline')}`} description={t('site.description')} path="/">
  <main>
    <HeroSection locale="zh" />
    <StatsBar locale="zh" />
    <SocialSection locale="zh" />
    <MissionSection locale="zh" />
    <DevicesSection locale="zh" />
    <div class="band-deep">
      <HowSection locale="zh" />
      <PathSection locale="zh" />
      <TrustSection locale="zh" />
      <NexTeaser locale="zh" />
      <LearnTeaser locale="zh" />
      <FaqSection locale="zh" />
    </div>
    <FinalCta locale="zh" />
  </main>
</Base>
