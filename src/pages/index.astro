---
/* Home(en)— hero 已落地(T3);其余板块 HomeSkeleton 占位,T4-T12 逐板块替换 */
import Base from '../layouts/Base.astro';
import HeroSection from '../components/hero/HeroSection.astro';
import StatsBar from '../components/StatsBar.astro';
import PathSection from '../components/PathSection.astro';
import HowSection from '../components/HowSection.astro';
import DevicesSection from '../components/DevicesSection.astro';
import HomeSkeleton from '../components/HomeSkeleton.astro';
import { useT } from '../i18n';
const t = useT('en');
---

<Base locale="en" title={`${t('site.name')} — ${t('site.tagline')}`} description={t('site.description')} path="/">
  <main>
    <HeroSection locale="en" />
    <StatsBar locale="en" />
    <PathSection locale="en" />
    <HowSection locale="en" />
    <DevicesSection locale="en" />
    <HomeSkeleton locale="en" />
  </main>
</Base>
