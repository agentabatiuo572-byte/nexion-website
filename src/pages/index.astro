---
/* Home(en)— R8 区带结构:黑带(hero/stats/statement/about/叠卡)→ 白幕布带(六块)→ 黑收尾 */
import Base from '../layouts/Base.astro';
import HeroSection from '../components/hero/HeroSection.astro';
import StatsBar from '../components/StatsBar.astro';
import SocialSection from '../components/SocialSection.astro';
import MissionSection from '../components/MissionSection.astro';
import DevicesSection from '../components/DevicesSection.astro';
import HowSection from '../components/HowSection.astro';
import PathSection from '../components/PathSection.astro';
import TrustSection from '../components/TrustSection.astro';
import NexTeaser from '../components/nex/NexTeaser.astro';
import LearnTeaser from '../components/learn/LearnTeaser.astro';
import FaqSection from '../components/FaqSection.astro';
import FinalCta from '../components/FinalCta.astro';
import { useT } from '../i18n';
const t = useT('en');
---

<Base locale="en" title={`${t('site.name')} — ${t('site.tagline')}`} description={t('site.description')} path="/">
  <main>
    <HeroSection locale="en" />
    <StatsBar locale="en" />
    <SocialSection locale="en" />
    <MissionSection locale="en" />
    <DevicesSection locale="en" />
    <div class="band-light x-invert">
      <HowSection locale="en" />
      <PathSection locale="en" />
      <TrustSection locale="en" />
      <NexTeaser locale="en" />
      <LearnTeaser locale="en" />
      <FaqSection locale="en" />
    </div>
    <FinalCta locale="en" />
  </main>
</Base>
