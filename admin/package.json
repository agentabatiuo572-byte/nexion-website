{
  "name": "nexgrid-site-console",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "官网运营后台。规格:PLAN/PRD/NexGrid_官网后台PRD_v1.0.md",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "dev": "vite --port 5175",
    "test": "vitest run",
    "test:copy-layout": "node ../scripts/test-copy-layout-catalog.mjs && node ../scripts/calibrate-copy-layout.mjs --self-test && node ../scripts/calibrate-copy-layout.mjs --check",
    "test:ui": "node ../scripts/console-ui-check.mjs",
    "test:typography": "node ../scripts/console-typography-check.mjs",
    "build": "npm run test:copy-layout && npm run typecheck && npm test && vite build"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.6.0",
    "vite": "^7.0.0",
    "vitest": "^4.1.11"
  }
}
