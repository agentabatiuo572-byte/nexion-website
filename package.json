{
  "name": "nexgrid-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "NexGrid official marketing site — Astro 7 + Tailwind 4, zero-framework JS. Spec: PLAN/PRD/NexGrid_官网PRD_v1.0.md",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "astro dev --port 4321",
    "build": "astro build",
    "preview": "astro preview --port 4321",
    "typecheck": "astro check",
    "verify": "node scripts/verify-preamble.mjs && node scripts/verify.mjs",
    "verify:prod": "node scripts/verify-preamble.mjs && node scripts/verify.mjs --prod",
    "test:worker": "npm --prefix worker test",
    "dev:worker": "npm --prefix worker run dev",
    "build:console": "npm --prefix admin run build && node worker/assemble-admin.mjs",
    "test:site-behavior": "node --import ./worker/register-ts-ext.mjs scripts/gate-site-behavior.mjs",
    "preview:assert": "node scripts/preview-assert.mjs",
    "prepare": "node .githooks/verify-before-push.mjs --install",
    "test:githooks": "node --test .githooks/verify-before-push.test.mjs .githooks/guard-mainline-commit.test.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "@fontsource/funnel-display": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "astro": "^7.2.4",
    "lenis": "^1.3.26"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@tailwindcss/vite": "^4.1.0",
    "playwright": "1.61.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.6.0"
  }
}
