    "test:red-d1": "vitest run --config vitest.red-d1.config.ts",
    "typecheck": "tsc --noEmit",
    "postinstall": "wrangler types",
    "types": "wrangler types",
    "test:static": "node test-static.mjs"
  },
  "dependencies": {
    "hono": "^4.6.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.0",
    "wrangler": "^4.127.0"
  }
}
